+//go:build with_gvisor
+
+package wireguard
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/base64"
+	"errors"
+	"net/netip"
+	"strings"
+	"sync/atomic"
+	"testing"
+
+	M "github.com/sagernet/sing/common/metadata"
+	"github.com/sagernet/wireguard-go/conn"
+	"github.com/sagernet/wireguard-go/device"
+)
+
+func TestPeerCoordinateChangeCannotReuseResolvedOldDestination(t *testing.T) {
+	for _, test := range []struct {
+		name, destination string
+		changed           bool
+	}{
+		{"unchanged_refresh", "a.example:51820", false},
+		{"changed_port", "a.example:51821", true},
+		{"changed_domain", "b.example:51820", true},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			// This device stays down. Its TUN is a memory gVisor device and its Bind
+			// never opens, so neither failure nor successful DNS exercises host UDP.
+			stack, err := newStackDevice(DeviceOptions{Context: ctx, MTU: 1408, Address: []netip.Prefix{netip.MustParsePrefix("::1/128")}})
+			if err != nil {
+				t.Fatal(err)
+			}
+			wg := device.NewDevice(ctx, stack, conn.NewStdNetBind(nil), device.NewLogger(device.LogLevelSilent, ""), 1)
+			defer wg.Close()
+			seed := sha256.Sum256([]byte("demo-coordinate-peer"))
+			peer := PeerOptions{PublicKey: base64.StdEncoding.EncodeToString(seed[:]), Endpoint: M.ParseSocksaddr("a.example:51820"), AllowedIPs: []netip.Prefix{netip.MustParsePrefix("fdab:79::1/128")}}
+			old, err := parsePeers([]PeerOptions{peer})
+			if err != nil {
+				t.Fatal(err)
+			}
+			old[0].endpoint = netip.MustParseAddrPort("192.0.2.10:51820")
+			if err := wg.IpcSet(old[0].GenerateIpcLines()); err != nil {
+				t.Fatal(err)
+			}
+			resolveFailure := errors.New("demo explicit resolver failure")
+			var resolveOK atomic.Bool
+			e := &Endpoint{device: wg, peers: old, options: EndpointOptions{Context: ctx, LazyPeers: true, ResolvePeerContext: func(_ context.Context, domain string) (netip.Addr, error) {
+				if !resolveOK.Load() {
+					return netip.Addr{}, resolveFailure
+				}
+				if domain == "b.example" {
+					return netip.MustParseAddr("192.0.2.11"), nil
+				}
+				return netip.MustParseAddr("192.0.2.10"), nil
+			}}}
+			peer.Endpoint = M.ParseSocksaddr(test.destination)
+			apply, err := e.PreparePeers([]PeerOptions{peer})
+			if err != nil {
+				t.Fatal(err)
+			}
+			if err := apply(); err != nil {
+				t.Fatal(err)
+			}
+			err = e.ensurePeer(ctx, peer.AllowedIPs[0].Addr())
+			if test.changed {
+				if !errors.Is(err, resolveFailure) {
+					t.Fatal("changed destination reused the old coordinate after failed resolution", err)
+				}
+				if e.peers[0].endpoint.IsValid() {
+					t.Fatal("changed destination inherited an old resolved endpoint")
+				}
+				resolveOK.Store(true)
+				if err := e.ensurePeer(ctx, peer.AllowedIPs[0].Addr()); err != nil {
+					t.Fatal("new destination could not recover", err)
+				}
+				expected := netip.MustParseAddrPort("192.0.2.10:51821")
+				if peer.Endpoint.Fqdn == "b.example" {
+					expected = netip.MustParseAddrPort("192.0.2.11:51820")
+				}
+				if e.peers[0].endpoint != expected {
+					t.Fatal("resolved endpoint does not match the new domain and port")
+				}
+				actual, err := wg.IpcGet()
+				if err != nil || !strings.Contains(actual, "endpoint="+expected.String()+"\n") {
+					t.Fatal("actual device did not consume the new coordinate", err)
+				}
+			} else if err != nil || e.peers[0].endpoint != old[0].endpoint {
+				t.Fatal("unchanged-coordinate refresh discarded a valid learnt endpoint", err)
+			}
+		})
+	}
+}
