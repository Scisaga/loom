+package group
+
+import (
+	"context"
+	"errors"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/common/sourcepool"
+	M "github.com/sagernet/sing/common/metadata"
+	"github.com/sagernet/sing/service"
+)
+
+func (s *Selector) pickContext(ctx context.Context, metadata *adapter.InboundContext, destination M.Socksaddr) adapter.Outbound {
+	if metadata != nil {
+		if tag := metadata.SelectedOutbounds[s.Tag()]; tag != "" {
+			if actual := sourcepool.BorrowedOutbound(ctx, tag); actual != nil {
+				if s.access.Load() != nil && s.CheckAccessConnection(*metadata) != nil {
+					return s.outbounds["reject"]
+				}
+				return actual
+			}
+		}
+	}
+	return s.pick(metadata, destination)
+}
+
+// PinSelection may prepare a cold sender only before path publication. The
+// resulting reference belongs to this synchronous dispatch until its dial binds
+// it to a connection; no selection or Policy is changed here.
+func (s *Selector) PinSelection(ctx context.Context, metadata *adapter.InboundContext) (context.Context, adapter.Outbound, func(), error) {
+	ctx = adapter.WithContext(ctx, metadata)
+	ctx, cleanup := sourcepool.WithCall(ctx)
+	pool := service.FromContext[*sourcepool.Pool](s.ctx)
+	if pool != nil && s.hop != nil && metadata.SelectedOutbounds[s.Tag()] == "" {
+		choice := s.selected.Load()
+		tags := s.qualifiedHopTags(metadata, choice)
+		var last error
+		for _, tag := range tags {
+			if err := ctx.Err(); err != nil {
+				return ctx, nil, cleanup, err
+			}
+			lease, err := pool.Acquire(ctx, tag)
+			if err != nil {
+				if errors.Is(err, context.Canceled) || errors.Is(err, context.DeadlineExceeded) {
+					return ctx, nil, cleanup, err
+				}
+				last = err
+				continue
+			}
+			if err = sourcepool.AddCallBorrow(ctx, lease); err != nil {
+				lease.Release()
+				return ctx, nil, cleanup, err
+			}
+			actual := lease.Outbound()
+			metadata.ExecutionNextNodeID = choice.hop.nodes[tag]
+			if metadata.SelectedOutbounds == nil {
+				metadata.SelectedOutbounds = map[string]string{}
+			}
+			metadata.SelectedOutbounds[s.Tag()] = tag
+			return ctx, actual, cleanup, nil
+		}
+		if last != nil {
+			return ctx, nil, cleanup, last
+		}
+	}
+	selected := s.pickContext(ctx, metadata, metadata.Destination)
+	if selected == nil {
+		return ctx, nil, cleanup, sourcepool.ErrResourcePending
+	}
+	// Source selection just fixed this connection's execution metadata. Capture
+	// those values before the pending-dial lease owns its context.
+	ctx = adapter.WithContext(ctx, metadata)
+	if pool != nil && s.RuntimeResourceConsumer() && selected.Tag() != "reject" && sourcepool.BorrowedOutbound(ctx, selected.Tag()) == nil {
+		lease, err := pool.Acquire(ctx, selected.Tag())
+		if err != nil {
+			return ctx, nil, cleanup, err
+		}
+		if !sourcepool.SameObject(lease.Outbound(), selected) {
+			lease.Release()
+			return ctx, nil, cleanup, sourcepool.ErrConflict
+		}
+		if err = sourcepool.AddCallBorrow(ctx, lease); err != nil {
+			lease.Release()
+			return ctx, nil, cleanup, err
+		}
+	}
+	if metadata.SelectedOutbounds == nil {
+		metadata.SelectedOutbounds = map[string]string{}
+	}
+	metadata.SelectedOutbounds[s.Tag()] = selected.Tag()
+	return ctx, selected, cleanup, nil
+}
