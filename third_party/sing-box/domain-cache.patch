+	_ = client.SetDeadline(time.Now().Add(3 * time.Second))
+	if _, err = io.WriteString(client, "CONNECT /loom/egress HTTP/1.1\r\nHost: localhost\r\n\r\n"+prefix); err != nil {
+		t.Fatal(err)
