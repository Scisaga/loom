+	for time.Now().Before(deadline) {
+		count, err := endpoint.ActualWireGuardPeerCount()
+		if err == nil && count == want {
+			return
+		}
+		time.Sleep(time.Millisecond)
+	}
+	t.Fatal("actual device peer count did not converge", want)
+}
