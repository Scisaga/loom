+package wireguard
+
+import (
+	"github.com/sagernet/wireguard-go/device"
+	"os"
+)
+
+func (e *Endpoint) PeerCounters() (string, []device.PeerCounter, error) {
+	if !e.counterMu.TryRLock() {
+		return "", nil, os.ErrNotExist
+	}
+	defer e.counterMu.RUnlock()
+	if e.device == nil || e.counterEpoch == "" {
+		return "", nil, os.ErrNotExist
+	}
+	values, err := e.device.PeerCounters()
+	if err != nil {
+		return "", nil, err
+	}
+	return e.counterEpoch, values, nil
+}
