+package clashapi
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	"github.com/sagernet/sing-box/experimental/clashapi/trafficontrol"
+)
+
+func TestTCPObservationsRequireAuthenticatedLoopbackAndNoQuery(t *testing.T) {
+	for _, test := range []struct {
+		address, secret, path string
+		authenticated         bool
+		want                  int
+	}{
+		{"127.0.0.1:61800", "demo-secret", "/loom/tcp-observations", true, 200},
+		{"127.0.0.1:61800", "", "/loom/tcp-observations", false, 403},
+		{"192.0.2.1:61800", "demo-secret", "/loom/tcp-observations", true, 403},
+		{"127.0.0.1:61800", "demo-secret", "/loom/tcp-observations?target=demo-target.example", true, 400},
+	} {
+		server := &Server{httpServer: &http.Server{Addr: test.address}, trafficManager: trafficontrol.NewManager()}
+		request := httptest.NewRequest(http.MethodGet, test.path, nil)
+		if test.secret != "" {
+			request.Header.Set("Authorization", "Bearer "+test.secret)
+		}
+		response := httptest.NewRecorder()
+		authentication(test.secret)(server.tcpObservations(test.authenticated)).ServeHTTP(response, request)
+		if response.Code != test.want {
+			t.Fatal("local observation readback admitted an unowned source", response.Code)
+		}
+		if test.want == 200 && response.Body.String() != "{\"observations\":[]}\n" {
+			t.Fatal("empty snapshot was not explicit")
+		}
+	}
+	server := &Server{httpServer: &http.Server{Addr: "127.0.0.1:61800"}, trafficManager: trafficontrol.NewManager()}
+	request := httptest.NewRequest(http.MethodGet, "/loom/tcp-observations", nil)
+	response := httptest.NewRecorder()
+	authentication("demo-secret")(server.tcpObservations(true)).ServeHTTP(response, request)
+	if response.Code != http.StatusUnauthorized {
+		t.Fatal("missing API secret gained observation access")
+	}
+}
