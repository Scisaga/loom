+//go:build linux && !android
+
+package device
+
+import (
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+func TestMessageBudgetRejectsWithoutWaitingAndRecovers(t *testing.T) {
+	p := newMessageBufferPool().(*linuxMessageBufferPool)
+	values := make([]any, maxLiveMessageBuffers)
+	for i := range values {
+		values[i] = p.Get()
+		if values[i] == nil {
+			t.Fatal("budget rejected an admitted message")
+		}
+	}
+	done := make(chan any, 1)
+	go func() { done <- p.Get() }()
+	select {
+	case value := <-done:
+		if value != nil {
+			t.Fatal("message exceeded whole-device budget")
+		}
+	case <-time.After(time.Second):
+		t.Fatal("exhausted producer waited while holding its batch")
+	}
+	p.Put(values[0])
+	values[0] = p.Get()
+	if values[0] == nil {
+		t.Fatal("released capacity did not recover")
+	}
+	for _, value := range values {
+		p.Put(value)
+	}
+	if p.inuse != 0 || len(p.idle) != maxIdleMessageBuffers {
+		t.Fatal("burst was not returned to the bounded idle set")
+	}
+}
+
+func TestConcurrentMessageBudgetDoesNotAlias(t *testing.T) {
+	p := newMessageBufferPool().(*linuxMessageBufferPool)
+	var active sync.Map
+	var wait sync.WaitGroup
+	var alias atomic.Bool
+	for i := 0; i < 32; i++ {
+		wait.Add(1)
+		go func() {
+			defer wait.Done()
+			for j := 0; j < 1000; j++ {
+				value := p.Get()
+				if value == nil {
+					continue
+				}
+				if _, loaded := active.LoadOrStore(value, true); loaded {
+					alias.Store(true)
+				}
+				active.Delete(value)
+				p.Put(value)
+			}
+		}()
+	}
+	wait.Wait()
+	if alias.Load() || p.inuse != 0 || len(p.idle) > maxIdleMessageBuffers {
+		t.Fatal("concurrent admission aliased or retained the burst")
+	}
+}
+
+func TestScratchSwapPreservesQueueBudgetDuringClose(t *testing.T) {
+	p := newMessageBufferPool().(*linuxMessageBufferPool)
+	// Simulate dual-stack receive plus a system TUN. They own permanent
+	// scratch credits even when packet ownership swaps to processing queues.
+	scratch := make([]any, 3*128)
+	for i := range scratch {
+		scratch[i] = p.GetScratch()
+	}
+	queued := make([]any, maxLiveMessageBuffers)
+	for i := range queued {
+		replacement := p.Get()
+		if replacement == nil {
+			t.Fatal("queue budget counted permanent scratch as queued data")
+		}
+		queued[i], scratch[i] = scratch[i], replacement
+	}
+	if p.Get() != nil {
+		t.Fatal("scratch swap exceeded the shared queued-byte budget")
+	}
+	for _, buffer := range scratch {
+		p.PutScratch(buffer)
+	}
+	for _, buffer := range queued {
+		p.Put(buffer)
+	}
+	if p.scratch != 0 || p.inuse != 0 || len(p.idle) != maxIdleMessageBuffers {
+		t.Fatal("closing scratch and queues leaked memory ownership")
+	}
+}
