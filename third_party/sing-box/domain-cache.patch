+package wireguard
+
+import (
+	"net/netip"
+
+	"github.com/sagernet/sing-box/common/execution"
+	"github.com/sagernet/sing-box/common/sourcepool"
+	"github.com/sagernet/sing-box/option"
+)
+
+// RetireRuntimeWireGuard deletes only exact sender bindings from the current
+// physical snapshot. It never reapplies a cached receiving peer list or grants
+// a missing peer. The caller has already checked that no live lease uses them.
+func (w *Endpoint) RuntimeWireGuardSnapshot() any { return w.sourceRoutes.Load() }
+
+func (w *Endpoint) RetireRuntimeWireGuard(expected any, peers []option.WireGuardPeer, routes []option.WireGuardSourceRoute, intervals map[string]uint16) error {
+	previous, ok := expected.(*sourceRouteSnapshot)
+	if !ok || w.sourceRoutes.Load() != previous {
+		return sourcepool.ErrConflict
+	}
+	if previous == nil {
+		return nil
+	}
+	remove := map[option.WireGuardSourceRoute]bool{}
+	for _, route := range routes {
+		remove[route] = true
+	}
+	remaining := make([]option.WireGuardSourceRoute, 0, len(previous.routes))
+	owned := map[string]option.WireGuardPeer{}
+	for _, peer := range peers {
+		owned[peer.PublicKey] = peer
+	}
+	removedPrefixes := map[string]map[netip.Prefix]bool{}
+	for _, route := range previous.routes {
+		if !remove[route] {
+			remaining = append(remaining, route)
+			continue
+		}
+		found := false
+		for _, current := range previous.peers {
+			bound := false
+			for _, prefix := range current.AllowedIPs {
+				bound = bound || prefix == route.Destination
+			}
+			if !bound {
+				continue
+			}
+			old, exists := owned[current.PublicKey]
+			if !exists || old.PreSharedKey != current.PreSharedKey {
+				return execution.ErrSuperseded
+			}
+			for _, prefix := range []netip.Prefix{route.Destination, netip.PrefixFrom(route.Execution, 128)} {
+				allowed := false
+				for _, source := range old.AllowedIPs {
+					allowed = allowed || source == prefix
+				}
+				if !allowed {
+					return execution.ErrSuperseded
+				}
+				if removedPrefixes[current.PublicKey] == nil {
+					removedPrefixes[current.PublicKey] = map[netip.Prefix]bool{}
+				}
+				removedPrefixes[current.PublicKey][prefix] = true
+			}
+			found = true
+		}
+		if !found {
+			return execution.ErrSuperseded
+		}
+	}
+	if len(remaining) == len(previous.routes) {
+		return nil
+	}
+	retained := map[netip.Prefix]bool{}
+	for _, route := range remaining {
+		retained[route.Destination] = true
+		retained[netip.PrefixFrom(route.Execution, 128)] = true
+	}
+	nextPeers := make([]option.WireGuardPeer, 0, len(previous.peers))
+	for _, peer := range previous.peers {
+		allowed := make([]netip.Prefix, 0, len(peer.AllowedIPs))
+		for _, prefix := range peer.AllowedIPs {
+			if !removedPrefixes[peer.PublicKey][prefix] || retained[prefix] {
+				allowed = append(allowed, prefix)
+			}
+		}
+		if len(allowed) != 0 {
+			peer.AllowedIPs = allowed
+			nextPeers = append(nextPeers, peer)
+		}
+	}
+	next, applyPeers, err := w.prepareWireGuardCleanup(nextPeers, remaining)
+	if err != nil {
+		return err
+	}
+	w.updateMu.Lock()
+	defer w.updateMu.Unlock()
+	if w.sourceRoutes.Load() != previous {
+		return sourcepool.ErrConflict
+	}
+	if err := applyPeers(); err != nil {
+		return err
+	}
+	refs, err := w.endpoint.CapturePeerReferences()
+	if err != nil {
+		return err
+	}
+	if !refs.Covers(intervals) {
+		return sourcepool.ErrConflict
+	}
+	next.references = refs
+	refs.Apply(intervals)
+	w.sourceRoutes.Store(next)
+	return nil
+}
