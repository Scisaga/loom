+type executionTestStore struct {
+	adapter.FakeIPStore
+	mu     sync.Mutex
+	values map[netip.Addr]string
+	ids    map[string]netip.Addr
+	next   uint16
+}
+
+func (s *executionTestStore) Contains(address netip.Addr) bool {
+	return netip.MustParsePrefix("fdab:80:1::/64").Contains(address)
+}
+func (s *executionTestStore) Create(value string, _ bool) (netip.Addr, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if address, ok := s.ids[value]; ok {
+		return address, nil
+	}
+	s.next++
+	raw := netip.MustParseAddr("fdab:80:1::").As16()
+	raw[14], raw[15] = byte(s.next>>8), byte(s.next)
+	address := netip.AddrFrom16(raw)
+	s.values[address] = value
+	s.ids[value] = address
+	return address, nil
+}
+func (s *executionTestStore) Lookup(address netip.Addr) (string, bool) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	value, ok := s.values[address]
+	return value, ok
+}
+
+var errExecutionTestLookup = errors.New("an entry must not resolve business domains")
+
+type executionStageLogger struct {
+	logger.ContextLogger
+	mu     sync.Mutex
+	stages []string
+}
+
+func (l *executionStageLogger) DebugContext(_ context.Context, args ...any) {
+	line := fmt.Sprint(args...)
+	if strings.HasPrefix(line, "WG stage=") {
+		l.mu.Lock()
+		l.stages = append(l.stages, line)
+		l.mu.Unlock()
+	}
+}
+func (l *executionStageLogger) check(t *testing.T) {
+	t.Helper()
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	for _, stage := range []string{"peer-prepare", "inner-dial", "execution-confirm"} {
+		for _, event := range []string{"begin", "end"} {
+			found := false
+			for _, line := range l.stages {
+				found = found || strings.HasPrefix(line, "WG stage="+stage+" event="+event)
+			}
+			if !found {
+				t.Fatal("actual WG connection omitted stage", stage, event)
+			}
+		}
+	}
+	for _, line := range l.stages {
+		if strings.Contains(line, "demo-") || strings.Contains(line, "api.example") || strings.Contains(line, "127.0.0.1") {
+			t.Fatal("stage diagnostics expanded connection metadata")
+		}
+	}
+}
+
+type executionTestRouter struct {
+	adapter.Router
+	store    *executionTestStore
+	received chan adapter.InboundContext
+	lookups  atomic.Int32
+}
+
+func (r *executionTestRouter) FakeIPStore() adapter.FakeIPStore { return r.store }
+func (r *executionTestRouter) Lookup(context.Context, string, dns.DomainStrategy) ([]netip.Addr, error) {
+	r.lookups.Add(1)
+	return nil, errExecutionTestLookup
+}
+func (r *executionTestRouter) PreMatch(adapter.InboundContext) error {
+	return errors.New("unframed business is rejected")
+}
+func (r *executionTestRouter) RouteConnectionEx(ctx context.Context, conn net.Conn, metadata adapter.InboundContext, onClose N.CloseHandlerFunc) {
+	value, ok := P.ConnectionFrom(ctx)
+	if !ok || value.PolicyID != "demo-policy" || len(value.Path.Visited) != 1 || metadata.ExecutionOutbound != "demo-egress" {
+		conn.Close()
+		return
+	}
+	r.received <- metadata
+	// The formal ConnectionManager confirms its downstream dial before
+	// reporting success, rather than waiting for an application payload.
+	if err := N.ReportConnHandshakeSuccess(conn, nil); err != nil {
+		conn.Close()
+		return
+	}
+	go func() {
+		defer conn.Close()
+		if onClose != nil {
+			defer onClose(nil)
+		}
+		var body [16]byte
+		for {
+			n, err := conn.Read(body[:])
+			if err != nil {
+				return
+			}
+			if _, err = conn.Write(body[:n]); err != nil {
+				return
+			}
+		}
+	}()
+}
+func (r *executionTestRouter) RoutePacketConnectionEx(ctx context.Context, conn N.PacketConn, metadata adapter.InboundContext, onClose N.CloseHandlerFunc) {
+	if _, ok := P.ConnectionFrom(ctx); !ok || metadata.ExecutionOutbound != "demo-egress" {
+		conn.Close()
+		return
+	}
+	r.received <- metadata
+	go func() {
+		defer conn.Close()
+		if onClose != nil {
+			defer onClose(nil)
+		}
+		for {
+			body := buf.NewPacket()
+			destination, err := conn.ReadPacket(body)
+			if err != nil {
+				body.Release()
+				return
+			}
+			if err = conn.WritePacket(body, destination); err != nil {
+				return
+			}
+		}
+	}()
+}
+func testWGKey(t *testing.T) (string, string) {
+	t.Helper()
+	private, err := ecdh.X25519().GenerateKey(rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return base64.StdEncoding.EncodeToString(private.Bytes()), base64.StdEncoding.EncodeToString(private.PublicKey().Bytes())
+}
+func testUDPPort(t *testing.T) uint16 {
+	t.Helper()
+	conn, err := net.ListenPacket("udp4", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	port := uint16(conn.LocalAddr().(*net.UDPAddr).Port)
+	conn.Close()
+	return port
+}
+func testReceivingOptions(source string) option.ExecutionOptions {
+	p := P.HopPolicy{PolicyID: "demo-policy", ServiceID: "demo-service", Kind: "internet", Origins: []string{"demo-access"}, Exits: []string{"demo-exit"}, Nodes: []string{"demo-exit"}, EntryScope: P.PolicyScope{Mode: "any", NodeIDs: []string{}}, RelayScope: P.PolicyScope{Mode: "none", NodeIDs: []string{}}, Edges: []P.DirectedHop{}}
+	return option.ExecutionOptions{SenderAuthenticationDigests: map[string]string{}, NodeID: "demo-exit", AccessEnabled: true, Responsibilities: []string{"internet_egress"}, Policies: []option.ExecutionPolicy{{Policy: p, ForwardOutbound: "demo-forward", EgressOutbound: "demo-egress", PublicInternet: true}}, Bindings: []option.ExecutionBinding{{Key: source, SenderID: "demo-access"}}}
+}
+
+func TestIndependentWGNativeTCPUDPAdmissionAndCurrentRevocation(t *testing.T) {
+	// Both endpoints use memory gVisor stacks; the only host sockets are loopback
+	// UDP underlay. No host TUN, route, resolver or firewall is created or changed.
+	ctx, cancel := context.WithTimeout(context.Background(), 15*time.Second)
+	defer cancel()
+	source := netip.MustParseAddr("fdab:77::1")
+	execution := netip.MustParseAddr("fdab:79::1")
+	pool := netip.MustParsePrefix("fdab:80:1::/64")
+	clientPrivate, clientPublic := testWGKey(t)
+	serverPrivate, serverPublic := testWGKey(t)
+	port := testUDPPort(t)
+	router := &executionTestRouter{store: &executionTestStore{values: map[netip.Addr]string{}, ids: map[string]netip.Addr{}}, received: make(chan adapter.InboundContext, 16)}
+	permissions := testReceivingOptions(source.String())
+	allowed := []option.DirectTarget{{Host: "api.example", Port: 443}}
+	permissions.Policies[0].AllowedTargets = &allowed
+	serverAdapter, err := NewEndpoint(ctx, router, logger.NOP(), "demo-server", option.WireGuardEndpointOptions{Execution: &permissions, ExecutionAddress: execution, Address: []netip.Prefix{netip.PrefixFrom(execution, 128)}, PrivateKey: serverPrivate, ListenPort: port, Peers: []option.WireGuardPeer{{PublicKey: clientPublic, AllowedIPs: []netip.Prefix{netip.PrefixFrom(source, 128)}}}, Workers: 1})
+	if err != nil {
+		t.Fatal(err)
+	}
+	server := serverAdapter.(*Endpoint)
+	defer server.Close()
+	_, unreachablePublic := testWGKey(t)
+	stages := &executionStageLogger{ContextLogger: logger.NOP()}
+	clientAdapter, err := NewEndpoint(ctx, router, stages, "demo-client", option.WireGuardEndpointOptions{Address: []netip.Prefix{netip.PrefixFrom(source, 128)}, PrivateKey: clientPrivate, Peers: []option.WireGuardPeer{{Address: "127.0.0.1", Port: port, PublicKey: serverPublic, AllowedIPs: []netip.Prefix{pool, netip.PrefixFrom(execution, 128)}}, {Address: "unreachable.example", Port: 443, PublicKey: unreachablePublic, AllowedIPs: []netip.Prefix{netip.MustParsePrefix("fdab:ffff::1/128")}}}, SourceRoutes: []option.WireGuardSourceRoute{{Source: source, Destination: pool, Execution: execution}}, Workers: 1})
+	if err != nil {
+		t.Fatal(err)
+	}
+	client := clientAdapter.(*Endpoint)
+	defer client.Close()
+	if err = server.Start(adapter.StartStateStart); err != nil {
+		t.Fatal(err)
+	}
+	if err = client.Start(adapter.StartStateStart); err != nil {
+		t.Fatal(err)
+	}
+	if router.lookups.Load() != 0 {
+		t.Fatal("optional peer DNS blocked shared endpoint start")
+	}
+	initial := P.Connection{PolicyID: "demo-policy", Path: P.PathContext{OriginID: "demo-access", FinalExitID: "demo-exit", Visited: []string{}}}
+	bound := P.WithConnection(adapter.WithWireGuardSource(ctx, source), initial)
+	target := M.ParseSocksaddr("api.example:443")
+	connection, err := client.DialContext(bound, "tcp", target)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer connection.Close()
+	exchange := func(conn net.Conn) {
+		t.Helper()
+		_ = conn.SetDeadline(time.Now().Add(5 * time.Second))
+		if _, err = conn.Write([]byte("demo")); err != nil {
+			t.Fatal(err)
+		}
+		var reply [4]byte
+		if _, err = io.ReadFull(conn, reply[:]); err != nil || string(reply[:]) != "demo" {
+			t.Fatal("actual encrypted WG stream failed", err)
+		}
+	}
+	exchange(connection)
+	metadata := <-router.received
+	if metadata.Destination != target {
+		t.Fatal("entry lost or resolved the original domain", metadata.Destination)
+	}
+	if _, err = client.endpoint.DialContext(ctx, "tcp", M.ParseSocksaddr("[fdab:ffff::1]:53")); err == nil {
+		t.Fatal("unresolvable optional peer became reachable")
+	}
+	if !errors.Is(err, errExecutionTestLookup) || !strings.HasPrefix(err.Error(), "WG stage=peer-prepare elapsed=") {
+		t.Fatal("peer preparation lost its stage or original resolver cause", err)
+	}
+	if router.lookups.Load() != 1 {
+		t.Fatal("used peer DNS was not resolved on demand")
+	}
+	exchange(connection)
+	// A different scope/exit cannot use the authenticated packet source.
+	denied := initial
+	denied.Path.FinalExitID = "demo-other-exit"
+	wrong, err := client.DialContext(P.WithConnection(adapter.WithWireGuardSource(ctx, source), denied), "tcp", target)
+	if err != nil && wrong != nil {
+		t.Fatalf("WG Endpoint returned a non-nil %T connection on native refusal: %v", wrong, err)
+	}
+	if err == nil {
+		_ = wrong.SetDeadline(time.Now().Add(2 * time.Second))
+		_, _ = wrong.Write([]byte("x"))
+		var byte [1]byte
+		_, err = wrong.Read(byte[:])
+		wrong.Close()
+	}
+	if err == nil {
+		t.Fatal("wrong final exit was accepted")
+	}
+	// Use the real WG receiver, without an access selector that could reject
+	// locally and hide a missing target check on the remote protocol entry.
+	for _, destination := range []M.Socksaddr{M.ParseSocksaddr("other.example:443"), M.ParseSocksaddr("api.example:8443"), M.ParseSocksaddr("192.0.2.1:443")} {
+		rejected, err := client.DialContext(bound, "tcp", destination)
+		if err != nil && rejected != nil {
+			t.Fatalf("WG Endpoint returned a non-nil %T connection on target refusal: %v", rejected, err)
+		}
+		if err == nil && rejected != nil {
+			_ = rejected.Close()
+		}
+		if !errors.Is(err, X.ErrDenied) {
+			t.Fatalf("receiver target denial was not typed: %v", err)
+		}
+		if !strings.HasPrefix(err.Error(), "WG stage=execution-confirm elapsed=") {
+			t.Fatal("native refusal lost its confirmation stage", err)
+		}
+		select {
+		case <-router.received:
+			t.Fatal("denied target reached business router")
+		default:
+		}
+	}
+	exchange(connection)
+	stages.check(t)
+	packet, err := client.ListenPacket(bound, target)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer packet.Close()
+	_ = packet.SetDeadline(time.Now().Add(4 * time.Second))
+	if _, err = packet.WriteTo([]byte("udp"), target); err != nil {
+		t.Fatal(err)
+	}
+	var reply [16]byte
+	n, address, err := packet.ReadFrom(reply[:])
+	if err != nil || string(reply[:n]) != "udp" || M.SocksaddrFromNet(address) != target {
+		t.Fatal("native WG UDP registration/target restoration failed", n, address, err)
+	}
+	metadata = <-router.received
+	if metadata.Destination != target {
+		t.Fatal("UDP restored another target")
+	}
+	// Recompile a grant addition without replacing the running endpoint/socket.
+	permissions.Policies[0].Policy.Origins = []string{"demo-access", "demo-new-access"}
+	permissions.Bindings = append(permissions.Bindings, option.ExecutionBinding{Key: "fdab:77::2", SenderID: "demo-new-access"})
+	beforeCounters, err := server.ReadWireGuardCounters()
+	if err != nil {
+		t.Fatal(err)
+	}
+	_, newPublic := testWGKey(t)
+	peers := []option.WireGuardPeer{{PublicKey: clientPublic, AllowedIPs: []netip.Prefix{netip.PrefixFrom(source, 128)}}, {PublicKey: newPublic, AllowedIPs: []netip.Prefix{netip.MustParsePrefix("fdab:77::2/128")}}}
+	prior := server.execution.State()
+	listener := &option.WireGuardListener{Port: port}
+	applied, err := server.UpdateRuntimeExecution(option.ExecutionUpdate{ExpectedRevision: prior.Revision, Execution: &permissions, WireGuardPeers: &peers, WireGuardListener: listener}, "demo-added", nil)
+	if err != nil || applied.Revision == prior.Revision {
+		t.Fatal("native incoming peer update failed", err)
+	}
+	afterCounters, err := server.ReadWireGuardCounters()
+	if err != nil || afterCounters.Epoch != beforeCounters.Epoch || len(afterCounters.Peers) != 2 {
+		t.Fatal("adding a peer replaced the shared WG device", err)
+	}
+	exchange(connection)
+	// A local WG receiving-port change retains the same inner TCP connection,
+	// keys and Device. The unrelated transports are not restarted.
+	port = testUDPPort(t)
+	listener = &option.WireGuardListener{Port: port}
+	applied, err = server.UpdateRuntimeExecution(option.ExecutionUpdate{ExpectedRevision: applied.Revision, Execution: &permissions, WireGuardPeers: &peers, WireGuardListener: listener}, "demo-listener-moved", nil)
+	if err != nil {
+		t.Fatal("receiving UDP port change failed", err)
+	}
+	movedPeers := []option.WireGuardPeer{{Address: "127.0.0.1", Port: port, PublicKey: serverPublic, AllowedIPs: []netip.Prefix{pool, netip.PrefixFrom(execution, 128)}}}
+	movedPrior := client.RuntimeExecutionState()
+	if _, err = client.UpdateRuntimeExecution(option.ExecutionUpdate{ExpectedRevision: movedPrior.Revision, WireGuardPeers: &movedPeers}, "demo-follow-listener", nil); err != nil {
+		t.Fatal("source did not consume the new public endpoint", err)
+	}
+	exchange(connection)
+	afterMove, err := server.ReadWireGuardCounters()
+	if err != nil || afterMove.Epoch != beforeCounters.Epoch {
+		t.Fatal("receiving UDP change replaced WG Device", err)
+	}
+	// A failed rebind closes the old UDP socket. Explicitly requesting that
+	// previous port must really bind it again, not confirm a cached option.
+	blocked, err := net.ListenUDP("udp4", &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1)})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer blocked.Close()
+	failedListener := &option.WireGuardListener{Port: uint16(blocked.LocalAddr().(*net.UDPAddr).Port)}
+	permissions.Policies[0].Policy.Origins = []string{"demo-access"}
+	failed, err := server.UpdateRuntimeExecution(option.ExecutionUpdate{ExpectedRevision: applied.Revision, Execution: &permissions, WireGuardPeers: &peers, WireGuardListener: failedListener}, "demo-blocked-listener", nil)
+	if err == nil || failed.Revision == applied.Revision || failed.ConfigHash != "" || server.execution.State().ConfigHash != "" {
+		t.Fatal("failed listener was confirmed or rolled back permission", err)
+	}
+	if err := server.endpoint.BindUpdate(); err == nil {
+		t.Fatal("underlay refresh silently replaced the failed receiving port with a random port")
+	}
+	applied, err = server.UpdateRuntimeExecution(option.ExecutionUpdate{ExpectedRevision: failed.Revision, Execution: &permissions, WireGuardPeers: &peers, WireGuardListener: listener}, "demo-explicit-rebind", nil)
+	if err != nil || applied.ConfigHash != "demo-explicit-rebind" {
+		t.Fatal("explicit old-port request did not recover the real socket", err)
+	}
+	exchange(connection)
+	// Moving this same authenticated peer to another UDP coordinate preserves
+	// the already established business stream and the source-only WG device.
+	relay, err := net.ListenUDP("udp4", &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1)})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer relay.Close()
+	go func() {
+		serverAddress := &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1), Port: int(port)}
+		var clientAddress *net.UDPAddr
+		var packet [65535]byte
+		for {
+			n, from, err := relay.ReadFromUDP(packet[:])
+			if err != nil {
+				return
+			}
+			to := serverAddress
+			if from.String() == serverAddress.String() {
+				to = clientAddress
+			} else {
+				clientAddress = from
+			}
+			if to != nil {
+				_, _ = relay.WriteToUDP(packet[:n], to)
+			}
+		}
+	}()
+	clientBefore, err := client.ReadWireGuardCounters()
+	if err != nil {
+		t.Fatal(err)
+	}
+	clientPeers := []option.WireGuardPeer{{Address: "127.0.0.1", Port: uint16(relay.LocalAddr().(*net.UDPAddr).Port), PublicKey: serverPublic, AllowedIPs: []netip.Prefix{pool, netip.PrefixFrom(execution, 128)}}}
+	clientPrior := client.RuntimeExecutionState()
+	clientApplied, err := client.UpdateRuntimeExecution(option.ExecutionUpdate{ExpectedRevision: clientPrior.Revision, WireGuardPeers: &clientPeers}, "demo-moved", nil)
+	if err != nil || clientApplied.Revision == clientPrior.Revision {
+		t.Fatal("source-only outgoing peer update failed", err)
+	}
+	clientAfter, err := client.ReadWireGuardCounters()
+	if err != nil || clientAfter.Epoch != clientBefore.Epoch {
+		t.Fatal("source peer update replaced the counter lifetime", err)
+	}
+	if count, err := client.ActualWireGuardPeerCount(); err != nil || count != 1 {
+		t.Fatal("source peer update retained a removed physical peer", err)
+	}
+	exchange(connection)
+	if _, err := client.UpdateRuntimeExecution(option.ExecutionUpdate{ExpectedRevision: clientPrior.Revision, WireGuardPeers: &clientPeers}, "demo-stale", nil); err == nil {
+		t.Fatal("old peer update CAS survived a transport change")
+	}
+	// Removing the newly added, unrelated incoming grant keeps this flow alive.
+	permissions.Bindings = permissions.Bindings[:1]
+	peers = peers[:1]
+	permissions.Policies[0].Policy.Origins = []string{"demo-access"}
+	if _, err := server.UpdateRuntimeExecution(option.ExecutionUpdate{ExpectedRevision: applied.Revision, Execution: &permissions, WireGuardPeers: &peers, WireGuardListener: listener}, "demo-removed", nil); err != nil {
+		t.Fatal(err)
+	}
+	exchange(connection)
+	// A cached UDP target is rechecked at actual use after an origin is removed.
+	registered, err := client.resolveTarget(bound, target)
+	if err != nil {
+		t.Fatal(err)
+	}
+	permissions.Policies[0].Policy.Origins = []string{"demo-new-access"}
+	if err = server.execution.Update(permissions); err != nil {
+		t.Fatal(err)
+	}
+	if _, _, _, err = server.restoreExecution(ctx, M.SocksaddrFrom(source, 1234), registered); err == nil {
+		t.Fatal("cached target survived revoked access permission")
+	}
+	rejected, err := client.DialContext(bound, "tcp", target)
+	if err == nil {
+		_ = rejected.SetDeadline(time.Now().Add(time.Second))
+		_, _ = rejected.Write([]byte("x"))
+		var one [1]byte
+		_, err = rejected.Read(one[:])
+		rejected.Close()
+	}
+	if err == nil {
+		t.Fatal("revoked source opened a new TCP stream")
+	}
+}
