+func forwardEcho(t *testing.T, conn net.Conn) {
+	t.Helper()
+	_ = conn.SetDeadline(time.Now().Add(time.Second))
+	done := make(chan error, 1)
+	go func() { _, err := conn.Write([]byte("demo")); done <- err }()
