+)
+
+func TestExecutionTCPHalfCloseRetainsFramedResponseAndOriginalFailure(t *testing.T) {
+	for _, reject := range []bool{false, true} {
+		t.Run(fmt.Sprint(reject), func(t *testing.T) {
+			listener, err := net.ListenTCP("tcp4", &net.TCPAddr{IP: net.IPv4(127, 0, 0, 1)})
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer listener.Close()
+			left, err := net.DialTCP("tcp4", nil, listener.Addr().(*net.TCPAddr))
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer left.Close()
+			right, err := listener.AcceptTCP()
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer right.Close()
+			left.SetDeadline(time.Now().Add(3 * time.Second))
+			right.SetDeadline(time.Now().Add(3 * time.Second))
+			nonce := [16]byte{1}
+			// The request is already written. Match the formal router: confirm
+			// the downstream dial before any application payload or FIN.
+			client := &executionClientConn{Conn: left, request: P.Request{Nonce: nonce, Operation: P.ConnectTCP}}
+			server := &executionServerConn{Conn: right, nonce: nonce, started: time.Now()}
+			confirmed := make(chan error, 1)
+			go func() {
+				if reject {
+					err := server.HandshakeFailure(execution.ErrDenied)
+					if err == nil {
+						err = N.CloseWrite(server)
+					}
+					confirmed <- err
+				} else {
+					confirmed <- server.HandshakeSuccess()
+				}
+			}()
+			confirmErr := client.confirm()
+			if err := <-confirmed; err != nil {
+				t.Fatal(err)
+			}
+			if reject {
+				if !errors.Is(confirmErr, execution.ErrDenied) {
+					t.Fatal("typed denial was not confirmed before application data", confirmErr)
+				}
+				var trailing [1]byte
+				if n, err := left.Read(trailing[:]); n != 0 || !errors.Is(err, io.EOF) {
+					t.Fatal("half-close manufactured a late Accepted", n, err)
+				}
+				return
+			}
+			if confirmErr != nil {
+				t.Fatal(confirmErr)
+			}
+			request := []byte("demo-send-until-fin")
+			response := bytes.Repeat([]byte("demo-response"), 8192)
+			done := make(chan error, 1)
+			go func() {
+				body, err := io.ReadAll(server)
+				if err != nil || !bytes.Equal(body, request) {
+					done <- fmt.Errorf("request FIN did not preserve its body: %v", err)
+					return
+				}
+				_, err = server.Write(response)
+				if err == nil {
+					err = N.CloseWrite(server)
+				}
+				done <- err
+			}()
+			if _, err := client.Write(request); err != nil {
+				t.Fatal(err)
+			}
+			if err := N.CloseWrite(client); err != nil {
+				t.Fatal(err)
+			}
+			var received bytes.Buffer
+			_, readErr := bufio.Copy(&received, client)
+			if err := <-done; err != nil {
+				t.Fatal(err)
+			}
+			if readErr != nil || !bytes.Equal(received.Bytes(), response) {
+				t.Fatal("FIN truncated the response or exposed its native response frame", readErr, received.Len())
+			}
+		})
+	}
+}
