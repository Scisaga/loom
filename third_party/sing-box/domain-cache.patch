+package execution
+
+import (
+	"context"
+	"errors"
+	"net"
+	"slices"
+	"strconv"
+	"sync"
+	"sync/atomic"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/common/dialer"
+	P "github.com/sagernet/sing-box/common/loomprotocol"
+	"github.com/sagernet/sing-box/common/sourcepool"
+	"github.com/sagernet/sing-box/option"
+	M "github.com/sagernet/sing/common/metadata"
+	"maps"
+)
+
+type Policy struct {
+	compiled *P.CompiledPolicy
+	options  option.ExecutionPolicy
+	targets  map[string]struct{}
+}
+type State struct {
+	Revision   string `json:"revision"`
+	ConfigHash string `json:"config_hash"`
+}
+type snapshot struct {
+	state                   State
+	nodeID                  string
+	forward, egress, access bool
+	bindings                map[string]string
+	senderAuthentications   map[string]string
+	policies                map[string]*Policy
+	maxNodes                int
+}
+
+// Receiver holds only a compiled, replaceable runtime projection. It contains
+// no credentials, durable state or alternate authorization facts.
+type Receiver struct {
+	fence       sync.RWMutex
+	transportMu sync.Mutex
+	current     atomic.Pointer[snapshot]
+}
+
+func New(options option.ExecutionOptions) (*Receiver, error) {
+	r := &Receiver{}
+	if err := r.Update(options); err != nil {
+		return nil, err
+	}
+	return r, nil
+}
+func compile(options option.ExecutionOptions) (*snapshot, error) {
+	if P.ValidateID(options.NodeID) != nil || options.NodeID == "direct" || options.Policies == nil || options.Bindings == nil || options.SenderAuthenticationDigests == nil {
+		return nil, errors.New("incomplete receiving execution projection")
+	}
+	forward := slices.Contains(options.Responsibilities, "forward")
+	egress := slices.Contains(options.Responsibilities, "internet_egress")
+	policies := make(map[string]*Policy, len(options.Policies))
+	for _, value := range options.Policies {
+		if _, exists := policies[value.Policy.PolicyID]; exists {
+			return nil, errors.New("duplicated receiving Policy")
+		}
+		p, err := NewPolicy(value)
+		if err != nil {
+			return nil, err
+		}
+		policies[value.Policy.PolicyID] = p
+	}
+	next := &snapshot{senderAuthentications: maps.Clone(options.SenderAuthenticationDigests), nodeID: options.NodeID, forward: forward, egress: egress, access: options.AccessEnabled, bindings: map[string]string{}, policies: policies}
+	for tag, digest := range next.senderAuthentications {
+		if tag == "" || !sourcepool.ValidHash(digest) {
+			return nil, errors.New("invalid sending authentication projection")
+		}
+	}
+	for _, p := range policies {
+		next.maxNodes = maxInt(next.maxNodes, p.compiled.MaxNodes())
+	}
+	for _, value := range options.Bindings {
+		if value.Key == "" || len(value.Key) > 512 || P.ValidateID(value.SenderID) != nil || value.SenderID == options.NodeID {
+			return nil, errors.New("invalid authenticated transport sender")
+		}
+		if _, exists := next.bindings[value.Key]; exists {
+			return nil, errors.New("duplicated authenticated transport sender")
+		}
+		next.bindings[value.Key] = value.SenderID
+	}
+	return next, nil
+}
+func maxInt(a, b int) int {
+	if a > b {
+		return a
+	}
+	return b
+}
+func (r *Receiver) sender(key string) (*snapshot, string, error) {
+	if r == nil {
+		return nil, "", errors.New("receiver has no execution projection")
+	}
+	s := r.current.Load()
+	if s == nil {
+		return nil, "", errors.New("receiver has no accepted execution projection")
+	}
+	sender, ok := s.bindings[key]
+	if !ok {
+		return nil, "", errors.New("transport has no authenticated sender")
+	}
+	return s, sender, nil
+}
+func (r *Receiver) permission(key string, connection P.Connection) (P.HopPermission, *Policy, error) {
+	s, sender, err := r.sender(key)
+	if err != nil {
+		return P.HopPermission{}, nil, err
+	}
+	p := s.policies[connection.PolicyID]
+	if p == nil {
+		return P.HopPermission{}, nil, errors.New("connection Policy has no current permission")
+	}
+	purpose := "access"
+	if len(connection.Path.Visited) > 0 {
+		purpose = "forward"
+	} else if !s.access {
+		return P.HopPermission{}, nil, errors.New("resource is not enabled for ordinary access")
+	}
+	permission := P.HopPermission{SenderID: sender, ReceiverID: s.nodeID, Purpose: purpose, Forward: s.forward, InternetEgress: s.egress, LANGateway: s.forward && p.options.Policy.Kind == "local_network" && slices.Contains(p.options.Policy.Exits, s.nodeID)}
+	return permission, p, nil
+}
+func (r *Receiver) MaxNodes() int {
+	if r == nil {
+		return 0
+	}
+	s := r.current.Load()
+	if s == nil {
+		return 0
+	}
+	return s.maxNodes
+}
+func (r *Receiver) InputLimit() int {
+	if r == nil {
+		return 0
+	}
+	s := r.current.Load()
+	if s == nil {
+		return 0
+	}
+	limit := 512 + (s.maxNodes+2)*(P.MaxIDBytes+2)
+	if limit > P.MaxFrameBytes {
+		return P.MaxFrameBytes
+	}
+	return limit
+}
+func (r *Receiver) Echo(key, policyID string) error {
+	s, sender, err := r.sender(key)
+	if err != nil {
+		return err
+	}
+	if policyID == "" {
+		return nil
+	}
+	p := s.policies[policyID]
+	if !s.access || p == nil {
+		return errors.New("Policy has no current ordinary entry admission")
+	}
+	return p.compiled.AdmitEntry(sender, s.nodeID, s.forward, s.egress)
+}
+func (p *Policy) target(destination M.Socksaddr) error {
+	host := destination.Fqdn
+	if host == "" {
+		host = destination.Addr.String()
+	}
+	if !P.CanonicalHost(host) || destination.Port == 0 {
+		return errors.New("invalid original target")
+	}
+	if p.options.PublicInternet {
+		if destination.IsFqdn() {
+			if !dialer.PublicInternetName(host) {
+				return errors.New("nonpublic name")
+			}
+		} else if !dialer.PublicInternetAddress(destination.Addr) {
+			return errors.New("nonpublic address")
+		}
+	} else if destination.IsFqdn() {
+		if len(p.options.LANRecords[host]) == 0 {
+			return errors.New("name has no current authorized LAN record")
+		}
+	} else if !p.options.LANPrefix.Contains(destination.Addr) {
+		return errors.New("target is outside the LAN permission")
+	}
+	if p.options.AllowedTargets != nil {
+		if _, ok := p.targets[net.JoinHostPort(host, strconv.Itoa(int(destination.Port)))]; !ok {
+			return errors.New("target is outside the exact allowed endpoints")
+		}
+	}
+	return nil
+}
+func (r *Receiver) Admit(ctx context.Context, key string, connection P.Connection, destination M.Socksaddr) (context.Context, string, error) {
+	permission, p, err := r.permission(key, connection)
+	if err != nil {
+		return nil, "", err
+	}
+	if err = p.target(destination); err != nil {
+		return nil, "", err
+	}
+	path, err := p.compiled.Admit(connection.Path, permission)
+	if err != nil {
+		return nil, "", err
+	}
+	outbound := p.options.ForwardOutbound
+	if path.FinalExitID == permission.ReceiverID {
+		outbound = p.options.EgressOutbound
+	}
+	if outbound == "" {
+		return nil, "", errors.New("Policy has no receiving execution outbound")
+	}
+	connection.Path = path
+	return withAdmission(P.WithConnection(ctx, connection), r, key, destination), outbound, nil
+}
+func (r *Receiver) Restore(ctx context.Context, key string, connection P.Connection, destination M.Socksaddr) (context.Context, string, error) {
+	// The receiver appended itself once. Infer access vs forward from the incoming
+	// path, not from the already appended form stored in a target/connection.
+	incoming := connection
+	incoming.Path.Visited = slices.Clone(connection.Path.Visited)
+	if len(incoming.Path.Visited) == 0 {
+		return nil, "", errors.New("restored connection lacks its receiving node")
+	}
+	incoming.Path.Visited = incoming.Path.Visited[:len(incoming.Path.Visited)-1]
+	permission, p, err := r.permission(key, incoming)
+	if err != nil {
+		return nil, "", err
+	}
+	if err = p.target(destination); err != nil {
+		return nil, "", err
+	}
+	if err = p.compiled.VerifyCurrent(connection.Path, permission); err != nil {
+		return nil, "", err
+	}
+	outbound := p.options.ForwardOutbound
+	if connection.Path.FinalExitID == permission.ReceiverID {
+		outbound = p.options.EgressOutbound
+	}
+	if outbound == "" {
+		return nil, "", errors.New("Policy has no receiving execution outbound")
+	}
+	return withAdmission(P.WithConnection(ctx, connection), r, key, destination), outbound, nil
+}
+func PrepareContext(ctx context.Context, route *option.ExecutionRoute) (context.Context, P.Connection, error) {
+	if route == nil {
+		return nil, P.Connection{}, errors.New("missing sending execution binding")
+	}
+	if route.PolicyID != "" && P.ValidateID(route.PolicyID) != nil {
+		return nil, P.Connection{}, errors.New("invalid sending Policy")
+	}
+	value, exists := P.ConnectionFrom(ctx)
+	if route.OriginID != "" {
+		if P.ValidateID(route.PolicyID) != nil || P.ValidateID(route.OriginID) != nil || route.OriginID == "direct" || P.ValidateID(route.FinalExitID) != nil || route.FinalExitID == "direct" || route.LocalNodeID != "" && route.LocalNodeID != route.OriginID {
+			return nil, P.Connection{}, errors.New("invalid initial sending connection")
+		}
+		initial := P.Connection{PolicyID: route.PolicyID, Path: P.PathContext{OriginID: route.OriginID, FinalExitID: route.FinalExitID, Visited: []string{}}}
+		if route.LocalNodeID != "" {
+			initial.Path.Visited = []string{route.LocalNodeID}
+		}
+		if exists && (value.PolicyID != initial.PolicyID || value.Path.OriginID != initial.Path.OriginID || value.Path.FinalExitID != initial.Path.FinalExitID || !slices.Equal(value.Path.Visited, initial.Path.Visited)) {
+			return nil, P.Connection{}, errors.New("sending binding cannot replace this connection context")
+		}
+		value = initial
+	} else if !exists || P.ValidateID(value.PolicyID) != nil || route.PolicyID != "" && value.PolicyID != route.PolicyID || route.FinalExitID != "" || route.LocalNodeID != "" {
+		return nil, P.Connection{}, errors.New("forward cannot change this connection Policy or final exit")
+	}
+
+	return P.WithConnection(ctx, value), value, nil
+}
+
+func NewPolicy(value option.ExecutionPolicy) (*Policy, error) {
+	compiled, err := value.Policy.Compile()
+	if err != nil {
+		return nil, err
+	}
+	if value.Policy.Kind == "internet" {
+		if !value.PublicInternet || value.LANPrefix.IsValid() {
+			return nil, errors.New("Internet permission lacks its public target boundary")
+		}
+	} else if value.PublicInternet || !value.LANPrefix.IsValid() || value.LANPrefix != value.LANPrefix.Masked() {
+		return nil, errors.New("LAN permission lacks its exact virtual prefix")
+	}
+	for name, addresses := range value.LANRecords {
+		if value.PublicInternet || !P.CanonicalHost(name) || len(addresses) == 0 {
+			return nil, errors.New("invalid LAN name projection")
+		}
+		for _, address := range addresses {
+			if !value.LANPrefix.Contains(address) {
+				return nil, errors.New("LAN name escapes its virtual prefix")
+			}
+		}
+	}
+	p := &Policy{compiled: compiled, options: value, targets: map[string]struct{}{}}
+	if value.AllowedTargets != nil {
+		for _, target := range *value.AllowedTargets {
+			if !P.CanonicalHost(target.Host) || target.Port == 0 {
+				return nil, errors.New("invalid allowed endpoint")
+			}
+			key := net.JoinHostPort(target.Host, strconv.Itoa(int(target.Port)))
+			if _, exists := p.targets[key]; exists {
+				return nil, errors.New("duplicate allowed endpoint")
+			}
+			p.targets[key] = struct{}{}
+		}
+	}
+
+	return p, nil
+}
+func (p *Policy) CheckTarget(destination M.Socksaddr) error { return p.target(destination) }
+func (p *Policy) Compiled() *P.CompiledPolicy               { return p.compiled }
+
+// CheckSenderAuthentication compares the actual immutable object pinned before
+// tracking with current receiving authority. Materialization/retirement alone
+// does not change this permission.
+func (r *Receiver) CheckSenderAuthentication(metadata adapter.InboundContext) error {
+	if r == nil || metadata.Execution == nil {
+		return ErrDenied
+	}
+	current := r.current.Load()
+	if current == nil {
+		return ErrDenied
+	}
+	if metadata.Execution.Path.FinalExitID == current.nodeID {
+		return nil
+	}
+	policy := current.policies[metadata.Execution.PolicyID]
+	if policy == nil || policy.options.ForwardOutbound == "" || metadata.ExecutionSenderTag == "" || metadata.SelectedOutbounds[policy.options.ForwardOutbound] != metadata.ExecutionSenderTag {
+		return ErrDenied
+	}
+	if digest, ok := current.senderAuthentications[metadata.ExecutionSenderTag]; !ok || digest != metadata.ExecutionSenderAuthenticationDigest {
+		return ErrDenied
+	}
+	// The actual successor was pinned from the accepted hop projection before
+	// tracking. A newer performance order must never supply its attribution.
+	next := metadata.ExecutionNextNodeID
+	if P.ValidateID(next) != nil {
+		return ErrDenied
+	}
+	forward := false
+	for _, edge := range policy.options.Policy.Edges {
+		if edge.From == next {
+			forward = true
+			break
+		}
+	}
+	egress := slices.Contains(policy.options.Policy.Exits, next)
+	_, err := policy.compiled.Admit(metadata.Execution.Path, P.HopPermission{SenderID: current.nodeID, ReceiverID: next, Purpose: "forward", Forward: forward, InternetEgress: egress, LANGateway: egress && policy.options.Policy.Kind == "local_network"})
+	if err != nil {
+		return ErrDenied
+	}
+	return nil
+}
