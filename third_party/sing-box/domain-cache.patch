+package wireguard
+
+import (
+	"net/netip"
+
+	"github.com/sagernet/sing-box/common/sourcepool"
+	"github.com/sagernet/sing-box/option"
+)
+
+func (w *Endpoint) RuntimeWireGuardNeedsRepair() bool { return w.endpoint.RuntimePeersNeedRepair() }
+func (w *Endpoint) PruneRuntimeWireGuard(expected any, keep []option.WireGuardSourceRoute, intervals map[string]uint16) error {
+	w.updateMu.Lock()
+	defer w.updateMu.Unlock()
+	previous, ok := expected.(*sourceRouteSnapshot)
+	if !ok || w.sourceRoutes.Load() != previous {
+		return sourcepool.ErrConflict
+	}
+	keepSet := map[option.WireGuardSourceRoute]bool{}
+	for _, route := range keep {
+		keepSet[route] = true
+	}
+	routes := []option.WireGuardSourceRoute{}
+	for _, route := range previous.routes {
+		if keepSet[route] {
+			routes = append(routes, route)
+		}
+	}
+	send := sendingWGPeers(&sourceRouteSnapshot{routes: routes, peers: previous.peers})
+	peers, err := mergeWGPeers(w.receivingPeersNow(), send)
+	if err != nil {
+		return err
+	}
+	// A cold in-flight reference may need the existing object before its route
+	// is installed. Keep that exact key with no ACL until its stage completes.
+	keys := map[string]bool{}
+	for _, peer := range peers {
+		keys[peer.PublicKey] = true
+	}
+	for _, peer := range previous.peers {
+		if intervals[peer.PublicKey] != 0 && !keys[peer.PublicKey] {
+			peer.AllowedIPs = []netip.Prefix{}
+			peer.PersistentKeepaliveInterval = 0
+			peers = append(peers, peer)
+		}
+	}
+	next, physical, err := w.prepareWireGuardCleanup(peers, routes)
+	if err != nil {
+		return err
+	}
+	if err = physical(); err != nil {
+		return err
+	}
+	refs, err := w.endpoint.CapturePeerReferences()
+	if err != nil {
+		return err
+	}
+	if !refs.Covers(intervals) {
+		return sourcepool.ErrConflict
+	}
+	next.references = refs
+	refs.Apply(intervals)
+	w.sourceRoutes.Store(next)
+	return nil
+}
+
+func (w *Endpoint) RuntimeWireGuardReferenceProjection(keys []string) func(map[string]uint16) {
+	if current := w.sourceRoutes.Load(); current != nil && current.references != nil {
+		return current.references.Projection(keys)
+	}
+	return nil
+}
