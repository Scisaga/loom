+func TestSameProjectionRepairsMissingActualRegistration(t *testing.T) {
+	f := newFixture(t)
+	commit(t, f.pool, sender("demo-a", ""))
+	oldLease, err := f.pool.Acquire(context.Background(), "demo-a")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer oldLease.Release()
+	previous := f.object("demo-a", 0)
+	// Only the pool's exact-object detach may transfer ownership; generic Remove
+	// cannot close an owned object underneath its existing leases.
+	if err := f.manager.Remove("demo-a"); !errors.Is(err, sourcepool.ErrConflict) {
+		t.Fatal("generic Remove bypassed resource ownership", err)
+	}
+	registration, _ := f.manager.RuntimeOutbound("demo-a")
+	if _, err := f.manager.DetachRuntimeOutbounds(context.Background(), []sourcepool.Registration{registration}); err != nil {
+		t.Fatal(err)
+	}
+	if f.pool.Ready() {
+		t.Fatal("missing actual object still had a complete proof")
+	}
+	commit(t, f.pool, sender("demo-a", ""))
+	lease, err := f.pool.Acquire(context.Background(), "demo-a")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer lease.Release()
+	if lease.Outbound() == previous || len(f.pool.Actual()) != 1 || !f.pool.Ready() {
+		t.Fatal("same projection failed to recreate missing actual resource")
+	}
+	if err := f.pool.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if previous.closed.Load() != 1 {
+		t.Fatal("missing previous object was not retired exactly once")
+	}
