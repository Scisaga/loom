+package route
+
+import (
+	"bytes"
+	"context"
+	"encoding/binary"
+	"errors"
+	"io"
+	"net"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	D "github.com/miekg/dns"
+	"github.com/sagernet/sing-box/adapter"
+)
+
+type lifecycleDNSRouter struct {
+	adapter.Router
+	exchange func(context.Context, *D.Msg) (*D.Msg, error)
+}
+
+func (r lifecycleDNSRouter) Exchange(ctx context.Context, message *D.Msg) (*D.Msg, error) {
+	return r.exchange(ctx, message)
+}
+
+type lifecycleDNSConn struct {
+	reader     *bytes.Reader
+	readErr    error
+	blockRead  bool
+	writeErr   error
+	blockWrite bool
+	closed     chan struct{}
+	closeOnce  sync.Once
+	closeCalls atomic.Int32
+	writers    atomic.Int32
+	maxWriters atomic.Int32
+	mu         sync.Mutex
+	frames     [][]byte
+}
+
+func (c *lifecycleDNSConn) Read(body []byte) (int, error) {
+	if c.reader.Len() > 0 {
+		return c.reader.Read(body)
+	}
+	if c.blockRead {
+		<-c.closed
+		return 0, net.ErrClosed
+	}
+	if c.readErr != nil {
+		return 0, c.readErr
+	}
+	return 0, io.EOF
+}
+func (c *lifecycleDNSConn) Write(body []byte) (int, error) {
+	n := c.writers.Add(1)
+	defer c.writers.Add(-1)
+	for old := c.maxWriters.Load(); n > old; old = c.maxWriters.Load() {
+		if c.maxWriters.CompareAndSwap(old, n) {
+			break
+		}
+	}
+	if c.blockWrite {
+		<-c.closed
+		return 0, net.ErrClosed
+	}
+	if c.writeErr != nil {
+		return 0, c.writeErr
+	}
+	time.Sleep(3 * time.Millisecond)
+	select {
+	case <-c.closed:
+		return 0, net.ErrClosed
+	default:
+	}
+	c.mu.Lock()
+	c.frames = append(c.frames, bytes.Clone(body))
+	c.mu.Unlock()
+	return len(body), nil
+}
+func (c *lifecycleDNSConn) Close() error {
+	c.closeCalls.Add(1)
+	c.closeOnce.Do(func() { close(c.closed) })
+	return nil
+}
+func (c *lifecycleDNSConn) LocalAddr() net.Addr { return &net.TCPAddr{IP: net.IPv6loopback, Port: 53} }
+func (c *lifecycleDNSConn) RemoteAddr() net.Addr {
+	return &net.TCPAddr{IP: net.IPv6loopback, Port: 12345}
+}
+func (c *lifecycleDNSConn) SetDeadline(time.Time) error      { return nil }
+func (c *lifecycleDNSConn) SetReadDeadline(time.Time) error  { return nil }
+func (c *lifecycleDNSConn) SetWriteDeadline(time.Time) error { return nil }
+
+func lifecycleDNSQueries(t *testing.T, count int) []byte {
+	t.Helper()
+	var body []byte
+	for n := 0; n < count; n++ {
+		q := D.Msg{}
+		q.SetQuestion("demo-service.example.", D.TypeAAAA)
+		q.Id = uint16(n + 1)
+		wire, err := q.Pack()
+		if err != nil {
+			t.Fatal(err)
+		}
+		var length [2]byte
+		binary.BigEndian.PutUint16(length[:], uint16(len(wire)))
+		body = append(body, length[:]...)
+		body = append(body, wire...)
+	}
+	return body
+}
+
+func TestLoomHijackedDNSStreamOwnership(t *testing.T) {
+	for _, mode := range []string{"eof_after_accepted_pipelined_queries", "malformed", "read_timeout", "cancel_blocked_read_and_exchange", "write_failure", "cancel_blocked_write"} {
+		t.Run(mode, func(t *testing.T) {
+			body := lifecycleDNSQueries(t, 8)
+			if mode == "malformed" {
+				body = []byte{0, 0}
+			}
+			conn := &lifecycleDNSConn{reader: bytes.NewReader(body), closed: make(chan struct{})}
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			router := lifecycleDNSRouter{exchange: func(ctx context.Context, q *D.Msg) (*D.Msg, error) {
+				select {
+				case <-time.After(30 * time.Millisecond):
+					answer := new(D.Msg)
+					answer.SetReply(q)
+					return answer, nil
+				case <-ctx.Done():
+					return nil, ctx.Err()
+				}
+			}}
