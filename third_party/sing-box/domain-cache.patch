+
+func (w *deferredWGCleanup) PruneRuntimeWireGuard(expected any, routes []option.WireGuardSourceRoute, intervals map[string]uint16) error {
+	first := false
+	w.once.Do(func() { first = true; close(w.entered); <-w.proceed })
+	if first {
+		defer close(w.done)
+	}
+	return w.Endpoint.PruneRuntimeWireGuard(expected, routes, intervals)
+}
+func actualWGPoolFixture(t *testing.T, deferCleanup bool) (*fixture, func() *WG.Endpoint, *deferredWGCleanup) {
