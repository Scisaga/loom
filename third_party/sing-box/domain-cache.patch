+		return badjson.UnmarshallExcludedContext(context.Background(), []byte(`{"type":"selector","tag":"access",`+raw[1:]), &parent, target)
+	}
+	if err := parse(body, &options); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := newAccessSelector(options); err != nil {
+		t.Fatalf("native JSON lost explicit required tables (policies=%t entries=%t egress=%t forward=%t): %v", options.Policies == nil, options.Entries == nil, options.EgressOutbounds == nil, options.ForwardOutbounds == nil, err)
+	}
+	for _, invalid := range []string{
+		strings.Replace(body, `"egress_outbounds":{},`, "", 1),
+		strings.Replace(body, `"egress_outbounds":{}`, `"egress_outbounds":null`, 1),
+		strings.Replace(body, `"kind":"internet"`, `"kind":"internet","unknown":{}`, 1),
+	} {
+		var changed option.ExecutionAccessOptions
+		if err := parse(invalid, &changed); err == nil {
+			if _, err = newAccessSelector(changed); err == nil {
+				t.Fatal("missing, null or unknown permission field was accepted")
+			}
+		}
+	}
+}
