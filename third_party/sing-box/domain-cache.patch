+func (c *egressCopyExitGate) Read(buffer []byte) (int, error) {
+	n, err := c.Conn.Read(buffer)
+	if err != nil {
+		c.once.Do(func() { close(c.entered) })
+		<-c.release
+	}
+	return n, err
