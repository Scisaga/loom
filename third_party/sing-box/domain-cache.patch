+package conn
+
+import (
+	"errors"
+	"net"
+	"net/netip"
+	"strconv"
+	"syscall"
+	"testing"
+)
+
+type singleFamilyTestListener struct {
+	family string
+	local  netip.Addr
+	fail   error
+}
+
+type conflictingFamilyTestListener struct {
+	port int
+}
+
+func (l *conflictingFamilyTestListener) ListenPacketCompat(network, address string) (net.PacketConn, error) {
+	if network == "udp6" {
+		return nil, syscall.EADDRINUSE
+	}
+	_, port, err := net.SplitHostPort(address)
+	if err != nil {
+		return nil, err
+	}
+	socket, err := net.ListenPacket(network, net.JoinHostPort("127.0.0.1", port))
+	if err == nil {
+		l.port = socket.LocalAddr().(*net.UDPAddr).Port
+	}
+	return socket, err
+}
+
+func TestStdNetBindFixedPortConflictDoesNotDowngradeOrLeak(t *testing.T) {
+	probe, err := net.ListenPacket("udp4", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	port := probe.LocalAddr().(*net.UDPAddr).Port
+	probe.Close()
+	listener := &conflictingFamilyTestListener{}
+	bind := NewStdNetBind(listener)
+	if _, actual, err := bind.Open(uint16(port)); !errors.Is(err, syscall.EADDRINUSE) || actual != 0 {
+		t.Fatal("fixed UDP conflict was hidden by a different port or single family", err)
+	}
+	defer bind.Close()
+	if listener.port != port {
+		t.Fatal("listener did not use the explicitly requested local port")
+	}
+	probe, err = net.ListenPacket("udp4", net.JoinHostPort("127.0.0.1", strconv.Itoa(port)))
+	if err != nil {
+		t.Fatal("failed dual-family open leaked its first socket", err)
+	}
+	probe.Close()
+}
+
+func (l singleFamilyTestListener) ListenPacketCompat(network, address string) (net.PacketConn, error) {
+	if network != l.family {
+		return nil, syscall.EAFNOSUPPORT
+	}
+	if l.fail != nil {
+		return nil, l.fail
+	}
+	_, port, err := net.SplitHostPort(address)
+	if err != nil {
+		return nil, err
+	}
+	return net.ListenPacket(network, net.JoinHostPort(l.local.String(), port))
+}
+
+func TestStdNetBindSingleFamilyRetainsActualPort(t *testing.T) {
+	for _, host := range []string{"127.0.0.1", "::1"} {
+		t.Run(host, func(t *testing.T) {
+			address := netip.MustParseAddr(host)
+			family := "udp4"
+			if address.Is6() {
+				family = "udp6"
+			}
+			bind := NewStdNetBind(singleFamilyTestListener{family: family, local: address})
+			functions, port, err := bind.Open(0)
+			if err != nil {
+				t.Fatal("required loopback address family unavailable", err)
+			}
+			defer bind.Close()
+			if len(functions) != 1 || port == 0 {
+				t.Fatal("single family lost its bound port")
+			}
+			probe, err := net.ListenPacket(family, net.JoinHostPort(host, strconv.Itoa(int(port))))
+			if err == nil {
+				probe.Close()
+				t.Fatal("reported port differs from actual listener")
+			}
+		})
+	}
+}
+
+func TestStdNetBindIPv6FailureWithoutIPv4DoesNotPanic(t *testing.T) {
+	want := errors.New("demo IPv6 bind conflict")
+	bind := NewStdNetBind(singleFamilyTestListener{family: "udp6", fail: want})
+	if _, _, err := bind.Open(12345); !errors.Is(err, want) {
+		t.Fatal("IPv6 error was not preserved", err)
+	}
+}
