+package clashapi
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"io"
+	"net"
+	"net/http"
+
+	"github.com/go-chi/render"
+	"github.com/sagernet/sing-box/common/execution"
+	"github.com/sagernet/sing-box/option"
+)
+
+type receivingExecution interface {
+	RuntimeExecutionReceiver() *execution.Receiver
+	RuntimeExecutionState() execution.State
+	UpdateRuntimeExecution(option.ExecutionUpdate, string, func()) (execution.State, error)
+}
+
+// This endpoint only applies projections supplied by the local accepted-config
+// consumer. It cannot sign, store, enlarge or independently author any grant.
+func (s *Server) executionReceiver(authenticated bool) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		host, _, err := net.SplitHostPort(s.httpServer.Addr)
+		address := net.ParseIP(host)
+		if !authenticated || err != nil || address == nil || !address.IsLoopback() {
+			http.Error(w, "receiving update requires the authenticated local listener", http.StatusForbidden)
+			return
+		}
+		if r.URL.RawQuery != "" {
+			http.Error(w, "unexpected receiving query", http.StatusBadRequest)
+			return
+		}
+		tag := getEscapeParam(r, "name")
+		var endpoint receivingExecution
+		if s.endpoint != nil {
+			if value, ok := s.endpoint.Get(tag); ok {
+				endpoint, _ = value.(receivingExecution)
+			}
+		}
+		if endpoint == nil && s.inbound != nil {
+			if value, ok := s.inbound.Get(tag); ok {
+				endpoint, _ = value.(receivingExecution)
+			}
+		}
+		if endpoint == nil || endpoint.RuntimeExecutionState().Revision == "" {
+			http.Error(w, "receiving resource unavailable", http.StatusNotFound)
+			return
+		}
+		receiver := endpoint.RuntimeExecutionReceiver()
+		if r.Method == http.MethodGet {
+			render.JSON(w, r, endpoint.RuntimeExecutionState())
+			return
+		}
+		body, err := io.ReadAll(http.MaxBytesReader(w, r.Body, 8<<20))
+		if err != nil {
+			http.Error(w, "receiving update exceeds its limit", http.StatusBadRequest)
+			return
+		}
+		var update option.ExecutionUpdate
+		decoder := json.NewDecoder(bytes.NewReader(body))
+		decoder.DisallowUnknownFields()
+		if err = decoder.Decode(&update); err != nil || decoder.Decode(new(any)) != io.EOF || update.ExpectedRevision == "" {
+			http.Error(w, "invalid receiving update", http.StatusBadRequest)
+			return
+		}
+		// Hash the complete applied request projection, without the CAS precondition.
+		var projection map[string]any
+		decoder = json.NewDecoder(bytes.NewReader(body))
+		decoder.UseNumber()
+		if decoder.Decode(&projection) != nil {
+			http.Error(w, "invalid receiving projection", http.StatusBadRequest)
+			return
+		}
+		delete(projection, "expected_revision")
+		canonical, _ := json.Marshal(projection)
+		digest := sha256.Sum256(canonical)
+		hash := "sha256:" + hex.EncodeToString(digest[:])
+		invalidate := func() {
+			if receiver == nil {
+				return
+			}
+			for _, tracker := range s.trafficManager.Snapshot().Connections {
+				metadata := tracker.Metadata().Metadata
+				if metadata.Inbound != tag || metadata.Execution == nil {
+					continue
+				}
+				if _, _, err := receiver.Restore(context.Background(), metadata.ExecutionPrincipal, *metadata.Execution, metadata.ExecutionTarget); err != nil || receiver.CheckSenderAuthentication(metadata) != nil {
+					_ = tracker.Close()
+				}
+			}
+		}
+		state, err := endpoint.UpdateRuntimeExecution(update, hash, invalidate)
+		if errors.Is(err, execution.ErrSuperseded) {
+			http.Error(w, "receiving update superseded", http.StatusConflict)
+			return
+		}
+		if err != nil {
+			http.Error(w, "receiving update failed closed", http.StatusServiceUnavailable)
+			return
+		}
+		render.JSON(w, r, state)
+	}
+}
