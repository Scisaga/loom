+)
+
+// No TUN, endpoint, listener or external network I/O is started by this fixture.
+const sourcePoolCheckConfig = `{"log":{"disabled":true},"outbounds":[{"type":"block","tag":"reject"}],"route":{"final":"reject"},"experimental":{"clash_api":{"external_controller":"127.0.0.1:0","secret":"demo-local-secret"}}}`
+
+func sourcePoolUnstartedBox(t *testing.T) *box.Box {
+	t.Helper()
+	ctx := box.Context(context.Background(), include.InboundRegistry(), include.OutboundRegistry(), include.EndpointRegistry())
+	ctx = service.ContextWith[platform.Interface](ctx, (*platformInterfaceStub)(nil))
+	options, err := parseConfig(ctx, sourcePoolCheckConfig)
+	if err != nil {
+		t.Fatal(err)
+	}
+	instance, err := box.New(box.Options{Context: ctx, Options: options})
+	if err != nil {
+		t.Fatal(err)
+	}
+	return instance
+}
+
+func TestSourcePoolCheckConfigClosesUnstartedBoxWithoutPanic(t *testing.T) {
+	if err := CheckConfig(sourcePoolCheckConfig); err != nil {
+		t.Fatal("valid check-only config failed", err)
+	}
+}
+
+func TestSourcePoolUnstartedClosePreservesPlatformError(t *testing.T) {
+	instance := sourcePoolUnstartedBox(t)
+	if err := instance.Close(); !errors.Is(err, os.ErrInvalid) {
+		t.Fatal("unstarted platform close error was lost", err)
+	}
+}
+
+func TestSourcePoolStartupErrorIsNotHiddenByCleanup(t *testing.T) {
+	instance := sourcePoolUnstartedBox(t)
+	// The check-only platform deliberately refuses Start. It must not open a
+	// real TUN or turn its original error into a cleanup panic or false success.
+	if err := instance.Start(); !errors.Is(err, os.ErrInvalid) {
+		t.Fatal("primary platform Start error was lost", err)
+	}
+	if err := instance.Close(); !errors.Is(err, os.ErrClosed) {
+		t.Fatal("failed Start did not close the instance", err)
+	}
+}
