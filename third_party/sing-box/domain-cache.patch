+package clashapi
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"io"
+	"net"
+	"net/http"
+	"strconv"
+	"sync"
+	"time"
+
+	"github.com/go-chi/render"
+	"github.com/sagernet/sing-box/common/execution"
+	P "github.com/sagernet/sing-box/common/loomprotocol"
+	"github.com/sagernet/sing-box/common/sourcepool"
+	"github.com/sagernet/sing-box/experimental/clashapi/trafficontrol"
+	"github.com/sagernet/sing-box/protocol/group"
+	M "github.com/sagernet/sing/common/metadata"
+)
+
+type accessTCPRequest struct {
+	Expected string        `json:"expected_revision"`
+	PolicyID string        `json:"policy_id"`
+	Choice   P.RouteChoice `json:"choice"`
+	Target   string        `json:"target"`
+}
+
+func accessTCPString(decoder *json.Decoder) (string, error) {
+	value, err := decoder.Token()
+	text, ok := value.(string)
+	if err != nil || !ok {
+		return "", errors.New("required string missing")
+	}
+	return text, nil
+}
+
+func decodeAccessTCPChoice(decoder *json.Decoder) (P.RouteChoice, error) {
+	var value P.RouteChoice
+	start, err := decoder.Token()
+	if err != nil || start != json.Delim('{') {
+		return value, errors.New("choice must be a complete object")
+	}
+	seen := map[string]bool{}
+	for decoder.More() {
+		key, err := accessTCPString(decoder)
+		if err != nil || seen[key] {
+			return value, errors.New("invalid or repeated choice field")
+		}
+		seen[key] = true
+		text, err := accessTCPString(decoder)
+		if err != nil {
+			return value, err
+		}
+		switch key {
+		case "entry_node_id":
+			value.EntryNodeID = text
+		case "first_resource_id":
+			value.FirstResourceID = text
+		case "final_exit":
+			value.FinalExit = text
+		default:
+			return value, errors.New("unknown choice field")
+		}
+	}
+	end, err := decoder.Token()
+	if err != nil || end != json.Delim('}') || len(seen) != 3 || value.Validate() != nil {
+		return value, errors.New("invalid or incomplete choice")
+	}
+	return value, nil
+}
+
+func decodeAccessTCPRequest(body []byte) (accessTCPRequest, error) {
+	var value accessTCPRequest
+	if len(body) == 0 || len(body) > 4<<10 {
+		return value, errors.New("invalid calibration request size")
+	}
+	decoder := json.NewDecoder(bytes.NewReader(body))
+	start, err := decoder.Token()
+	if err != nil || start != json.Delim('{') {
+		return value, errors.New("calibration request must be an object")
+	}
+	seen := map[string]bool{}
+	for decoder.More() {
+		key, err := accessTCPString(decoder)
+		if err != nil || seen[key] {
+			return value, errors.New("invalid or repeated calibration field")
+		}
+		seen[key] = true
+		if key == "choice" {
+			value.Choice, err = decodeAccessTCPChoice(decoder)
+		} else {
+			var text string
+			text, err = accessTCPString(decoder)
+			switch key {
+			case "expected_revision":
+				value.Expected = text
+			case "policy_id":
+				value.PolicyID = text
+			case "target":
+				value.Target = text
+			default:
+				return value, errors.New("unknown calibration field")
+			}
+		}
+		if err != nil {
+			return value, err
+		}
+	}
+	end, err := decoder.Token()
+	if err != nil || end != json.Delim('}') || len(seen) != 4 || value.Expected == "" || P.ValidateID(value.PolicyID) != nil {
+		return value, errors.New("invalid or incomplete calibration request")
+	}
+	if _, err := decoder.Token(); err != io.EOF {
+		return value, errors.New("trailing calibration input")
+	}
+	network, _, _, err := P.ParseConnectionTargetKey(value.Target)
+	if err != nil || network != "tcp" {
+		return value, errors.New("calibration requires a canonical TCP target")
+	}
+	return value, nil
+}
+
+// Only Close is used by the existing tracker. A late Dial result is attached
+// under the same lock, so revocation cannot leave its newly returned stream open.
+type tcpCalibrationConn struct {
+	net.Conn
+	access sync.Mutex
+	cancel context.CancelFunc
+	closed bool
+}
+
+func (c *tcpCalibrationConn) attach(conn net.Conn) {
+	c.access.Lock()
+	closed := c.closed
+	if !closed {
+		c.Conn = conn
+	}
+	c.access.Unlock()
+	if closed && conn != nil {
+		_ = conn.Close()
+	}
+}
+
+func (c *tcpCalibrationConn) Close() error {
+	c.access.Lock()
+	c.closed = true
+	conn := c.Conn
+	c.Conn = nil
+	c.access.Unlock()
+	c.cancel()
+	if conn != nil {
+		return conn.Close()
+	}
+	return nil
+}
