+// Package sourcepool executes disposable sender facilities through the existing
+// outbound registry. Permissions remain in the source and receiver snapshots.
+package sourcepool
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"io"
+	"reflect"
+
+	"github.com/sagernet/sing-box/adapter"
+)
+
+var (
+	ErrResourcePending = errors.New("runtime sender preparation pending")
+	ErrConflict        = errors.New("runtime outbound registration changed")
+	ErrNotRunning      = errors.New("outbound registry is not running")
+	ErrDependency      = errors.New("runtime outbound still has an external dependency")
+)
+
+// Registration describes an actual object, not a grant or desired-state store.
+// Hash binds its original typed configuration. Owned is installed only by
+// a matching, explicit adoption or publication from the resource consumer.
+type Registration struct {
+	Outbound   adapter.Outbound
+	ConfigHash string
+	Owned      bool
+}
+
+func (r Registration) Valid() bool {
+	if r.Outbound == nil || r.Outbound.Tag() == "" || !ValidHash(r.ConfigHash) {
+		return false
+	}
+	value := reflect.ValueOf(r.Outbound)
+	return value.Kind() == reflect.Pointer && !value.IsNil()
+}
+
+func ValidHash(value string) bool {
+	if len(value) != 71 || value[:7] != "sha256:" {
+		return false
+	}
+	decoded, err := hex.DecodeString(value[7:])
+	return err == nil && len(decoded) == sha256.Size && value == "sha256:"+hex.EncodeToString(decoded)
+}
+
+func SameObject(a, b adapter.Outbound) bool {
+	if a == nil || b == nil {
+		return a == nil && b == nil
+	}
+	av, bv := reflect.ValueOf(a), reflect.ValueOf(b)
+	return av.Kind() == reflect.Pointer && bv.Kind() == reflect.Pointer && av.Type() == bv.Type() && av.Pointer() == bv.Pointer()
+}
+
+// Registry publishes only already-prepared objects. None of these methods
+// starts or closes an outbound while holding the manager's map lock.
+type Registry interface {
+	RuntimeOutbound(string) (Registration, bool)
+	AdoptRuntimeOutbound(string, string) (Registration, error)
+	PublishRuntimeOutbounds(context.Context, []Registration, []Registration) ([]Registration, error)
+	ReconcileRuntimeOutbounds(context.Context, []Registration, []Registration, []Registration) ([]Registration, error)
+	DetachRuntimeOutbounds(context.Context, []Registration) ([]Registration, error)
+}
+
+// ConfigHash normalizes the same typed constructor options on initial creation
+// and on a pool request. It never includes time, object identity or live state.
+func ConfigHash(kind, tag string, options any) (string, error) {
+	body, err := json.Marshal(options)
+	if err != nil {
+		return "", err
+	}
+	if bytes.Equal(body, []byte("null")) {
+		body = []byte("{}")
+	}
+	decoder := json.NewDecoder(bytes.NewReader(body))
+	decoder.UseNumber()
+	var fields map[string]any
+	if err := decoder.Decode(&fields); err != nil || fields == nil {
+		return "", errors.New("outbound options must be an object")
+	}
+	var trailing any
+	if err := decoder.Decode(&trailing); !errors.Is(err, io.EOF) {
+		return "", errors.New("outbound options have trailing data")
+	}
+	fields["type"], fields["tag"] = kind, tag
+	normalized, err := json.Marshal(fields)
+	if err != nil {
+		return "", err
+	}
+	sum := sha256.Sum256(normalized)
+	return "sha256:" + hex.EncodeToString(sum[:]), nil
+}
