+package device
+
+import (
+	"bytes"
+	"os"
+	"sort"
+	"sync/atomic"
+)
+
+// These two numbers belong to one public peer identity for this Device's
+// lifetime. They retain no protocol object, key material, queue or session.
+// Recreating a peer reuses the same numbers, including late handshake writes.
+type peerByteCounters struct {
+	txBytes atomic.Uint64
+	rxBytes atomic.Uint64
+}
+
+// PeerCounter reads authenticated WireGuard message bytes. It deliberately has
+// no configuration or private-key fields and never calls the UAPI exporter.
+type PeerCounter struct {
+	PublicKey        NoisePublicKey
+	RXBytes, TXBytes uint64
+}
+
+func (device *Device) PeerCounters() ([]PeerCounter, error) {
+	if !device.peers.TryRLock() {
+		return nil, os.ErrNotExist
+	}
+	if device.isClosed() {
+		device.peers.RUnlock()
+		return nil, os.ErrClosed
+	}
+	result := make([]PeerCounter, 0, len(device.peers.counters))
+	for public, counters := range device.peers.counters {
+		result = append(result, PeerCounter{PublicKey: public, RXBytes: counters.rxBytes.Load(), TXBytes: counters.txBytes.Load()})
+	}
+	if device.isClosed() {
+		device.peers.RUnlock()
+		return nil, os.ErrClosed
+	}
+	device.peers.RUnlock()
+	sort.Slice(result, func(i, j int) bool { return bytes.Compare(result[i].PublicKey[:], result[j].PublicKey[:]) < 0 })
+	return result, nil
+}
