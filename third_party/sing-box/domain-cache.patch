+func TestWGLastBusinessLeaseRemovesActualPeerAndColdBorrowRecreatesIt(t *testing.T) {
+	f, getEndpoint, _ := actualWGPoolFixture(t, false)
+	lease, err := f.pool.Acquire(context.Background(), "demo-a")
+	if err != nil {
+		t.Fatal(err)
+	}
+	endpoint := getEndpoint()
+	if actualPeerCount(t, endpoint) != 1 {
+		t.Fatal("cold borrow did not create physical WG peer")
+	}
+	before, _ := endpoint.ReadWireGuardCounters()
+	first := lease.Outbound()
+	local, remote := net.Pipe()
+	defer remote.Close()
+	conn, err := lease.BindConn(local)
+	if err != nil {
+		t.Fatal(err)
+	}
+	lease.Release()
+	if actualPeerCount(t, endpoint) != 1 {
+		t.Fatal("pending Release retired live business")
+	}
+	_ = conn.Close()
+	awaitPeerCount(t, endpoint, 0)
+	next, err := f.pool.Acquire(context.Background(), "demo-a")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if next.Outbound() == first || getEndpoint() != endpoint || actualPeerCount(t, endpoint) != 1 {
+		t.Fatal("cold reuse did not recreate only the sender peer")
+	}
+	after, _ := endpoint.ReadWireGuardCounters()
+	if after.Epoch != before.Epoch {
+		t.Fatal("cold peer creation replaced shared identity/device")
+	}
+	next.Release()
+	awaitPeerCount(t, endpoint, 0)
+	// A whole new executor has a new counter lifetime. Peer-only cold creation
+	// above deliberately kept the original endpoint and lifetime.
+	restarted, getRestarted, _ := actualWGPoolFixture(t, false)
+	restartedLease, err := restarted.pool.Acquire(context.Background(), "demo-a")
+	if err != nil {
+		t.Fatal(err)
+	}
+	restartedCounters, err := getRestarted().ReadWireGuardCounters()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if restartedCounters.Epoch == after.Epoch || len(restartedCounters.Peers) != 1 || restartedCounters.Peers[0].RXBytes != 0 || restartedCounters.Peers[0].TXBytes != 0 {
+		t.Fatal("whole endpoint construction reused old counter lifetime")
+	}
+	restartedLease.Release()
+	awaitPeerCount(t, getRestarted(), 0)
+}
+func TestWGLateCleanupCannotDeleteNewPeerWithSameKey(t *testing.T) {
+	f, getEndpoint, delayed := actualWGPoolFixture(t, true)
+	first, err := f.pool.Acquire(context.Background(), "demo-a")
+	if err != nil {
+		t.Fatal(err)
+	}
+	endpoint := getEndpoint()
+	first.Release()
+	await(t, delayed.entered)
+	// A second legitimate idle reconciliation finishes before the original
+	// cleanup resumes; the next borrow must create a new same-key object.
+	source := endpoint.RuntimeWireGuardSnapshot()
+	description := f.pool.Actual()
+	if len(description) != 0 {
+		t.Fatal("retired sender stayed registered")
+	}
+	// The old entry's exact sender binding is the already-installed test shape.
+	request := wgRequest("demo-a", "fdab:77::1", "fdab:79::1", false)
+	// Use the actual currently accepted peer identity, without disclosing it.
+	counters, _ := endpoint.ReadWireGuardCounters()
+	raw, err := base64.RawURLEncoding.DecodeString(counters.Peers[0].PublicKey)
+	if err != nil {
+		t.Fatal(err)
+	}
+	request.WireGuard.Peers[0].PublicKey = base64.StdEncoding.EncodeToString(raw)
+	if err = endpoint.RetireRuntimeWireGuard(source, request.WireGuard.Peers, request.WireGuard.SourceRoutes, map[string]uint16{}); err != nil {
+		t.Fatal(err)
+	}
+	awaitPeerCount(t, endpoint, 0)
+	readDone := make(chan struct{})
+	go func() { _ = f.pool.Described(); _ = f.pool.Actual(); close(readDone) }()
+	await(t, readDone)
+	next, err := f.pool.Acquire(context.Background(), "demo-a")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if actualPeerCount(t, endpoint) != 1 {
+		t.Fatal("new same-key physical peer missing")
+	}
+	close(delayed.proceed)
+	await(t, delayed.done)
+	if actualPeerCount(t, endpoint) != 1 {
+		t.Fatal("old cleanup deleted the newly borrowed same-key peer")
+	}
+	next.Release()
+	awaitPeerCount(t, endpoint, 0)
+}
