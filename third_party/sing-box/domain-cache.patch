+package endpoint
+
+import (
+	"context"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/common/sourcepool"
+)
+
+// PublishRuntimeEndpoint installs one already-started sender endpoint. Its
+// preparation and cleanup never execute under the manager's lookup lock.
+func (m *Manager) PublishRuntimeEndpoint(ctx context.Context, candidate adapter.Endpoint) error {
+	m.access.Lock()
+	defer m.access.Unlock()
+	if ctx.Err() != nil {
+		return ctx.Err()
+	}
+	if m.closed || !m.started || m.stage != adapter.StartStateStarted {
+		return sourcepool.ErrNotRunning
+	}
+	if candidate == nil || candidate.Tag() == "" {
+		return sourcepool.ErrConflict
+	}
+	if _, exists := m.endpointByTag[candidate.Tag()]; exists {
+		return sourcepool.ErrConflict
+	}
+	m.endpointByTag[candidate.Tag()] = candidate
+	m.endpoints = append(m.endpoints, candidate)
+	return nil
+}
