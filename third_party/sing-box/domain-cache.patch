+func TestSharedTargetRequiresSamePeerExecutionOwnership(t *testing.T) {
+	source := netip.MustParseAddr("fdab:77::1")
+	pool := netip.MustParsePrefix("fdab:80:1::/64")
+	execution := netip.MustParseAddr("fdab:79::1")
+	options := option.WireGuardEndpointOptions{SourceRoutes: []option.WireGuardSourceRoute{{Source: source, Destination: pool, Execution: execution}}, Peers: []option.WireGuardPeer{{PublicKey: "demo-peer", AllowedIPs: []netip.Prefix{pool, netip.PrefixFrom(execution, 128)}}}}
+	endpoint := Endpoint{localAddresses: []netip.Prefix{netip.PrefixFrom(source, 128)}}
+	if err := endpoint.configureSourceRoutes(options); err != nil {
+		t.Fatal(err)
+	}
+	options.Peers[0].AllowedIPs = []netip.Prefix{pool}
+	options.Peers = append(options.Peers, option.WireGuardPeer{PublicKey: "demo-other", AllowedIPs: []netip.Prefix{netip.PrefixFrom(execution, 128)}})
+	if err := endpoint.configureSourceRoutes(options); err == nil {
+		t.Fatal("execution control was redirected to a different authenticated peer")
+	}
+	options.SourceRoutes[0].Execution = netip.Addr{}
+	if err := endpoint.configureSourceRoutes(options); err == nil {
+		t.Fatal("retired global DNS lookup was retained as a business fallback")
+	}
+}
