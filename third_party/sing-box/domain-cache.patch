+func TestForwardContainersMaterializeUpdateAndRetireWithoutClosingLegalTCP(t *testing.T) {
+	f := newFixture(t)
+	registerForwardFactory(f)
+	a, b, c := sender("demo-a", "echo-a"), sender("demo-b", "echo-b"), sender("demo-c", "echo-c")
+	initial := option.RuntimeResources{Outbounds: []option.Outbound{a, b}, Forwarding: map[string]option.ExecutionHopOptions{"demo-hop": forwardingOptions("demo-policy", false)}}
+	forwardingCommit(t, f, initial)
+	actual, ok := f.manager.Outbound("demo-hop")
+	if !ok {
+		t.Fatal("new forwarding container was not published")
+	}
+	selector := actual.(*group.Selector)
+	before, revision := selector.ForwardSnapshot()
+	if _, err := selector.CompareAndSelectExits(map[string][]string{"demo-egress": {"demo-b", "demo-a"}}, before, revision); err != nil {
+		t.Fatal(err)
+	}
+	connection := P.Connection{PolicyID: "demo-policy", Path: P.PathContext{OriginID: "demo-source", FinalExitID: "demo-egress", Visited: []string{"demo-forward"}}}
+	metadata := adapter.InboundContext{Network: "tcp", Execution: &connection, Destination: M.ParseSocksaddr("demo-target.example:443")}
+	pinCtx, releasePin, pinErr := adapter.PinOutboundPath(context.Background(), f.manager, selector, &metadata)
+	defer releasePin()
+	if pinErr != nil {
+		t.Fatal(pinErr)
+	}
+	ctx := P.WithConnection(adapter.WithContext(pinCtx, &metadata), connection)
+	conn, err := selector.DialContext(ctx, "tcp", metadata.Destination)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer conn.Close()
+	forwardEcho(t, conn)
+	if metadata.ExecutionNextNodeID != "demo-relay-b" {
+		t.Fatal("flow did not pin the optimized successor")
+	}
+	expanded := option.RuntimeResources{Outbounds: []option.Outbound{a, b, c}, Forwarding: map[string]option.ExecutionHopOptions{"demo-hop": forwardingOptions("demo-policy", true)}}
+	prepared, err := f.pool.Prepare(context.Background(), expanded)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer prepared.Close()
+	previous, oldRevision := selector.ForwardSnapshot()
+	optimized := map[string][]string{"demo-egress": {"demo-a", "demo-b"}}
+	if _, err := selector.CompareAndSelectExits(optimized, previous, oldRevision); err != nil {
+		t.Fatal(err)
+	}
+	if err := prepared.Commit(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	next, newRevision := selector.ForwardSnapshot()
+	if strings.Join(next["demo-egress"], ",") != "demo-a,demo-b,demo-c" || newRevision == oldRevision {
+		t.Fatal("graph publication reset latest performance or kept stale revision", next)
+	}
+	if _, err := selector.CompareAndSelectExits(previous, previous, oldRevision); !errors.Is(err, group.ErrSelectionChanged) {
+		t.Fatal("old optimizer crossed graph publication", err)
+	}
+	same, _ := f.manager.Outbound("demo-hop")
+	if same != selector {
+		t.Fatal("graph update replaced the live forwarding container")
+	}
+	forwardEcho(t, conn)
+	hash, err := option.RuntimeForwardingHash(expanded.Forwarding["demo-hop"])
+	if err != nil || f.pool.Forwarding()["demo-hop"] != hash || len(f.pool.Actual()) != 1 {
+		t.Fatal("actual graph/readback did not reflect finite resources", err)
+	}
+	expanded.Forwarding["demo-hop-two"] = forwardingOptions("demo-policy-two", true)
+	forwardingCommit(t, f, expanded)
+	if len(f.pool.Forwarding()) != 2 {
+		t.Fatal("second current Policy container was not created")
+	}
+	delete(expanded.Forwarding, "demo-hop")
+	forwardingCommit(t, f, expanded)
+	if _, ok := f.manager.Outbound("demo-hop"); ok {
+		t.Fatal("retired Policy container stayed selectable")
+	}
+	forwardEcho(t, conn)
+	if metadata.ExecutionNextNodeID != "demo-relay-b" {
+		t.Fatal("retirement changed the existing path attribution")
+	}
+}
