+
+	"github.com/sagernet/sing-box/option"
+)
+
+type replacementResult struct {
+	state State
+	err   error
+}
+
+func TestNewPermissionOnlyReplacementDoesNotAwaitOldTransport(t *testing.T) {
+	for _, failed := range []bool{false, true} {
+		t.Run(map[bool]string{false: "old-success", true: "old-failure"}[failed], func(t *testing.T) {
+			r, err := New(receivingFixture())
+			if err != nil {
+				t.Fatal(err)
+			}
+			entered, release := make(chan struct{}), make(chan struct{})
+			var releaseOnce sync.Once
+			unblock := func() { releaseOnce.Do(func() { close(release) }) }
+			defer unblock()
+			oldDone := make(chan replacementResult, 1)
+			oldInvalidated := make(chan struct{})
+			transportError := errors.New("demo transport error")
+			before := r.State()
+			go func() {
+				state, err := r.Replace(receivingFixture(), before.Revision, "demo-old", func(State) error {
+					close(entered)
+					<-release
+					if failed {
+						return transportError
+					}
+					return nil
+				}, func() { close(oldInvalidated) })
+				oldDone <- replacementResult{state, err}
+			}()
+			<-entered
+			pending := r.State()
+			options := receivingFixture()
+			options.Bindings = []option.ExecutionBinding{}
+			newDone := make(chan replacementResult, 1)
+			newInvalidated := make(chan struct{})
+			go func() {
+				state, err := r.Replace(options, pending.Revision, "demo-current", nil, func() { close(newInvalidated) })
+				newDone <- replacementResult{state, err}
+			}()
+			var current replacementResult
+			select {
+			case current = <-newDone:
+			case <-time.After(500 * time.Millisecond):
+				unblock()
+				<-oldDone
+				<-newDone
+				t.Fatal("new permission and invalidation waited for old transport I/O")
+			}
+			if current.err != nil || current.state.Revision == pending.Revision || current.state.ConfigHash != "demo-current" || current.state != r.State() {
+				t.Fatal("accepted permission-only projection was not confirmed immediately", current)
+			}
+			for _, invalidated := range []chan struct{}{oldInvalidated, newInvalidated} {
+				select {
+				case <-invalidated:
+				default:
+					t.Fatal("accepted permission did not invalidate before transport completion")
+				}
+			}
+			if r.Echo("demo-principal", "demo-policy") == nil {
+				t.Fatal("blocked old transport retained a withdrawn permission")
+			}
+			if err := r.WithState(current.state.Revision, nil); err != nil {
+				t.Fatal("short permission fence remained unavailable", err)
+			}
+			unblock()
+			old := <-oldDone
+			if !errors.Is(old.err, ErrSuperseded) || failed && !errors.Is(old.err, transportError) || old.state != current.state || r.State() != current.state {
+				t.Fatal("old completion changed a newer permission or discarded its original error", old)
+			}
+			// The hash above proves only accepted permission. A later full update
+			// still runs and confirms its own physical callback independently.
+			applied := false
+			retried, err := r.Replace(options, current.state.Revision, "demo-current-full", func(state State) error {
+				if state != r.State() {
+					t.Fatal("full retry received an unaccepted physical snapshot")
+				}
+				applied = true
+				return nil
+			}, nil)
+			if err != nil || !applied || retried.ConfigHash != "demo-current-full" || retried.Revision == current.state.Revision || retried != r.State() {
+				t.Fatal("current physical retry could not confirm independently", retried, err)
+			}
+		})
+	}
+}
+
+func TestBusyPhysicalReplacementReturnsUnknownAndRetriesCurrent(t *testing.T) {
+	r, err := New(receivingFixture())
+	if err != nil {
+		t.Fatal(err)
+	}
+	entered, release := make(chan struct{}), make(chan struct{})
+	var releaseOnce sync.Once
+	unblock := func() { releaseOnce.Do(func() { close(release) }) }
+	defer unblock()
+	physicalUsers := "demo-before"
+	oldDone := make(chan replacementResult, 1)
+	before := r.State()
+	go func() {
+		state, err := r.Replace(receivingFixture(), before.Revision, "demo-old", func(State) error {
+			close(entered)
+			<-release
+			physicalUsers = "demo-old"
+			return nil
+		}, nil)
+		oldDone <- replacementResult{state, err}
+	}()
+	<-entered
+	accepted, called := make(chan State, 1), make(chan struct{}, 1)
+	newDone := make(chan replacementResult, 1)
+	pending := r.State()
+	go func() {
+		state, err := r.Replace(receivingFixture(), pending.Revision, "demo-latest", func(State) error {
+			physicalUsers = "demo-latest"
+			called <- struct{}{}
+			return nil
+		}, func() { accepted <- r.State() })
+		newDone <- replacementResult{state, err}
+	}()
+	var newest replacementResult
+	select {
+	case newest = <-newDone:
+	case <-time.After(500 * time.Millisecond):
+		unblock()
+		<-oldDone
+		<-newDone
+		t.Fatal("busy physical replacement queued behind old transport I/O")
+	}
+	latest := <-accepted
+	if !errors.Is(newest.err, ErrSuperseded) || newest.state != latest || latest.ConfigHash != "" || r.State() != latest {
+		t.Fatal("busy physical replacement lost accepted permission or claimed complete apply", newest)
+	}
+	select {
+	case <-called:
+		t.Fatal("busy physical callback ran concurrently")
+	default:
+	}
+	if err = r.WithState(latest.Revision, nil); err != nil {
+		t.Fatal("busy physical request retained the permission fence", err)
+	}
+	unblock()
+	old := <-oldDone
+	if !errors.Is(old.err, ErrSuperseded) || old.state != latest || r.State() != latest || physicalUsers != "demo-old" {
+		t.Fatal("old completion overwrote newer permission or its unknown proof", old)
+	}
+	select {
+	case <-called:
+		t.Fatal("returned busy callback remained queued")
+	default:
+	}
+	// No queued task or pending latch is needed: the existing retry applies only
+	// the latest accepted users after older physical I/O has completed.
+	retried, err := r.Replace(receivingFixture(), latest.Revision, "demo-latest", func(state State) error {
+		if state != r.State() {
+			t.Fatal("retry received an unaccepted physical snapshot")
+		}
+		physicalUsers = "demo-latest"
+		return nil
+	}, nil)
+	if err != nil || retried.ConfigHash != "demo-latest" || retried.Revision == latest.Revision || r.State() != retried || physicalUsers != "demo-latest" {
+		t.Fatal("ordinary retry could not apply the latest physical users", retried, err)
+	}
+}
