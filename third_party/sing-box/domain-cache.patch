+//go:build with_gvisor
+
+package wireguard
+
+import (
+	"bytes"
+	"fmt"
+	"net/netip"
+	"testing"
+	"time"
+
+	"github.com/sagernet/sing-tun"
+)
+
+type checkedHostBatch struct {
+	tun.LinuxTUN
+	entered chan struct{}
+	release chan struct{}
+}
+
+func (b *checkedHostBatch) BatchWrite(packets [][]byte, offset int) (int, error) {
+	original := bytes.Clone(packets[0])
+	b.entered <- struct{}{}
+	<-b.release
+	if !bytes.Equal(original, packets[0]) {
+		return 0, fmt.Errorf("another WG peer changed this host packet batch")
+	}
+	return len(packets), nil
+}
+
+func TestConcurrentPeersKeepTheirOwnHostBatch(t *testing.T) {
+	batch := &checkedHostBatch{entered: make(chan struct{}, 2), release: make(chan struct{})}
+	device := &systemStackDevice{endpoint: &deviceEndpoint{done: make(chan struct{})}, systemDevice: &systemDevice{
+		batchDevice: batch,
+		options: DeviceOptions{Address: []netip.Prefix{netip.MustParsePrefix("192.0.2.20/32")},
+			HostSources: []netip.Prefix{netip.MustParsePrefix("192.0.2.10/32")}},
+	}}
+	done := make(chan error, 2)
+	packet := func(size int) []byte {
+		p := make([]byte, 16+20+size)
+		p[16] = 0x45
+		copy(p[28:32], []byte{192, 0, 2, 10})
+		copy(p[32:36], []byte{192, 0, 2, 20})
+		for i := 36; i < len(p); i++ {
+			p[i] = byte(size)
+		}
+		return p
+	}
+	for _, size := range []int{32, 128} {
+		go func(data []byte) { _, err := device.Write([][]byte{data}, 16); done <- err }(packet(size))
+		select {
+		case <-batch.entered:
+		case <-time.After(3 * time.Second):
+			close(batch.release)
+			t.Fatal("peer did not reach host delivery")
+		}
+	}
+	close(batch.release)
+	for i := 0; i < 2; i++ {
+		if err := <-done; err != nil {
+			t.Error(err)
+		}
+	}
+}
