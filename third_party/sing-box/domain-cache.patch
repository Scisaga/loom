+func TestAccessSharesTransportsPinsTargetPolicyEntryAndExit(t *testing.T) {
+	s, _, a, b := accessFixture(t)
+	idA, choices := sourceChoice(t, a)
+	idB, onlyB := sourceChoice(t, b)
+	choices[idB] = b
+	applied, err := s.CompareAndSelectAccess(context.Background(), AccessSnapshot{Name: idA, PolicyID: "demo-policy", Choices: choices, Targets: map[string]string{"tcp://demo-b.example:443": idB}}, s.AccessSnapshot())
+	if err != nil {
+		t.Fatal(err)
+	}
+	old := &adapter.InboundContext{Network: "tcp", Destination: M.ParseSocksaddr("demo-a.example:443")}
+	if s.pinSelection(old) != "demo-a" || old.Execution == nil || old.Execution.PolicyID != "demo-policy" || old.Execution.Path.FinalExitID != a.FinalExit {
+		t.Fatal("source context was not pinned")
+	}
+	if old.ExecutionSelectionRevision != applied.Revision {
+		t.Fatal("connection did not retain its original selection revision")
+	}
+	other := &adapter.InboundContext{Network: "tcp", Destination: M.ParseSocksaddr("demo-b.example:443")}
+	if s.pinSelection(other) != "demo-b" || other.Execution.Path.FinalExitID != b.FinalExit {
+		t.Fatal("target exit was collapsed")
+	}
+	udp := &adapter.InboundContext{Network: "udp", Destination: M.ParseSocksaddr("demo-b.example:443")}
+	if s.pinSelection(udp) != "demo-a" {
+		t.Fatal("TCP preference leaked into a UDP session")
+	}
+	current, err := s.CompareAndSelectAccess(context.Background(), AccessSnapshot{Name: idB, PolicyID: "demo-policy", Choices: onlyB, Targets: map[string]string{}}, applied)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if s.pinSelection(old) != "demo-a" || old.Execution.Path.FinalExitID != a.FinalExit {
+		t.Fatal("performance update moved an established connection")
+	}
+	if old.ExecutionSelectionRevision != applied.Revision {
+		t.Fatal("late result was relabeled with the current revision")
+	}
+	fresh := &adapter.InboundContext{Destination: M.ParseSocksaddr("demo-a.example:443")}
+	if s.pinSelection(fresh) != "demo-b" {
+		t.Fatal("new connection did not use current preference")
+	}
+	if _, err = s.CompareAndSelectAccess(context.Background(), AccessSnapshot{Name: idA, PolicyID: "demo-policy", Choices: map[string]P.RouteChoice{idA: a}, Targets: map[string]string{}}, applied); !errors.Is(err, ErrSelectionChanged) {
+		t.Fatal("stale selection applied", err)
+	}
+	if current.Revision == applied.Revision {
+		t.Fatal("missing own CAS revision")
+	}
+}
