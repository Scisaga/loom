+//go:build linux && !android
+
+package device
+
+import (
+	"encoding/binary"
+	"errors"
+	"net/netip"
+	"runtime"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/sagernet/wireguard-go/conn"
+	"github.com/sagernet/wireguard-go/tun"
+)
+
+type reachabilityBind struct {
+	conn.Bind
+	entered chan struct{}
+	release chan struct{}
+	calls   atomic.Int32
+	invalid atomic.Bool
+	fail    bool
+}
+
+func (*reachabilityBind) BatchSize() int { return conn.IdealBatchSize }
+
+func (b *reachabilityBind) Send(bufs [][]byte, _ conn.Endpoint) error {
+	if b.calls.Add(1) == 1 {
+		close(b.entered)
+		<-b.release
+	}
+	// The synchronous I/O owns every slice until it returns, including errors.
+	for _, packet := range bufs {
+		if len(packet) != 64 || packet[0] != MessageTransportType {
+			b.invalid.Store(true)
+			return errors.New("packet released before synchronous send completed")
+		}
+	}
+	if b.fail {
+		return errors.New("demo send failure")
+	}
+	return nil
+}
+
+type reachabilityTUN struct {
+	tun.Device
+	entered chan struct{}
+	release chan struct{}
+	calls   atomic.Int32
+	invalid atomic.Bool
+	fail    bool
+}
+
+func (*reachabilityTUN) BatchSize() int { return conn.IdealBatchSize }
+
+func (example *reachabilityTUN) Write(bufs [][]byte, offset int) (int, error) {
+	if example.calls.Add(1) == 1 {
+		close(example.entered)
+		<-example.release
+	}
+	for _, packet := range bufs {
+		if len(packet) != offset+20 || packet[offset] != 0x45 {
+			example.invalid.Store(true)
+			return 0, errors.New("packet released before synchronous TUN write completed")
+		}
+	}
+	if example.fail {
+		return 0, errors.New("demo TUN write failure")
+	}
+	return len(bufs), nil
+}
+
+func reachabilityPeer() (*Device, *Peer) {
+	example := &Device{log: &Logger{Verbosef: func(string, ...any) {}, Errorf: func(string, ...any) {}}}
+	example.net.bind = &reachabilityBind{}
+	example.tun.device = &reachabilityTUN{}
+	example.PopulatePools()
+	p := &Peer{device: example, peerByteCounters: new(peerByteCounters)}
+	p.isRunning.Store(true)
+	p.endpoint.val = &conn.StdNetEndpoint{AddrPort: netip.MustParseAddrPort("192.0.2.20:51820")}
+	p.stopping.Add(1)
+	return example, p
+}
+
+func awaitReturnedPackets(t *testing.T, example *Device) {
+	t.Helper()
+	p := example.pool.messageBuffers.(*linuxMessageBufferPool)
+	deadline := time.Now().Add(time.Second)
+	for time.Now().Before(deadline) {
+		p.mu.Lock()
+		returned := p.inuse == 0
+		p.mu.Unlock()
+		if returned {
+			return
+		}
+		time.Sleep(time.Millisecond)
+	}
+	t.Fatal("sequential queue did not return its packets")
+}
+
+func awaitUnreachablePackets(t *testing.T, example *Device, finalized *atomic.Int32) {
+	t.Helper()
+	// The idle pool is allowed to keep its warm set. Every other packet from
+	// the full batch must become unreachable while the peer is still running
+	// and its real sequential routine is blocked waiting for the next batch.
+	want := int32(conn.IdealBatchSize - maxIdleMessageBuffers)
+	deadline := time.Now().Add(2 * time.Second)
+	for time.Now().Before(deadline) {
+		runtime.GC()
+		if finalized.Load() >= want {
+			runtime.KeepAlive(example)
+			return
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+	runtime.KeepAlive(example)
+	t.Fatalf("idle sequential routine retained returned packet payloads: finalized %d, want at least %d", finalized.Load(), want)
+}
+
+func queueSendBatch(example *Device, p *Peer, count int, finalized *atomic.Int32) {
+	c := example.GetOutboundElementsContainer()
+	for i := 0; i < count; i++ {
+		e := example.NewOutboundElement()
+		if finalized != nil {
+			runtime.SetFinalizer(e.buffer, func(*[MaxMessageSize]byte) { finalized.Add(1) })
+		}
+		e.buffer[0] = MessageTransportType
+		e.packet = e.buffer[:64]
+		c.elems = append(c.elems, e)
+	}
+	p.queue.outbound.c <- c
+}
+
+func TestSequentialSenderReleasesIdlePayloads(t *testing.T) {
+	for _, fail := range []bool{false, true} {
+		name := "success"
+		if fail {
+			name = "send_error"
+		}
+		t.Run(name, func(t *testing.T) {
+			example, p := reachabilityPeer()
+			b := &reachabilityBind{entered: make(chan struct{}), release: make(chan struct{}), fail: fail}
+			example.net.bind = b
+			p.queue.outbound = &autodrainingOutboundQueue{c: make(chan *QueueOutboundElementsContainer)}
+			go p.RoutineSequentialSender(conn.IdealBatchSize)
+			defer func() { close(p.queue.outbound.c); p.stopping.Wait() }()
+			var finalized atomic.Int32
+			queueSendBatch(example, p, conn.IdealBatchSize, &finalized)
+			<-b.entered
+			runtime.GC()
+			if finalized.Load() != 0 {
+				t.Fatal("synchronous send lost a live packet")
+			}
+			close(b.release)
+			awaitReturnedPackets(t, example)
+			// A shorter subsequent batch must not preserve the full batch's tail.
+			queueSendBatch(example, p, 2, nil)
+			awaitReturnedPackets(t, example)
+			if b.calls.Load() != 2 {
+				t.Fatal("shorter send batch was not consumed")
+			}
+			if b.invalid.Load() {
+				t.Fatal("send packet aliases were released before synchronous I/O returned")
+			}
+			awaitUnreachablePackets(t, example, &finalized)
+		})
+	}
+}
+
+func queueReceiveBatch(example *Device, p *Peer, keypair *Keypair, count int, firstCounter uint64, finalized *atomic.Int32) {
+	c := example.GetInboundElementsContainer()
+	for i := 0; i < count; i++ {
+		e := example.GetInboundElement()
+		e.buffer = example.GetMessageBuffer()
+		if finalized != nil {
+			runtime.SetFinalizer(e.buffer, func(*[MaxMessageSize]byte) { finalized.Add(1) })
+		}
+		e.packet = e.buffer[MessageTransportOffsetContent : MessageTransportOffsetContent+20]
+		e.packet[0] = 0x45
+		binary.BigEndian.PutUint16(e.packet[2:4], 20)
+		copy(e.packet[12:16], []byte{192, 0, 2, 10})
+		e.counter = firstCounter + uint64(i)
+		e.keypair = keypair
+		e.endpoint = p.endpoint.val
+		c.elems = append(c.elems, e)
+	}
+	p.queue.inbound.c <- c
+}
+
+func TestSequentialReceiverReleasesIdlePayloads(t *testing.T) {
+	for _, fail := range []bool{false, true} {
+		name := "success"
+		if fail {
+			name = "tun_write_error"
+		}
