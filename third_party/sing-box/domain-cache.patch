+	done := make(chan *httptest.ResponseRecorder, 1)
+	go func() { response := httptest.NewRecorder(); handler.ServeHTTP(response, request); done <- response }()
+	select {
+	case <-started:
+	case <-time.After(time.Second):
+		t.Fatal("calibration did not dial")
+	}
+	delete(options.Entries, b.FirstResourceID)
+	body, _ := json.Marshal(struct {
+		Expected string                        `json:"expected_revision"`
+		Access   option.ExecutionAccessOptions `json:"access"`
+	}{selector.AccessAuthorizationState().Revision, options})
+	update := httptest.NewRequest(http.MethodPut, "/loom/access/access", bytes.NewReader(body))
+	update.Header.Set("Authorization", "Bearer demo-secret")
+	updated := httptest.NewRecorder()
+	handler.ServeHTTP(updated, update)
+	if updated.Code != http.StatusOK {
+		t.Fatal("formal source withdrawal blocked behind Dial", updated.Code, updated.Body.String())
+	}
+	select {
+	case response := <-done:
+		if response.Code != http.StatusConflict {
+			t.Fatal("revoked calibration published an outcome", response.Code)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("source withdrawal did not cancel actual Dial")
+	}
+	remote := <-latePeer
+	defer remote.Close()
+	_ = remote.SetReadDeadline(time.Now().Add(time.Second))
+	if _, err := remote.Read(make([]byte, 1)); err != io.EOF {
+		t.Fatal("late connection escaped cancellation", err)
+	}
+	_ = old.ExtendedConn.SetDeadline(time.Now().Add(time.Second))
+	if _, err := old.ExtendedConn.Write([]byte{'x'}); err != nil {
+		t.Fatal("calibration withdrawal closed unrelated old flow", err)
+	}
+	var payload [1]byte
+	if _, err := io.ReadFull(old.ExtendedConn, payload[:]); err != nil || payload[0] != 'x' {
+		t.Fatal("authorized old flow lost business", err)
+	}
