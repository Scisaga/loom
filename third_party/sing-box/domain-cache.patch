+// This real connection is provided only by the running component lookup.
+type accessPipeOutbound struct{ targetOutbound }
+
+func (accessPipeOutbound) DialContext(context.Context, string, M.Socksaddr) (net.Conn, error) {
+	client, remote := net.Pipe()
+	go func() {
+		defer remote.Close()
+		_, _ = io.Copy(remote, remote)
+	}()
+	return client, nil
+}
