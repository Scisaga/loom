+package group
+
+import (
+	"crypto/rand"
+	"encoding/base64"
+	"encoding/json"
+	"errors"
+	"maps"
+	"slices"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/common/execution"
+	P "github.com/sagernet/sing-box/common/loomprotocol"
+	"github.com/sagernet/sing-box/option"
+)
+
+type hopSelector struct {
+	hash      string
+	policy    P.HopPolicy
+	node      string
+	nodes     map[string]string
+	initial   map[string][]string
+	reverse   map[string][]string
+	exits     map[string]bool
+	distances map[string]map[string]int
+}
+
+func cloneExitChoices(value map[string][]string) map[string][]string {
+	result := make(map[string][]string, len(value))
+	for exit, tags := range value {
+		result[exit] = slices.Clone(tags)
+	}
+	return result
+}
+func newHopSelector(options option.ExecutionHopOptions) (*hopSelector, error) {
+	// A request may be prepared while its caller continues computing. Own every
+	// nested Policy/scope slice as well as the local successor and initial maps.
+	body, err := json.Marshal(options)
+	if err != nil {
+		return nil, err
+	}
+	var owned option.ExecutionHopOptions
+	if err = json.Unmarshal(body, &owned); err != nil {
+		return nil, err
+	}
+	options = owned
+	if options.Policy.Validate() != nil || !slices.Contains(options.Policy.Nodes, options.NodeID) || options.Nodes == nil || options.ExitChoices == nil {
+		return nil, errors.New("invalid native forwarding projection")
+	}
+	h := &hopSelector{policy: options.Policy, node: options.NodeID, nodes: maps.Clone(options.Nodes), initial: cloneExitChoices(options.ExitChoices), reverse: map[string][]string{}, exits: map[string]bool{}, distances: map[string]map[string]int{}}
+	edges := map[P.DirectedHop]bool{}
+	for _, edge := range h.policy.Edges {
+		edges[edge] = true
+		h.reverse[edge.To] = append(h.reverse[edge.To], edge.From)
+	}
+	for _, node := range h.policy.Exits {
+		h.exits[node] = true
+		h.distances[node] = h.distance(node, nil)
+	}
+	for tag, node := range h.nodes {
+		if tag == "" || tag == "reject" || node == h.node || !edges[P.DirectedHop{From: h.node, To: node}] {
+			return nil, errors.New("forward candidate is not a qualified local segment")
+		}
+	}
+	if err := h.validate(h.initial); err != nil {
+		return nil, err
+	}
+	h.hash, err = option.RuntimeForwardingHash(options)
+	if err != nil {
+		return nil, err
+	}
+	return h, nil
+}
+func (h *hopSelector) distance(exit string, forbidden map[string]bool) map[string]int {
+	values := map[string]int{exit: 0}
+	queue := []string{exit}
+	for head := 0; head < len(queue); head++ {
+		node := queue[head]
+		if node != exit && !h.policy.RelayScope.Allows(node) {
+			continue
+		}
+		for _, from := range h.reverse[node] {
+			if forbidden[from] {
+				continue
+			}
+			if _, seen := values[from]; !seen {
+				values[from] = values[node] + 1
+				queue = append(queue, from)
+			}
+		}
+	}
+	return values
+}
+func (h *hopSelector) validate(choices map[string][]string) error {
+	if choices == nil || len(choices) != len(h.exits) {
+		return errors.New("incomplete forwarding exit choices")
+	}
+	for exit, tags := range choices {
+		if !h.exits[exit] || tags == nil {
+			return errors.New("unknown forwarding exit")
+		}
+		seen := map[string]bool{}
+		for _, tag := range tags {
+			node, exists := h.nodes[tag]
+			_, reachable := h.distances[exit][node]
+			if !exists || !reachable || seen[tag] || node != exit && !h.policy.RelayScope.Allows(node) {
+				return errors.New("choice is outside the forwarding Policy")
+			}
+			seen[tag] = true
+		}
+	}
+	return nil
+}
+func (s *Selector) IsHopSelector() bool { return s.hop != nil }
+
+// RuntimeForwardingHash identifies the applied disposable graph description,
+// not its changing performance order or any receiving permission.
+func (s *Selector) RuntimeForwardingHash() string {
+	if current := s.selected.Load(); current != nil && current.hop != nil {
+		return current.hop.hash
+	}
+	return ""
+}
+
+// PrepareRuntimeForwarding compiles outside all permission/publication fences.
+// A prepared commit only merges the latest recommendations and publishes one
+// immutable snapshot; it performs no I/O and cannot fail after preparation.
+func (s *Selector) PrepareRuntimeForwarding(options option.ExecutionHopOptions) (func() error, error) {
+	if s.hop == nil || options.NodeID != s.hop.node || options.Policy.PolicyID != s.hop.policy.PolicyID {
+		return nil, errors.New("forwarding projection cannot replace its identity")
+	}
+	nextHop, err := newHopSelector(options)
+	if err != nil {
+		return nil, err
+	}
+	current := s.selected.Load()
+	if current == nil || current.hop == nil {
+		return nil, errors.New("forwarding selector is not started")
+	}
+	revision, err := accessRevision()
+	if err != nil {
+		return nil, err
+	}
+	return func() error {
+		for {
+			previous := s.selected.Load()
+			if previous.hop.hash == nextHop.hash {
+				return nil
+			}
+			next := *previous
+			next.hop = nextHop
+			next.exitChoices = nextHop.mergeChoices(previous.exitChoices)
+			next.revision = revision
+			if s.selected.CompareAndSwap(previous, &next) {
+				return nil
+			}
+		}
+	}, nil
+}
+
+func (h *hopSelector) mergeChoices(previous map[string][]string) map[string][]string {
+	next := make(map[string][]string, len(h.exits))
+	for exit := range h.exits {
+		choices := []string{}
+		seen := map[string]bool{}
+		appendCurrent := func(tag string) {
+			node, exists := h.nodes[tag]
+			_, reachable := h.distances[exit][node]
+			if !exists || !reachable || seen[tag] || node != exit && !h.policy.RelayScope.Allows(node) {
+				return
+			}
+			choices = append(choices, tag)
+			seen[tag] = true
+		}
+		for _, tag := range previous[exit] {
+			appendCurrent(tag)
+		}
+		for _, tag := range h.initial[exit] {
+			appendCurrent(tag)
+		}
+		next[exit] = choices
+	}
+	return next
+}
+
+func (s *Selector) ForwardSnapshot() (map[string][]string, string) {
+	choice := s.selected.Load()
+	if choice == nil {
+		return map[string][]string{}, ""
+	}
+	return cloneExitChoices(choice.exitChoices), choice.revision
+}
+func (s *Selector) CompareAndSelectExits(choices, expected map[string][]string, revision string) (string, error) {
+	previous := s.selected.Load()
+	if previous == nil || previous.hop == nil {
+		return "", errors.New("selector has no forwarding Policy")
+	}
+	if err := previous.hop.validate(choices); err != nil {
+		return "", err
+	}
+	if previous.revision != revision || !maps.EqualFunc(previous.exitChoices, expected, slices.Equal[[]string]) {
+		return "", ErrSelectionChanged
+	}
+	var nonce [32]byte
+	if _, err := rand.Read(nonce[:]); err != nil {
+		return "", err
+	}
+	next := *previous
+	next.revision, next.exitChoices = base64.RawURLEncoding.EncodeToString(nonce[:]), cloneExitChoices(choices)
+	if !s.selected.CompareAndSwap(previous, &next) {
+		return "", ErrSelectionChanged
+	}
+	return next.revision, nil
+}
+func (s *Selector) qualifiedHopTags(metadata *adapter.InboundContext, choice *selectorChoice) []string {
+	if metadata == nil || metadata.Execution == nil || choice == nil || choice.hop == nil {
+		return nil
+	}
+	connection := metadata.Execution
+	h := choice.hop
+	if connection.PolicyID != h.policy.PolicyID || connection.Path.Validate(len(h.policy.Nodes)) != nil || len(connection.Path.Visited) == 0 || connection.Path.Visited[len(connection.Path.Visited)-1] != h.node || !h.exits[connection.Path.FinalExitID] || connection.Path.FinalExitID == h.node {
+		return nil
+	}
+	forbidden := make(map[string]bool, len(connection.Path.Visited))
+	for _, node := range connection.Path.Visited {
+		forbidden[node] = true
+	}
+	// Topology is checked against this connection's visited set. It does not
+	// invent RTTs or alter the performance order calculated by this forward.
+	distances := h.distance(connection.Path.FinalExitID, forbidden)
+	result := []string{}
+	for _, tag := range choice.exitChoices[connection.Path.FinalExitID] {
+		node := h.nodes[tag]
+		distance, reachable := distances[node]
+		if !forbidden[node] && reachable && (h.policy.MaxHops <= 0 || len(connection.Path.Visited)+distance+1 <= h.policy.MaxHops) {
+			result = append(result, tag)
+		}
+	}
+	return result
+}
+func (s *Selector) pickHop(metadata *adapter.InboundContext, choice *selectorChoice) adapter.Outbound {
+	for _, tag := range s.qualifiedHopTags(metadata, choice) {
+		if actual := s.accessOutbound(tag); actual != nil {
+			metadata.ExecutionNextNodeID = choice.hop.nodes[tag]
+			return actual
+		}
+	}
+	return s.outbounds["reject"]
+}
+func (s *Selector) PinExecution(metadata *adapter.InboundContext) error {
+	return execution.BindMetadata(metadata, s.executionSource)
+}
