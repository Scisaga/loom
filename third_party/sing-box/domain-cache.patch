+func TestNativeResponseErrorsPreserveDeclaredStatus(t *testing.T) {
+	request := P.Request{Nonce: [16]byte{1}, Operation: P.ConnectTCP}
+	for _, value := range []struct {
+		status P.Status
+		want   error
+	}{{P.Accepted, nil}, {P.Denied, ErrDenied}, {P.Unavailable, ErrUnavailable}} {
+		body, err := (P.Response{Nonce: request.Nonce, Status: value.status}).Marshal()
+		if err != nil {
+			t.Fatal(err)
+		}
+		_, err = CheckResponse(body, request)
+		if value.want == nil && err != nil || value.want != nil && !errors.Is(err, value.want) {
+			t.Fatal("native status lost its type", err)
+		}
+	}
+	if _, err := CheckResponse([]byte("invalid"), request); !errors.Is(err, ErrUnknown) {
+		t.Fatal("malformed confirmation became a declared outcome", err)
+	}
