+func handleHijackedDNSStream(ctx context.Context, router adapter.Router, conn net.Conn, metadata adapter.InboundContext, onClose N.CloseHandlerFunc) (retErr error) {
+	parentCtx := ctx
+	ctx, cancel := context.WithCancel(ctx)
