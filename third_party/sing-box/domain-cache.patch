+package group
+
+import (
+	"context"
+	"errors"
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/common/execution"
+	P "github.com/sagernet/sing-box/common/loomprotocol"
+	"github.com/sagernet/sing-box/common/sourcepool"
+	M "github.com/sagernet/sing/common/metadata"
+	"github.com/sagernet/sing/service"
+)
+
+// WithAccessTCPChoice pins one authorized diagnostic connection without storing
+// a selection. The callback runs under the source authorization fence and may
+// only register a tracker or inspect the derived values, never perform I/O.
+func (s *Selector) WithAccessTCPChoice(expectedRevision, policyID string, choice P.RouteChoice, target M.Socksaddr, use func(adapter.InboundContext, adapter.Outbound) error) error {
+	s.accessFence.RLock()
+	defer s.accessFence.RUnlock()
+	authorization := s.access.Load()
+	if s.Tag() != "access" || authorization == nil || authorization.options.Kind != "internet" {
+		return execution.ErrDenied
+	}
+	current := s.selected.Load()
+	if current == nil || current.access == nil || expectedRevision == "" || current.access.Revision != expectedRevision {
+		return ErrSelectionChanged
+	}
+	if current.access.Name == "reject" || policyID == "" || current.access.PolicyID != policyID || target.Port == 0 || !P.CanonicalHost(target.AddrString()) {
+		return execution.ErrDenied
+	}
+	policy, ok := authorization.policies[policyID]
+	if !ok {
+		return execution.ErrDenied
+	}
+	if _, err := s.accessConnectionTag(policyID, choice, target, nil, ""); err != nil {
+		return execution.ErrDenied
+	}
+	id, err := P.CandidateID(policy.value.Policy.ServiceID, policyID, choice)
+	if err != nil {
+		return execution.ErrDenied
+	}
+	// Reuse the ordinary connection context builder. This temporary choice is
+	// never published, and an unselected candidate still needs the full grant.
+	metadata := adapter.InboundContext{Inbound: "loom-tcp-calibration", Network: "tcp", Destination: target}
+	temporary := &selectorChoice{access: &AccessSnapshot{Name: id, PolicyID: policyID, Revision: expectedRevision,
+		Targets: map[string]string{}, Choices: map[string]P.RouteChoice{id: choice}}}
+	selected := s.pickAccess(&metadata, target, temporary)
+	if selected == nil || selected.Tag() == "reject" || metadata.Execution == nil {
+		return execution.ErrDenied
+	}
+	metadata.SelectedOutbounds = map[string]string{s.Tag(): selected.Tag()}
+	if use != nil {
+		return use(metadata, selected)
+	}
+	return nil
+}
+
+// WithAccessSelectedTarget pins only the current target-specific choice for a
+// trusted Service probe. It never changes the production selection or grants a
+// path that is absent from the current complete source permission.
+func (s *Selector) WithAccessSelectedTarget(expected string, target M.Socksaddr, use func(adapter.InboundContext, adapter.Outbound) error) error {
+	s.accessFence.RLock()
+	defer s.accessFence.RUnlock()
+	current := s.selected.Load()
+	if s.access.Load() == nil || current == nil || current.access == nil || expected == "" || current.access.Revision != expected {
+		return ErrSelectionChanged
+	}
+	metadata := adapter.InboundContext{Inbound: "loom-link-probe", Network: "tcp", Destination: target}
+	selected := s.pickAccess(&metadata, target, current)
+	if selected == nil || selected.Tag() == "reject" || metadata.Execution == nil {
+		return execution.ErrDenied
+	}
+	metadata.SelectedOutbounds = map[string]string{s.Tag(): selected.Tag()}
+	if use != nil {
+		return use(metadata, selected)
+	}
+	return nil
+}
+
+// BorrowAccessTCPChoice prepares only this diagnostic attempt, before entering
+// the source read fence. The final derivation rechecks the same source revision.
+func (s *Selector) BorrowAccessTCPChoice(ctx context.Context, expected, policyID string, choice P.RouteChoice, target M.Socksaddr) (adapter.InboundContext, adapter.Outbound, *sourcepool.Lease, error) {
+	return s.borrowAccessDiagnostic(ctx, expected, policyID, choice, target, false)
+}
+func (s *Selector) BorrowAccessSelectedTarget(ctx context.Context, expected string, target M.Socksaddr) (adapter.InboundContext, adapter.Outbound, *sourcepool.Lease, error) {
+	return s.borrowAccessDiagnostic(ctx, expected, "", P.RouteChoice{}, target, true)
+}
+func (s *Selector) borrowAccessDiagnostic(ctx context.Context, expected, policyID string, choice P.RouteChoice, target M.Socksaddr, currentTarget bool) (metadata adapter.InboundContext, actual adapter.Outbound, lease *sourcepool.Lease, result error) {
+	var tag string
+	result = func() error {
+		s.accessFence.RLock()
+		defer s.accessFence.RUnlock()
+		current := s.selected.Load()
+		authorization := s.access.Load()
+		if current == nil || current.access == nil || authorization == nil || expected == "" || current.access.Revision != expected {
+			return ErrSelectionChanged
+		}
+		value := current.access
+		if currentTarget {
+			id := value.Name
+			key, err := P.ConnectionTargetKey("tcp", target.AddrString(), target.Port)
+			if err == nil && value.Targets[key] != "" {
+				id = value.Targets[key]
+			}
+			var ok bool
+			choice, ok = value.Choices[id]
+			if !ok {
+				return execution.ErrDenied
+			}
+			policyID = value.PolicyID
+		} else if s.Tag() != "access" || authorization.options.Kind != "internet" || value.Name == "reject" || value.PolicyID != policyID {
+			return execution.ErrDenied
+		}
+		var err error
+		tag, err = s.accessConnectionTag(policyID, choice, target, nil, expected)
+		return err
+	}()
+	if result != nil {
+		return
+	}
+	pool := service.FromContext[*sourcepool.Pool](s.ctx)
+	if pool != nil {
+		lease, result = pool.Acquire(ctx, tag)
+		if result != nil {
+			return
+		}
+	}
+	use := func(value adapter.InboundContext, selected adapter.Outbound) error {
+		metadata, actual = value, selected
+		return nil
+	}
+	if currentTarget {
+		result = s.WithAccessSelectedTarget(expected, target, use)
+	} else {
+		result = s.WithAccessTCPChoice(expected, policyID, choice, target, use)
+	}
+	if result == nil && lease != nil && !sourcepool.SameObject(actual, lease.Outbound()) {
+		result = sourcepool.ErrConflict
+	}
+	if result != nil && lease != nil {
+		lease.Release()
+		lease = nil
+	}
+	if result == nil && actual == nil {
+		result = errors.Join(sourcepool.ErrResourcePending, execution.ErrUnknown)
+	}
+	return
+}
