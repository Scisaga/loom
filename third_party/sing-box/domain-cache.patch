+package wireguard
+
+import (
+	"net"
+	"sync"
+	"sync/atomic"
+
+	"github.com/sagernet/wireguard-go/conn"
+)
+
+// Whole-endpoint shutdown interrupts socket I/O before joining peer workers.
+// Ordinary peer retirement never closes this shared bind.
+type lifetimeBind struct {
+	conn.Bind
+	closeMu sync.Mutex
+	stopped atomic.Bool
+}
+
+func (b *lifetimeBind) Open(port uint16) ([]conn.ReceiveFunc, uint16, error) {
+	b.closeMu.Lock()
+	defer b.closeMu.Unlock()
+	if b.stopped.Load() {
+		return nil, 0, net.ErrClosed
+	}
+	return b.Bind.Open(port)
+}
+func (b *lifetimeBind) Close() error {
+	b.closeMu.Lock()
+	defer b.closeMu.Unlock()
+	return b.Bind.Close()
+}
+func (b *lifetimeBind) Send(packets [][]byte, endpoint conn.Endpoint) error {
+	if b.stopped.Load() {
+		return net.ErrClosed
+	}
+	return b.Bind.Send(packets, endpoint)
+}
+func (b *lifetimeBind) Stop() error { b.stopped.Store(true); return b.Close() }
