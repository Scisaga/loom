+func TestPeerDeltaPreservesLearntEndpointAndChangesOnlyAffectedFields(t *testing.T) {
+	before := peerConfig{publicKeyHex: strings.Repeat("1", 64), endpoint: netip.MustParseAddrPort("192.0.2.10:51820"), allowedIPs: []netip.Prefix{netip.MustParsePrefix("fdab::1/128")}, keepalive: 25}
+	after := before
+	after.allowedIPs = append([]netip.Prefix{}, before.allowedIPs...)
+	after.allowedIPs = append(after.allowedIPs, netip.MustParsePrefix("fdab::2/128"))
+	ipc, err := peerDelta([]peerConfig{before}, []peerConfig{after})
+	if err != nil || strings.Contains(ipc, "endpoint=") || strings.Contains(ipc, "keepalive") || !strings.Contains(ipc, "allowed_ip=fdab::2/128") {
+		t.Fatal("permission update reset unrelated peer state", err)
+	}
+	after.endpoint = netip.MustParseAddrPort("192.0.2.11:51820")
+	after.keepalive = 0
+	ipc, err = peerDelta([]peerConfig{before}, []peerConfig{after})
+	if err != nil || !strings.Contains(ipc, "endpoint=192.0.2.11:51820\n") || !strings.Contains(ipc, "persistent_keepalive_interval=0\n") || strings.Contains(ipc, "private_key=") || strings.Contains(ipc, "replace_peers=") {
+		t.Fatal("transport change replaced the device or omitted changed fields", err)
+	}
+	ipc, err = peerDelta([]peerConfig{before}, nil)
+	if err != nil || ipc != "public_key="+before.publicKeyHex+"\nremove=true\n" {
+		t.Fatal("outgoing peer removal required a device replacement", err)
+	}
+	before.preSharedKeyHex = strings.Repeat("2", 64)
+	after = before
+	after.preSharedKeyHex = ""
+	ipc, err = peerDelta([]peerConfig{before}, []peerConfig{after})
+	if err != nil || !strings.Contains(ipc, "preshared_key="+strings.Repeat("0", 64)+"\n") || strings.Contains(ipc, "endpoint=") {
+		t.Fatal("explicit secret removal did not clear only that peer secret", err)
+	}
+}
+
+func TestPeerDNSUpdateKeepsUnchangedWorkAndCancelsObsoleteFlightIdentity(t *testing.T) {
+	peer := peerConfig{publicKeyHex: "demo-peer", destination: M.ParseSocksaddr("a.example:443")}
+	other := peerConfig{publicKeyHex: "demo-other", destination: M.ParseSocksaddr("other.example:443")}
+	oldContext, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	old := &peerDNSFlight{cancel: cancel}
+	until := time.Unix(100, 0)
+	e := &Endpoint{peerDNSCache: map[string]peerDNSResult{peer.publicKeyHex: {until: until}, other.publicKeyHex: {until: until}}, peerDNSFlights: map[string]*peerDNSFlight{peer.publicKeyHex: old}}
+	next := peer
+	next.destination = M.ParseSocksaddr("b.example:443")
+	e.syncPeerDNS([]peerConfig{peer, other}, []peerConfig{next, other})
+	if oldContext.Err() != context.Canceled || e.peerDNSFlights[peer.publicKeyHex] != nil || !e.peerDNSCache[other.publicKeyHex].until.Equal(until) {
+		t.Fatal("changed peer left old DNS active or discarded unrelated evidence")
+	}
+	newContext, newCancel := context.WithCancel(context.Background())
+	defer newCancel()
+	current := &peerDNSFlight{cancel: newCancel}
+	e.peerDNSFlights[peer.publicKeyHex] = current
+	e.syncPeerDNS([]peerConfig{next, other}, []peerConfig{next, other})
+	if newContext.Err() != nil || e.peerDNSFlights[peer.publicKeyHex] != current {
+		t.Fatal("unrelated update cancelled current DNS")
+	}
+	// Even when A becomes current again, the old A flight must not become current.
+	e.syncPeerDNS([]peerConfig{next, other}, []peerConfig{peer, other})
+	if newContext.Err() != context.Canceled || e.peerDNSFlights[peer.publicKeyHex] == old {
+		t.Fatal("A -> B -> A restored an obsolete flight")
+	}
+}
