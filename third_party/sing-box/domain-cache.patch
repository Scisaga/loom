+// A packet-shaped in-memory pipe suffices for tracker lifetime and metadata;
+// the test creates no UDP socket, listener, TUN or external request.
+type metadataPacketPipe struct{ net.Conn }
+
+func (p *metadataPacketPipe) ReadFrom(body []byte) (int, net.Addr, error) {
+	n, err := p.Read(body)
+	return n, &net.UDPAddr{IP: net.IPv4(192, 0, 2, 10), Port: 443}, err
+}
+func (p *metadataPacketPipe) WriteTo(body []byte, _ net.Addr) (int, error) { return p.Write(body) }
+
+func TestSourceServiceMetadataComesFromAuthorizedPolicyAndStaysPerConnection(t *testing.T) {
+	f, selector, a, b := sourceLeaseFixturePolicies(t, "echo", true)
+	manager := trafficontrol.NewManager()
+	choose := func(value group.AccessSnapshot) {
+		t.Helper()
+		if _, err := selector.CompareAndSelectAccess(context.Background(), value, selector.AccessSnapshot()); err != nil {
+			t.Fatal(err)
+		}
+	}
+	type tracked struct {
+		tracker  trafficontrol.Tracker
+		metadata *adapter.InboundContext
+		remote   net.Conn
+	}
+	pinAndTrack := func(network, expected string) tracked {
+		t.Helper()
+		metadata := &adapter.InboundContext{Inbound: "tun-in", InboundType: "tun", Network: network, Destination: M.ParseSocksaddr("demo.example:443"), ExecutionServiceID: "demo-forged-service"}
+		ctx, cleanup, err := adapter.PinOutboundPath(context.Background(), f.manager, selector, metadata)
+		defer cleanup()
+		if err != nil {
+			t.Fatal(err)
+		}
+		if metadata.Execution == nil || metadata.ExecutionServiceID != expected || metadata.ExecutionSourceScope != "access" {
+			t.Fatal("source did not derive Service from its validated Policy")
+		}
+		lease := sourcepool.TakeCallBorrow(ctx, metadata.SelectedOutbounds["access"])
+		if lease == nil {
+			t.Fatal("formal pin did not retain its actual sender")
+		}
+		defer lease.Release()
+		local, remote := net.Pipe()
+		var tracker trafficontrol.Tracker
+		release, principal, target, err := execution.TrackFence(ctx)
+		if err != nil {
+			local.Close()
+			remote.Close()
+			t.Fatal(err)
+		}
+		metadata.ExecutionPrincipal, metadata.ExecutionTarget = principal, target
+		if network == "tcp" {
+			bound, err := lease.BindConn(local)
+			if err != nil {
+				release()
+				remote.Close()
+				t.Fatal(err)
+			}
+			tracker = trafficontrol.NewTCPTracker(bound, manager, *metadata, f.manager, nil, selector)
+		} else {
+			bound, err := lease.BindPacketConn(&metadataPacketPipe{local})
+			if err != nil {
+				release()
+				remote.Close()
+				t.Fatal(err)
+			}
+			tracker = trafficontrol.NewUDPTracker(bufio.NewPacketConn(bound), manager, *metadata, f.manager, nil, selector)
+		}
+		release()
+		t.Cleanup(func() { tracker.Close(); remote.Close() })
+		return tracked{tracker, metadata, remote}
+	}
+	assertService := func(value tracked, expected string) {
+		t.Helper()
+		body, err := json.Marshal(value.tracker.Metadata())
+		if err != nil {
+			t.Fatal(err)
+		}
+		var view struct {
+			Metadata map[string]any `json:"metadata"`
+		}
+		if json.Unmarshal(body, &view) != nil || view.Metadata["serviceID"] != expected {
+			t.Fatal("tracker did not keep its connection's authorized Service")
+		}
+		original, err := json.Marshal(value.metadata)
+		if err != nil {
+			t.Fatal(err)
+		}
+		var generic map[string]any
+		if json.Unmarshal(original, &generic) != nil {
+			t.Fatal("metadata JSON invalid")
+		}
+		if _, exists := generic["ExecutionServiceID"]; exists {
+			t.Fatal("local Service field escaped generic metadata encoding")
+		}
+	}
+	choose(a)
+	oldTCP, oldUDP := pinAndTrack("tcp", "demo-service"), pinAndTrack("udp", "demo-service")
+	choose(b)
+	freshTCP, freshUDP := pinAndTrack("tcp", "demo-service-b"), pinAndTrack("udp", "demo-service-b")
+	oldTCP.metadata.ExecutionServiceID, oldUDP.metadata.ExecutionServiceID = "demo-caller-overwrite", "demo-caller-overwrite"
+	assertService(oldTCP, "demo-service")
+	assertService(oldUDP, "demo-service")
+	assertService(freshTCP, "demo-service-b")
+	assertService(freshUDP, "demo-service-b")
+	// Metadata is copied into each real tracker, and the old TCP lease remains
+	// usable after selecting another Policy/Service.
+	oldConn := oldTCP.tracker.(*trafficontrol.TCPConn)
+	_ = oldConn.SetDeadline(time.Now().Add(time.Second))
+	sent := make(chan error, 1)
+	go func() { _, err := oldTCP.remote.Write([]byte("demo")); sent <- err }()
+	body := make([]byte, 4)
+	if _, err := oldConn.Read(body); err != nil || string(body) != "demo" {
+		t.Fatal("Service switch damaged legal old TCP", err)
+	}
+	if err := <-sent; err != nil {
+		t.Fatal(err)
+	}
+}
