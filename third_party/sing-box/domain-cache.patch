+package wireguard
+
+import (
+	"slices"
+	"strings"
+)
+
+// An IpcSet error can follow earlier accepted lines. These disposable keys only
+// identify the touched physical objects; all values come from the caller's
+// latest legal typed projection, never the failed historical request.
+func runtimeRepairIPC(next []peerConfig, touched map[string]bool, cleanup bool) string {
+	var body strings.Builder
+	wanted := map[string]bool{}
+	for _, peer := range next {
+		wanted[peer.publicKeyHex] = true
+	}
+	if cleanup {
+		keys := []string{}
+		for key := range touched {
+			if !wanted[key] {
+				keys = append(keys, key)
+			}
+		}
+		slices.Sort(keys)
+		for _, key := range keys {
+			body.WriteString("public_key=" + key + "\nremove=true\n")
+		}
+	}
+	for _, peer := range next {
+		body.WriteString("public_key=" + peer.publicKeyHex + "\n")
+		key := peer.preSharedKeyHex
+		if key == "" {
+			key = strings.Repeat("0", 64)
+		}
+		body.WriteString("preshared_key=" + key + "\nreplace_allowed_ips=true\n")
+		for _, prefix := range peer.allowedIPs {
+			body.WriteString("allowed_ip=" + prefix.String() + "\n")
+		}
+		if peer.endpoint.IsValid() {
+			body.WriteString("endpoint=" + peer.endpoint.String() + "\n")
+		}
+	}
+	return body.String()
+}
+func (e *Endpoint) RuntimePeersNeedRepair() bool { return e.runtimeDirty.Load() != nil }
