@@ -0,0 +1,70 @@
+//go:build linux
+
+package dialer
+
+import (
+	"errors"
+	"io"
+	"os"
+	"runtime"
+
+	"golang.org/x/sys/unix"
+)
+
+// Only socket creation enters the pinned underlay; TUN, rules and route workers
+// remain in the isolated process namespace. Numeric dials cannot spawn a DNS
+// resolver or a dual-stack race outside this locked thread.
+func inNamespace[T io.Closer](path string, operation func() (T, error)) (T, error) {
+	if path == "" {
+		return operation()
+	}
+	type result struct {
+		value T
+		err   error
+	}
+	done := make(chan result, 1)
+	go func() {
+		runtime.LockOSThread()
+		restored := true
+		defer func() {
+			if restored {
+				runtime.UnlockOSThread()
+			}
+		}()
+		var zero T
+		original, err := os.Open("/proc/thread-self/ns/net")
+		if err != nil {
+			done <- result{zero, err}
+			return
+		}
+		defer original.Close()
+		target, err := os.Open(path)
+		if err != nil {
+			done <- result{zero, err}
+			return
+		}
+		defer target.Close()
+		if err = unix.Setns(int(target.Fd()), unix.CLONE_NEWNET); err != nil {
+			done <- result{zero, err}
+			return
+		}
+		restored = false
+		defer func() {
+			if !restored {
+				restored = unix.Setns(int(original.Fd()), unix.CLONE_NEWNET) == nil
+			}
+		}()
+		value, callErr := operation()
+		restoreErr := unix.Setns(int(original.Fd()), unix.CLONE_NEWNET)
+		restored = restoreErr == nil
+		if restoreErr != nil {
+			if callErr == nil {
+				_ = value.Close()
+			}
+			value = zero
+		}
+		done <- result{value, errors.Join(callErr, restoreErr)}
+	}()
+	resultValue := <-done
+	return resultValue.value, resultValue.err
+}
