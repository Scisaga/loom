+package dialer
+
+import (
+	"context"
+	"net"
+	"net/netip"
+	"reflect"
+	"time"
+
+	"github.com/sagernet/sing-box/adapter"
+	C "github.com/sagernet/sing-box/constant"
+	"github.com/sagernet/sing-box/option"
+	E "github.com/sagernet/sing/common/exceptions"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+	"github.com/sagernet/sing/service"
+)
+
+type wireGuardSourceDialer struct {
+	upstream *DetourDialer
+	source   netip.Addr
+}
+
+func newWireGuardSourceDialer(ctx context.Context, options option.DialerOptions) (ParallelInterfaceDialer, error) {
+	if options.Inet6BindAddress == nil {
+		return nil, E.New("direct WireGuard dial requires an explicit IPv6 source")
+	}
+	source := options.Inet6BindAddress.Build(netip.Addr{})
+	if !source.Is6() || source.Is4In6() || source.Zone() != "" || !source.IsGlobalUnicast() {
+		return nil, E.New("direct WireGuard source must be a unicast IPv6 address")
+	}
+	rest := options
+	rest.Detour, rest.Inet6BindAddress, rest.UDPFragmentDefault = "", nil, false
+	if !reflect.DeepEqual(rest, option.DialerOptions{}) {
+		return nil, E.New("direct WireGuard source cannot bind or reconfigure host sockets")
+	}
+	manager := service.FromContext[adapter.OutboundManager](ctx)
+	if manager == nil {
+		return nil, E.New("missing outbound manager")
+	}
+	return &wireGuardSourceDialer{upstream: &DetourDialer{outboundManager: manager, detour: options.Detour}, source: source}, nil
+}
+
+func (d *wireGuardSourceDialer) bound(ctx context.Context) (context.Context, N.Dialer, error) {
+	upstream, err := d.upstream.Dialer()
+	if err != nil {
+		return ctx, nil, err
+	}
+	binder, ok := upstream.(adapter.WireGuardSourceBinder)
+	if !ok {
+		return ctx, nil, E.New("direct bound dial requires a native WireGuard endpoint")
+	}
+	ctx, err = binder.BindWireGuardSource(ctx, d.source)
+	return ctx, upstream, err
+}
+
+func (d *wireGuardSourceDialer) DialContext(ctx context.Context, network string, destination M.Socksaddr) (net.Conn, error) {
+	ctx, upstream, err := d.bound(ctx)
+	if err != nil {
+		return nil, err
+	}
+	return upstream.DialContext(ctx, network, destination)
+}
+
+func (d *wireGuardSourceDialer) ListenPacket(ctx context.Context, destination M.Socksaddr) (net.PacketConn, error) {
+	ctx, upstream, err := d.bound(ctx)
+	if err != nil {
+		return nil, err
+	}
+	return upstream.ListenPacket(ctx, destination)
+}
+
+func (d *wireGuardSourceDialer) DialParallelInterface(ctx context.Context, network string, destination M.Socksaddr, strategy *C.NetworkStrategy, interfaces, fallback []C.InterfaceType, delay time.Duration) (net.Conn, error) {
+	if strategy != nil || len(interfaces) != 0 || len(fallback) != 0 {
+		return nil, E.New("WireGuard source cannot select a host interface")
+	}
+	return d.DialContext(ctx, network, destination)
+}
+
+func (d *wireGuardSourceDialer) ListenSerialInterfacePacket(ctx context.Context, destination M.Socksaddr, strategy *C.NetworkStrategy, interfaces, fallback []C.InterfaceType, delay time.Duration) (net.PacketConn, error) {
+	if strategy != nil || len(interfaces) != 0 || len(fallback) != 0 {
+		return nil, E.New("WireGuard source cannot select a host interface")
+	}
+	return d.ListenPacket(ctx, destination)
+}
