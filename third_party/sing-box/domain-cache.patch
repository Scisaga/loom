+package wireguard
+
+import (
+	"errors"
+	"net/netip"
+
+	"github.com/sagernet/sing-box/common/sourcepool"
+	"github.com/sagernet/sing-box/option"
+)
+
+func runtimeInitializerIdentity(value option.WireGuardEndpointOptions, addresses []netip.Prefix) (string, error) {
+	value.System = false
+	value.Name = ""
+	value.ListenPort = 0
+	value.Execution = nil
+	value.ExecutionAddress = netip.Addr{}
+	value.HostSources = nil
+	value.StackAddress = nil
+	value.Peers = nil
+	value.SourceRoutes = nil
+	value.Address = append([]netip.Prefix(nil), addresses...)
+	return sourcepool.ConfigHash("wireguard", "wg-shared", value)
+}
+
+// ValidateRuntimeWireGuardInitializer compares a disposable sender template to
+// this actual endpoint's stable identity and stack anchors. It never returns
+// private material and cannot alter listening or receiving geometry.
+func (w *Endpoint) ValidateRuntimeWireGuardInitializer(value option.WireGuardEndpointOptions) error {
+	if value.System || value.Name != "" || value.ListenPort != 0 || value.Execution != nil || value.ExecutionAddress.IsValid() || len(value.HostSources) != 0 || len(value.StackAddress) != 0 || value.Detour != "" || len(value.Peers) != 0 || len(value.SourceRoutes) != 0 {
+		return errors.New("WG initializer is not a pure sender template")
+	}
+	if len(value.Address) != 2 || value.Address[0] != netip.MustParsePrefix("127.0.0.1/32") || value.Address[1] != netip.MustParsePrefix("::1/128") {
+		return errors.New("WG initializer stack anchors differ")
+	}
+	identity, err := runtimeInitializerIdentity(value, value.Address)
+	if err != nil || identity != w.initializerIdentity {
+		return errors.New("WG initializer identity differs from actual endpoint")
+	}
+	return nil
+}
