+//go:build linux && !android
+
+package device
+
+import "sync"
+
+const (
+	boundedMessageBuffers = true
+	// Reserve a replacement before a receive/TUN scratch packet enters a queue.
+	// The global budget covers all peers; failed admission never blocks a batch.
+	maxLiveMessageBuffers = 256
+	maxIdleMessageBuffers = 32
+)
+
+type linuxMessageBufferPool struct {
+	mu      sync.Mutex
+	inuse   uint32
+	scratch uint32
+	idle    []*[MaxMessageSize]byte
+}
+
+func newMessageBufferPool() messageBufferPool {
+	return &linuxMessageBufferPool{idle: make([]*[MaxMessageSize]byte, 0, maxIdleMessageBuffers)}
+}
+
+func (p *linuxMessageBufferPool) Get() any {
+	p.mu.Lock()
+	if p.inuse-p.scratch >= maxLiveMessageBuffers {
+		p.mu.Unlock()
+		return nil
+	}
+	p.inuse++
+	return p.takeLocked()
+}
+
+func (p *linuxMessageBufferPool) GetScratch() any {
+	p.mu.Lock()
+	p.scratch++
+	p.inuse++
+	return p.takeLocked()
+}
+
+func (p *linuxMessageBufferPool) takeLocked() any {
+	if n := len(p.idle); n > 0 {
+		buffer := p.idle[n-1]
+		p.idle[n-1] = nil
+		p.idle = p.idle[:n-1]
+		p.mu.Unlock()
+		return buffer
+	}
+	p.mu.Unlock()
+	return new([MaxMessageSize]byte)
+}
+
+func (p *linuxMessageBufferPool) Put(value any) {
+	p.mu.Lock()
+	p.putLocked(value)
+}
+
+func (p *linuxMessageBufferPool) PutScratch(value any) {
+	p.mu.Lock()
+	p.scratch--
+	p.putLocked(value)
+}
+
+func (p *linuxMessageBufferPool) putLocked(value any) {
+	p.inuse--
+	// Keep a small warm set rather than the entire previous traffic peak.
+	if len(p.idle) < maxIdleMessageBuffers {
+		p.idle = append(p.idle, value.(*[MaxMessageSize]byte))
+	}
+	p.mu.Unlock()
+}
