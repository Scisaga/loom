+package device
+
+// BoundPort reports the current shared UDP port, rather than the last requested
+// port. BindUpdate clears it on open failure; an inactive device is not bound.
+func (device *Device) BoundPort() uint16 {
+	device.net.Lock()
+	defer device.net.Unlock()
+	if !device.isUp() {
+		return 0
+	}
+	return device.net.port
