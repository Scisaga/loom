+package wireguard
+
+import (
+	"bytes"
+	"context"
+	"crypto/rand"
+	"errors"
+	"fmt"
+	"io"
+	"net"
+	"net/netip"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/common/execution"
+	P "github.com/sagernet/sing-box/common/loomprotocol"
+	E "github.com/sagernet/sing/common/exceptions"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+)
+
+var executionPreface = []byte(P.WireGuardPreface)
+
+func (w *Endpoint) isExecution(destination M.Socksaddr) bool {
+	return w.execution != nil && destination.Addr == w.executionAddress && destination.Port == 53 && !destination.IsFqdn()
+}
+func executionRequest(ctx context.Context, destination M.Socksaddr, operation P.Operation) (P.Request, []byte, error) {
+	connection, exists := P.ConnectionFrom(ctx)
+	if !exists {
+		return P.Request{}, nil, errors.New("WG business requires its native connection context")
+	}
+	host := destination.Fqdn
+	if host == "" {
+		host = destination.Addr.String()
+	} else {
+		host = strings.ToLower(strings.TrimSuffix(host, "."))
+	}
+	request := P.Request{Operation: operation, PolicyID: connection.PolicyID, Context: &connection.Path, Host: host, Port: destination.Port}
+	if _, err := rand.Read(request.Nonce[:]); err != nil {
+		return P.Request{}, nil, err
+	}
+	body, err := request.Marshal(len(request.Context.Visited) + 1)
+	return request, body, err
+}
+func writeExecution(conn net.Conn, body []byte) error {
+	if _, err := io.Copy(conn, bytes.NewReader(executionPreface)); err != nil {
+		return err
+	}
+	return P.WriteFrame(conn, body)
+}
+func (w *Endpoint) dialExecutionTCP(ctx context.Context, destination M.Socksaddr) (net.Conn, error) {
+	ctx, cancel := context.WithTimeout(ctx, 8*time.Second)
+	defer cancel()
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	source := adapter.WireGuardSource(ctx)
+	binding, exists := w.sourceBinding(source)
+	prefix, address := binding.destination, binding.execution
+	if !exists || !address.IsValid() {
+		return nil, errors.New("WG source has no execution binding")
+	}
+	endpoint := M.SocksaddrFrom(address, 53)
+	if destination == endpoint {
+		return w.endpoint.DialContext(ctx, N.NetworkTCP, destination)
+	}
+	if prefix.Bits() != 64 {
+		return nil, errors.New("WG transport identity cannot request business forwarding")
+	}
+	request, body, err := executionRequest(ctx, destination, P.ConnectTCP)
+	if err != nil {
+		return nil, err
+	}
+	conn, err := w.endpoint.DialContext(ctx, N.NetworkTCP, endpoint)
+	if err != nil {
+		return nil, err
+	}
+	started := time.Now()
+	w.logger.DebugContext(ctx, "WG stage=execution-confirm event=begin")
+	confirmed, err := confirmExecutionTCP(ctx, conn, request, body)
+	elapsed := time.Since(started)
+	w.logger.DebugContext(ctx, "WG stage=execution-confirm event=end elapsed=", elapsed, " canceled=", ctx.Err() != nil, " error_type=", fmt.Sprintf("%T", err))
+	if err != nil {
+		return nil, fmt.Errorf("WG stage=execution-confirm elapsed=%s: %w", elapsed, err)
+	}
+	return confirmed, nil
+}
+
+// Confirm the native response before exposing this stream to a preceding hop.
+// The caller's one deadline bounds request writes and response reads together.
+func confirmExecutionTCP(ctx context.Context, conn net.Conn, request P.Request, body []byte) (*executionClientConn, error) {
+	deadline := time.Now().Add(8 * time.Second)
+	if limit, ok := ctx.Deadline(); ok && limit.Before(deadline) {
+		deadline = limit
+	}
+	if err := conn.SetDeadline(deadline); err != nil {
+		conn.Close()
+		return nil, err
+	}
+	canceled := make(chan struct{})
+	stop := context.AfterFunc(ctx, func() {
+		conn.Close()
+		close(canceled)
+	})
+	client := &executionClientConn{Conn: conn, request: request}
+	err := writeExecution(conn, body)
+	if err == nil {
+		err = client.confirm()
+	}
+	if !stop() {
+		<-canceled
+	}
+	if ctx.Err() != nil {
+		err = ctx.Err()
+	}
+	if err != nil {
+		conn.Close()
+		return nil, err
+	}
+	if err := conn.SetDeadline(time.Time{}); err != nil {
+		conn.Close()
+		return nil, err
+	}
+	return client, nil
+}
+
+func (w *Endpoint) registerTarget(ctx context.Context, destination M.Socksaddr, prefix netip.Prefix, address netip.Addr) (M.Socksaddr, error) {
+	request, body, err := executionRequest(ctx, destination, P.ResolveTarget)
+	if err != nil {
+		return M.Socksaddr{}, err
+	}
+	conn, err := w.endpoint.DialContext(ctx, N.NetworkTCP, M.SocksaddrFrom(address, 53))
+	if err != nil {
+		return M.Socksaddr{}, err
+	}
+	defer conn.Close()
+	deadline := time.Now().Add(8 * time.Second)
+	if limit, ok := ctx.Deadline(); ok && limit.Before(deadline) {
+		deadline = limit
+	}
+	_ = conn.SetDeadline(deadline)
+	stop := context.AfterFunc(ctx, func() { conn.Close() })
+	defer stop()
+	if err = writeExecution(conn, body); err != nil {
+		return M.Socksaddr{}, err
+	}
+	response, err := P.ReadFrame(conn, 128)
+	if err != nil {
+		return M.Socksaddr{}, err
+	}
+	accepted, err := execution.CheckResponse(response, request)
+	if err != nil {
+		return M.Socksaddr{}, err
+	}
+	if !prefix.Contains(accepted.Address) {
+		return M.Socksaddr{}, errors.New("WG registration belongs to another execution peer")
+	}
+	return M.SocksaddrFrom(accepted.Address, destination.Port), nil
+}
+func (w *Endpoint) acceptExecution(ctx context.Context, conn net.Conn, source, destination M.Socksaddr, onClose N.CloseHandlerFunc) {
+	_ = conn.SetReadDeadline(time.Now().Add(8 * time.Second))
+	preface := make([]byte, len(executionPreface))
+	_, err := io.ReadFull(conn, preface)
+	if err == nil && !bytes.Equal(preface, executionPreface) {
+		err = errors.New("unsupported native WG execution schema")
+	}
+	if err == nil {
+		err = w.handleExecution(ctx, conn, source, onClose)
+	}
+	if err != nil {
+		conn.Close()
+		if onClose != nil {
+			onClose(err)
+		}
+	}
+}
+func (w *Endpoint) handleExecution(ctx context.Context, conn net.Conn, source M.Socksaddr, onClose N.CloseHandlerFunc) error {
+	body, err := P.ReadFrame(conn, w.execution.InputLimit())
+	if err != nil {
+		return err
+	}
+	request, err := P.UnmarshalRequest(body, w.execution.MaxNodes())
+	if err != nil {
+		return err
+	}
+	_ = conn.SetReadDeadline(time.Time{})
+	started := time.Now()
+	reply := func(status P.Status, address netip.Addr) error {
+		_ = conn.SetWriteDeadline(time.Now().Add(8 * time.Second))
+		response, err := (P.Response{Nonce: request.Nonce, Status: status, Address: address, ProcessingNanos: uint64(time.Since(started))}).Marshal()
+		if err != nil {
+			return err
+		}
+		if err = P.WriteFrame(conn, response); err != nil {
+			return err
+		}
+		err = conn.Close()
+		if onClose != nil {
+			onClose(err)
+		}
+		return err
+	}
+	key := source.Addr.String()
+	switch request.Operation {
+	case P.TransportEcho:
+		if err = w.execution.Echo(key, ""); err != nil {
+			return reply(P.Denied, netip.Addr{})
+		}
+		return reply(P.Accepted, netip.Addr{})
+	case P.AdmissionEcho:
+		if err = w.execution.Echo(key, request.PolicyID); err != nil {
+			return reply(P.Denied, netip.Addr{})
+		}
+		return reply(P.Accepted, netip.Addr{})
+	case P.ResolveTarget, P.ConnectTCP:
+		target := M.ParseSocksaddrHostPort(request.Host, request.Port)
+		admitted, outbound, err := w.execution.Admit(ctx, key, P.Connection{PolicyID: request.PolicyID, Path: *request.Context}, target)
+		if err != nil {
+			return reply(P.Denied, netip.Addr{})
+		}
+		if request.Operation == P.ConnectTCP {
+			wrapper := &executionServerConn{Conn: conn, nonce: request.Nonce, started: started}
+			w.router.RouteConnectionEx(admitted, wrapper, adapter.InboundContext{Inbound: w.Tag(), InboundType: w.Type(), Source: source, Destination: target, ExecutionOutbound: outbound}, onClose)
+			return nil
+		}
+		store := w.router.FakeIPStore()
+		if store == nil {
+			return reply(P.Unavailable, netip.Addr{})
+		}
+		connection, _ := P.ConnectionFrom(admitted)
+		registration, err := (P.TargetRegistration{Principal: key, Connection: connection, Host: request.Host, Port: request.Port}).Marshal(w.execution.MaxNodes())
+		if err != nil {
+			return err
+		}
+		address, err := store.Create(registration, true)
+		if err != nil {
+			return reply(P.Unavailable, netip.Addr{})
+		}
+		return reply(P.Accepted, address)
+	default:
+		return reply(P.Denied, netip.Addr{})
+	}
+}
+func (w *Endpoint) restoreExecution(ctx context.Context, source, destination M.Socksaddr) (context.Context, string, M.Socksaddr, error) {
+	store := w.router.FakeIPStore()
+	if store == nil || !store.Contains(destination.Addr) {
+		if w.execution != nil && !w.isExecution(destination) {
+			return nil, "", M.Socksaddr{}, errors.New("WG business requires its native execution context")
+		}
+		return ctx, "", destination, nil
+	}
+	if w.execution == nil {
+		return nil, "", M.Socksaddr{}, errors.New("synthetic WG target has no current execution projection")
+	}
+	key, found := store.Lookup(destination.Addr)
+	if !found {
+		return nil, "", M.Socksaddr{}, errors.New("WG execution registration is missing")
+	}
+	registration, err := P.UnmarshalRegistration(key, w.execution.MaxNodes())
+	if err != nil {
+		return nil, "", M.Socksaddr{}, err
+	}
+	if registration.Principal != source.Addr.String() || registration.Port != destination.Port {
+		return nil, "", M.Socksaddr{}, errors.New("WG registration belongs to another sender or target port")
+	}
+	target := M.ParseSocksaddrHostPort(registration.Host, registration.Port)
+	restored, outbound, err := w.execution.Restore(ctx, registration.Principal, registration.Connection, target)
+	return restored, outbound, target, err
+}
+
+type executionClientConn struct {
+	net.Conn
+	request   P.Request
+	readOnce  sync.Once
+	readError error
+}
+
+func (c *executionClientConn) confirm() error {
+	c.readOnce.Do(func() {
+		response, err := P.ReadFrame(c.Conn, 128)
+		if err == nil {
+			_, err = execution.CheckResponse(response, c.request)
+		} else {
+			err = errors.Join(execution.ErrUnknown, err)
+		}
+		c.readError = err
+	})
+	return c.readError
+}
+func (c *executionClientConn) Read(body []byte) (int, error) {
+	if err := c.confirm(); err != nil {
+		return 0, err
+	}
+	return c.Conn.Read(body)
+}
+
+// The execution request is already written before this wrapper is returned.
+// Keep the response reader in place: exposing Upstream could bypass its frame.
+func (c *executionClientConn) CloseWrite() error { return N.CloseWrite(c.Conn) }
+func (c *executionClientConn) CloseRead() error  { return N.CloseRead(c.Conn) }
+
+type executionServerConn struct {
+	net.Conn
+	nonce      [16]byte
+	started    time.Time
+	writeOnce  sync.Once
+	writeError error
+}
+
+func (c *executionServerConn) respond(status P.Status) error {
+	c.writeOnce.Do(func() {
+		body, err := (P.Response{Nonce: c.nonce, Status: status, ProcessingNanos: uint64(time.Since(c.started))}).Marshal()
+		if err == nil {
+			err = P.WriteFrame(c.Conn, body)
+		}
+		c.writeError = err
+	})
+	return c.writeError
+}
+func (c *executionServerConn) HandshakeSuccess() error { return c.respond(P.Accepted) }
+func (c *executionServerConn) HandshakeFailure(cause error) error {
+	if errors.Is(cause, execution.ErrDenied) {
+		return c.respond(P.Denied)
+	}
+	if errors.Is(cause, execution.ErrUnknown) || E.IsClosed(cause) || E.IsCanceled(cause) {
+		c.writeOnce.Do(func() {
+			c.writeError = cause
+			c.Conn.Close()
+		})
+		return nil
+	}
+	return c.respond(P.Unavailable)
+}
+func (c *executionServerConn) Write(body []byte) (int, error) {
+	if err := c.HandshakeSuccess(); err != nil {
+		return 0, err
+	}
+	return c.Conn.Write(body)
+}
+
+func (c *executionServerConn) CloseWrite() error {
+	if err := c.HandshakeSuccess(); err != nil {
+		return err
+	}
+	return N.CloseWrite(c.Conn)
+}
+func (c *executionServerConn) CloseRead() error { return N.CloseRead(c.Conn) }
