+package wireguard
+
+import (
+	"context"
+	"errors"
+	"net/netip"
+
+	"github.com/sagernet/sing-box/common/execution"
+	"github.com/sagernet/sing-box/common/sourcepool"
+	"github.com/sagernet/sing-box/option"
+	W "github.com/sagernet/sing-box/transport/wireguard"
+	M "github.com/sagernet/sing/common/metadata"
+)
+
+// PrepareRuntimeWireGuard prepares only physical sender admission. The resource
+// pool checks its instance, desired workset and permission revisions before
+// calling apply; this operation never replaces receiving permission or ports.
+func (w *Endpoint) PrepareRuntimeWireGuardStage(ctx context.Context, peers []option.WireGuardPeer, routes []option.WireGuardSourceRoute, retained []option.WireGuardPeer, retainedRoutes []option.WireGuardSourceRoute) (func(string, bool) error, func(map[string]uint16, func() error) error, error) {
+	previous := w.sourceRoutes.Load()
+	peers, err := retainedWireGuardPeers(previous, peers, retained, retainedRoutes)
+	if err != nil {
+		return nil, nil, err
+	}
+	base, err := w.makeReceivingProjection(peers, routes, "")
+	if err != nil {
+		return nil, nil, err
+	}
+	var applied *sourceRouteSnapshot
+	apply := func(expected string, acceptBase bool) error {
+		if !w.updateMu.TryLock() {
+			return errors.Join(sourcepool.ErrConflict, execution.ErrSuperseded)
+		}
+		defer w.updateMu.Unlock()
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+		if w.sourceRoutes.Load() != previous || w.execution != nil && w.execution.State().Revision != expected {
+			return errors.Join(sourcepool.ErrConflict, execution.ErrSuperseded)
+		}
+		if acceptBase {
+			if err := w.acceptReceivingProjection(base, expected); err != nil {
+				return err
+			}
+		}
+		allRoutes, err := mergeWGRoutes(previous, routes)
+		if err != nil {
+			return err
+		}
+		send, err := mergeWGPeers(sendingWGPeers(previous), sendingWGPeers(&sourceRouteSnapshot{peers: peers, routes: routes}))
+		if err != nil {
+			return err
+		}
+		wanted, err := mergeWGPeers(w.receivingPeersNow(), send)
+		if err != nil {
+			return err
+		}
+		next, physical, err := w.prepareWireGuardSources(wanted, allRoutes)
+		if err != nil {
+			return err
+		}
+		if err = ctx.Err(); err != nil {
+			return err
+		}
+		if err = physical(); err != nil {
+			return err
+		}
+		refs, err := w.endpoint.CapturePeerReferences()
+		if err != nil {
+			return err
+		}
+		next.references = refs
+		w.sourceRoutes.Store(next)
+		applied = next
+		return nil
+	}
+	guard := func(intervals map[string]uint16, publish func() error) error {
+		if !w.updateMu.TryLock() {
+			return errors.Join(sourcepool.ErrConflict, execution.ErrSuperseded)
+		}
+		defer w.updateMu.Unlock()
+		if applied == nil || w.sourceRoutes.Load() != applied || applied.references == nil || !applied.references.Covers(intervals) {
+			return errors.Join(sourcepool.ErrConflict, execution.ErrSuperseded)
+		}
+		if err := publish(); err != nil {
+			return err
+		}
+		applied.references.Apply(intervals)
+		return nil
+	}
+	return apply, guard, nil
+}
+
+// retainedWireGuardPeers carries only bindings pinned by actual old flows.
+// Current requested peer options win; if the peer leaves the new workset, use
+// its latest applied options from this same immutable endpoint snapshot. Never
+// restore coordinates or grant prefixes from an entry's construction-time copy.
+func retainedWireGuardPeers(previous *sourceRouteSnapshot, wanted, retained []option.WireGuardPeer, retainedRoutes []option.WireGuardSourceRoute) ([]option.WireGuardPeer, error) {
+	for _, binding := range retainedRoutes {
+		found := false
+		if previous != nil {
+			for _, current := range previous.routes {
+				found = found || current == binding
+			}
+		}
+		if !found {
+			return nil, execution.ErrSuperseded
+		}
+	}
+	peers := make([]option.WireGuardPeer, len(wanted))
+	indices := make(map[string]int, len(wanted))
+	for index, peer := range wanted {
+		if _, exists := indices[peer.PublicKey]; exists {
+			return nil, errors.New("duplicate requested WG peer")
+		}
+		peer.AllowedIPs = append([]netip.Prefix(nil), peer.AllowedIPs...)
+		peer.Reserved = append([]uint8(nil), peer.Reserved...)
+		peers[index], indices[peer.PublicKey] = peer, index
+	}
+	current := make(map[string]option.WireGuardPeer)
+	if previous != nil {
+		for _, peer := range previous.peers {
+			current[peer.PublicKey] = peer
+		}
+	}
+	for _, binding := range retained {
+		actual, exists := current[binding.PublicKey]
+		if !exists || actual.PreSharedKey != binding.PreSharedKey {
+			return nil, execution.ErrSuperseded
+		}
+		index, requested := indices[binding.PublicKey]
+		if requested {
+			if peers[index].PreSharedKey != actual.PreSharedKey {
+				return nil, errors.New("leased WG peer authentication changed")
+			}
+		} else {
+			actual.AllowedIPs = nil
+			actual.PersistentKeepaliveInterval = 0
+			actual.Reserved = append([]uint8(nil), actual.Reserved...)
+			index = len(peers)
+			peers = append(peers, actual)
+			indices[binding.PublicKey] = index
+		}
+		if interval := binding.PersistentKeepaliveInterval; interval != 0 &&
+			(peers[index].PersistentKeepaliveInterval == 0 || interval < peers[index].PersistentKeepaliveInterval) {
+			peers[index].PersistentKeepaliveInterval = interval
+		}
+		for _, prefix := range binding.AllowedIPs {
+			owned := false
+			for _, currentPrefix := range current[binding.PublicKey].AllowedIPs {
+				owned = owned || currentPrefix == prefix
+			}
+			if !owned {
+				return nil, execution.ErrSuperseded
+			}
+			found := false
+			for _, currentPrefix := range peers[index].AllowedIPs {
+				found = found || currentPrefix == prefix
+			}
+			if !found {
+				peers[index].AllowedIPs = append(peers[index].AllowedIPs, prefix)
+			}
+		}
+	}
+	return peers, nil
+}
+
+// Sender worksets cannot add or remove receiving admission. Recover that base
+// only from this same current snapshot, excluding its exact sender bindings.
+func receivingWireGuardPeers(previous *sourceRouteSnapshot, wanted []option.WireGuardPeer, routes []option.WireGuardSourceRoute) ([]option.WireGuardPeer, error) {
+	senderPrefixes := wireGuardSourcePrefixes(routes)
+	base := map[string]option.WireGuardPeer{}
+	var current []option.WireGuardPeer
+	if previous != nil {
+		current = previous.peers
+		oldSenderPrefixes := wireGuardSourcePrefixes(previous.routes)
+		for _, peer := range current {
+			allowed := peer.AllowedIPs
+			peer.AllowedIPs = nil
+			for _, prefix := range allowed {
+				if !oldSenderPrefixes[prefix] {
+					peer.AllowedIPs = append(peer.AllowedIPs, prefix)
+				}
+			}
+			peer.PersistentKeepaliveInterval = 0
+			base[peer.PublicKey] = peer
+		}
+	}
+	peers := append([]option.WireGuardPeer(nil), wanted...)
+	indices := make(map[string]int, len(peers))
+	for i, peer := range peers {
+		indices[peer.PublicKey] = i
+		receiving, exists := base[peer.PublicKey]
+		if exists && len(receiving.AllowedIPs) != 0 && receiving.PreSharedKey != peer.PreSharedKey {
+			return nil, errors.New("sender workset changed receiving WG authentication")
+		}
+		for _, prefix := range peer.AllowedIPs {
+			allowed := senderPrefixes[prefix]
+			for _, source := range receiving.AllowedIPs {
+				allowed = allowed || source == prefix
+			}
+			if !allowed {
+				return nil, execution.ErrSuperseded
+			}
+		}
+		if peer.Address == "" && peer.Port == 0 {
+			for _, prior := range current {
+				if prior.PublicKey == peer.PublicKey {
+					peers[i].Address, peers[i].Port = prior.Address, prior.Port
+				}
+			}
+		}
+		peers[i].AllowedIPs = append([]netip.Prefix(nil), peer.AllowedIPs...)
+	}
+	for _, prior := range current {
+		receiving := base[prior.PublicKey]
+		if len(receiving.AllowedIPs) == 0 {
+			continue
+		}
+		if i, exists := indices[prior.PublicKey]; exists {
+			for _, prefix := range receiving.AllowedIPs {
+				found := false
+				for _, source := range peers[i].AllowedIPs {
+					found = found || source == prefix
+				}
+				if !found {
+					peers[i].AllowedIPs = append(peers[i].AllowedIPs, prefix)
+				}
+			}
+		} else {
+			peers = append(peers, receiving)
+		}
+	}
+	return peers, nil
+}
+
+func wireGuardSourcePrefixes(routes []option.WireGuardSourceRoute) map[netip.Prefix]bool {
+	prefixes := make(map[netip.Prefix]bool, len(routes)*2)
+	for _, route := range routes {
+		prefixes[route.Destination] = true
+		prefixes[netip.PrefixFrom(route.Execution, 128)] = true
+	}
+	return prefixes
+}
+
+func wireGuardPeerSends(peer option.WireGuardPeer, routes []option.WireGuardSourceRoute) bool {
+	for _, route := range routes {
+		for _, prefix := range peer.AllowedIPs {
+			if prefix == route.Destination {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+func (w *Endpoint) prepareWireGuardSources(peers []option.WireGuardPeer, routes []option.WireGuardSourceRoute) (*sourceRouteSnapshot, func() error, error) {
+	return w.prepareWireGuardPeerProjection(peers, routes, false)
+}
+func (w *Endpoint) prepareWireGuardCleanup(peers []option.WireGuardPeer, routes []option.WireGuardSourceRoute) (*sourceRouteSnapshot, func() error, error) {
+	return w.prepareWireGuardPeerProjection(peers, routes, true)
+}
+func (w *Endpoint) prepareWireGuardPeerProjection(peers []option.WireGuardPeer, routes []option.WireGuardSourceRoute, cleanup bool) (*sourceRouteSnapshot, func() error, error) {
+	peers = append([]option.WireGuardPeer(nil), peers...)
+	for i, peer := range peers {
+		if !wireGuardPeerSends(peer, routes) {
+			peers[i].PersistentKeepaliveInterval = 0
+		}
+	}
+	next, err := w.prepareSourceRoutes(routes, peers)
+	if err != nil {
+		return nil, nil, err
+	}
+	if w.endpoint == nil {
+		return nil, nil, errors.New("WG endpoint is not running")
+	}
+	transportPeers := make([]W.PeerOptions, 0, len(peers))
+	for _, p := range peers {
+		transportPeers = append(transportPeers, W.PeerOptions{Endpoint: M.ParseSocksaddrHostPort(p.Address, p.Port), PublicKey: p.PublicKey, PreSharedKey: p.PreSharedKey, AllowedIPs: append([]netip.Prefix{}, p.AllowedIPs...), PersistentKeepaliveInterval: p.PersistentKeepaliveInterval, Reserved: append([]uint8{}, p.Reserved...)})
+	}
+	var apply func() error
+	if cleanup {
+		apply, err = w.endpoint.PrepareRuntimePeerCleanup(transportPeers)
+	} else {
+		apply, err = w.endpoint.PrepareRuntimePeers(transportPeers)
+	}
+	return next, apply, err
+}
+
+func (w *Endpoint) RuntimeExecutionReceiver() *execution.Receiver { return w.execution }
+func (w *Endpoint) RuntimeExecutionState() execution.State {
+	if w.execution != nil {
+		return w.execution.State()
+	}
+	if state := w.transportState.Load(); state != nil {
+		return *state
+	}
+	return execution.State{}
+}
+func (w *Endpoint) UpdateRuntimeExecution(update option.ExecutionUpdate, hash string, invalidate func()) (execution.State, error) {
+	if update.ExpectedRevision == "" || update.Hysteria2Users != nil || (w.execution == nil) != (update.Execution == nil) ||
+		w.execution == nil && update.WireGuardListener != nil || update.WireGuardSourceRoutes != nil && update.WireGuardPeers == nil {
+		return execution.State{}, errors.New("incomplete WG receiving update")
+	}
+	var incoming *sourceRouteSnapshot
+	var incomingErr error
+	if update.WireGuardPeers != nil {
+		declared := []option.WireGuardSourceRoute{}
+		if update.WireGuardSourceRoutes != nil {
+			declared = *update.WireGuardSourceRoutes
+		} else if current := w.sourceRoutes.Load(); current != nil {
+			for _, route := range current.routes {
+				for _, peer := range *update.WireGuardPeers {
+					for _, prefix := range peer.AllowedIPs {
+						if prefix == route.Destination {
+							declared = append(declared, route)
+						}
+					}
+				}
+			}
+		}
+		incoming, incomingErr = w.makeReceivingProjection(*update.WireGuardPeers, declared, "")
+	}
+	var apply func() error
+	if update.WireGuardPeers != nil || update.WireGuardListener != nil {
+		apply = func() error {
+			if incomingErr != nil {
+				return incomingErr
+			}
+			// Receiver.Replace publishes accepted permissions before entering this
+			// preparation. A bad/unavailable new peer cannot retain an old grant.
+			var next *sourceRouteSnapshot
+			var applyPeers, move func() error
+			if update.WireGuardPeers != nil {
+				routes := []option.WireGuardSourceRoute{}
+				previous := w.sourceRoutes.Load()
+				if previous == nil {
+					previous = &sourceRouteSnapshot{}
+				}
+				if previous != nil {
+					routes = previous.routes
+				}
+				if update.WireGuardSourceRoutes != nil {
+					routes = *update.WireGuardSourceRoutes
+				}
+				send, err := mergeWGPeers(sendingWGPeers(&sourceRouteSnapshot{peers: previous.peers, routes: routes}), sendingWGPeers(&sourceRouteSnapshot{peers: *update.WireGuardPeers, routes: routes}))
+				if err != nil {
+					return err
+				}
+				peers, err := mergeWGPeers(w.receivingPeersNow(), send)
+				if err != nil {
+					return err
+				}
+				next, applyPeers, err = w.prepareWireGuardCleanup(peers, routes)
+				if err != nil {
+					return err
+				}
+			}
+
+			if update.WireGuardListener != nil {
+				var err error
+				move, err = w.endpoint.PrepareListener(update.WireGuardListener.Port)
+				if err != nil {
+					return err
+				}
+			}
+			if applyPeers != nil {
+				if err := applyPeers(); err != nil {
+					return err
+				}
+			}
+			if move != nil {
+				if err := move(); err != nil {
+					return err
+				}
+			}
+			if next != nil {
+				w.sourceRoutes.Store(next)
+			}
+			return nil
+		}
+	}
+	if w.execution != nil {
+		previousInvalidate := invalidate
+		invalidate = func() {
+			if incoming != nil && incomingErr == nil {
+				incomingErr = w.acceptReceivingProjection(incoming, w.execution.State().Revision)
+			}
+			if previousInvalidate != nil {
+				previousInvalidate()
+			}
+		}
+		var acceptedApply func(execution.State) error
+		if apply != nil {
+			acceptedApply = func(accepted execution.State) error {
+				if !w.updateMu.TryLock() {
+					return execution.ErrSuperseded
+				}
+				defer w.updateMu.Unlock()
+				if w.execution.State().Revision != accepted.Revision {
+					return execution.ErrSuperseded
+				}
+				return apply()
+			}
+		}
+		return w.execution.Replace(*update.Execution, update.ExpectedRevision, hash, acceptedApply, invalidate)
+	}
+	if !w.updateMu.TryLock() {
+		return w.RuntimeExecutionState(), execution.ErrSuperseded
+	}
+	defer w.updateMu.Unlock()
+	if current := w.RuntimeExecutionState(); current.Revision == "" || current.Revision != update.ExpectedRevision {
+		return execution.State{}, execution.ErrSuperseded
+	}
+	if apply == nil {
+		return execution.State{}, errors.New("empty WG transport update")
+	}
+	state, err := execution.NewState("")
+	if err != nil {
+		return execution.State{}, err
+	}
+	w.transportState.Store(&state)
+	if incoming != nil && incomingErr == nil {
+		incomingErr = w.acceptReceivingProjection(incoming, state.Revision)
+	}
+	if err := apply(); err != nil {
+		return state, err
+	}
+	confirmed := state
+	confirmed.ConfigHash = hash
+	w.transportState.Store(&confirmed)
+	return confirmed, nil
+}
