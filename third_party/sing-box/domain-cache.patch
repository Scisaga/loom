+		t.Fatal("unstarted transport blocked current source authorization", err)
+	}
+	if err := s.CheckAccessConnection(*metadata); err != nil {
+		t.Fatal("retiring a facility revoked an otherwise legal pinned connection", err)
+	}
+	if got := s.pinSelection(metadata); got != "reject" {
+		t.Fatal("pinned connection used stale static member", got)
+	}
