+package hysteria2
+
+import (
+	"context"
+	"errors"
+	"net"
+	"time"
+
+	"github.com/sagernet/sing-box/common/execution"
+	P "github.com/sagernet/sing-box/common/loomprotocol"
+	"github.com/sagernet/sing-quic/hysteria2"
+	"github.com/sagernet/sing/common/auth"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+)
+
+func (h *Inbound) handleExecution(ctx context.Context, conn net.Conn, source M.Socksaddr, acceptTCP func(context.Context, M.Socksaddr), registerUDP func(context.Context, uint32, M.Socksaddr) error) error {
+	if h.execution == nil {
+		return errors.New("Hy2 receiver has no execution projection")
+	}
+	user, ok := auth.UserFromContext[string](ctx)
+	if !ok {
+		return errors.New("Hy2 execution lacks its actual principal")
+	}
+	_ = conn.SetDeadline(time.Now().Add(8 * time.Second))
+	body, err := P.ReadFrame(conn, h.execution.InputLimit())
+	if err != nil {
+		return err
+	}
+	request, err := P.UnmarshalRequest(body, h.execution.MaxNodes())
+	if err != nil {
+		return err
+	}
+	started := time.Now()
+	reply := func(status P.Status) error {
+		response := P.Response{Nonce: request.Nonce, Status: status, ProcessingNanos: uint64(time.Since(started))}
+		body, err := response.Marshal()
+		if err != nil {
+			return err
+		}
+		if err = P.WriteFrame(conn, body); err != nil {
+			return err
+		}
+		return conn.Close()
+	}
+	switch request.Operation {
+	case P.TransportEcho, P.AdmissionEcho:
+		if err = h.execution.Echo(user, request.PolicyID); err != nil {
+			return reply(P.Denied)
+		}
+		return reply(P.Accepted)
+	case P.ConnectTCP, P.RegisterUDP:
+		destination := M.ParseSocksaddrHostPort(request.Host, request.Port)
+		admitted, _, err := h.execution.Admit(ctx, user, P.Connection{PolicyID: request.PolicyID, Path: *request.Context}, destination)
+		if err != nil {
+			if request.Operation == P.ConnectTCP {
+				if err = hysteria2.WriteTCPResponse(conn, false, hysteria2.ExecutionDeniedMessage); err != nil {
+					return err
+				}
+				return conn.Close()
+			}
+			return reply(P.Denied)
+		}
+		_ = conn.SetDeadline(time.Time{})
+		if request.Operation == P.ConnectTCP {
+			acceptTCP(admitted, destination)
+			return nil
+		}
+		if err = registerUDP(admitted, request.SessionID, destination); err != nil {
+			return reply(P.Denied)
+		}
+		return reply(P.Accepted)
+	default:
+		return reply(P.Denied)
+	}
+}
+func (h *Outbound) executionRequest(ctx context.Context, destination M.Socksaddr, operation P.Operation) (P.Request, []byte, error) {
+	request, err := execution.Request(ctx, h.execution, destination, operation)
+	if err != nil {
+		return P.Request{}, nil, err
+	}
+	body, err := request.Marshal(len(request.Context.Visited) + 1)
+	return request, body, err
+}
+
+// Only an admitted native request uses this wrapper. Generic Hy2 TCP retains
+// its original status/message behavior and lazy client response consumption.
+type executionHandshakeConn struct{ net.Conn }
+
+func (c *executionHandshakeConn) HandshakeSuccess() error {
+	return N.ReportConnHandshakeSuccess(c.Conn, nil)
+}
+func (c *executionHandshakeConn) HandshakeFailure(cause error) error {
+	switch {
+	case errors.Is(cause, execution.ErrDenied):
+		cause = hysteria2.ErrExecutionDenied
+	case errors.Is(cause, execution.ErrUnavailable):
+		cause = hysteria2.ErrExecutionUnavailable
+	case errors.Is(cause, execution.ErrUnknown):
+		cause = hysteria2.ErrExecutionUnknown
+	}
+	if reporter, ok := c.Conn.(N.HandshakeFailure); ok {
+		return reporter.HandshakeFailure(cause)
+	}
+	return nil
+}
+func (c *executionHandshakeConn) CloseWrite() error { return N.CloseWrite(c.Conn) }
+func (c *executionHandshakeConn) CloseRead() error  { return N.CloseRead(c.Conn) }
+
+func executionDialError(err error) error {
+	switch {
+	case errors.Is(err, hysteria2.ErrExecutionDenied):
+		return execution.ErrDenied
+	case errors.Is(err, hysteria2.ErrExecutionUnavailable):
+		return execution.ErrUnavailable
+	case errors.Is(err, hysteria2.ErrExecutionUnknown):
+		return errors.Join(execution.ErrUnknown, err)
+	default:
+		return err
+	}
+}
