+func TestDescriptionHashMatchesCanonicalRuntimeMap(t *testing.T) {
+	for _, raw := range []string{
+		`{"type":"hysteria2","tag":"demo-hy2","server":"demo.example","server_port":443,"password":"demo-only","tls":{"enabled":true,"server_name":"demo.example"},"execution":{"authentication_digest":"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa","policy_id":""}}`,
+		`{"type":"direct","tag":"demo-wg","detour":"wg-shared","inet6_bind_address":"fdab::1","execution":{"authentication_digest":"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa","policy_id":""}}`,
+	} {
+		var value map[string]any
+		if err := json.Unmarshal([]byte(raw), &value); err != nil {
+			t.Fatal(err)
+		}
+		options := map[string]any{}
+		for key, item := range value {
+			if key != "type" && key != "tag" {
+				options[key] = item
+			}
+		}
+		body, _ := json.Marshal(options)
+		var typed any
+		if value["type"] == "direct" {
+			typed = &option.DirectOutboundOptions{}
+		} else {
+			typed = &option.Hysteria2OutboundOptions{}
+		}
+		if err := json.Unmarshal(body, typed); err != nil {
+			t.Fatal(err)
+		}
+		actual, err := sourcepool.ConfigHash(value["type"].(string), value["tag"].(string), typed)
+		if err != nil {
+			t.Fatal(err)
+		}
+		canonical, _ := json.Marshal(value)
+		sum := sha256.Sum256(canonical)
+		expected := "sha256:" + hex.EncodeToString(sum[:])
+		if actual != expected {
+			t.Fatal("typed constructor hash differs from canonical runtime map", value["type"])
+		}
+	}
+}
