+type AccessSnapshot struct {
+	Name     string                   `json:"now"`
+	PolicyID string                   `json:"policy_id"`
+	Targets  map[string]string        `json:"targets"`
+	Choices  map[string]P.RouteChoice `json:"choices"`
+	Revision string                   `json:"revision"`
+}
+type accessPolicy struct {
+	value     option.ExecutionPolicy
+	compiled  *execution.Policy
+	distances map[string]map[string]int
+}
+type accessSelector struct {
+	options  option.ExecutionAccessOptions
+	policies map[string]accessPolicy
+}
+
+func cloneTargets(value map[string]string) map[string]string { return maps.Clone(value) }
+func cloneAccess(value AccessSnapshot) AccessSnapshot {
+	value.Targets = maps.Clone(value.Targets)
+	value.Choices = maps.Clone(value.Choices)
+	return value
+}
+func newAccessSelector(options option.ExecutionAccessOptions) (*accessSelector, error) {
+	// Own the accepted projection; caller-owned maps cannot rewrite a live grant.
+	body, err := json.Marshal(options)
+	if err != nil {
+		return nil, err
+	}
+	var owned option.ExecutionAccessOptions
+	if err = json.Unmarshal(body, &owned); err != nil {
+		return nil, err
+	}
+	options = owned
+
+	if P.ValidateID(options.NodeID) != nil || options.Kind != "internet" && options.Kind != "local_network" || options.Kind == "local_network" && P.ValidateID(options.ServiceID) != nil || options.Kind == "internet" && options.ServiceID != "" || options.Policies == nil || options.Entries == nil || options.EgressOutbounds == nil || options.ForwardOutbounds == nil {
+		return nil, errors.New("invalid stable access authorization projection")
+	}
+	result := &accessSelector{options: options, policies: map[string]accessPolicy{}}
+	for _, value := range options.Policies {
+		if value.Policy.Nodes != nil || value.Policy.Edges != nil {
+			return nil, errors.New("source Policy must reuse its one qualified topology")
+		}
+		value.Policy.Nodes = options.Nodes
+		value.Policy.Edges = options.Edges
+		compiled, err := execution.NewPolicy(value)
+		if err != nil {
+			return nil, err
+		}
+		if value.Policy.Kind != options.Kind || options.Kind == "local_network" && value.Policy.ServiceID != options.ServiceID || !compiled.Compiled().AllowsOrigin(options.NodeID) {
+			return nil, errors.New("access Policy is not granted to this source")
+		}
+		if _, exists := result.policies[value.Policy.PolicyID]; exists {
+			return nil, errors.New("duplicated access Policy")
+		}
+		topology := &hopSelector{policy: value.Policy, reverse: map[string][]string{}}
+		for _, edge := range value.Policy.Edges {
+			topology.reverse[edge.To] = append(topology.reverse[edge.To], edge.From)
+		}
+		distances := map[string]map[string]int{}
+		for _, exit := range value.Policy.Exits {
+			distances[exit] = topology.distance(exit, nil)
+		}
+		result.policies[value.Policy.PolicyID] = accessPolicy{value, compiled, distances}
+	}
+	for id, entry := range options.Entries {
+		if !sourcepool.ValidHash(entry.AuthenticationDigest) || P.ValidateID(id) != nil || P.ValidateID(entry.NodeID) != nil || entry.NodeID == options.NodeID || entry.Outbound == "" {
+			return nil, errors.New("invalid shared entry transport")
+		}
+	}
+	return result, nil
+}
+
+// accessOutbound resolves only an already running component. The accepted
+// access projection supplies the tag after Policy/path validation; this lookup
+// neither creates a transport nor expands the selector's static members.
+func (s *Selector) accessOutbound(tag string) adapter.Outbound {
+	if tag == "reject" {
+		return s.outbounds["reject"]
+	}
+	if s.outbound == nil || tag == "" || tag == s.Tag() {
+		return nil
+	}
+	outbound, found := s.outbound.Outbound(tag)
+	if !found {
+		return nil
+	}
+	return outbound
+}
+
+func (s *Selector) IsAccessSelector() bool { return s.access.Load() != nil }
+func (s *Selector) AccessSnapshot() AccessSnapshot {
+	if current := s.selected.Load(); current != nil && current.access != nil {
+		return cloneAccess(*current.access)
+	}
+	return AccessSnapshot{Name: "reject", Targets: map[string]string{}, Choices: map[string]P.RouteChoice{}}
+}
+func (s *Selector) initializeAccess() (string, error) {
+	var nonce [32]byte
+	if _, err := rand.Read(nonce[:]); err != nil {
+		return "", err
+	}
+	value := AccessSnapshot{Name: "reject", Targets: map[string]string{}, Choices: map[string]P.RouteChoice{}, Revision: base64.RawURLEncoding.EncodeToString(nonce[:])}
+	reject := s.outbounds["reject"]
+	if reject == nil {
+		return "", errors.New("access has no rejection outbound")
+	}
+	s.accessFence.Lock()
+	previous := s.selected.Swap(&selectorChoice{revision: value.Revision, fallback: reject, targets: map[string]adapter.Outbound{}, access: &value})
+	if s.accessState.Revision == "" {
+		s.accessState.Revision = value.Revision
+	}
+	s.accessFence.Unlock()
+	if previous != nil {
+		sourcepool.ReleaseAll(previous.leases)
+	}
+	return value.Revision, nil
+}
+func (a *accessSelector) choice(policy accessPolicy, choice P.RouteChoice) (string, error) {
+	if choice.Validate() != nil {
+		return "", errors.New("invalid access path choice")
+	}
+	service := policy.value.Policy.ServiceID
+	if choice.FinalExit == "direct" {
+		if !policy.value.AllowDirect || policy.value.Policy.Kind != "internet" {
+			return "", errors.New("Policy forbids Direct")
+		}
+		tag := a.options.EgressOutbounds[service]
+		if tag == "" {
+			return "", errors.New("Direct has no target guard")
+		}
+		return tag, nil
+	}
+	if !policy.compiled.Compiled().AllowsExit(choice.FinalExit) {
+		return "", errors.New("selected final exit is outside this Policy")
+	}
+	if choice.FirstResourceID == "" {
+		if choice.EntryNodeID != a.options.NodeID {
+			return "", errors.New("local entry belongs to another node")
+		}
+		if choice.FinalExit == a.options.NodeID {
+			if !policy.value.LocalEgress {
+				return "", errors.New("Policy forbids this local final exit")
+			}
+			tag := a.options.EgressOutbounds[service]
+			if tag == "" {
+				return "", errors.New("local exit lacks its target guard")
+			}
+			return tag, nil
+		}
+		if !a.options.Forward || !policy.value.Policy.EntryScope.Allows(a.options.NodeID) {
+			return "", errors.New("local entry lacks forwarding permission")
+		}
+	} else {
+		entry, ok := a.options.Entries[choice.FirstResourceID]
+		if !ok || !entry.AccessEnabled || entry.NodeID != choice.EntryNodeID {
+			return "", errors.New("chosen entry lacks its ordinary access transport")
+		}
+		if err := policy.compiled.Compiled().AdmitEntry(a.options.NodeID, entry.NodeID, entry.Forward, entry.InternetEgress); err != nil {
+			return "", err
+		}
+	}
+	distance, ok := policy.distances[choice.FinalExit][choice.EntryNodeID]
+	if !ok || policy.value.Policy.MaxHops > 0 && distance+1 > policy.value.Policy.MaxHops {
+		return "", errors.New("entry has no qualified path to the selected exit")
+	}
+	if choice.FirstResourceID != "" {
+		return a.options.Entries[choice.FirstResourceID].Outbound, nil
+	}
+	tag := a.options.ForwardOutbounds[policy.value.Policy.PolicyID]
+	if tag == "" {
+		return "", errors.New("local entry has no forwarding execution")
+	}
+	return tag, nil
+}
+func (s *Selector) CompareAndSelectAccess(ctx context.Context, desired, expected AccessSnapshot) (AccessSnapshot, error) {
+	var authorization *accessSelector
+	var previous *selectorChoice
+	needed := map[string]bool{}
+	err := func() error {
+		s.accessFence.RLock()
+		defer s.accessFence.RUnlock()
+		authorization = s.access.Load()
+		if authorization == nil || desired.Targets == nil || desired.Choices == nil {
+			return errors.New("incomplete access selection")
+		}
+		policy, known := authorization.policies[desired.PolicyID]
+		if desired.PolicyID != "" && !known {
+			return errors.New("selection Policy is not currently granted")
+		}
+		used := map[string]bool{}
+		if desired.Name == "reject" {
+			if desired.PolicyID != "" || len(desired.Targets) > 0 || len(desired.Choices) > 0 {
+				return errors.New("rejection cannot carry path choices")
+			}
+		} else {
+			if !known {
+				return errors.New("path choice has no current Policy")
+			}
+			used[desired.Name] = true
+			for target, id := range desired.Targets {
+				_, host, port, err := P.ParseConnectionTargetKey(target)
+				if err != nil {
+					return errors.New("invalid target override")
+				}
+				if err := policy.compiled.CheckTarget(M.ParseSocksaddrHostPort(host, port)); err != nil {
+					return err
+				}
+				used[id] = true
+			}
+			if len(used) != len(desired.Choices) {
+				return errors.New("selection contains unused or missing path choices")
+			}
+			for id := range used {
+				choice, ok := desired.Choices[id]
+				if !ok {
+					return errors.New("selected path choice is missing")
+				}
+				identity, err := P.CandidateID(policy.value.Policy.ServiceID, desired.PolicyID, choice)
+				if err != nil || identity != id {
+					return errors.New("selected path identity does not match its Policy and entry/exit")
+				}
+				tag, err := authorization.choice(policy, choice)
+				if err != nil {
+					return err
+				}
+				needed[tag] = true
+			}
+		}
+		previous = s.selected.Load()
+		if previous == nil || previous.access == nil || !reflect.DeepEqual(*previous.access, expected) {
+			return ErrSelectionChanged
+		}
+		return nil
+	}()
+	if err != nil {
+		return AccessSnapshot{}, err
+	}
+	pool := service.FromContext[*sourcepool.Pool](s.ctx)
+	var prepared *sourcepool.Prepared
+	if pool != nil {
+		tags := make([]string, 0, len(needed))
+		for tag := range needed {
+			tags = append(tags, tag)
+		}
+		prepared, err = pool.PrepareBorrow(ctx, tags)
+		if err != nil {
+			return AccessSnapshot{}, err
+		}
+		defer prepared.Close()
+	}
+	var nonce [32]byte
+	if _, err := rand.Read(nonce[:]); err != nil {
+		return AccessSnapshot{}, err
+	}
+	value := cloneAccess(desired)
+	value.Revision = base64.RawURLEncoding.EncodeToString(nonce[:])
+	validate := func() error {
+		if ctx.Err() != nil {
+			return ctx.Err()
+		}
+		if s.access.Load() != authorization || s.selected.Load() != previous {
+			return ErrSelectionChanged
+		}
+		if prepared != nil && !prepared.Authorizes(s.Tag(), s.accessState.Revision) {
+			return ErrSelectionChanged
+		}
+		if desired.Name != "reject" {
+			policy := authorization.policies[desired.PolicyID]
+			for id, choice := range desired.Choices {
+				if id != desired.Name {
+					used := false
+					for _, targetID := range desired.Targets {
+						used = used || targetID == id
+					}
+					if !used {
+						continue
+					}
+				}
+				tag, err := authorization.choice(policy, choice)
+				if err != nil {
+					return err
+				}
+				var selected adapter.Outbound
+				if prepared != nil {
+					selected = prepared.PreparedOutbound(tag)
+				} else {
+					selected = s.accessOutbound(tag)
+				}
+				if selected == nil {
+					return sourcepool.ErrResourcePending
+				}
+				if choice.FirstResourceID != "" {
+					entry := authorization.options.Entries[choice.FirstResourceID]
+					actual, ok := selected.(interface{ OutboundAuthenticationDigest() string })
+					if !ok || actual.OutboundAuthenticationDigest() != entry.AuthenticationDigest {
+						return errors.Join(sourcepool.ErrResourcePending, errors.New("source resource authentication not materialized"))
+					}
+				}
+			}
+		}
+		return nil
+	}
+	publish := func(leases []*sourcepool.Lease) {
+		s.selected.Store(&selectorChoice{revision: value.Revision, fallback: s.outbounds["reject"], targets: map[string]adapter.Outbound{}, access: &value, leases: leases})
+	}
+	s.accessFence.Lock()
+	if prepared != nil {
+		err = prepared.CommitSelection(ctx, validate, publish)
+	} else {
+		err = validate()
+		if err == nil {
+			publish(nil)
+		}
+	}
+	s.accessFence.Unlock()
+	if err != nil {
+		return AccessSnapshot{}, err
+	}
+	sourcepool.ReleaseAll(previous.leases)
+	return cloneAccess(value), nil
+}
+
+// Preserve the first rejection across route pinning and its later dispatch.
+// These fields describe only this attempted connection and cannot affect choice.
+func recordAccessRejection(metadata *adapter.InboundContext, reason, revision string) {
+	if metadata == nil || metadata.ExecutionAccessRejectReason != "" {
+		return
+	}
+	metadata.ExecutionAccessRejectReason = reason
+	if revision != "" {
+		digest := sha256.Sum256([]byte(revision))
+		metadata.ExecutionAccessRejectRevision = hex.EncodeToString(digest[:])
+	}
+}
+func (s *Selector) pickAccess(metadata *adapter.InboundContext, destination M.Socksaddr, current *selectorChoice) adapter.Outbound {
+	reject := s.outbounds["reject"]
+	if metadata == nil || current.access == nil || current.access.Name == "reject" {
+		reason := "snapshot-reject"
+		if metadata == nil {
+			reason = "metadata-missing"
+		} else if current.access == nil {
+			reason = "snapshot-missing"
+		}
+		recordAccessRejection(metadata, reason, current.revision)
+		return reject
+	}
+	value := current.access
+	authorization := s.access.Load()
+	if authorization == nil {
+		recordAccessRejection(metadata, "authorization-unavailable", value.Revision)
+		return reject
+	}
+	policy, ok := authorization.policies[value.PolicyID]
+	if !ok {
+		recordAccessRejection(metadata, "policy-ungranted", value.Revision)
+		return reject
+	}
+	if destination.IsFqdn() {
+		destination.Fqdn = strings.ToLower(strings.TrimSuffix(destination.Fqdn, "."))
+	}
+	if policy.compiled.CheckTarget(destination) != nil {
+		recordAccessRejection(metadata, "target-disallowed", value.Revision)
+		return reject
+	}
+	target, err := P.ConnectionTargetKey(metadata.Network, destination.AddrString(), destination.Port)
+	id := value.Name
+	if chosen := value.Targets[target]; err == nil && chosen != "" {
+		id = chosen
+	}
+	choice, ok := value.Choices[id]
+	if !ok {
+		recordAccessRejection(metadata, "choice-missing", value.Revision)
+		return reject
+	}
+	if _, err := authorization.choice(policy, choice); err != nil {
+		recordAccessRejection(metadata, "choice-ineligible", value.Revision)
+		return reject
+	}
+	selected, lookupErr := s.accessConnectionOutbound(value.PolicyID, choice, destination, metadata, value.Revision)
+	if lookupErr != nil || selected == nil {
+		recordAccessRejection(metadata, "connection-recheck", value.Revision)
+		return reject
+	}
+	visited := []string{}
+	if choice.EntryNodeID == authorization.options.NodeID {
+		visited = append(visited, authorization.options.NodeID)
+	}
+	connection := P.Connection{PolicyID: value.PolicyID, Path: P.PathContext{OriginID: authorization.options.NodeID, FinalExitID: choice.FinalExit, Visited: visited}}
+	metadata.Execution = &connection
+	metadata.ExecutionServiceID = policy.value.Policy.ServiceID
+	metadata.ExecutionCandidate = id
+	metadata.ExecutionSelectionRevision = value.Revision
+	metadata.ExecutionEntry = choice.EntryNodeID
+	metadata.ExecutionResource = choice.FirstResourceID
+	if entry, ok := authorization.options.Entries[choice.FirstResourceID]; ok {
+		metadata.ExecutionAuthenticationDigest = entry.AuthenticationDigest
+	}
+	metadata.ExecutionSourceScope = s.Tag()
+	metadata.ExecutionSourceTarget = destination
+	s.BindAccessConnectionFence(metadata)
+	return selected
+}
+
+// A pinned connection retains its own path, while each later use is checked
+// against the current authorization and the actual running component set.
+func (s *Selector) pickPinnedAccess(metadata *adapter.InboundContext) adapter.Outbound {
+	if metadata.Execution == nil || metadata.ExecutionSourceScope != s.Tag() {
+		reason := "pinned-context-missing"
+		if metadata.Execution != nil {
+			reason = "pinned-scope-mismatch"
+		}
+		recordAccessRejection(metadata, reason, metadata.ExecutionSelectionRevision)
+		return s.outbounds["reject"]
+	}
+	selected, err := s.accessConnectionOutbound(metadata.Execution.PolicyID,
+		P.RouteChoice{EntryNodeID: metadata.ExecutionEntry, FirstResourceID: metadata.ExecutionResource, FinalExit: metadata.Execution.Path.FinalExitID}, metadata.ExecutionSourceTarget, metadata, metadata.ExecutionSelectionRevision)
+	if err != nil {
+		recordAccessRejection(metadata, "pinned-recheck", metadata.ExecutionSelectionRevision)
+		return s.outbounds["reject"]
+	}
+	return selected
+}
