+	target := M.SocksaddrFrom(execution, 53)
+	ctx, err := endpoint.BindWireGuardExecutionTarget(context.Background(), target)
+	if err != nil || adapter.WireGuardSource(ctx) != source {
+		t.Fatal("measurement changed the original resource principal", err)
+	}
+	for _, invalid := range []M.Socksaddr{M.SocksaddrFrom(execution, 54), M.SocksaddrFrom(netip.MustParseAddr("fdab:79::2"), 53), M.SocksaddrFrom(netip.MustParseAddr("::1"), 53), M.ParseSocksaddr("demo.example:53"), M.ParseSocksaddr("192.0.2.1:53")} {
+		if _, err := endpoint.BindWireGuardExecutionTarget(context.Background(), invalid); err == nil {
+			t.Fatal("measurement accepted a target outside current exact execution bindings", invalid)
+		}
+	}
+	options.SourceRoutes = append(options.SourceRoutes, option.WireGuardSourceRoute{Source: netip.MustParseAddr("fdab:77::2"), Destination: netip.PrefixFrom(execution, 128), Execution: execution})
+	if err := endpoint.configureSourceRoutes(options); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := endpoint.BindWireGuardExecutionTarget(context.Background(), target); err == nil {
+		t.Fatal("measurement guessed between two principals for one target")
+	}
+	if err := endpoint.configureSourceRoutes(option.WireGuardEndpointOptions{}); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := endpoint.BindWireGuardExecutionTarget(context.Background(), target); err == nil {
+		t.Fatal("retired measurement target remained usable")
+	}
+	if _, err := endpoint.DialContext(ctx, "tcp", target); err == nil {
+		t.Fatal("late measurement context revived a retired source")
+	}
