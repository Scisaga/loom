+type publicInternetDialer struct {
+	underlay dialer.ParallelInterfaceDialer
+}
+
+func newPublicInternetDialer(ctx context.Context, router adapter.Router, options option.DirectOutboundOptions) (dialer.ParallelInterfaceDialer, error) {
+	if options.PrefixMapping != nil || options.Detour != "" || options.OverrideAddress != "" || options.OverridePort != 0 {
+		return nil, errors.New("ordinary internet cannot override or translate targets")
+	}
+	underlay, err := dialer.NewDefault(ctx, options.DialerOptions)
+	if err != nil {
+		return nil, err
+	}
+	guard := &publicInternetDialer{underlay: underlay}
+	return dialer.NewResolveParallelInterfaceDialer(router, guard, true, dns.DomainStrategy(options.DomainStrategy), time.Duration(options.FallbackDelay)), nil
+}
+
+func publicDestination(destination M.Socksaddr) error {
+	if destination.Fqdn != "" || destination.Port == 0 || !dialer.PublicInternetAddress(destination.Addr) {
+		return errors.New("destination is outside ordinary internet")
+	}
+	return nil
+}
+
+func (d *publicInternetDialer) DialContext(ctx context.Context, network string, destination M.Socksaddr) (net.Conn, error) {
+	if err := publicDestination(destination); err != nil {
+		return nil, err
+	}
+	return d.underlay.DialContext(ctx, network, destination)
+}
+
+func (d *publicInternetDialer) DialParallelInterface(ctx context.Context, network string, destination M.Socksaddr, strategy *C.NetworkStrategy, interfaces, fallback []C.InterfaceType, delay time.Duration) (net.Conn, error) {
+	if err := publicDestination(destination); err != nil {
+		return nil, err
+	}
+	return d.underlay.DialParallelInterface(ctx, network, destination, strategy, interfaces, fallback, delay)
+}
+
+func (d *publicInternetDialer) ListenPacket(ctx context.Context, destination M.Socksaddr) (net.PacketConn, error) {
+	if err := publicDestination(destination); err != nil {
+		return nil, err
+	}
+	conn, err := d.underlay.ListenPacket(ctx, destination)
+	if err != nil {
+		return nil, err
+	}
+	return &prefixPacketConn{PacketConn: conn, virtual: destination, local: destination}, nil
+}
+
+func (d *publicInternetDialer) ListenSerialInterfacePacket(ctx context.Context, destination M.Socksaddr, strategy *C.NetworkStrategy, interfaces, fallback []C.InterfaceType, delay time.Duration) (net.PacketConn, error) {
+	if err := publicDestination(destination); err != nil {
+		return nil, err
+	}
+	conn, err := d.underlay.ListenSerialInterfacePacket(ctx, destination, strategy, interfaces, fallback, delay)
+	if err != nil {
+		return nil, err
+	}
+	return &prefixPacketConn{PacketConn: conn, virtual: destination, local: destination}, nil
+}
