+func TestNativeOfferRejectsLatePublicationAndAllowsFreshCreation(t *testing.T) {
+	client := &Client{ctx: context.Background(), connAccess: make(chan struct{}, 1)}
+	candidate := func() (*clientQUICConnection, *offerRawCloser) {
+		ctx, cancel := context.WithCancel(context.Background())
+		raw := &offerRawCloser{}
+		return &clientQUICConnection{quicConn: &offerQUICConnection{ctx: ctx, cancel: cancel}, rawConn: raw, connDone: make(chan struct{})}, raw
+	}
+	// Simulate the one creator returning after Close canceled its registered
+	// context. The same production completion boundary owns publication.
+	client.connAccess <- struct{}{}
+	pending, cancel := context.WithCancel(context.Background())
+	client.pendingCancel = cancel
+	client.CloseWithError(errors.New("demo network replaced"))
+	late, lateRaw := candidate()
+	if conn, err := client.completeOffer(pending, late, nil); conn != nil || !errors.Is(err, context.Canceled) || client.conn.Load() != nil || !lateRaw.closed.Load() {
+		t.Fatal("late transport was published or leaked", err)
+	}
+	<-client.connAccess
+	client.connAccess <- struct{}{}
+	freshContext, freshCancel := context.WithCancel(context.Background())
+	client.pendingCancel = freshCancel
+	fresh, freshRaw := candidate()
+	if conn, err := client.completeOffer(freshContext, fresh, nil); err != nil || conn != fresh || client.conn.Load() != fresh {
+		t.Fatal("fresh creation was blocked by retired publication", err)
+	}
+	freshCancel()
+	if !fresh.active() || freshRaw.closed.Load() || client.pendingCancel != nil {
+		t.Fatal("completed creator context killed shared transport")
+	}
+	<-client.connAccess
+	client.CloseWithError(errors.New("demo cleanup"))
+	if !freshRaw.closed.Load() || client.conn.Load() != nil {
+		t.Fatal("close did not detach the published transport")
+	}
+}
