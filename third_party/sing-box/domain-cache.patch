+package trafficontrol
+
+import (
+	"context"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"net"
+	"sort"
+	"strconv"
+	"strings"
+	"syscall"
+	"time"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/common/execution"
+	P "github.com/sagernet/sing-box/common/loomprotocol"
+	"github.com/sagernet/sing/common/atomic"
+	E "github.com/sagernet/sing/common/exceptions"
+)
+
+const maxTCPObservations = 128
+const maxTCPObservationBytes = (64 << 10) - 64
+const tcpObservationRetention = 10 * time.Minute
+
+// TCPObservation is a bounded local outcome, never an authorization, a shared
+// measurement or proof of TLS/application success. Times are original UTC ms.
+type TCPObservation struct {
+	Revision    string `json:"revision"`
+	PolicyID    string `json:"policy_id"`
+	CandidateID string `json:"candidate_id"`
+	Target      string `json:"target"`
+	Result      string `json:"result"`
+	StartedAt   int64  `json:"started_at"`
+	ObservedAt  int64  `json:"observed_at"`
+}
+type tcpObservationEntry struct {
+	value TCPObservation
+	bytes int
+}
+
+// TCPConnectResult classifies only actual downstream connection outcomes.
+// An empty value cannot establish either success or a path failure.
+func TCPConnectResult(cause error) string {
+	if cause == nil {
+		return "available"
+	}
+	// DialSerial can join several errors. A definite refusal in one branch
+	// cannot wash a denied, canceled or unknown branch into definite failure.
+	if errors.Is(cause, execution.ErrDenied) || errors.Is(cause, execution.ErrUnknown) || errors.Is(cause, context.Canceled) || E.IsClosed(cause) {
+		return ""
+	}
+	for inner := cause; inner != nil; inner = errors.Unwrap(inner) {
+		if multiple, ok := inner.(interface{ Unwrap() []error }); ok {
+			children := multiple.Unwrap()
+			if len(children) == 0 {
+				return ""
+			}
+			for _, child := range children {
+				if TCPConnectResult(child) != "unavailable" {
+					return ""
+				}
+			}
+			return "unavailable"
+		}
+	}
+	if errors.Is(cause, execution.ErrUnavailable) || errors.Is(cause, syscall.ECONNREFUSED) || errors.Is(cause, syscall.EHOSTUNREACH) || errors.Is(cause, syscall.ENETUNREACH) {
+		return "unavailable"
+	}
+	var dnsError *net.DNSError
+	if errors.As(cause, &dnsError) && (dnsError.IsNotFound || dnsError.IsTimeout) {
+		return "unavailable"
+	}
+	// A local wait deadline has no authenticated downstream outcome.
+	// It is not evidence of a definite target/path failure.
+	return ""
+}
+
+func (m *Manager) recordTCPResult(metadata adapter.InboundContext, started, observed time.Time, cause error, closed *atomic.Bool) {
+	if metadata.Inbound != "tun-in" || metadata.Network != "tcp" || metadata.ExecutionSourceScope != "access" || metadata.Execution == nil || metadata.ExecutionSourceCheck == nil || metadata.ExecutionSelectionRevision == "" || len(metadata.ExecutionSelectionRevision) > 128 || P.ValidateID(metadata.Execution.PolicyID) != nil {
+		return
+	}
+	candidate := strings.TrimPrefix(metadata.ExecutionCandidate, "sha256:")
+	decoded, err := hex.DecodeString(candidate)
+	if err != nil || len(decoded) != 32 || "sha256:"+hex.EncodeToString(decoded) != metadata.ExecutionCandidate {
+		return
+	}
+	target := metadata.ExecutionSourceTarget
+	if target.Port == 0 || !P.CanonicalHost(target.AddrString()) {
+		return
+	}
+	result := TCPConnectResult(cause)
+	if result == "" {
+		if errors.Is(cause, execution.ErrDenied) || errors.Is(cause, context.Canceled) || E.IsClosed(cause) {
+			return
+		}
+		// A real ordinary attempt can show recent use without proving health.
+		// In particular a local confirmation deadline is not a path failure.
+		// The caller already excludes a canceled outer routing context.
+		result = "unknown"
+	}
+	if started.UnixMilli() < 0 || observed.UnixMilli() < started.UnixMilli() || observed.UnixMilli() > 253402300799999 {
+		return
+	}
+	release, err := metadata.ExecutionSourceCheck()
+	if err != nil || release == nil {
+		return
+	}
+	defer release()
+	value := TCPObservation{Revision: metadata.ExecutionSelectionRevision, PolicyID: metadata.Execution.PolicyID, CandidateID: metadata.ExecutionCandidate,
+		Target: net.JoinHostPort(target.AddrString(), strconv.Itoa(int(target.Port))), Result: result, StartedAt: started.UnixMilli(), ObservedAt: observed.UnixMilli()}
+	key := value.Revision + "\x00" + value.CandidateID + "\x00" + value.Target
+	m.tcpObservationsAccess.Lock()
+	defer m.tcpObservationsAccess.Unlock()
+	if closed != nil && closed.Load() {
+		return
+	}
+	if m.tcpObservations == nil {
+		m.tcpObservations = map[string]tcpObservationEntry{}
+	}
+	if old, exists := m.tcpObservations[key]; exists {
+		if value.StartedAt < old.value.StartedAt {
+			return
+		}
+		if value.StartedAt == old.value.StartedAt {
+			if value.Result == old.value.Result {
+				return
+			}
+			value.Result = "unknown"
+			if old.value.ObservedAt > value.ObservedAt {
+				value.ObservedAt = old.value.ObservedAt
+			}
+		}
+		m.tcpObservationBytes -= old.bytes
+	}
+	body, err := json.Marshal(value)
+	if err != nil {
+		return
+	}
+	m.tcpObservations[key] = tcpObservationEntry{value, len(body) + 1}
+	m.tcpObservationBytes += len(body) + 1
+	for len(m.tcpObservations) > maxTCPObservations || m.tcpObservationBytes > maxTCPObservationBytes {
+		oldest := ""
+		for key, entry := range m.tcpObservations {
+			if oldest == "" || entry.value.StartedAt < m.tcpObservations[oldest].value.StartedAt || entry.value.StartedAt == m.tcpObservations[oldest].value.StartedAt && key < oldest {
+				oldest = key
+			}
+		}
+		m.tcpObservationBytes -= m.tcpObservations[oldest].bytes
+		delete(m.tcpObservations, oldest)
+	}
+}
+
+// HasRecentTCPAttempt only reads original ordinary-traffic attempts. A
+// calibration neither creates these entries nor renews their activity.
+func (m *Manager) HasRecentTCPAttempt(policyID, target string, now time.Time) bool {
+	m.tcpObservationsAccess.Lock()
+	defer m.tcpObservationsAccess.Unlock()
+	at := now.UnixMilli()
+	for _, entry := range m.tcpObservations {
+		value := entry.value
+		if value.PolicyID == policyID && value.Target == target && value.StartedAt > 0 && value.StartedAt <= at && at-value.StartedAt < tcpObservationRetention.Milliseconds() {
+			return true
+		}
+	}
+	return false
+}
+
+func (m *Manager) TCPObservations(clock func() time.Time) []TCPObservation {
+	m.tcpObservationsAccess.Lock()
+	now := clock()
+	values := make([]TCPObservation, 0, len(m.tcpObservations))
+	for key, entry := range m.tcpObservations {
+		value := entry.value
+		if value.ObservedAt > now.UnixMilli() {
+			continue
+		}
+		if now.UnixMilli()-value.ObservedAt >= tcpObservationRetention.Milliseconds() {
+			m.tcpObservationBytes -= entry.bytes
+			delete(m.tcpObservations, key)
+			continue
+		}
+		values = append(values, value)
+	}
+	m.tcpObservationsAccess.Unlock()
+	sort.Slice(values, func(i, j int) bool {
+		a, b := values[i], values[j]
+		return a.Revision+"\x00"+a.CandidateID+"\x00"+a.Target < b.Revision+"\x00"+b.CandidateID+"\x00"+b.Target
+	})
+	return values
+}
