+type wgEndpoint struct {
+	transport
+	mu       sync.Mutex
+	peers    []option.WireGuardPeer
+	routes   []option.WireGuardSourceRoute
+	revision int
+	repair   atomic.Bool
+}
+
+func (e *wgEndpoint) RuntimeWireGuardNeedsRepair() bool { return e.repair.Load() }
+
+func (e *wgEndpoint) ValidateRuntimeWireGuardInitializer(option.WireGuardEndpointOptions) error {
+	return nil
+}
+func (e *wgEndpoint) RuntimeWireGuardReferenceProjection(keys []string) func(map[string]uint16) {
+	return func(intervals map[string]uint16) {
+		e.mu.Lock()
+		defer e.mu.Unlock()
+		for i := range e.peers {
+			for _, key := range keys {
+				if e.peers[i].PublicKey == key {
+					e.peers[i].PersistentKeepaliveInterval = intervals[key]
+				}
+			}
+		}
+	}
+}
+func (e *wgEndpoint) PrepareRuntimeWireGuardStage(_ context.Context, peers []option.WireGuardPeer, routes []option.WireGuardSourceRoute, retained []option.WireGuardPeer, retainedRoutes []option.WireGuardSourceRoute) (func(string, bool) error, func(map[string]uint16, func() error) error, error) {
+	if e.repair.Load() {
+		return nil, nil, sourcepool.ErrResourcePending
+	}
+	peers = append([]option.WireGuardPeer(nil), peers...)
+	for i := range peers {
+		peers[i].PersistentKeepaliveInterval = 0
+	}
+	apply, err := e.PrepareRuntimeWireGuard(peers, routes, retained, retainedRoutes)
+	if err != nil {
+		return nil, nil, err
+	}
+	revision := -1
+	physical := func(string, bool) error {
+		if err := apply(); err != nil {
+			return err
+		}
+		e.mu.Lock()
+		revision = e.revision
+		e.mu.Unlock()
+		return nil
+	}
+	guard := func(intervals map[string]uint16, publish func() error) error {
+		e.mu.Lock()
+		defer e.mu.Unlock()
+		if revision < 0 || revision != e.revision {
+			return sourcepool.ErrConflict
+		}
+		if err := publish(); err != nil {
+			return err
+		}
+		for i := range e.peers {
+			e.peers[i].PersistentKeepaliveInterval = intervals[e.peers[i].PublicKey]
+		}
+		return nil
+	}
+	return physical, guard, nil
+}
+func (e *wgEndpoint) PrepareRuntimeWireGuard(peers []option.WireGuardPeer, routes []option.WireGuardSourceRoute, retained []option.WireGuardPeer, _ []option.WireGuardSourceRoute) (func() error, error) {
+	e.mu.Lock()
+	revision := e.revision
+	current := append([]option.WireGuardPeer(nil), e.peers...)
+	e.mu.Unlock()
+	peers = append([]option.WireGuardPeer(nil), peers...)
+	for _, old := range retained {
+		index := -1
+		for i, peer := range peers {
+			if peer.PublicKey == old.PublicKey {
+				index = i
+				break
+			}
+		}
+		if index < 0 {
+			for _, peer := range current {
+				if peer.PublicKey == old.PublicKey {
+					peer.AllowedIPs = nil
+					peers = append(peers, peer)
+					index = len(peers) - 1
+					break
+				}
+			}
+		}
+		if index < 0 {
+			return nil, sourcepool.ErrConflict
+		}
+		peers[index].AllowedIPs = append([]netip.Prefix(nil), peers[index].AllowedIPs...)
+		for _, prefix := range old.AllowedIPs {
+			found := false
+			for _, existing := range peers[index].AllowedIPs {
+				found = found || existing == prefix
+			}
+			if !found {
+				peers[index].AllowedIPs = append(peers[index].AllowedIPs, prefix)
+			}
+		}
+	}
+	return func() error {
+		e.mu.Lock()
+		defer e.mu.Unlock()
+		if e.revision != revision {
+			return sourcepool.ErrConflict
+		}
+		e.peers = peers
+		e.routes = routes
+		e.revision++
+		return nil
+	}, nil
+}
+func (e *wgEndpoint) RuntimeWireGuardSnapshot() any {
+	e.mu.Lock()
+	defer e.mu.Unlock()
+	return e.revision
+}
+func (e *wgEndpoint) PruneRuntimeWireGuard(expected any, keep []option.WireGuardSourceRoute, intervals map[string]uint16) error {
+	e.mu.Lock()
+	if expected != e.revision {
+		e.mu.Unlock()
+		return sourcepool.ErrConflict
+	}
+	drop := []option.WireGuardSourceRoute{}
+	for _, route := range e.routes {
+		used := false
+		for _, current := range keep {
+			used = used || current == route
+		}
+		if !used {
+			drop = append(drop, route)
+		}
+	}
+	e.mu.Unlock()
+	return e.RetireRuntimeWireGuard(expected, nil, drop, intervals)
+}
+func (e *wgEndpoint) RetireRuntimeWireGuard(expected any, _ []option.WireGuardPeer, routes []option.WireGuardSourceRoute, intervals map[string]uint16) error {
+	e.mu.Lock()
+	defer e.mu.Unlock()
+	if expected != e.revision {
+		return sourcepool.ErrConflict
+	}
+	remaining := []option.WireGuardSourceRoute{}
+	for _, r := range e.routes {
+		removed := false
+		for _, old := range routes {
+			removed = removed || old == r
+		}
+		if !removed {
+			remaining = append(remaining, r)
+		}
+	}
+	e.routes = remaining
+	for i := range e.peers {
+		e.peers[i].PersistentKeepaliveInterval = intervals[e.peers[i].PublicKey]
+	}
+	e.revision++
+	return nil
+}
+func (e *wgEndpoint) hasSource(source netip.Addr) bool {
+	e.mu.Lock()
+	defer e.mu.Unlock()
+	for _, r := range e.routes {
+		if r.Source == source {
+			return true
+		}
+	}
+	return false
+}
+func wgRequest(tag, source, execution string, initialize bool) option.RuntimeResources {
+	s, x := netip.MustParseAddr(source), netip.MustParseAddr(execution)
+	a := badoption.Addr(s)
+	endpoint := &option.RuntimeWireGuard{Tag: "wg-shared", SourceRoutes: []option.WireGuardSourceRoute{{Source: s, Execution: x, Destination: netip.PrefixFrom(x, 128)}}, Peers: []option.WireGuardPeer{{PublicKey: "demo-wg-peer", AllowedIPs: []netip.Prefix{netip.PrefixFrom(x, 128)}}}}
+	if initialize {
+		endpoint.Initializer = &option.WireGuardEndpointOptions{Address: []netip.Prefix{netip.MustParsePrefix("127.0.0.1/32"), netip.MustParsePrefix("::1/128")}}
+	}
+	return option.RuntimeResources{Forwarding: map[string]option.ExecutionHopOptions{}, Outbounds: []option.Outbound{{Type: C.TypeDirect, Tag: tag, Options: &option.DirectOutboundOptions{Execution: &option.ExecutionRoute{AuthenticationDigest: "sha256:" + strings.Repeat("a", 64)}, DialerOptions: option.DialerOptions{Detour: "wg-shared", Inet6BindAddress: &a}}}}, WireGuard: endpoint}
+}
