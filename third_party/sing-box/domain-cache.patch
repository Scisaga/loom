+	var writeMu, errorMu sync.Mutex
+	var failure error
+	abort := func(err error) {
+		if parentCtx.Err() != nil {
+			err = parentCtx.Err()
+		}
+		errorMu.Lock()
+		if failure == nil {
+			failure = err
+		}
+		errorMu.Unlock()
+		cancel()
+		closeConnection()
+	}
+	writeResponse := func(body []byte) (int, error) {
+		writeMu.Lock()
+		defer writeMu.Unlock()
+		if err := ctx.Err(); err != nil {
+			return 0, err
+		}
+		if err := conn.SetWriteDeadline(time.Now().Add(C.DNSTimeout)); err != nil {
+			return 0, err
+		}
+		n, err := conn.Write(body)
+		if err == nil && n != len(body) {
+			err = io.ErrShortWrite
+		}
+		return n, err
+	}
+	responseDone := func(err error) {
+		if err != nil {
+			abort(err)
+		}
+		pending.Done()
+	}
 	metadata.Destination = M.Socksaddr{}
+	var readErr error
 	for {
-		conn.SetReadDeadline(time.Now().Add(C.DNSTimeout))
-		err := dnsOutbound.HandleStreamDNSRequest(ctx, r, conn, metadata)
-		if err != nil {
-			return err
+		if readErr = conn.SetReadDeadline(time.Now().Add(C.DNSTimeout)); readErr != nil {
+			break
+		}
+		pending.Add(1)
+		queryCtx, queryCancel := context.WithTimeout(ctx, C.DNSTimeout)
+		readErr = dnsOutbound.HandleStreamDNSRequestEx(queryCtx, router, conn, metadata, writeResponse, func(err error) {
+			queryCancel()
+			responseDone(err)
+		})
+		if readErr != nil {
+			queryCancel()
+			pending.Done()
+			break
