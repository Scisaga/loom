+)
+
+type targetTestRouter struct {
+	adapter.Router
+	answers []netip.Addr
+}
+
+func (r *targetTestRouter) Lookup(context.Context, string, dns.DomainStrategy) ([]netip.Addr, error) {
+	return r.answers, nil
+}
+
+func TestSharedTargetCanonicalLiterals(t *testing.T) {
+	for _, value := range []string{"198.51.100.80", "2001:db8::80"} {
+		address := netip.MustParseAddr(value)
+		name, err := literalName(address)
+		if err != nil {
+			t.Fatal(err)
+		}
+		actual, recognized, err := literalAddress(name)
+		if err != nil || !recognized || actual != address {
+			t.Fatal("literal lost its IP meaning")
+		}
+	}
+	for _, value := range []string{"bad.v6.loom-ip.invalid", "c6336450.v6.loom-ip.invalid", "20010DB8000000000000000000000001.v6.loom-ip.invalid", "00000000000000000000ffffc6336450.v6.loom-ip.invalid"} {
+		_, recognized, err := literalAddress(value)
+		if !recognized || err == nil {
+			t.Fatal("ambiguous literal accepted", value)
+		}
+	}
+	if _, literal, err := literalAddress("allowed.example"); literal || err != nil {
+		t.Fatal("domain became an IP")
+	}
+}
+
+func TestSharedTargetRequiresUniquePeerOwnership(t *testing.T) {
+	source := netip.MustParseAddr("fdab:77::1")
+	prefix := netip.MustParsePrefix("fdab:80:1::/64")
+	options := option.WireGuardEndpointOptions{
+		SourceRoutes: []option.WireGuardSourceRoute{{Source: source, Destination: prefix}},
+		Peers:        []option.WireGuardPeer{{AllowedIPs: []netip.Prefix{prefix}}},
+	}
+	endpoint := Endpoint{localAddresses: []netip.Prefix{netip.PrefixFrom(source, 128)}}
+	if err := endpoint.configureSourceRoutes(options); err != nil {
+		t.Fatal(err)
+	}
+	options.Peers = append(options.Peers, option.WireGuardPeer{AllowedIPs: []netip.Prefix{netip.MustParsePrefix("::/0")}})
+	if err := endpoint.configureSourceRoutes(options); err == nil {
+		t.Fatal("overlapping peer can receive or impersonate another exit")
+	}
+}
+
+func TestSharedTargetRejectsWrongExitAndDNSPrivilege(t *testing.T) {
+	source := netip.MustParseAddr("fdab:77::1")
+	dnsSource := netip.MustParseAddr("fdab:78::1")
+	dnsAddress := netip.MustParseAddr("fdab:79::1")
+	router := &targetTestRouter{answers: []netip.Addr{netip.MustParseAddr("fdab:80:2::1")}}
+	endpoint := Endpoint{router: router, sourceRoutes: map[netip.Addr]netip.Prefix{
+		source: netip.MustParsePrefix("fdab:80:1::/64"), dnsSource: netip.PrefixFrom(dnsAddress, 128),
+	}}
+	ctx := adapter.WithWireGuardSource(context.Background(), source)
+	if _, err := endpoint.resolveTarget(ctx, M.ParseSocksaddr("allowed.example:443")); err == nil {
+		t.Fatal("DNS redirected a permission to another peer")
+	}
+	router.answers = []netip.Addr{netip.MustParseAddr("fdab:80:1::2")}
+	if _, err := endpoint.resolveTarget(ctx, M.ParseSocksaddr("allowed.example:443")); err != nil {
+		t.Fatal(err)
+	}
+	ctx = adapter.WithWireGuardSource(context.Background(), dnsSource)
+	if _, err := endpoint.resolveTarget(ctx, M.SocksaddrFrom(dnsAddress, 53)); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := endpoint.resolveTarget(ctx, M.SocksaddrFrom(dnsAddress, 443)); err == nil {
+		t.Fatal("DNS-only source obtained business access")
+	}
+	if _, err := endpoint.resolveTarget(context.Background(), M.SocksaddrFrom(dnsAddress, 53)); err == nil {
+		t.Fatal("unbound source accepted")
+	}
+}
