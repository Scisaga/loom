+)
+
+func dynamicHopOptions() option.ExecutionHopOptions {
+	return option.ExecutionHopOptions{
+		Policy: P.HopPolicy{PolicyID: "demo-policy", ServiceID: "demo-service", Kind: "internet",
+			Origins: []string{}, Nodes: []string{"demo-a", "demo-b", "demo-c", "demo-exit"}, Exits: []string{"demo-exit"},
+			EntryScope: P.PolicyScope{Mode: "any", NodeIDs: []string{}}, RelayScope: P.PolicyScope{Mode: "only", NodeIDs: []string{"demo-b", "demo-c"}},
+			Edges: []P.DirectedHop{{From: "demo-a", To: "demo-b"}, {From: "demo-a", To: "demo-c"}, {From: "demo-a", To: "demo-exit"}, {From: "demo-b", To: "demo-exit"}, {From: "demo-c", To: "demo-exit"}}},
+		NodeID: "demo-a", Nodes: map[string]string{"demo-a": "demo-b", "demo-b": "demo-exit"},
+		ExitChoices: map[string][]string{"demo-exit": {"demo-a", "demo-b"}},
+	}
+}
+
+func dynamicHopFixture(t *testing.T) (*Selector, option.ExecutionHopOptions) {
+	t.Helper()
+	options := dynamicHopOptions()
+	hop, err := newHopSelector(options)
+	if err != nil {
+		t.Fatal(err)
+	}
+	s := targetSelector()
+	s.hop = hop
+	s.outbounds["demo-c"] = targetOutbound("demo-c")
+	s.outbound = &initialTestManager{values: s.outbounds}
+	if !s.SelectTargets("reject", map[string]string{}) {
+		t.Fatal("initial forwarding snapshot failed")
+	}
+	return s, options
+}
+
+func withThirdHop(options option.ExecutionHopOptions) option.ExecutionHopOptions {
+	options.Nodes = map[string]string{"demo-a": "demo-b", "demo-b": "demo-exit", "demo-c": "demo-c"}
+	options.ExitChoices = map[string][]string{"demo-exit": {"demo-a", "demo-b", "demo-c"}}
+	return options
+}
+
+func TestForwardProjectionMergesLatestPerformanceAndIdenticalRetryKeepsRevision(t *testing.T) {
+	s, options := dynamicHopFixture(t)
+	next := withThirdHop(options)
+	commit, err := s.PrepareRuntimeForwarding(next)
+	if err != nil {
+		t.Fatal(err)
+	}
+	before, revision := s.ForwardSnapshot()
+	optimized := map[string][]string{"demo-exit": {"demo-b", "demo-a"}}
+	optimizedRevision, err := s.CompareAndSelectExits(optimized, before, revision)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = commit(); err != nil {
+		t.Fatal(err)
+	}
+	actual, applied := s.ForwardSnapshot()
+	if !slices.Equal(actual["demo-exit"], []string{"demo-b", "demo-a", "demo-c"}) || applied == optimizedRevision {
+		t.Fatal("resource publication reset a later optimization or retained its stale revision", actual)
+	}
+	if _, err = s.CompareAndSelectExits(optimized, optimized, optimizedRevision); !errors.Is(err, ErrSelectionChanged) {
+		t.Fatal("old optimizer committed against a different graph", err)
+	}
+	if !slices.Equal(s.All(), []string{"reject", "demo-a", "demo-b", "demo-c"}) {
+		t.Fatal("group membership still reads construction-time candidates", s.All())
+	}
+	hash, err := option.RuntimeForwardingHash(next)
+	if err != nil || s.RuntimeForwardingHash() != hash {
+		t.Fatal("applied descriptor hash does not identify the current graph", err)
+	}
+	retry, err := s.PrepareRuntimeForwarding(next)
+	if err != nil {
+		t.Fatal(err)
+	}
+	latest := map[string][]string{"demo-exit": {"demo-c", "demo-b", "demo-a"}}
+	latestRevision, err := s.CompareAndSelectExits(latest, actual, applied)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = retry(); err != nil {
+		t.Fatal(err)
+	}
+	actual, applied = s.ForwardSnapshot()
+	if applied != latestRevision || !reflect.DeepEqual(actual, latest) || s.RuntimeForwardingHash() != hash {
+		t.Fatal("same-View retry or performance change invalidated the applied graph", actual)
+	}
+}
+
+func TestForwardProjectionChangesOnlyNewUnpinnedChoices(t *testing.T) {
+	s, options := dynamicHopFixture(t)
+	before, revision := s.ForwardSnapshot()
+	if _, err := s.CompareAndSelectExits(map[string][]string{"demo-exit": {"demo-b", "demo-a"}}, before, revision); err != nil {
+		t.Fatal(err)
+	}
+	connection := func() *adapter.InboundContext {
+		return &adapter.InboundContext{Execution: &P.Connection{PolicyID: "demo-policy", Path: P.PathContext{
+			OriginID: "demo-source", FinalExitID: "demo-exit", Visited: []string{"demo-a"}}}}
+	}
+	old := connection()
+	if got := s.pinSelection(old); got != "demo-b" || old.ExecutionNextNodeID != "demo-exit" {
+		t.Fatal("old connection did not pin the actual successor", got)
+	}
+	// Removing a recommendation is not withdrawing the receiver's permission.
+	// Its exact current-authorization check remains independent of this graph.
+	options.Nodes = map[string]string{"demo-a": "demo-b", "demo-c": "demo-c"}
+	options.ExitChoices = map[string][]string{"demo-exit": {"demo-c", "demo-a"}}
+	delete(s.outbounds, "demo-c") // New description is not a running component.
+	commit, err := s.PrepareRuntimeForwarding(options)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = commit(); err != nil {
+		t.Fatal(err)
+	}
+	if got := s.pinSelection(old); got != "demo-b" || old.ExecutionNextNodeID != "demo-exit" {
+		t.Fatal("a changed recommendation reselected an existing connection", got)
+	}
+	fresh := connection()
+	if got := s.pinSelection(fresh); got != "demo-a" || fresh.ExecutionNextNodeID != "demo-b" {
+		t.Fatal("new connection used a removed or unmaterialized recommendation", got)
+	}
+	if _, err = s.PrepareRuntimeForwarding(option.ExecutionHopOptions{}); err == nil {
+		t.Fatal("invalid traversal description was accepted")
+	}
+	wrong := dynamicHopOptions()
+	wrong.NodeID = "demo-b"
+	if _, err = s.PrepareRuntimeForwarding(wrong); err == nil {
+		t.Fatal("hot update changed the selector's local identity")
+	}
+}
+
+func TestForwardSnapshotRemainsWholeDuringConcurrentRecommendations(t *testing.T) {
+	s, initial := dynamicHopFixture(t)
+	var workers sync.WaitGroup
+	workers.Add(1)
+	errors := make(chan error, 1)
+	go func() {
+		defer workers.Done()
+		for index := 0; index < 200; index++ {
+			previous := s.selected.Load()
+			if err := previous.hop.validate(previous.exitChoices); err != nil {
+				errors <- err
+				return
+			}
+			next := cloneExitChoices(previous.exitChoices)
+			slices.Reverse(next["demo-exit"])
+			_, _ = s.CompareAndSelectExits(next, previous.exitChoices, previous.revision)
+		}
+	}()
+	for index := 0; index < 200; index++ {
+		next := initial
+		if index%2 == 0 {
+			next = withThirdHop(initial)
+		}
+		commit, err := s.PrepareRuntimeForwarding(next)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if err = commit(); err != nil {
+			t.Fatal(err)
+		}
+		current := s.selected.Load()
+		if err = current.hop.validate(current.exitChoices); err != nil {
+			t.Fatal("observed mixed graph and recommendation snapshots", err)
+		}
+	}
+	workers.Wait()
+	select {
+	case err := <-errors:
+		t.Fatal(err)
+	default:
+	}
+}
+
+func TestHopProjectionOwnsCallerInput(t *testing.T) {
+	options := dynamicHopOptions()
+	hop, err := newHopSelector(options)
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := dynamicHopOptions()
+	options.Policy.Nodes[0] = "demo-other"
+	options.Policy.Exits[0] = "demo-other"
+	options.Policy.Edges[0].To = "demo-other"
+	options.Policy.RelayScope.NodeIDs[0] = "demo-other"
+	options.Nodes["demo-a"] = "demo-other"
+	options.ExitChoices["demo-exit"][0] = "demo-other"
+	if !reflect.DeepEqual(hop.policy, want.Policy) || !reflect.DeepEqual(hop.nodes, want.Nodes) || !reflect.DeepEqual(hop.initial, want.ExitChoices) {
+		t.Fatal("caller changed an immutable compiled forwarding projection")
+	}
+}
