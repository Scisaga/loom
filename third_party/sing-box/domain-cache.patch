+package wireguard
+
+import (
+	"errors"
+	"net/netip"
+
+	"github.com/sagernet/sing-box/common/execution"
+	"github.com/sagernet/sing-box/option"
+)
+
+// This is a deletable cache of the accepted local typed receiving projection,
+// not another permission source. Current execution admission still filters it.
+func (w *Endpoint) makeReceivingProjection(peers []option.WireGuardPeer, routes []option.WireGuardSourceRoute, revision string) (*sourceRouteSnapshot, error) {
+	full, err := w.prepareSourceRoutes(routes, peers)
+	if err != nil {
+		return nil, err
+	}
+	base, err := receivingWireGuardPeers(full, nil, nil)
+	if err != nil {
+		return nil, err
+	}
+	if w.execution == nil {
+		kept := []option.WireGuardPeer{}
+		for _, peer := range base {
+			allowed := []netip.Prefix{}
+			for _, prefix := range peer.AllowedIPs {
+				for _, protected := range w.protectedSources {
+					if protected == prefix {
+						allowed = append(allowed, prefix)
+					}
+				}
+			}
+			peer.AllowedIPs = allowed
+			if len(allowed) > 0 {
+				kept = append(kept, peer)
+			}
+		}
+		base = kept
+	}
+	next, err := w.prepareSourceRoutes(nil, base)
+	if err != nil {
+		return nil, err
+	}
+	next.permissionRevision = revision
+	return next, nil
+}
+func (w *Endpoint) receivingPeersNow() []option.WireGuardPeer {
+	return w.filterReceivingProjection(w.receivingProjection.Load())
+}
+func (w *Endpoint) filterReceivingProjection(projection *sourceRouteSnapshot) []option.WireGuardPeer {
+	if projection == nil {
+		return nil
+	}
+	result := []option.WireGuardPeer{}
+	for _, peer := range projection.peers {
+		allowed := []netip.Prefix{}
+		for _, prefix := range peer.AllowedIPs {
+			protected := false
+			for _, source := range w.protectedSources {
+				protected = protected || source == prefix
+			}
+			if w.execution == nil || protected || w.execution.Echo(prefix.Addr().String(), "") == nil {
+				allowed = append(allowed, prefix)
+			}
+		}
+		if len(allowed) > 0 {
+			peer.AllowedIPs = allowed
+			peer.PersistentKeepaliveInterval = 0
+			result = append(result, peer)
+		}
+	}
+	return result
+}
+func mergeWGPeers(base, wanted []option.WireGuardPeer) ([]option.WireGuardPeer, error) {
+	result := []option.WireGuardPeer{}
+	indices := map[string]int{}
+	for _, set := range [][]option.WireGuardPeer{base, wanted} {
+		for _, peer := range set {
+			if index, exists := indices[peer.PublicKey]; exists {
+				old := result[index]
+				if old.PreSharedKey != peer.PreSharedKey {
+					return nil, errors.Join(execution.ErrSuperseded, errors.New("WG peer authentication differs"))
+				}
+				for _, prefix := range peer.AllowedIPs {
+					found := false
+					for _, prior := range old.AllowedIPs {
+						found = found || prior == prefix
+					}
+					if !found {
+						old.AllowedIPs = append(old.AllowedIPs, prefix)
+					}
+				}
+				if peer.Address != "" || peer.Port != 0 {
+					old.Address, old.Port = peer.Address, peer.Port
+				}
+				old.PersistentKeepaliveInterval = 0
+				result[index] = old
+			} else {
+				peer.AllowedIPs = append([]netip.Prefix(nil), peer.AllowedIPs...)
+				peer.PersistentKeepaliveInterval = 0
+				indices[peer.PublicKey] = len(result)
+				result = append(result, peer)
+			}
+		}
+	}
+	return result, nil
+}
+
+func sendingWGPeers(snapshot *sourceRouteSnapshot) []option.WireGuardPeer {
+	if snapshot == nil {
+		return nil
+	}
+	prefixes := wireGuardSourcePrefixes(snapshot.routes)
+	result := []option.WireGuardPeer{}
+	for _, peer := range snapshot.peers {
+		allowed := peer.AllowedIPs
+		peer.AllowedIPs = nil
+		for _, prefix := range allowed {
+			if prefixes[prefix] {
+				peer.AllowedIPs = append(peer.AllowedIPs, prefix)
+			}
+		}
+		peer.PersistentKeepaliveInterval = 0
+		if len(peer.AllowedIPs) > 0 {
+			result = append(result, peer)
+		}
+	}
+	return result
+}
+func mergeWGRoutes(previous *sourceRouteSnapshot, wanted []option.WireGuardSourceRoute) ([]option.WireGuardSourceRoute, error) {
+	result := []option.WireGuardSourceRoute{}
+	seen := map[netip.Addr]option.WireGuardSourceRoute{}
+	if previous != nil {
+		for _, route := range previous.routes {
+			seen[route.Source] = route
+			result = append(result, route)
+		}
+	}
+	for _, route := range wanted {
+		if old, exists := seen[route.Source]; exists {
+			if old != route {
+				return nil, execution.ErrSuperseded
+			}
+			continue
+		}
+		seen[route.Source] = route
+		result = append(result, route)
+	}
+	return result, nil
+}
+
+func (w *Endpoint) acceptReceivingProjection(next *sourceRouteSnapshot, revision string) error {
+	for {
+		if w.execution != nil && w.execution.State().Revision != revision {
+			return execution.ErrSuperseded
+		}
+		previous := w.receivingProjection.Load()
+		peers, err := mergeWGPeers(w.filterReceivingProjection(previous), next.peers)
+		if err != nil {
+			return err
+		}
+		accepted, err := w.prepareSourceRoutes(nil, peers)
+		if err != nil {
+			return err
+		}
+		accepted.permissionRevision = revision
+		if w.execution != nil && w.execution.State().Revision != revision {
+			return execution.ErrSuperseded
+		}
+		if w.receivingProjection.CompareAndSwap(previous, accepted) {
+			return nil
+		}
+	}
+}
