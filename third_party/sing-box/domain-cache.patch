+			httpServer := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				defer close(finished)
+				if !shutdown {
+					ctx, cancel := context.WithTimeout(r.Context(), 100*time.Millisecond)
+					defer cancel()
+					r = r.WithContext(ctx)
+				}
+				s.serveEgressTunnel(w, r, func(context.Context) (net.Conn, error) {
+					if shutdown {
+						return copyGate, nil
+					}
+					return remote, nil
+				})
+			}))
+			defer httpServer.Close()
+			client, reader := egressRawClient(t, strings.TrimPrefix(httpServer.URL, "http://"), "")
+			if shutdown {
+				closeDone := make(chan error, 1)
+				go func() { closeDone <- s.Close() }()
+				awaitEgress(t, copyGate.entered)
+				select {
+				case err := <-closeDone:
+					t.Fatal("Server.Close returned while an owned copy was blocked", err)
+				default:
+				}
+				releaseCopy()
+				select {
+				case err := <-closeDone:
+					if err != nil {
+						t.Fatal(err)
+					}
+				case <-time.After(2 * time.Second):
+					t.Fatal("Server.Close did not join released copies")
+				}
+				awaitEgress(t, finished)
+			}
+			if data, err := io.ReadAll(reader); len(data) != 0 || err != nil {
+				t.Fatalf("silent stream shutdown %q %v", data, err)
+			}
+			_ = client.Close()
+			awaitEgress(t, finished)
+			if shutdown {
+				w := httptest.NewRecorder()
+				s.serveEgressTunnel(w, httptest.NewRequest(http.MethodConnect, "/loom/egress", nil), func(context.Context) (net.Conn, error) { t.Fatal("dial after Server.Close"); return nil, nil })
+				if w.Code != 503 {
+					t.Fatal("stopped Server accepted new owned I/O", w.Code)
+				}
+			}
+		})
+	}
+}
+
+func TestEgressServerCloseCancelsAndJoinsPendingDial(t *testing.T) {
+	s := newEgressTestServer(t, "demo-local-secret", "127.0.0.1:0")
+	entered, finished := make(chan struct{}), make(chan struct{})
+	go func() {
+		defer close(finished)
+		s.serveEgressTunnel(httptest.NewRecorder(), httptest.NewRequest(http.MethodConnect, "/loom/egress", nil), func(ctx context.Context) (net.Conn, error) { close(entered); <-ctx.Done(); return nil, ctx.Err() })
+	}()
+	awaitEgress(t, entered)
+	if err := s.Close(); err != nil {
+		t.Fatal(err)
+	}
+	awaitEgress(t, finished)
+}
+
+func TestEgressCancelledDialReturnCannotBeatCancellationCallback(t *testing.T) {
+	s := newEgressTestServer(t, "demo-local-secret", "127.0.0.1:0")
+	ctx, cancel := context.WithCancel(context.Background())
+	remote, target := net.Pipe()
+	defer target.Close()
+	observed := &egressObservedConn{Conn: remote, closed: make(chan struct{})}
+	w := httptest.NewRecorder()
+	s.serveEgressTunnel(w, httptest.NewRequest(http.MethodConnect, "/loom/egress", nil).WithContext(ctx), func(context.Context) (net.Conn, error) { cancel(); return observed, nil })
+	if w.Code >= 200 && w.Code < 300 {
+		t.Fatal("cancel callback scheduling produced success", w.Code)
+	}
+	awaitEgress(t, observed.closed)
+}
