+func TestNativeOfferShortWaitAndCloseDoNotWaitForCreatingTransport(t *testing.T) {
+	started := make(chan context.Context, 1)
+	resume := make(chan struct{})
+	client := &Client{ctx: context.Background(), connAccess: make(chan struct{}, 1), dialer: pendingOfferDialer{started: started, resume: resume}}
+	created := make(chan error, 1)
+	go func() { _, err := client.offer(context.Background()); created <- err }()
+	pending := <-started
+	short, cancel := context.WithTimeout(context.Background(), 20*time.Millisecond)
+	defer cancel()
+	waiting := make(chan error, 1)
+	go func() { _, err := client.offer(short); waiting <- err }()
+	select {
+	case err := <-waiting:
+		if !errors.Is(err, context.DeadlineExceeded) {
+			t.Fatal(err)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("short caller waited for another authentication")
+	}
+	if err := client.CloseWithError(errors.New("demo underlay changed")); err != nil {
+		t.Fatal(err)
+	}
+	if !errors.Is(pending.Err(), context.Canceled) {
+		t.Fatal("close did not cancel pending creation")
+	}
+	select {
+	case <-created:
+		t.Fatal("fake creator unexpectedly completed before its I/O joined")
+	default:
+	}
+	close(resume)
+	select {
+	case err := <-created:
+		if !errors.Is(err, context.Canceled) {
+			t.Fatal(err)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("canceled creation did not release offer slot")
+	}
+	if client.pendingCancel != nil || len(client.connAccess) != 0 || client.conn.Load() != nil {
+		t.Fatal("completed cancellation retained pending publication")
+	}
+}
