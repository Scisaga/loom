+func forwardingOptions(policy string, third bool) option.ExecutionHopOptions {
+	nodes := []string{"demo-egress", "demo-forward", "demo-relay-a", "demo-relay-b"}
+	edges := []P.DirectedHop{{From: "demo-forward", To: "demo-relay-a"}, {From: "demo-forward", To: "demo-relay-b"}}
+	if third {
+		nodes = append(nodes, "demo-relay-c")
+		edges = append(edges, P.DirectedHop{From: "demo-forward", To: "demo-relay-c"})
+	}
+	edges = append(edges, P.DirectedHop{From: "demo-relay-a", To: "demo-egress"}, P.DirectedHop{From: "demo-relay-b", To: "demo-egress"})
+	if third {
+		edges = append(edges, P.DirectedHop{From: "demo-relay-c", To: "demo-egress"})
+	}
+	candidates := map[string]string{"demo-a": "demo-relay-a", "demo-b": "demo-relay-b"}
+	order := []string{"demo-a", "demo-b"}
+	if third {
+		candidates["demo-c"] = "demo-relay-c"
+		order = append(order, "demo-c")
+	}
+	return option.ExecutionHopOptions{Policy: P.HopPolicy{PolicyID: policy, ServiceID: "demo-service", Kind: "internet", Origins: []string{}, Nodes: nodes, Edges: edges, Exits: []string{"demo-egress"}, EntryScope: P.PolicyScope{Mode: "any", NodeIDs: []string{}}, RelayScope: P.PolicyScope{Mode: "any", NodeIDs: []string{}}}, NodeID: "demo-forward", Nodes: candidates, ExitChoices: map[string][]string{"demo-egress": order}}
+}
+func forwardingCommit(t *testing.T, f *fixture, desired option.RuntimeResources) {
+	t.Helper()
+	prepared, err := f.pool.Prepare(context.Background(), desired)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer prepared.Close()
+	if err := prepared.Commit(context.Background()); err != nil {
