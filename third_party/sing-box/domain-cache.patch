+
+func ordinaryTCPMetadata() adapter.InboundContext {
+	return adapter.InboundContext{Inbound: "tun-in", Network: "tcp", Execution: &P.Connection{PolicyID: "demo-policy"},
+		ExecutionCandidate: "sha256:" + strings.Repeat("1", 64), ExecutionSelectionRevision: "demo-revision",
+		ExecutionSourceScope: "access", ExecutionSourceTarget: M.ParseSocksaddr("demo-target.example:443"),
+		ExecutionSourceCheck: func() (func(), error) { return func() {}, nil }}
+}
+
+func recordTCPResult(manager *Manager, metadata adapter.InboundContext, started, observed time.Time, cause error) {
+	manager.recordTCPResult(metadata, started, observed, cause, nil)
+}
+
+func snapshotTCP(manager *Manager, at time.Time) []TCPObservation {
+	return manager.TCPObservations(func() time.Time { return at })
+}
+
+func TestTCPObservationsKeepOnlyActualOrdinaryPathOutcomes(t *testing.T) {
+	at := time.UnixMilli(1700000000000)
+	for _, test := range []struct {
+		name string
+		err  error
+		want string
+	}{
+		{"connected", nil, "available"}, {"path-unavailable", execution.ErrUnavailable, "unavailable"},
+		{"refused", syscall.ECONNREFUSED, "unavailable"}, {"deadline", context.DeadlineExceeded, "unknown"},
+		{"confirmation-timeout", &net.OpError{Op: "read", Net: "tcp", Err: context.DeadlineExceeded}, "unknown"},
+		{"dns-not-found", &net.DNSError{Err: "demo nonexistent name", IsNotFound: true}, "unavailable"},
+		{"mixed-deadline", errors.Join(execution.ErrUnavailable, context.DeadlineExceeded), "unknown"},
+		{"denied", execution.ErrDenied, ""}, {"unknown", execution.ErrUnknown, "unknown"},
+		{"cancel", context.Canceled, ""}, {"eof", io.EOF, ""}, {"generic", errors.New("demo error"), "unknown"},
+		{"mixed-denial", errors.Join(execution.ErrUnavailable, execution.ErrDenied), ""},
+		{"mixed-unknown", errors.Join(execution.ErrUnavailable, execution.ErrUnknown), "unknown"},
+		{"mixed-cancel", errors.Join(execution.ErrUnavailable, context.Canceled), ""},
+		{"mixed-generic", errors.Join(execution.ErrUnavailable, errors.New("demo unsupported result")), "unknown"},
+		{"wrapped-mixed", fmt.Errorf("demo: %w", errors.Join(execution.ErrUnavailable, errors.New("demo unknown result"))), "unknown"},
+		{"all-failed", errors.Join(execution.ErrUnavailable, syscall.ENETUNREACH), "unavailable"},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			manager := NewManager()
+			recordTCPResult(manager, ordinaryTCPMetadata(), at, at.Add(time.Millisecond), test.err)
+			values := snapshotTCP(manager, at.Add(time.Second))
+			if test.want == "" {
+				if len(values) != 0 {
+					t.Fatal("non-business outcome became a network failure")
+				}
+				return
+			}
+			if len(values) != 1 || values[0].Result != test.want || values[0].StartedAt != at.UnixMilli() || values[0].ObservedAt != at.Add(time.Millisecond).UnixMilli() {
+				t.Fatal("actual result lost its original attempt or completion")
+			}
+			if test.want == "unknown" && (TCPConnectResult(test.err) != "" || !manager.HasRecentTCPAttempt("demo-policy", "demo-target.example:443", at.Add(time.Second)) || manager.HasRecentTCPAttempt("demo-policy", "demo-target.example:443", at.Add(10*time.Minute))) {
+				t.Fatal("unknown attempt changed health or renewed activity")
+			}
+		})
+	}
+	for _, change := range []func(*adapter.InboundContext){
+		func(m *adapter.InboundContext) { m.Inbound = "loom-link-probe" },
+		func(m *adapter.InboundContext) { m.ExecutionSourceScope = "local_network:demo-service" },
+		func(m *adapter.InboundContext) { m.ExecutionSourceScope = "" },
+		func(m *adapter.InboundContext) { m.Network = "udp" },
+		func(m *adapter.InboundContext) { m.ExecutionSelectionRevision = "" },
+		func(m *adapter.InboundContext) {
+			m.ExecutionSourceCheck = func() (func(), error) { return nil, execution.ErrDenied }
+		},
+	} {
+		manager := NewManager()
+		metadata := ordinaryTCPMetadata()
+		change(&metadata)
+		recordTCPResult(manager, metadata, at, at.Add(time.Millisecond), nil)
+		if len(snapshotTCP(manager, at.Add(time.Second))) != 0 {
+			t.Fatal("unowned or non-ordinary traffic became business evidence")
+		}
+	}
+}
+
+func TestTCPObservationsUseAttemptOrderAndKeepSameTimeConflictUnknown(t *testing.T) {
+	manager := NewManager()
+	metadata := ordinaryTCPMetadata()
+	at := time.UnixMilli(1700000000000)
+	recordTCPResult(manager, metadata, at.Add(time.Second), at.Add(2*time.Second), nil)
+	recordTCPResult(manager, metadata, at.Add(time.Second), at.Add(2500*time.Millisecond), nil)
+	recordTCPResult(manager, metadata, at, at.Add(8*time.Second), execution.ErrUnavailable)
+	values := snapshotTCP(manager, at.Add(9*time.Second))
+	if len(values) != 1 || values[0].Result != "available" || values[0].StartedAt != at.Add(time.Second).UnixMilli() {
+		t.Fatal("old slow failure replaced a newer actual attempt")
+	}
+	recordTCPResult(manager, metadata, at.Add(time.Second), at.Add(3*time.Second), execution.ErrUnavailable)
+	recordTCPResult(manager, metadata, at.Add(time.Second), at.Add(4*time.Second), nil)
+	values = snapshotTCP(manager, at.Add(9*time.Second))
+	if len(values) != 1 || values[0].Result != "unknown" {
+		t.Fatal("a same-time conflict was washed into success")
+	}
+	recordTCPResult(manager, metadata, at.Add(10*time.Second), at.Add(11*time.Second), nil)
+	if snapshotTCP(manager, at.Add(12*time.Second))[0].Result != "available" {
+		t.Fatal("a new real attempt could not replace unknown")
+	}
+}
+
+func TestTCPObservationCacheIsBoundedAndReadsNeverRenewSamples(t *testing.T) {
+	manager := NewManager()
+	at := time.UnixMilli(1700000000000)
+	for i := 0; i < 300; i++ {
+		metadata := ordinaryTCPMetadata()
+		metadata.ExecutionSourceTarget = M.ParseSocksaddr(fmt.Sprintf("demo-%03d.example:443", i))
+		recordTCPResult(manager, metadata, at.Add(time.Duration(i)*time.Millisecond), at.Add(time.Duration(i+1)*time.Millisecond), nil)
+	}
+	values := snapshotTCP(manager, at.Add(time.Second))
+	if len(values) != 128 || values[0].Target != "demo-172.example:443" {
+		t.Fatal("cache did not retain its bounded latest set")
+	}
+	body, err := json.Marshal(struct {
+		Observations []TCPObservation `json:"observations"`
+	}{values})
+	if err != nil || len(body) > 64<<10 {
+		t.Fatal("encoded local snapshot exceeded its bound")
+	}
+	if len(snapshotTCP(manager, at.Add(11*time.Minute))) != 0 {
+		t.Fatal("reading renewed the original sample")
+	}
+}
+
+func TestClosedTCPTrackerCannotPublishALateDial(t *testing.T) {
+	manager := NewManager()
+	at := time.UnixMilli(1700000000000)
+	tracker := &TCPConn{manager: manager, metadata: TrackerMetadata{Metadata: ordinaryTCPMetadata()}}
+	tracker.closed.Store(true)
+	tracker.ObserveTCPConnect(at, at.Add(time.Millisecond), nil)
+	if len(snapshotTCP(manager, at.Add(time.Second))) != 0 {
+		t.Fatal("a closed connection published a late success")
+	}
+}
+
+func TestTCPObservationCacheAlsoBoundsEncodedBytes(t *testing.T) {
+	manager := NewManager()
+	at := time.UnixMilli(1700000000000)
+	for i := 0; i < 160; i++ {
+		metadata := ordinaryTCPMetadata()
+		metadata.ExecutionSelectionRevision = strings.Repeat("r", 128)
+		metadata.Execution.PolicyID = strings.Repeat("p", 128)
+		host := fmt.Sprintf("demo-%03d.", i) + strings.Repeat("a", 63) + "." + strings.Repeat("b", 63) + "." + strings.Repeat("c", 63) + ".example"
+		metadata.ExecutionSourceTarget = M.ParseSocksaddr(host + ":443")
+		recordTCPResult(manager, metadata, at.Add(time.Duration(i)*time.Millisecond), at.Add(time.Duration(i+1)*time.Millisecond), nil)
+	}
+	values := snapshotTCP(manager, at.Add(time.Second))
+	body, err := json.Marshal(struct {
+		Observations []TCPObservation `json:"observations"`
+	}{values})
+	if err != nil || len(body) > 64<<10 || len(values) == 0 || len(values) >= 128 {
+		t.Fatal("long individual records bypassed the snapshot byte bound")
+	}
+}
+
+func TestRecentTCPAttemptUsesOrdinaryAttemptStartWithoutRenewal(t *testing.T) {
+	manager := NewManager()
+	at := time.UnixMilli(1700000000000)
+	metadata := ordinaryTCPMetadata()
+	recordTCPResult(manager, metadata, at, at.Add(7*time.Second), nil)
+	if !manager.HasRecentTCPAttempt("demo-policy", "demo-target.example:443", at.Add(9*time.Minute)) || manager.HasRecentTCPAttempt("demo-policy", "demo-target.example:443", at.Add(10*time.Minute)) || manager.HasRecentTCPAttempt("demo-other", "demo-target.example:443", at.Add(time.Second)) || manager.HasRecentTCPAttempt("demo-policy", "demo-other.example:443", at.Add(time.Second)) || manager.HasRecentTCPAttempt("demo-policy", "demo-target.example:443", at.Add(-time.Second)) {
+		t.Fatal("recent target scope or original attempt deadline changed")
+	}
+	if !manager.HasRecentTCPAttempt("demo-policy", "demo-target.example:443", at.Add(9*time.Minute)) || manager.HasRecentTCPAttempt("demo-policy", "demo-target.example:443", at.Add(10*time.Minute)) {
+		t.Fatal("checking a target renewed its activity")
+	}
+}
