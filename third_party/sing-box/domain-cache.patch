+// A dial coordinate is not a peer identity change. Keep the old flow leased
+// while the current finite resource workset changes only that peer endpoint.
+func TestWGCoordinateChangeDoesNotWaitForExistingLease(t *testing.T) {
+	for _, firstChangeBeforeLease := range []bool{false, true} {
+		name := "change_with_live_flow"
+		if firstChangeBeforeLease {
+			name = "repeat_current_after_idle_change"
+		}
+		t.Run(name, func(t *testing.T) {
+			f := newFixture(t)
+			factory := service.FromContext[adapter.OutboundRegistry](f.ctx).(*OB.Registry)
+			epFactory := service.FromContext[adapter.EndpointRegistry](f.ctx).(*EP.Registry)
+			OB.Register[option.DirectOutboundOptions](factory, C.TypeDirect, func(ctx context.Context, _ adapter.Router, _ log.ContextLogger, tag string, _ option.DirectOutboundOptions) (adapter.Outbound, error) {
+				return &transport{ctx: ctx, tag: tag, kind: C.TypeDirect}, nil
+			})
+			var endpoint *wgEndpoint
+			EP.Register[option.WireGuardEndpointOptions](epFactory, C.TypeWireGuard, func(ctx context.Context, _ adapter.Router, _ log.ContextLogger, tag string, options option.WireGuardEndpointOptions) (adapter.Endpoint, error) {
+				endpoint = &wgEndpoint{transport: transport{ctx: ctx, tag: tag, kind: C.TypeWireGuard}, peers: options.Peers, routes: options.SourceRoutes}
+				return endpoint, nil
+			})
+			original := wgRequest("demo-a", "fdab:77::1", "fdab:79::1", true)
+			original.WireGuard.Peers[0].Address = "192.0.2.10"
+			original.WireGuard.Peers[0].Port = 51820
+			apply := func(request option.RuntimeResources) {
+				t.Helper()
+				prepared, err := f.pool.Prepare(context.Background(), request)
+				if err != nil {
+					t.Fatalf("same authenticated peer coordinate update blocked by legal old flow: %v", err)
+				}
+				defer prepared.Close()
+				if err := prepared.Commit(context.Background()); err != nil {
+					t.Fatal(err)
+				}
+			}
+			apply(original)
+			next := wgRequest("demo-a", "fdab:77::1", "fdab:79::1", true)
+			next.WireGuard.Peers[0].Address = "192.0.2.11"
+			next.WireGuard.Peers[0].Port = 51821
+			if firstChangeBeforeLease {
+				apply(next)
+			}
+			lease, err := f.pool.Acquire(context.Background(), "demo-a")
+			if err != nil {
+				t.Fatal(err)
+			}
+			left, right := net.Pipe()
+			defer right.Close()
+			conn, err := lease.BindConn(left)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer conn.Close()
+			lease.Release()
+			apply(next)
+			endpoint.mu.Lock()
+			peers := append([]option.WireGuardPeer{}, endpoint.peers...)
+			endpoint.mu.Unlock()
+			if len(peers) != 1 || peers[0].Address != "192.0.2.11" || peers[0].Port != 51821 {
+				t.Fatal("new connections did not receive the current authenticated peer coordinate")
+			}
+			// No new flow needs this transport, but the actual old flow keeps its
+			// binding. Its old construction-time endpoint must not overwrite B.
+			empty := option.RuntimeResources{Forwarding: map[string]option.ExecutionHopOptions{}, Outbounds: []option.Outbound{}, WireGuard: &option.RuntimeWireGuard{Tag: "wg-shared", SourceRoutes: []option.WireGuardSourceRoute{}, Peers: []option.WireGuardPeer{}}}
+			apply(empty)
+			endpoint.mu.Lock()
+			retiredPeers := append([]option.WireGuardPeer{}, endpoint.peers...)
+			endpoint.mu.Unlock()
+			if len(retiredPeers) != 1 || retiredPeers[0].Address != "192.0.2.11" || retiredPeers[0].Port != 51821 {
+				t.Fatal("retirement revived the construction-time WG coordinate")
+			}
+			if endpoint.closed.Load() != 0 || lease.Outbound().(*transport).closed.Load() != 0 {
+				t.Fatal("coordinate change closed the instance or leased actual sender")
+			}
+			done := make(chan error, 1)
+			go func() { _, err := right.Write([]byte("ok")); done <- err }()
+			_ = conn.SetReadDeadline(time.Now().Add(time.Second))
+			var body [2]byte
+			if _, err := io.ReadFull(conn, body[:]); err != nil || string(body[:]) != "ok" {
+				t.Fatal("old connection stopped", err)
+			}
+			if err := <-done; err != nil {
+				t.Fatal(err)
+			}
+		})
+	}
