+)
+
+// This is disposable execution state; every member and its Policy comes from
+// the accepted profile. The private API cannot insert a candidate or a grant.
+type selectorChoice struct {
+	revision    string
+	leases      []*sourcepool.Lease
+	hop         *hopSelector
+	access      *AccessSnapshot
+	exitChoices map[string][]string
+	fallback    adapter.Outbound
+	targets     map[string]adapter.Outbound
+}
+
+func canonicalTarget(value string) bool {
+	host, port, err := net.SplitHostPort(value)
+	number, errPort := strconv.ParseUint(port, 10, 16)
+	if err != nil || errPort != nil || number == 0 || strconv.FormatUint(number, 10) != port || host == "" || strings.ToLower(host) != host || strings.HasSuffix(host, ".") {
+		return false
+	}
+	if addr, err := netip.ParseAddr(host); err == nil {
+		return addr.Zone() == "" && !addr.Is4In6() && addr.String() == host && net.JoinHostPort(host, port) == value
+	}
+	return M.IsDomainName(host) && !strings.ContainsAny(host, "*:/@") && net.JoinHostPort(host, port) == value
+}
+
+// SelectTargets validates the complete replacement before a single atomic
+// application. No existing connection is interrupted by performance updates.
+func (s *Selector) SelectTargets(tag string, targets map[string]string) bool {
+	_, err := s.selectTargets(tag, targets, nil, nil, nil)
+	return err == nil
+}
+
+var ErrSelectionChanged = errors.New("selector changed before application")
+
+// CompareAndSelectTargets protects a complete default/target calculation from
+// a later user operation. Expected values are readbacks, never authority.
+func (s *Selector) CompareAndSelectTargets(tag string, targets map[string]string, expected string, expectedTargets map[string]string, expectedRevision string) (string, error) {
+	return s.selectTargets(tag, targets, &expected, expectedTargets, &expectedRevision)
+}
+
+func (s *Selector) selectTargets(tag string, targets map[string]string, expected *string, expectedTargets map[string]string, expectedRevision *string) (string, error) {
+	if s.access.Load() != nil {
+		if expected != nil || tag != "reject" || len(targets) != 0 {
+			return "", errors.New("access requires a complete Policy/choice snapshot")
+		}
+		return s.initializeAccess()
+	}
+	fallback, loaded := s.outbounds[tag]
+	if !loaded {
+		return "", errors.New("unknown selector candidate")
+	}
+	choice := &selectorChoice{fallback: fallback, targets: map[string]adapter.Outbound{}}
+	if s.hop != nil {
+		if tag != "reject" || len(targets) != 0 {
+			return "", errors.New("forward selector updates use per-exit choices")
+		}
+		choice.hop = s.hop
+		choice.exitChoices = cloneExitChoices(s.hop.initial)
+	}
+	policy := s.candidatePolicies[tag]
+	for target, candidate := range targets {
+		outbound, found := s.outbounds[candidate]
+		if policy == "" || !found || s.candidatePolicies[candidate] != policy || !canonicalTarget(target) {
+			return "", errors.New("target is outside the selected Policy")
+		}
+		choice.targets[target] = outbound
+	}
+	var nonce [32]byte
+	if _, err := rand.Read(nonce[:]); err != nil {
+		return "", err
+	}
+	choice.revision = base64.RawURLEncoding.EncodeToString(nonce[:])
+	var previous *selectorChoice
+	for {
+		previous = s.selected.Load()
+		if s.hop != nil && previous != nil && previous.hop != nil {
+			choice.hop, choice.exitChoices = previous.hop, previous.exitChoices
+		}
+		if expected != nil {
+			if previous == nil || expectedRevision == nil || previous.revision != *expectedRevision || previous.fallback.Tag() != *expected || len(previous.targets) != len(expectedTargets) {
+				return "", ErrSelectionChanged
+			}
+			for target, outbound := range previous.targets {
+				if expectedTargets[target] != outbound.Tag() {
+					return "", ErrSelectionChanged
+				}
+			}
+		}
+		if s.selected.CompareAndSwap(previous, choice) {
+			break
+		}
+		if expected != nil {
+			return "", ErrSelectionChanged
+		}
+	}
+	if previous != nil && previous.fallback == fallback && sameTargetChoices(previous.targets, choice.targets) {
+		return choice.revision, nil
+	}
+	if s.interruptExternalConnections {
+		s.interruptGroup.Interrupt(true)
+	}
+	// Runtime selections are observations, not a second persistent preference.
+	// Loom profiles disable the generic selected-outbound cache.
+	return choice.revision, nil
+}
+
+func (s *Selector) RequiresPolicyComparison() bool { return s.candidatePolicies != nil }
+
+func sameTargetChoices(a, b map[string]adapter.Outbound) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for k, v := range a {
+		if b[k] != v {
+			return false
+		}
+	}
+	return true
+}
+
+func (s *Selector) TargetSelections() map[string]string {
+	_, targets, _ := s.SelectionSnapshot()
+	return targets
+}
+
+func (s *Selector) ExecutionSnapshot() (string, map[string]string, map[string][]string, string) {
+	targets := map[string]string{}
+	if choice := s.selected.Load(); choice != nil {
+		if choice.access != nil {
+			return choice.access.Name, cloneTargets(choice.access.Targets), map[string][]string{}, choice.revision
+		}
+		for target, outbound := range choice.targets {
+			targets[target] = outbound.Tag()
+		}
+		return choice.fallback.Tag(), targets, cloneExitChoices(choice.exitChoices), choice.revision
+	}
+	return "", targets, map[string][]string{}, ""
+}
+func (s *Selector) SelectionSnapshot() (string, map[string]string, string) {
+	name, targets, _, revision := s.ExecutionSnapshot()
+	return name, targets, revision
+}
+
+func (s *Selector) pick(metadata *adapter.InboundContext, destination M.Socksaddr) adapter.Outbound {
+	if metadata != nil {
+		if tag := metadata.SelectedOutbounds[s.Tag()]; tag != "" {
+			if s.access.Load() != nil {
+				return s.pickPinnedAccess(metadata)
+			}
+			if s.hop != nil {
+				if outbound := s.accessOutbound(tag); outbound != nil {
+					return outbound
+				}
+				return s.outbounds["reject"]
+			}
+			if outbound := s.outbounds[tag]; outbound != nil {
+				return outbound
+			}
+		}
+	}
+	choice := s.selected.Load()
+	if choice == nil {
+		if s.access.Load() != nil {
+			recordAccessRejection(metadata, "snapshot-missing", "")
+		}
+		return nil
+	}
+	if s.hop != nil {
+		return s.pickHop(metadata, choice)
+	}
+	if s.access.Load() != nil {
+		return s.pickAccess(metadata, destination, choice)
+	}
+	host := destination.AddrString()
+	if destination.Fqdn != "" {
+		host = strings.ToLower(strings.TrimSuffix(destination.Fqdn, "."))
+	}
+	target := net.JoinHostPort(host, strconv.Itoa(int(destination.Port)))
+	if outbound := choice.targets[target]; outbound != nil {
+		return outbound
+	}
+	return choice.fallback
+}
+
+func (s *Selector) pinSelection(metadata *adapter.InboundContext) string {
+	selected := s.pick(metadata, metadata.Destination)
+	if selected == nil {
+		return ""
+	}
+	if metadata.SelectedOutbounds == nil {
+		metadata.SelectedOutbounds = map[string]string{}
+	}
+	metadata.SelectedOutbounds[s.Tag()] = selected.Tag()
+	return selected.Tag()
+}
