+// egressConnect is a trusted local socket capability, not a Service permission.
+// Ordinary business enters through the access/receiving Policy checks instead.
+func (s *Server) egressConnect(authenticated bool) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		listenHost, _, listenErr := net.SplitHostPort(s.httpServer.Addr)
+		peerHost, _, peerErr := net.SplitHostPort(r.RemoteAddr)
+		listenIP, peerIP := net.ParseIP(listenHost), net.ParseIP(peerHost)
+		if !authenticated || listenErr != nil || peerErr != nil || listenIP == nil || peerIP == nil || !listenIP.IsLoopback() || !peerIP.IsLoopback() {
+			http.Error(w, "egress requires the authenticated local listener", http.StatusForbidden)
+			return
+		}
+		if r.Method != http.MethodConnect || r.ProtoMajor != 1 || r.URL.Path != "/loom/egress" || r.URL.RawQuery != "" || r.URL.ForceQuery || r.ContentLength != 0 || len(r.TransferEncoding) != 0 || len(r.Header.Values("X-Loom-Target")) != 1 {
+			http.Error(w, "invalid egress request", http.StatusBadRequest)
+			return
+		}
+		network, host, port, err := P.ParseConnectionTargetKey(r.Header.Get("X-Loom-Target"))
+		if err != nil || network != "tcp" {
+			http.Error(w, "invalid egress target", http.StatusBadRequest)
+			return
+		}
+		target := M.ParseSocksaddrHostPort(host, port)
+		if target.IsFqdn() && !dialer.PublicInternetName(target.Fqdn) || !target.IsFqdn() && !dialer.PublicInternetAddress(target.Addr) {
+			http.Error(w, "nonpublic egress target", http.StatusForbidden)
+			return
+		}
+		if s.outbound == nil {
+			http.Error(w, "physical egress unavailable", http.StatusServiceUnavailable)
+			return
+		}
+		value, found := s.outbound.Outbound("loom-internet-egress")
+		physical, ok := value.(*direct.Outbound)
+		if !found || !ok || physical == nil || !physical.PublicInternet() {
+			http.Error(w, "physical egress unavailable", http.StatusServiceUnavailable)
+			return
+		}
+		s.serveEgressTunnel(w, r, func(ctx context.Context) (net.Conn, error) {
+			// The public direct resolves through the runtime's authenticated DNS,
+			// protects platform underlay sockets and checks every resolved IP.
+			return physical.DialContext(ctx, network, target)
+		})
+	}
+}
+
+func (s *Server) serveEgressTunnel(w http.ResponseWriter, r *http.Request, dial func(context.Context) (net.Conn, error)) {
+	s.egressMu.Lock()
+	if s.egressStopped {
+		s.egressMu.Unlock()
+		http.Error(w, "physical egress stopped", http.StatusServiceUnavailable)
+		return
+	}
+	s.egressWG.Add(1)
+	owner := s.egressContext
+	s.egressMu.Unlock()
+	defer s.egressWG.Done()
+
+	deadline := time.Now().Add(8 * time.Second)
+	if requestDeadline, ok := r.Context().Deadline(); ok && requestDeadline.Before(deadline) {
+		deadline = requestDeadline
+	}
+	ctx, cancel := context.WithDeadline(owner, deadline)
+	defer cancel()
+	requestCancelled := make(chan struct{})
+	stopRequest := context.AfterFunc(r.Context(), func() {
+		cancel()
+		close(requestCancelled)
+	})
+	var detachOnce sync.Once
+	detachRequest := func() {
+		detachOnce.Do(func() {
+			if !stopRequest() {
+				<-requestCancelled
+			}
+		})
+	}
+	defer detachRequest()
+	if r.Context().Err() != nil {
+		cancel()
+	}
+	remote, err := dial(ctx)
+	if err != nil {
+		status := http.StatusBadGateway
+		if errors.Is(err, sourcepool.ErrConflict) || errors.Is(err, execution.ErrSuperseded) {
+			status = http.StatusConflict
+		} else if errors.Is(err, sourcepool.ErrResourcePending) {
+			status = http.StatusServiceUnavailable
+		}
+		http.Error(w, "physical egress dial failed", status)
+		return
+	}
+	defer remote.Close()
+	if r.Context().Err() != nil {
+		cancel()
+	}
+	if ctx.Err() != nil {
+		http.Error(w, "physical egress cancelled", http.StatusBadGateway)
+		return
+	}
+	hijacker, ok := w.(http.Hijacker)
+	if !ok {
+		http.Error(w, "HTTP/1 required", http.StatusHTTPVersionNotSupported)
+		return
+	}
+	local, buffered, err := hijacker.Hijack()
+	if err != nil {
+		return
+	}
+	defer local.Close()
+	// A hijacked request's context ends when its handler returns. Complete the
+	// cancellation handoff before sending success; the original absolute
+	// deadline and Server-owned lifetime remain in force throughout the copy.
+	detachRequest()
+	if r.Context().Err() != nil {
+		cancel()
+	}
+	if ctx.Err() != nil {
+		return
+	}
+	var closeOnce sync.Once
+	closeBoth := func() { closeOnce.Do(func() { _ = local.Close(); _ = remote.Close() }) }
+	closed := make(chan struct{})
+	stopClose := context.AfterFunc(ctx, func() {
+		closeBoth()
+		close(closed)
+	})
+	defer func() {
+		if !stopClose() {
+			<-closed
+		}
+		closeBoth()
+	}()
+	if local.SetDeadline(deadline) != nil || remote.SetDeadline(deadline) != nil {
+		return
+	}
+	if _, err = buffered.WriteString("HTTP/1.1 200 Connection Established\r\n\r\n"); err == nil {
+		err = buffered.Flush()
+	}
+	if err != nil {
+		return
+	}
+	var copies sync.WaitGroup
+	copies.Add(2)
+	copyOne := func(dst net.Conn, src io.Reader) {
+		defer copies.Done()
+		if _, err := io.Copy(dst, src); err != nil {
+			closeBoth()
+			return
+		}
+		if half, ok := common.Cast[N.WriteCloser](dst); !ok || half.CloseWrite() != nil {
+			closeBoth()
+		}
+	}
+	go copyOne(remote, buffered)
+	go copyOne(local, remote)
+	copies.Wait()
+}
