+
+func TestRetainedWGPeerBindingsUseCurrentSnapshotWithoutWidening(t *testing.T) {
+	source := netip.MustParseAddr("fdab:77::1")
+	target := netip.MustParseAddr("fdab:79::1")
+	prefix := netip.PrefixFrom(target, 128)
+	route := option.WireGuardSourceRoute{Source: source, Execution: target, Destination: prefix}
+	old := option.WireGuardPeer{PublicKey: "demo-key", Address: "192.0.2.10", Port: 51820, AllowedIPs: []netip.Prefix{prefix}}
+	latest := old
+	latest.Address, latest.Port = "192.0.2.11", 51821
+	previous := &sourceRouteSnapshot{routes: []option.WireGuardSourceRoute{route}, peers: []option.WireGuardPeer{latest}}
+	retained := []option.WireGuardPeer{{PublicKey: old.PublicKey, AllowedIPs: append([]netip.Prefix(nil), old.AllowedIPs...)}}
+	peerCopy := append([]option.WireGuardPeer(nil), previous.peers...)
+	for _, wanted := range [][]option.WireGuardPeer{{latest}, {}} {
+		result, err := retainedWireGuardPeers(previous, wanted, retained, []option.WireGuardSourceRoute{route})
+		if err != nil {
+			t.Fatal(err)
+		}
+		if len(result) != 1 || result[0].Address != latest.Address || result[0].Port != latest.Port || (len(result[0].AllowedIPs) != 1 || result[0].AllowedIPs[0] != prefix) {
+			t.Fatal("old bindings restored old coordinates or widened access")
+		}
+		if _, err := (&Endpoint{}).prepareSourceRoutes([]option.WireGuardSourceRoute{route}, result); err != nil {
+			t.Fatal(err)
+		}
+		result[0].AllowedIPs[0] = netip.MustParsePrefix("fdac:79::1/128")
+		if !reflect.DeepEqual(previous.peers, peerCopy) || previous.peers[0].AllowedIPs[0] != prefix {
+			t.Fatal("retention mutated the current immutable snapshot")
+		}
+	}
+	for _, test := range []struct {
+		name             string
+		current          *sourceRouteSnapshot
+		wanted, retained []option.WireGuardPeer
+	}{
+		{"missing_peer", &sourceRouteSnapshot{}, nil, retained},
+		{"missing_current_prefix", &sourceRouteSnapshot{peers: []option.WireGuardPeer{{PublicKey: old.PublicKey}}}, nil, retained},
+		{"changed_actual_authentication", &sourceRouteSnapshot{peers: []option.WireGuardPeer{{PublicKey: old.PublicKey, PreSharedKey: "demo-new-secret", AllowedIPs: []netip.Prefix{prefix}}}}, nil, retained},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			if _, err := retainedWireGuardPeers(test.current, test.wanted, test.retained, nil); !errors.Is(err, execution.ErrSuperseded) {
+				t.Fatal("stale binding was reintroduced", err)
+			}
+		})
+	}
+	removed := &sourceRouteSnapshot{peers: previous.peers}
+	if _, err := retainedWireGuardPeers(removed, []option.WireGuardPeer{latest}, retained, []option.WireGuardSourceRoute{route}); !errors.Is(err, execution.ErrSuperseded) {
+		t.Fatal("retention restored a removed source binding", err)
+	}
+	changedRoute := route
+	changedRoute.Source = netip.MustParseAddr("fdab:77::2")
+	if _, err := retainedWireGuardPeers(previous, []option.WireGuardPeer{latest}, retained, []option.WireGuardSourceRoute{changedRoute}); !errors.Is(err, execution.ErrSuperseded) {
+		t.Fatal("a different source borrowed another binding", err)
+	}
+
+	changed := latest
+	changed.PreSharedKey = "demo-new-secret"
+	if _, err := retainedWireGuardPeers(previous, []option.WireGuardPeer{changed}, retained, []option.WireGuardSourceRoute{route}); err == nil {
+		t.Fatal("leased authentication change was accepted")
+	}
+	// Keeping exact old bindings must not permit a different public key to
+	// claim their destination or hide a duplicate source declaration.
+	foreign := latest
+	foreign.PublicKey = "demo-other-key"
+	result, err := retainedWireGuardPeers(previous, []option.WireGuardPeer{foreign}, retained, []option.WireGuardSourceRoute{route})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err = (&Endpoint{}).prepareSourceRoutes([]option.WireGuardSourceRoute{route}, result); err == nil {
+		t.Fatal("overlapping peer ownership was accepted")
+	}
+	result, err = retainedWireGuardPeers(previous, []option.WireGuardPeer{latest}, retained, []option.WireGuardSourceRoute{route})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err = (&Endpoint{}).prepareSourceRoutes([]option.WireGuardSourceRoute{route, route}, result); err == nil {
+		t.Fatal("duplicate source binding was accepted")
+	}
+}
