+package adapter
+
+import (
+	"context"
+	"errors"
+)
+
+// PinOutboundPath captures the execution decision once, before the tracker and
+// dialer consume it. It owns no persistent state or independent authorization.
+func PinOutboundPath(ctx context.Context, manager OutboundManager, selected Outbound, metadata *InboundContext) (context.Context, func(), error) {
+	ctx = WithContext(ctx, metadata)
+	cleanups := []func(){}
+	cleanup := func() {
+		for i := len(cleanups) - 1; i >= 0; i-- {
+			cleanups[i]()
+		}
+	}
+	seen := map[string]bool{}
+	for selected != nil {
+		if initializer, ok := selected.(interface{ PinExecution(*InboundContext) error }); ok {
+			if err := initializer.PinExecution(metadata); err != nil {
+				return ctx, cleanup, err
+			}
+		}
+		group, ok := selected.(OutboundGroup)
+		if !ok {
+			metadata.ExecutionSenderTag, metadata.ExecutionSenderAuthenticationDigest = "", ""
+			if sender, ok := selected.(interface{ OutboundAuthenticationDigest() string }); ok {
+				if digest := sender.OutboundAuthenticationDigest(); digest != "" {
+					metadata.ExecutionSenderTag, metadata.ExecutionSenderAuthenticationDigest = selected.Tag(), digest
+				}
+			}
+			return ctx, cleanup, nil
+		}
+		if seen[selected.Tag()] {
+			return ctx, cleanup, errors.New("outbound selection contains a loop")
+		}
+		seen[selected.Tag()] = true
+		var next string
+		var actual Outbound
+		if pinned, ok := selected.(interface {
+			PinSelection(context.Context, *InboundContext) (context.Context, Outbound, func(), error)
+		}); ok {
+			var release func()
+			var err error
+			ctx, actual, release, err = pinned.PinSelection(ctx, metadata)
+			if release != nil {
+				cleanups = append(cleanups, release)
+			}
+			if err != nil {
+				return ctx, cleanup, err
+			}
+			if actual != nil {
+				next = actual.Tag()
+			}
+		} else {
+			next = group.Now()
+			actual, _ = manager.Outbound(next)
+		}
+		if metadata.SelectedOutbounds == nil {
+			metadata.SelectedOutbounds = map[string]string{}
+		}
+		metadata.SelectedOutbounds[selected.Tag()] = next
+		if actual == nil {
+			return ctx, cleanup, errors.New("selected outbound is unavailable")
+		}
+		selected = actual
+	}
+	return ctx, cleanup, nil
+}
