+func TestTargetOptimizationKeepsEstablishedTCPAndChangesOnlyNewDials(t *testing.T) {
+	listen := func(identity byte) string {
+		listener, err := net.Listen("tcp", "127.0.0.1:0")
+		if err != nil {
+			t.Fatal(err)
+		}
+		t.Cleanup(func() { _ = listener.Close() })
+		go func() {
+			for {
+				conn, err := listener.Accept()
+				if err != nil {
+					return
+				}
+				go func() {
+					defer conn.Close()
+					_ = conn.SetDeadline(time.Now().Add(5 * time.Second))
+					var input [1]byte
+					for {
+						if _, err := io.ReadFull(conn, input[:]); err != nil {
+							return
+						}
+						if _, err := conn.Write([]byte{identity, input[0]}); err != nil {
+							return
+						}
+					}
+				}()
+			}
+		}()
+		return listener.Addr().String()
+	}
+	s := targetSelector()
+	s.outbounds["demo-a"] = realTargetOutbound{targetOutbound("demo-a"), listen('a')}
+	s.outbounds["demo-b"] = realTargetOutbound{targetOutbound("demo-b"), listen('b')}
+	if !s.SelectTargets("demo-a", map[string]string{}) {
+		t.Fatal("initial selection failed")
+	}
+	request := M.ParseSocksaddr("demo.example:443")
+	metadata := &adapter.InboundContext{Destination: request}
+	s.pinSelection(metadata)
+	ctx := adapter.WithContext(context.Background(), metadata)
+	connection, err := s.DialContext(ctx, "tcp", request)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer connection.Close()
+	exchange := func(conn net.Conn, want byte) {
+		t.Helper()
+		_ = conn.SetDeadline(time.Now().Add(time.Second))
+		if _, err := conn.Write([]byte{'x'}); err != nil {
+			t.Fatal("established connection was interrupted", err)
+		}
+		var reply [2]byte
+		if _, err := io.ReadFull(conn, reply[:]); err != nil || reply != [2]byte{want, 'x'} {
+			t.Fatal("connection changed its actual transport", reply, err)
+		}
+	}
+	exchange(connection, 'a')
+	if _, err := s.CompareAndSelectTargets("demo-b", map[string]string{}, "demo-a", map[string]string{}, selectorRevision(s)); err != nil {
+		t.Fatal(err)
+	}
+	exchange(connection, 'a')
+	fresh, err := s.DialContext(context.Background(), "tcp", request)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer fresh.Close()
+	exchange(fresh, 'b')
+	if _, err := s.CompareAndSelectTargets("demo-b", map[string]string{"demo.example:443": "demo-a"}, "demo-b", map[string]string{}, selectorRevision(s)); err != nil {
+		t.Fatal(err)
+	}
+	exchange(connection, 'a')
+	exchange(fresh, 'b')
+	target, err := s.DialContext(context.Background(), "tcp", request)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer target.Close()
+	exchange(target, 'a')
+}
+
+func TestPolicySelectorRejectsImplicitConnectionInterruption(t *testing.T) {
+	_, err := NewSelector(context.Background(), nil, nil, "access", option.SelectorOutboundOptions{
+		Outbounds: []string{"reject", "demo-a"}, CandidatePolicies: map[string]string{"demo-a": "demo-policy"}, InterruptExistConnections: true,
+	})
+	if err == nil {
+		t.Fatal("Loom selector accepted an option that interrupts performance switches")
+	}
+}
+
+func TestTargetSelectionsAreExactPolicyBoundAndPinnedPerConnection(t *testing.T) {
+	s := targetSelector()
+	if !s.SelectTargets("demo-a", map[string]string{"api.example:443": "demo-b", "192.0.2.1:8443": "demo-b"}) {
+		t.Fatal("valid target choices rejected")
+	}
+	for _, tt := range []struct {
+		host string
+		port uint16
+		want string
+	}{{"api.example", 443, "demo-b"}, {"API.EXAMPLE.", 443, "demo-b"}, {"api.example", 8443, "demo-a"}, {"other.example", 443, "demo-a"}, {"192.0.2.1", 8443, "demo-b"}} {
+		if got := s.pick(nil, M.ParseSocksaddrHostPort(tt.host, tt.port)).Tag(); got != tt.want {
+			t.Fatal(tt, got)
+		}
+	}
+	metadata := adapter.InboundContext{Destination: M.ParseSocksaddr("api.example:443")}
+	if s.pinSelection(&metadata) != "demo-b" {
+		t.Fatal("target was not pinned")
+	}
+	if !s.SelectTargets("demo-a", map[string]string{}) {
+		t.Fatal("target update failed")
+	}
+	if s.pick(&metadata, metadata.Destination).Tag() != "demo-b" || s.pick(nil, metadata.Destination).Tag() != "demo-a" {
+		t.Fatal("new preference changed an existing connection or did not affect a new one")
+	}
+	for _, item := range []struct{ target, candidate string }{{"api.example:443", "demo-fixed"}, {"API.example:443", "demo-b"}, {"api.example:0443", "demo-b"}, {"api.example:0", "demo-b"}, {"api.example:443", "missing"}} {
+		if s.SelectTargets("demo-a", map[string]string{item.target: item.candidate}) {
+			t.Fatal("invalid/cross-Policy target accepted", item)
+		}
+		if s.Now() != "demo-a" || len(s.TargetSelections()) != 0 {
+			t.Fatal("invalid update was partially applied")
+		}
+	}
+
+	if !s.SelectTargets("demo-a", map[string]string{"api.example:443": "demo-b"}) || !s.SelectOutbound("demo-fixed") || len(s.TargetSelections()) != 0 {
+		t.Fatal("manual Policy change kept target routes from another Policy")
+	}
+}
+
+func TestSupersededOptimizationCannotOverwritePolicyOrTargetChoice(t *testing.T) {
+	s := targetSelector()
+	s.SelectTargets("demo-a", map[string]string{"api.example:443": "demo-b"})
+	// A user operation wins after the optimization read its starting values.
+	s.SelectTargets("demo-fixed", nil)
+	if _, err := s.CompareAndSelectTargets("demo-b", map[string]string{}, "demo-a", map[string]string{"api.example:443": "demo-b"}, selectorRevision(s)); !errors.Is(err, ErrSelectionChanged) {
+		t.Fatal("an old optimization overwrote a manual Policy", err)
+	}
+	if s.Now() != "demo-fixed" {
+		t.Fatal("manual Policy was reverted")
+	}
+	s.SelectTargets("demo-a", map[string]string{})
+	if _, err := s.CompareAndSelectTargets("demo-b", map[string]string{}, "demo-a", map[string]string{"api.example:443": "demo-b"}, selectorRevision(s)); !errors.Is(err, ErrSelectionChanged) {
+		t.Fatal("target changes with the same default escaped comparison", err)
+	}
+	if _, err := s.CompareAndSelectTargets("demo-b", map[string]string{"api.example:443": "demo-a"}, "demo-a", map[string]string{}, selectorRevision(s)); err != nil {
+		t.Fatal("current atomic update rejected", err)
+	}
+	if s.Now() != "demo-b" || s.TargetSelections()["api.example:443"] != "demo-a" {
+		t.Fatal("complete choice was not applied")
+	}
+}
+
+func TestSelectorOptimizationKeepsExistingInternalAndExternalConnections(t *testing.T) {
+	s := targetSelector()
+	s.SelectTargets("demo-a", nil)
+	for _, external := range []bool{false, true} {
+		a, b := net.Pipe()
+		tracked := s.interruptGroup.NewConn(a, external)
+		defer tracked.Close()
+		defer b.Close()
+		if !s.SelectTargets("demo-b", nil) {
+			t.Fatal("switch failed")
+		}
+		done := make(chan error, 1)
+		go func() { _, err := b.Write([]byte{1}); done <- err }()
+		buf := make([]byte, 1)
+		if _, err := tracked.Read(buf); err != nil || buf[0] != 1 {
+			t.Fatal("performance update interrupted a connection", external, err)
+		}
+		if err := <-done; err != nil {
+			t.Fatal(err)
+		}
+	}
+}
+
+func TestConcurrentTargetSnapshotsNeverMixPolicies(t *testing.T) {
+	s := targetSelector()
+	s.SelectTargets("demo-a", nil)
+	var wg sync.WaitGroup
+	for i := 0; i < 4; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			for n := 0; n < 100; n++ {
+				if n%2 == 0 {
+					s.SelectTargets("demo-a", map[string]string{"api.example:443": "demo-b"})
+				} else {
+					s.SelectTargets("demo-fixed", nil)
+				}
+				choice := s.selected.Load()
+				for _, outbound := range choice.targets {
+					if s.candidatePolicies[choice.fallback.Tag()] != s.candidatePolicies[outbound.Tag()] {
+						t.Error("mixed Policy snapshot")
+					}
+				}
+			}
+		}()
+	}
+	wg.Wait()
+}
+
+func selectorRevision(s *Selector) string { _, _, revision := s.SelectionSnapshot(); return revision }
+
+func TestSupersededOptimizationRejectsAnIdenticalStateAfterUserChanges(t *testing.T) {
+	s := targetSelector()
+	s.SelectTargets("demo-a", map[string]string{})
+	revision := selectorRevision(s)
+	s.SelectTargets("demo-b", map[string]string{})
+	s.SelectTargets("demo-a", map[string]string{})
