+package execution
+
+import (
+	"context"
+	"reflect"
+	"testing"
+
+	P "github.com/sagernet/sing-box/common/loomprotocol"
+	"github.com/sagernet/sing-box/option"
+	M "github.com/sagernet/sing/common/metadata"
+)
+
+func TestPrepareContextPreservesTrustedForwardBindingAndRejectsReplacement(t *testing.T) {
+	want := P.Connection{PolicyID: "demo-policy", Path: P.PathContext{OriginID: "demo-access", FinalExitID: "demo-exit", Visited: []string{"demo-entry"}}}
+	ctx := P.WithConnection(context.Background(), want)
+	for _, route := range []*option.ExecutionRoute{{}, {PolicyID: "demo-policy"}} {
+		prepared, got, err := PrepareContext(ctx, route)
+		if err != nil {
+			t.Fatal(err)
+		}
+		stored, ok := P.ConnectionFrom(prepared)
+		if err != nil || !ok || !reflect.DeepEqual(got, want) || !reflect.DeepEqual(stored, want) {
+			t.Fatal("forward changed the original Policy, origin, exit or history", got, err)
+		}
+	}
+	for _, test := range []struct {
+		name  string
+		route *option.ExecutionRoute
+	}{
+		{"missing-binding", nil},
+		{"different-policy", &option.ExecutionRoute{PolicyID: "demo-other-policy"}},
+		{"replace-final-exit", &option.ExecutionRoute{FinalExitID: "demo-other-exit"}},
+		{"replace-local-node", &option.ExecutionRoute{LocalNodeID: "demo-entry"}},
+		{"replace-origin", &option.ExecutionRoute{PolicyID: want.PolicyID, OriginID: "demo-other-access", FinalExitID: want.Path.FinalExitID}},
+		{"drop-visited-history", &option.ExecutionRoute{PolicyID: want.PolicyID, OriginID: want.Path.OriginID, FinalExitID: want.Path.FinalExitID}},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			if _, _, err := PrepareContext(ctx, test.route); err == nil {
+				t.Fatal("sending binding replaced an existing connection")
+			}
+		})
+	}
+	if _, _, err := PrepareContext(context.Background(), &option.ExecutionRoute{}); err == nil {
+		t.Fatal("forward invented a connection without an admitted origin")
+	}
+	initial := &option.ExecutionRoute{PolicyID: want.PolicyID, OriginID: want.Path.OriginID, FinalExitID: want.Path.FinalExitID}
+	initialContext, original, err := PrepareContext(context.Background(), initial)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, change := range []func(*option.ExecutionRoute){
+		func(route *option.ExecutionRoute) { route.PolicyID = "demo-other-policy" },
+		func(route *option.ExecutionRoute) { route.OriginID = "demo-other-access" },
+		func(route *option.ExecutionRoute) { route.FinalExitID = "demo-other-exit" },
+	} {
+		route := *initial
+		change(&route)
+		if _, _, err := PrepareContext(initialContext, &route); err == nil {
+			t.Fatal("initial binding silently replaced the pinned identity")
+		}
+	}
+	_, repeated, err := PrepareContext(initialContext, initial)
+	if err != nil || !reflect.DeepEqual(repeated, original) {
+		t.Fatal("unchanged initial binding was not repeatable", err)
+	}
+}
+
+func TestReceiverAuthenticatesSenderAndChecksRequestPolicyIndependently(t *testing.T) {
+	options := receivingFixture()
+	options.Policies[0].Policy.Origins = []string{"demo-access", "demo-other-access"}
+	other := options.Policies[0]
+	other.Policy.PolicyID, other.Policy.Origins = "demo-other-policy", []string{}
+	options.Policies = append(options.Policies, other)
+	r, err := New(options)
+	if err != nil {
+		t.Fatal(err)
+	}
+	connection := P.Connection{PolicyID: "demo-policy", Path: P.PathContext{OriginID: "demo-access", FinalExitID: "demo-exit", Visited: []string{}}}
+	target := M.ParseSocksaddr("demo.example:443")
+	if _, _, err := r.Admit(context.Background(), "demo-principal", connection, target); err != nil {
+		t.Fatal("baseline admission failed", err)
+	}
+	for _, test := range []struct {
+		name   string
+		key    string
+		change func(*P.Connection)
+	}{
+		{"unknown-transport-principal", "demo-unknown", func(*P.Connection) {}},
+		{"another-granted-origin", "demo-principal", func(c *P.Connection) { c.Path.OriginID = "demo-other-access" }},
+		{"unknown-policy", "demo-principal", func(c *P.Connection) { c.PolicyID = "demo-unknown-policy" }},
+		{"current-policy-without-origin-grant", "demo-principal", func(c *P.Connection) { c.PolicyID = "demo-other-policy" }},
+		{"invented-forward-history", "demo-principal", func(c *P.Connection) { c.Path.Visited = []string{"demo-other-access"} }},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			value := connection
+			test.change(&value)
+			if _, _, err := r.Admit(context.Background(), test.key, value, target); err == nil {
+				t.Fatal("request declaration became transport authentication or a grant")
+			}
+		})
+	}
+}
+
+func TestReceiverRestoreRechecksCurrentForwardAuthorization(t *testing.T) {
+	for _, test := range []struct {
+		name   string
+		change func(*option.ExecutionOptions)
+	}{
+		{"origin-withdrawn", func(o *option.ExecutionOptions) { o.Policies[0].Policy.Origins = []string{} }},
+		{"policy-withdrawn", func(o *option.ExecutionOptions) { o.Policies = []option.ExecutionPolicy{} }},
+		{"transport-principal-withdrawn", func(o *option.ExecutionOptions) { o.Bindings = []option.ExecutionBinding{} }},
+		{"exit-withdrawn", func(o *option.ExecutionOptions) { o.Policies[0].Policy.Exits = []string{} }},
+		{"final-role-withdrawn", func(o *option.ExecutionOptions) { o.Responsibilities = []string{"forward"} }},
+		{"link-withdrawn", func(o *option.ExecutionOptions) { o.Policies[0].Policy.Edges = []P.DirectedHop{} }},
+		{"entry-scope-narrowed", func(o *option.ExecutionOptions) {
+			o.Policies[0].Policy.EntryScope = P.PolicyScope{Mode: "none", NodeIDs: []string{}}
+		}},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			options := receivingFixture()
+			options.Bindings[0].SenderID = "demo-entry"
+			options.Policies[0].Policy.Nodes = []string{"demo-entry", "demo-exit"}
+			options.Policies[0].Policy.Edges = []P.DirectedHop{{From: "demo-entry", To: "demo-exit"}}
+			r, err := New(options)
+			if err != nil {
+				t.Fatal(err)
+			}
+			target := M.ParseSocksaddr("demo.example:443")
+			incoming := P.Connection{PolicyID: "demo-policy", Path: P.PathContext{OriginID: "demo-access", FinalExitID: "demo-exit", Visited: []string{"demo-entry"}}}
+			admitted, _, err := r.Admit(context.Background(), "demo-principal", incoming, target)
+			if err != nil {
+				t.Fatal(err)
+			}
+			stored, _ := P.ConnectionFrom(admitted)
+			if _, _, err := r.Restore(context.Background(), "demo-principal", stored, target); err != nil {
+				t.Fatal("unchanged current authorization failed restoration", err)
+			}
+			test.change(&options)
+			if err := r.Update(options); err != nil {
+				t.Fatal(err)
+			}
+			if _, _, err := r.Restore(context.Background(), "demo-principal", stored, target); err == nil {
+				t.Fatal("old admitted context bypassed current revocation")
+			}
+			if _, _, err := r.Admit(context.Background(), "demo-principal", incoming, target); err == nil {
+				t.Fatal("replayed incoming context bypassed current revocation")
+			}
+		})
+	}
+}
