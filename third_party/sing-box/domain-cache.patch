+)
+
+type wireGuardExecutionProbe interface {
+	BindWireGuardExecutionTarget(context.Context, M.Socksaddr) (context.Context, error)
+	DialContext(context.Context, string, M.Socksaddr) (net.Conn, error)
+}
+
+// probeConnect is the one trusted local diagnostic dispatcher. A source probe
+// retains its current Policy choice; an unscoped probe can only address one
+// exact WG execution DNS binding. Neither shape authorizes ordinary traffic.
+func (s *Server) probeConnect(authenticated bool) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		listenHost, _, listenErr := net.SplitHostPort(s.httpServer.Addr)
+		peerHost, _, peerErr := net.SplitHostPort(r.RemoteAddr)
+		listenIP, peerIP := net.ParseIP(listenHost), net.ParseIP(peerHost)
+		if !authenticated || listenErr != nil || peerErr != nil || listenIP == nil || peerIP == nil || !listenIP.IsLoopback() || !peerIP.IsLoopback() {
+			http.Error(w, "probe requires the authenticated local listener", http.StatusForbidden)
+			return
+		}
+		if r.Method != http.MethodConnect || r.ProtoMajor != 1 || r.URL.Path != "/loom/probe" || r.URL.RawQuery != "" || r.URL.ForceQuery || r.ContentLength != 0 || len(r.TransferEncoding) != 0 || len(r.Header.Values("X-Loom-Target")) != 1 || len(r.Header.Values("X-Loom-Scope")) > 1 || len(r.Header.Values("X-Loom-Expected-Revision")) > 1 {
+			http.Error(w, "invalid probe request", http.StatusBadRequest)
+			return
+		}
+		network, host, port, err := P.ParseConnectionTargetKey(r.Header.Get("X-Loom-Target"))
+		if err != nil || network != "tcp" {
+			http.Error(w, "invalid probe target", http.StatusBadRequest)
+			return
+		}
+		target := M.ParseSocksaddrHostPort(host, port)
+		scope, expected := r.Header.Get("X-Loom-Scope"), r.Header.Get("X-Loom-Expected-Revision")
+		if scope != "" {
+			value, found := s.outbound.Outbound(scope)
+			selector, ok := value.(*group.Selector)
+			if !found || !ok || !selector.IsAccessSelector() || expected == "" {
+				http.Error(w, "source probe unavailable", http.StatusForbidden)
+				return
+			}
+			s.serveEgressTunnel(w, r, func(ctx context.Context) (net.Conn, error) {
+				pending, cancel := context.WithCancel(ctx)
+				owned := &tcpCalibrationConn{cancel: cancel}
+				metadata, actual, lease, err := selector.BorrowAccessSelectedTarget(pending, expected, target)
+				if err != nil {
+					cancel()
+					return nil, err
+				}
+				if lease != nil {
+					defer lease.Release()
+				}
+				dialCtx, tracker, cleanup, err := s.pinAccessDiagnostic(pending, selector, &metadata, actual, lease, owned)
+				defer cleanup()
+				if err != nil {
+					cancel()
+					return nil, err
+				}
+				conn, err := actual.DialContext(dialCtx, network, target)
+				if err == nil && conn != nil && lease != nil {
+					conn, err = lease.BindConn(conn)
+				}
+				owned.attach(conn)
+				if err != nil || conn == nil || pending.Err() != nil {
+					tracker.Close()
+					if err == nil {
+						err = errors.New("source probe canceled")
+					}
+					return nil, err
+				}
+				return tracker, nil
+			})
+			return
+		}
+		if expected != "" || target.IsFqdn() || !target.Addr.Is6() || target.Port != 53 || s.endpoint == nil {
+			http.Error(w, "probe target is not an execution DNS binding", http.StatusForbidden)
+			return
+		}
+
+		// Resolve and bind from one immutable current source-route snapshot;
+		// DialContext performs the same current binding check before use.
+		s.serveEgressTunnel(w, r, func(ctx context.Context) (net.Conn, error) {
+			if s.resourcePool == nil {
+				return nil, errors.New("resource executor unavailable")
+			}
+			lease, err := s.resourcePool.AcquireWireGuardExecution(ctx, target)
+			if err != nil {
+				return nil, err
+			}
+			defer lease.Release()
+			value, found := s.endpoint.Get("wg-shared")
+			endpoint, ok := value.(wireGuardExecutionProbe)
+			if !found || !ok {
+				return nil, sourcepool.ErrResourcePending
+			}
+			bound, err := endpoint.BindWireGuardExecutionTarget(lease.Context(), target)
+			if err != nil {
+				return nil, err
+			}
+			conn, err := endpoint.DialContext(bound, network, target)
+			if err != nil {
+				if conn != nil {
+					conn.Close()
+				}
+				return nil, err
+			}
+			return lease.BindConn(conn)
+		})
+	}
+}
+
+// Preparation and graph traversal run before the short current-authorization
+// fence; only tracker registration happens while that fence is held.
+func (s *Server) pinAccessDiagnostic(ctx context.Context, selector *group.Selector, metadata *adapter.InboundContext, selected adapter.Outbound, lease *sourcepool.Lease, owned *tcpCalibrationConn) (context.Context, *trafficontrol.TCPConn, func(), error) {
+	ctx, cleanup := sourcepool.WithCall(ctx)
+	if lease != nil {
+		if err := sourcepool.AddCallBorrow(ctx, lease); err != nil {
+			return ctx, nil, cleanup, err
+		}
+	}
+	var release func()
+	var err error
+	ctx, release, err = adapter.PinOutboundPath(ctx, s.outbound, selected, metadata)
+	defer release()
+	if err != nil {
+		return ctx, nil, cleanup, err
+	}
+	selector.BindAccessConnectionFence(metadata)
+	ctx = adapter.WithContext(ctx, metadata)
+	unlock, principal, target, err := execution.TrackFence(ctx)
+	if err != nil {
+		return ctx, nil, cleanup, err
+	}
+	metadata.ExecutionPrincipal, metadata.ExecutionTarget = principal, target
+	tracker := trafficontrol.NewTCPTracker(owned, s.trafficManager, *metadata, s.outbound, nil, selected)
+	unlock()
+	return ctx, tracker, cleanup, nil
+}
