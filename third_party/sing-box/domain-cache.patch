+package sourcepool
+
+import (
+	"context"
+	"errors"
+	"sort"
+
+	C "github.com/sagernet/sing-box/constant"
+	"github.com/sagernet/sing-box/option"
+)
+
+// A traversal description is a derived recommendation input. Source and
+// receiver snapshots remain the only complete permission checks at use time.
+type forwardingRuntime interface {
+	PrepareRuntimeForwarding(option.ExecutionHopOptions) (func() error, error)
+	RuntimeForwardingHash() string
+}
+
+func (r *Prepared) prepareForwarding(desired map[string]option.ExecutionHopOptions) error {
+	p := r.pool
+	p.mu.Lock()
+	current := make(map[string]*entry, len(p.forwarding))
+	for tag, value := range p.forwarding {
+		current[tag] = value
+	}
+	p.mu.Unlock()
+	tags := make([]string, 0, len(desired))
+	for tag := range desired {
+		tags = append(tags, tag)
+	}
+	sort.Strings(tags)
+	for _, tag := range tags {
+		if tag == "" || r.wanted[tag] != nil {
+			return errors.New("ambiguous forwarding container")
+		}
+		value := desired[tag]
+		if err := r.ctx.Err(); err != nil {
+			return err
+		}
+		actual, exists := p.registry.RuntimeOutbound(tag)
+		if exists {
+			runtime, ok := actual.Outbound.(forwardingRuntime)
+			if !ok {
+				return ErrConflict
+			}
+			hash, err := option.RuntimeForwardingHash(value)
+			if err != nil {
+				return err
+			}
+			var apply func() error
+			if runtime.RuntimeForwardingHash() != hash {
+				apply, err = runtime.PrepareRuntimeForwarding(value)
+				if err != nil {
+					return err
+				}
+			}
+			previous := current[tag]
+			if previous != nil {
+				if !SameObject(previous.registration.Outbound, actual.Outbound) {
+					return ErrConflict
+				}
+			} else {
+				adopted, err := p.registry.AdoptRuntimeOutbound(tag, actual.ConfigHash)
+				if err != nil {
+					return err
+				}
+				previous = &entry{registration: adopted, leases: map[*Lease]struct{}{}}
+			}
+			r.forwarding[tag] = previous
+			if apply != nil {
+				r.applyForwarding = append(r.applyForwarding, apply)
+			}
+			continue
+		}
+		members := []string{"reject"}
+		for member := range value.Nodes {
+			if member == "reject" || member == tag {
+				return errors.New("invalid forwarding transport reference")
+			}
+			members = append(members, member)
+		}
+		sort.Strings(members)
+		bindings := make(map[string]string, len(value.Nodes))
+		for member := range value.Nodes {
+			bindings[member] = value.Policy.PolicyID
+		}
+		constructor := &option.SelectorOutboundOptions{Hop: &value, Outbounds: members, CandidatePolicies: bindings, Default: "reject"}
+		hash, err := ConfigHash(C.TypeSelector, tag, constructor)
+		if err != nil {
+			return err
+		}
+		objectCtx, cancel := context.WithCancel(p.ctx)
+		stop := context.AfterFunc(r.ctx, cancel)
+		candidate, err := p.factory.CreateOutbound(objectCtx, p.router, p.logger, tag, C.TypeSelector, constructor)
+		if err != nil {
+			stop()
+			cancel()
+			return err
+		}
+		owned := &entry{registration: Registration{Outbound: candidate, ConfigHash: hash, Owned: true}, cancel: cancel, stopPrepare: stop, leases: map[*Lease]struct{}{}}
+		r.created = append(r.created, owned)
+		r.forwarding[tag] = owned
+		_, ok := candidate.(forwardingRuntime)
+		if !ok {
+			return errors.New("selector factory lacks dynamic forwarding")
+		}
+		// Constructors compile and own their initial immutable description; Start
+		// remains in the common lock-free preparation pass. No sender must be live.
+	}
+	return nil
+}
+
+// Forwarding reads actual current descriptor hashes, never requested hashes or
+// live performance ordering. A missing/replaced actual object is omitted.
+func (p *Pool) Forwarding() map[string]string {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	result := map[string]string{}
+	if p.closed {
+		return result
+	}
+	for tag, value := range p.forwarding {
+		actual, exists := p.registry.RuntimeOutbound(tag)
+		runtime, ok := value.registration.Outbound.(forwardingRuntime)
+		if exists && SameObject(actual.Outbound, value.registration.Outbound) && ok {
+			if hash := runtime.RuntimeForwardingHash(); ValidHash(hash) {
+				result[tag] = hash
+			}
+		}
+	}
+	return result
+}
