+	"testing"
+)
+
+func TestMessageDescriptorsFollowBatchAndReleasePayload(t *testing.T) {
+	bind := NewStdNetBind(nil).(*StdNetBind)
+	for _, size := range []int{16, IdealBatchSize, 16} {
+		messages := bind.getMessages(size)
+		if len(*messages) != size {
+			t.Fatal("descriptor count differs from admitted batch")
+		}
+		for i := range *messages {
+			(*messages)[i].Buffers[0] = make([]byte, 65535)
+		}
+		bind.putMessages(messages)
+		for _, message := range *messages {
+			if message.Buffers[0] != nil || message.Addr != nil {
+				t.Fatal("idle descriptor retained a previous packet")
+			}
+		}
+	}
+}
+
+func TestMaximumGROAggregateStillSplits(t *testing.T) {
+	bind := NewStdNetBind(nil).(*StdNetBind)
+	messages := bind.getMessages(IdealBatchSize)
+	defer bind.putMessages(messages)
+	for i := range *messages {
+		(*messages)[i].Buffers[0] = make([]byte, 65535)
+	}
+	const segment = 1023
+	peer := &net.UDPAddr{IP: net.IPv4(192, 0, 2, 20), Port: 51820}
+	for i := IdealBatchSize - 2; i < IdealBatchSize; i++ {
+		message := &(*messages)[i]
+		message.N = 64 * segment
+		message.Addr = peer
+		for j := 0; j < 64; j++ {
+			copy(message.Buffers[0][j*segment:(j+1)*segment], bytes.Repeat([]byte{byte(j)}, segment))
+		}
+	}
+	n, err := splitCoalescedMessages(*messages, IdealBatchSize-2, func([]byte) (int, error) { return segment, nil })
+	if err != nil || n != IdealBatchSize {
+		t.Fatalf("unchanged GRO boundary failed: count=%d error=%v", n, err)
+	}
+	for i, message := range *messages {
+		if message.N != segment || !bytes.Equal(message.Buffers[0][:segment], bytes.Repeat([]byte{byte(i % 64)}, segment)) {
+			t.Fatal("GRO changed datagram bytes or boundaries")
+		}
+	}
+}
