+package option
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+)
+
+// RuntimeResources installs the current disposable typed construction and
+// traversal descriptions. Presence does not create a sender or grant authority.
+type RuntimeResources struct {
+	ExpectedRevision       string                         `json:"expected_revision"`
+	AuthorizationRevisions map[string]string              `json:"authorization_revisions"`
+	Outbounds              []Outbound                     `json:"outbounds"`
+	Forwarding             map[string]ExecutionHopOptions `json:"forwarding"`
+	WireGuard              *RuntimeWireGuard              `json:"wireguard,omitempty"`
+}
+
+// RuntimeForwardingHash describes the immutable traversal input, not its live
+// performance order. It uses the same sorted object bytes as the local request.
+func RuntimeForwardingHash(options ExecutionHopOptions) (string, error) {
+	body, err := json.Marshal(options)
+	if err != nil {
+		return "", err
+	}
+	decoder := json.NewDecoder(bytes.NewReader(body))
+	decoder.UseNumber()
+	var fields map[string]any
+	if err = decoder.Decode(&fields); err != nil {
+		return "", err
+	}
+	body, err = json.Marshal(fields)
+	if err != nil {
+		return "", err
+	}
+	sum := sha256.Sum256(body)
+	return "sha256:" + hex.EncodeToString(sum[:]), nil
+}
+
+type RuntimeWireGuard struct {
+	Tag          string                    `json:"tag"`
+	Initializer  *WireGuardEndpointOptions `json:"initializer,omitempty"`
+	SourceRoutes []WireGuardSourceRoute    `json:"source_routes"`
+	Peers        []WireGuardPeer           `json:"peers"`
+}
