+)
+
+func rejectionRevisionHash(revision string) string {
+	sum := sha256.Sum256([]byte(revision))
+	return hex.EncodeToString(sum[:])
+}
+func selectRejectionFixture(t *testing.T) (*Selector, option.ExecutionAccessOptions, P.RouteChoice) {
+	t.Helper()
+	s, options, a, _ := accessFixture(t)
+	id, choices := sourceChoice(t, a)
+	if _, err := s.CompareAndSelectAccess(context.Background(), AccessSnapshot{Name: id, PolicyID: "demo-policy", Choices: choices, Targets: map[string]string{}}, s.AccessSnapshot()); err != nil {
+		t.Fatal(err)
+	}
+	return s, options, a
+}
+
+func TestAccessRejectionRecordsExactGuardWithoutChangingState(t *testing.T) {
+	for _, test := range []string{"snapshot-reject", "snapshot-missing", "authorization-unavailable", "policy-ungranted", "target-disallowed", "choice-missing", "choice-ineligible", "sender-not-materialized", "sender-authentication-mismatch"} {
+		t.Run(test, func(t *testing.T) {
+			s, options, _ := selectRejectionFixture(t)
+			current := s.selected.Load()
+			replace := func() {
+				a, err := newAccessSelector(options)
+				if err != nil {
+					t.Fatal(err)
+				}
+				s.access.Store(a)
+			}
+			switch test {
+			case "snapshot-reject":
+				if _, err := s.CompareAndSelectAccess(context.Background(), AccessSnapshot{Name: "reject", Targets: map[string]string{}, Choices: map[string]P.RouteChoice{}}, s.AccessSnapshot()); err != nil {
+					t.Fatal(err)
+				}
+				current = s.selected.Load()
+			case "snapshot-missing":
+				owned := *current
+				owned.access = nil
+				current = &owned
+			case "authorization-unavailable":
+				s.access.Store(nil)
+			case "policy-ungranted":
+				options.Policies = []option.ExecutionPolicy{}
+				replace()
+			case "target-disallowed":
+				empty := []option.DirectTarget{}
+				options.Policies[0].AllowedTargets = &empty
+				replace()
+			case "choice-missing":
+				owned := *current
+				value := cloneAccess(*current.access)
+				value.Choices = map[string]P.RouteChoice{}
+				owned.access = &value
+				current = &owned
+			case "choice-ineligible":
+				entry := options.Entries["demo-resource-a"]
+				entry.AccessEnabled = false
+				options.Entries["demo-resource-a"] = entry
+				replace()
+			case "sender-not-materialized":
+				s.outbound = accessRunningOutbounds{running: map[string]adapter.Outbound{}}
+			case "sender-authentication-mismatch":
+				s.outbound = accessRunningOutbounds{running: map[string]adapter.Outbound{"demo-a": targetOutbound("demo-b")}}
+			}
+			before, auth, pointer := s.AccessSnapshot(), s.AccessAuthorizationState(), s.selected.Load()
+			metadata := &adapter.InboundContext{Network: "tcp", Destination: M.ParseSocksaddr("demo.example:443")}
+			if got := s.pickAccess(metadata, metadata.Destination, current); got == nil || got.Tag() != "reject" {
+				t.Fatal("guard did not retain rejection")
+			}
+			if metadata.ExecutionAccessRejectReason != test || metadata.ExecutionAccessRejectRevision != rejectionRevisionHash(current.revision) {
+				t.Fatal("wrong originating branch or snapshot", metadata.ExecutionAccessRejectReason)
+			}
+			if !reflect.DeepEqual(s.AccessSnapshot(), before) || s.AccessAuthorizationState() != auth || s.selected.Load() != pointer {
+				t.Fatal("diagnostics altered authorization or selection")
+			}
+			if metadata.Execution != nil {
+				t.Fatal("rejection manufactured a connection context")
+			}
+		})
+	}
+}
+
+type rejectionDiagnosticLogger struct {
+	logger.ContextLogger
+	lines  []string
+	values []any
+}
+type rejectionContextKey struct{}
+
+func (l *rejectionDiagnosticLogger) WarnContext(ctx context.Context, args ...any) {
+	l.lines = append(l.lines, fmt.Sprint(args...))
+	l.values = append(l.values, ctx.Value(rejectionContextKey{}))
+}
+
+type rejectionDiagnosticHandler struct {
+	targetOutbound
+	seen *adapter.InboundContext
+}
+
+func (h rejectionDiagnosticHandler) OutboundAuthenticationDigest() string {
+	if h.targetOutbound == "reject" {
+		return ""
+	}
+	return h.targetOutbound.OutboundAuthenticationDigest()
+}
+func (h rejectionDiagnosticHandler) NewConnectionEx(_ context.Context, c net.Conn, m adapter.InboundContext, _ N.CloseHandlerFunc) {
+	*h.seen = m
+	_ = c.Close()
+}
+
+func TestAccessRejectionSurvivesFormalPinAndLaterSelection(t *testing.T) {
+	s, _, a, _ := accessFixture(t)
+	var seen adapter.InboundContext
+	s.outbounds["reject"] = rejectionDiagnosticHandler{targetOutbound("reject"), &seen}
+	log := &rejectionDiagnosticLogger{ContextLogger: logger.NOP()}
+	s.logger = log
+	metadata := &adapter.InboundContext{Network: "tcp", Destination: M.ParseSocksaddr("demo.example:443")}
+	original := s.AccessSnapshot()
+	_, releasePin, pinErr := adapter.PinOutboundPath(context.Background(), s.outbound, s, metadata)
+	defer releasePin()
+	if pinErr != nil {
+		t.Fatal(pinErr)
+	}
+	id, choices := sourceChoice(t, a)
+	if _, err := s.CompareAndSelectAccess(context.Background(), AccessSnapshot{Name: id, PolicyID: "demo-policy", Choices: choices, Targets: map[string]string{}}, original); err != nil {
+		t.Fatal(err)
+	}
+	before := s.AccessSnapshot()
+	left, right := net.Pipe()
+	defer right.Close()
+	s.NewConnectionEx(context.WithValue(context.Background(), rejectionContextKey{}, "demo-context"), left, *metadata, nil)
+	if seen.ExecutionAccessRejectReason != "snapshot-reject" || seen.ExecutionAccessRejectRevision != rejectionRevisionHash(original.Revision) {
+		t.Fatal("later pinned missing context overwrote originating rejection")
+	}
+	if len(log.lines) != 1 || log.values[0] != "demo-context" || !strings.Contains(log.lines[0], "reason=snapshot-reject") || !strings.Contains(log.lines[0], rejectionRevisionHash(original.Revision)) {
+		t.Fatal("rejection was not associated with the same connection")
+	}
+	for _, unsafe := range []string{"demo.example", "demo-policy", original.Revision} {
+		if strings.Contains(log.lines[0], unsafe) {
+			t.Fatal("diagnostic expanded protected connection values")
+		}
+	}
+	if !reflect.DeepEqual(s.AccessSnapshot(), before) {
+		t.Fatal("logging changed later selection")
+	}
+}
+
+func TestAccessPinnedRejectionsRetainTheirOwnRevision(t *testing.T) {
+	for _, test := range []string{"pinned-context-missing", "policy-ungranted", "sender-not-materialized"} {
+		t.Run(test, func(t *testing.T) {
