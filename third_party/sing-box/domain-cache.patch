+func prepareRuntimeWireGuardForTest(w *Endpoint, peers []option.WireGuardPeer, routes []option.WireGuardSourceRoute, retained []option.WireGuardPeer, retainedRoutes []option.WireGuardSourceRoute) (func() error, error) {
+	apply, guard, err := w.PrepareRuntimeWireGuardStage(context.Background(), peers, routes, retained, retainedRoutes)
