+func receivingFixture() option.ExecutionOptions {
+	p := P.HopPolicy{PolicyID: "demo-policy", ServiceID: "demo-service", Kind: "internet", Origins: []string{"demo-access"}, Exits: []string{"demo-exit"}, Nodes: []string{"demo-exit"}, EntryScope: P.PolicyScope{Mode: "any", NodeIDs: []string{}}, RelayScope: P.PolicyScope{Mode: "none", NodeIDs: []string{}}, Edges: []P.DirectedHop{}}
+	return option.ExecutionOptions{SenderAuthenticationDigests: map[string]string{}, NodeID: "demo-exit", AccessEnabled: true, Responsibilities: []string{"internet_egress"}, Policies: []option.ExecutionPolicy{{Policy: p, EgressOutbound: "demo-egress", PublicInternet: true}}, Bindings: []option.ExecutionBinding{{Key: "demo-principal", SenderID: "demo-access"}}}
+}
+func TestRevocationFencesDelayedTrackerRegistration(t *testing.T) {
+	options := receivingFixture()
+	r, err := New(options)
+	if err != nil {
+		t.Fatal(err)
+	}
+	path := P.PathContext{OriginID: "demo-access", FinalExitID: "demo-exit", Visited: []string{}}
+	target := M.ParseSocksaddr("api.example:443")
+	ctx, _, err := r.Admit(context.Background(), "demo-principal", P.Connection{PolicyID: "demo-policy", Path: path}, target)
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx = trackedReceiverContext(ctx)
+	release, _, _, err := TrackFence(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	options.Policies[0].Policy.Origins = []string{}
+	entered, done := make(chan struct{}), make(chan error, 1)
+	before := r.State()
+	go func() {
