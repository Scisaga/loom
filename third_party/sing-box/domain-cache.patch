+func TestDescriptionsDoNotConstructUnusedSenders(t *testing.T) {
+	f := newFixture(t)
+	prepared, err := f.pool.Prepare(context.Background(), request(sender("demo-used", "echo"), sender("demo-unused", "fail")))
+	if err != nil {
+		t.Fatal("installing descriptions performed an unused constructor", err)
+	}
+	defer prepared.Close()
+	if err := prepared.Commit(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	if len(f.pool.Actual()) != 0 {
+		t.Fatal("descriptions were materialized without a current use")
+	}
+	f.mu.Lock()
+	unused := len(f.objects["demo-unused"])
+	used := len(f.objects["demo-used"])
+	f.mu.Unlock()
+	if unused != 0 || used != 0 {
+		t.Fatal("description installation constructed a sender")
+	}
