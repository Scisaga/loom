+package execution
+
+import (
+	"errors"
+	"github.com/sagernet/sing/common/buf"
+	M "github.com/sagernet/sing/common/metadata"
+	"net"
+)
+
+// A UDP connection represents one immutable original target. A downstream
+// resolution or measurement update cannot turn it into another target's flow.
+type PacketConn struct {
+	net.PacketConn
+	Target M.Socksaddr
+}
+
+func (c *PacketConn) WriteTo(body []byte, address net.Addr) (int, error) {
+	if M.SocksaddrFromNet(address).Unwrap() != c.Target.Unwrap() {
+		return 0, errors.New("UDP target differs from its execution registration")
+	}
+	return c.PacketConn.WriteTo(body, address)
+}
+
+func (c *PacketConn) ReadPacket(buffer *buf.Buffer) (M.Socksaddr, error) {
+	_, address, err := buffer.ReadPacketFrom(c)
+	if err != nil {
+		return M.Socksaddr{}, err
+	}
+	return M.SocksaddrFromNet(address), nil
+}
+
+func (c *PacketConn) WritePacket(buffer *buf.Buffer, destination M.Socksaddr) error {
+	defer buffer.Release()
+	_, err := c.WriteTo(buffer.Bytes(), destination)
+	return err
+}
