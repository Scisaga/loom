+				cancel()
+			}
+			select {
+			case err := <-done:
+				if mode == "eof_after_accepted_pipelined_queries" {
+					if err != nil {
+						t.Fatal(err)
+					}
+					if len(conn.frames) != 8 || conn.maxWriters.Load() != 1 {
+						t.Fatalf("responses truncated/interleaved: frames=%d writers=%d", len(conn.frames), conn.maxWriters.Load())
+					}
+					seen := map[uint16]bool{}
+					for _, wire := range conn.frames {
+						if int(binary.BigEndian.Uint16(wire)) != len(wire)-2 {
+							t.Fatal("invalid response frame")
+						}
+						var answer D.Msg
+						if answer.Unpack(wire[2:]) != nil || !answer.Response || seen[answer.Id] {
+							t.Fatal("mismatched or duplicate response")
+						}
+						seen[answer.Id] = true
+					}
+				} else if err == nil {
+					t.Fatal("terminal failure became success")
+				}
