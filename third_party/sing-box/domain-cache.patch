+func TestAccessRevocationCommitsBeforeUnmaterializedResourcePreparation(t *testing.T) {
+	s, options, a, b := accessFixture(t)
+	pin := func(choice P.RouteChoice) *adapter.InboundContext {
+		t.Helper()
+		id, choices := sourceChoice(t, choice)
+		if _, err := s.CompareAndSelectAccess(context.Background(), AccessSnapshot{Name: id, PolicyID: "demo-policy", Choices: choices, Targets: map[string]string{}}, s.AccessSnapshot()); err != nil {
+			t.Fatal(err)
+		}
+		metadata := &adapter.InboundContext{Destination: M.ParseSocksaddr("demo.example:443")}
+		if s.pinSelection(metadata) == "reject" {
+			t.Fatal("fixture failed to pin existing resource")
+		}
+		return metadata
+	}
+	revoked, retained := pin(a), pin(b)
+	delete(options.Entries, a.FirstResourceID)
+	options.Entries["demo-unmaterialized"] = option.ExecutionEntry{AuthenticationDigest: "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", NodeID: "demo-entry-a", Outbound: "demo-unmaterialized-outbound", AccessEnabled: true, Forward: true}
+	before := s.AccessAuthorizationState()
+	invalidated := false
+	after, err := s.ReplaceAccess(options, before.Revision, "demo-current-permissions", func() { invalidated = true })
+	if err != nil {
+		t.Fatal("unmaterialized new resource blocked current permission", err)
+	}
+	if !invalidated || after.Revision == before.Revision || after.ConfigHash != "demo-current-permissions" {
+		t.Fatal("current permission was not published and fenced")
+	}
+	if s.CheckAccessConnection(*revoked) == nil {
+		t.Fatal("revoked old resource remained authorized")
+	}
+	if err := s.CheckAccessConnection(*retained); err != nil {
+		t.Fatal("unrelated legal connection was revoked", err)
+	}
+	missing := P.RouteChoice{EntryNodeID: "demo-entry-a", FirstResourceID: "demo-unmaterialized", FinalExit: "demo-exit-a"}
+	id, choices := sourceChoice(t, missing)
+	if _, err := s.CompareAndSelectAccess(context.Background(), AccessSnapshot{Name: id, PolicyID: "demo-policy", Choices: choices, Targets: map[string]string{}}, s.AccessSnapshot()); err == nil {
+		t.Fatal("selection used an unmaterialized resource")
+	}
+	if _, err := s.ReplaceAccess(options, before.Revision, "demo-stale", nil); !errors.Is(err, ErrSelectionChanged) {
+		t.Fatal("old permission revision was accepted", err)
+	}
+}
