+package hysteria2
+
+import (
+	"bytes"
+	"context"
+	"encoding/binary"
+	"errors"
+	"io"
+	"net"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/sagernet/quic-go"
+	"github.com/sagernet/quic-go/quicvarint"
+	"github.com/sagernet/sing-quic/hysteria2/internal/protocol"
+	M "github.com/sagernet/sing/common/metadata"
+)
+
+type executionTestStream struct {
+	quic.Stream
+	conn          net.Conn
+	readStarted   chan struct{}
+	readOnce      sync.Once
+	cancelOnce    sync.Once
+	cancelStarted chan struct{}
+	allowCancel   <-chan struct{}
+	writeCanceled atomic.Bool
+}
+
+func (s *executionTestStream) Read(body []byte) (int, error) {
+	s.readOnce.Do(func() {
+		if s.readStarted != nil {
+			close(s.readStarted)
+		}
+	})
+	return s.conn.Read(body)
+}
+func (s *executionTestStream) Write(body []byte) (int, error)     { return s.conn.Write(body) }
+func (s *executionTestStream) SetDeadline(at time.Time) error     { return s.conn.SetDeadline(at) }
+func (s *executionTestStream) SetReadDeadline(at time.Time) error { return s.conn.SetReadDeadline(at) }
+func (s *executionTestStream) SetWriteDeadline(at time.Time) error {
+	return s.conn.SetWriteDeadline(at)
+}
+func (s *executionTestStream) Close() error { return s.conn.Close() }
+func (s *executionTestStream) CancelRead(quic.StreamErrorCode) {
+	s.cancelOnce.Do(func() {
+		if s.cancelStarted != nil {
+			close(s.cancelStarted)
+		}
+		if s.allowCancel != nil {
+			<-s.allowCancel
+		}
+		s.conn.Close()
+	})
+}
+func (s *executionTestStream) CancelWrite(quic.StreamErrorCode) {
+	s.writeCanceled.Store(true)
+	s.conn.Close()
+}
+func readExecutionTestRequest(conn net.Conn) error {
+	kind, err := quicvarint.Read(quicvarint.NewReader(conn))
+	if err != nil {
+		return err
+	}
+	if kind != executionFrameType {
+		return errors.New("wrong native stream type")
+	}
+	var header [4]byte
+	if _, err := io.ReadFull(conn, header[:]); err != nil {
+		return err
+	}
+	length := binary.BigEndian.Uint32(header[:])
+	if length == 0 || length > maxExecutionFrame {
+		return errors.New("wrong native request boundary")
+	}
+	_, err = io.CopyN(io.Discard, conn, int64(length))
+	return err
+}
+func TestNativeTCPConfirmationWaitsForAcceptedAndPreservesPayload(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	left, right := net.Pipe()
+	defer right.Close()
+	stream := &executionTestStream{conn: left, readStarted: make(chan struct{})}
+	client := &clientConn{Stream: stream}
+	ready := make(chan error, 1)
+	go func() { ready <- readExecutionTestRequest(right) }()
+	done := make(chan error, 1)
+	go func() { done <- confirmExecutionTCP(ctx, client, []byte("demo-execution-request")) }()
+	if err := <-ready; err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case <-stream.readStarted:
+	case <-time.After(time.Second):
+		t.Fatal("native dial did not read confirmation")
+	}
+	select {
+	case <-done:
+		t.Fatal("native dial returned before Accepted")
+	default:
+	}
+	payload := []byte("first-application-byte")
+	written := make(chan error, 1)
+	go func() {
+		response := protocol.WriteTCPResponse(true, "", payload)
+		defer response.Release()
+		_, err := right.Write(response.Bytes())
+		written <- err
+	}()
+	if err := <-done; err != nil {
+		t.Fatal(err)
+	}
+	cancel()
+	defer client.Close()
+	_ = client.SetReadDeadline(time.Now().Add(time.Second))
+	body := make([]byte, len(payload))
+	if _, err := io.ReadFull(client, body); err != nil || !bytes.Equal(body, payload) {
+		t.Fatal("confirmation lost first payload or callback closed established stream", err)
+	}
+	if err := <-written; err != nil {
+		t.Fatal(err)
+	}
+}
+func TestNativeTCPConfirmationJoinsOnlyThisStreamCancellation(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	left, right := net.Pipe()
+	defer right.Close()
+	allow := make(chan struct{})
+	stream := &executionTestStream{conn: left, readStarted: make(chan struct{}), cancelStarted: make(chan struct{}), allowCancel: allow}
+	client := &clientConn{Stream: stream}
+	go func() { _ = readExecutionTestRequest(right) }()
+	done := make(chan error, 1)
+	go func() { done <- confirmExecutionTCP(ctx, client, []byte("demo-execution-request")) }()
+	select {
+	case <-stream.readStarted:
+	case <-time.After(time.Second):
+		t.Fatal("confirmation did not start")
+	}
+	cancel()
+	select {
+	case <-stream.cancelStarted:
+	case <-time.After(time.Second):
+		t.Fatal("cancel did not reach this stream")
+	}
+	select {
+	case <-done:
+		t.Fatal("returned while cancel callback still ran")
+	default:
+	}
+	close(allow)
+	select {
+	case err := <-done:
+		if !errors.Is(err, context.Canceled) || !stream.writeCanceled.Load() {
+			t.Fatal("cancellation was not completed", err)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("canceled dial did not return")
+	}
+	// A separate stream remains independent of this cancellation.
+	otherLeft, otherRight := net.Pipe()
+	defer otherLeft.Close()
+	defer otherRight.Close()
+	written := make(chan error, 1)
+	go func() { _, err := otherRight.Write([]byte{'x'}); written <- err }()
+	var body [1]byte
+	if _, err := io.ReadFull(otherLeft, body[:]); err != nil || body[0] != 'x' {
+		t.Fatal("another stream was affected", err)
+	}
+	if err := <-written; err != nil {
+		t.Fatal(err)
+	}
+}
+func TestNativeTCPConfirmationRecognizesOnlyDeclaredSafeMessages(t *testing.T) {
+	for _, value := range []struct {
+		name, message string
+		status        byte
+		want          error
+	}{
+		{"denied", ExecutionDeniedMessage, 1, ErrExecutionDenied},
+		{"unavailable", ExecutionUnavailableMessage, 1, ErrExecutionUnavailable},
+		{"legacy", "execution request denied", 1, ErrExecutionUnknown},
+		{"prefix", "prefix:" + ExecutionDeniedMessage, 1, ErrExecutionUnknown},
+		{"invalid-status", ExecutionDeniedMessage, 2, ErrExecutionUnknown},
+	} {
+		t.Run(value.name, func(t *testing.T) {
+			left, right := net.Pipe()
+			defer left.Close()
+			client := &clientConn{Stream: &executionTestStream{conn: left}}
+			written := make(chan error, 1)
+			go func() {
+				defer right.Close()
+				response := protocol.WriteTCPResponse(false, value.message, nil)
+				defer response.Release()
+				body := append([]byte{}, response.Bytes()...)
+				body[0] = value.status
+				_, err := right.Write(body)
+				written <- err
+			}()
+			err := client.readExecutionResponse()
+			if !errors.Is(err, value.want) || value.want == ErrExecutionUnknown && (errors.Is(err, ErrExecutionDenied) || errors.Is(err, ErrExecutionUnavailable)) {
+				t.Fatal("generic or malformed response gained a declared outcome", err)
+			}
+			left.Close()
+			<-written
+		})
+	}
+}
+func TestGenericTCPReadKeepsItsOriginalMessageSemantics(t *testing.T) {
+	left, right := net.Pipe()
+	defer left.Close()
+	client := &clientConn{Stream: &executionTestStream{conn: left}, requestWritten: true}
+	go func() {
+		defer right.Close()
+		response := protocol.WriteTCPResponse(false, ExecutionDeniedMessage, nil)
+		defer response.Release()
+		_, _ = right.Write(response.Bytes())
+	}()
+	var body [1]byte
+	_, err := client.Read(body[:])
+	if err == nil || errors.Is(err, ErrExecutionDenied) || errors.Is(err, ErrExecutionUnavailable) {
+		t.Fatal("generic Hy2 response acquired native semantics", err)
+	}
