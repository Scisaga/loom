+			}
+			if mode == "cancel_blocked_read_and_exchange" {
+				conn.blockRead = true
+				router.exchange = func(ctx context.Context, q *D.Msg) (*D.Msg, error) { <-ctx.Done(); return nil, ctx.Err() }
+			}
+			if mode == "cancel_blocked_write" {
+				conn.blockWrite = true
+			}
+			var callbacks atomic.Int32
+			done := make(chan error, 1)
+			go func() {
+				done <- handleHijackedDNSStream(ctx, router, conn, adapter.InboundContext{}, func(err error) {
+					if conn.closeCalls.Load() != 1 {
