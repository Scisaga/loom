+func (p *poolTransport) ListenPacket(context.Context, M.Socksaddr) (net.PacketConn, error) {
+	return nil, errors.New("not used")
+}
+func (p *poolTransport) Close() error {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	for _, c := range p.peers {
+		c.Close()
+	}
+	return nil
+}
