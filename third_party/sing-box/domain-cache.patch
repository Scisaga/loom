+func (p *poolTransport) DialContext(ctx context.Context, _ string, _ M.Socksaddr) (net.Conn, error) {
+	if p.tag == "reject" {
+		return nil, X.ErrDenied
+	}
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	a, b := net.Pipe()
+	p.mu.Lock()
+	p.peers = append(p.peers, b)
+	p.mu.Unlock()
+	go func() { defer b.Close(); _, _ = io.Copy(b, b) }()
+	return a, nil
