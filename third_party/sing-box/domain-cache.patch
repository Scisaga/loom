+func TestWGExecutionTargetBindingUsesUniqueCurrentResource(t *testing.T) {
+	source := netip.MustParseAddr("fdab:77::1")
+	execution := netip.MustParseAddr("fdab:79::1")
+	endpoint := Endpoint{localAddresses: []netip.Prefix{netip.MustParsePrefix("::1/128")}}
