+package sourcepool
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"net/netip"
+	"reflect"
+	"sort"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/option"
+)
+
+type descriptionState struct {
+	outbounds     map[string]option.Outbound
+	hashes        map[string]string
+	forwarding    map[string]option.ExecutionHopOptions
+	wireguard     *option.RuntimeWireGuard
+	authorization map[string]string
+}
+
+func cloneTyped[T any](source T) (T, error) {
+	var result T
+	body, err := json.Marshal(source)
+	if err == nil {
+		err = json.Unmarshal(body, &result)
+	}
+	return result, err
+}
+func ownOutbound(value option.Outbound) (option.Outbound, error) {
+	if err := validateSender(value); err != nil {
+		return option.Outbound{}, err
+	}
+	body, err := json.Marshal(value.Options)
+	if err != nil {
+		return option.Outbound{}, err
+	}
+	target := reflect.New(reflect.TypeOf(value.Options).Elem()).Interface()
+	if err = json.Unmarshal(body, target); err != nil {
+		return option.Outbound{}, err
+	}
+	value.Options = target
+	return value, nil
+}
+
+// Prepare accepts only a disposable construction projection; unused transports
+// are not constructed. Native source/receiver snapshots remain the authority.
+func (p *Pool) Prepare(ctx context.Context, desired option.RuntimeResources) (_ *Prepared, resultErr error) {
+	if desired.Forwarding == nil {
+		return nil, errors.New("forwarding description must be explicit")
+	}
+	state := &descriptionState{outbounds: map[string]option.Outbound{}, hashes: map[string]string{}}
+	for _, value := range desired.Outbounds {
+		if err := ctx.Err(); err != nil {
+			return nil, err
+		}
+		if _, exists := state.outbounds[value.Tag]; exists {
+			return nil, errors.New("duplicate sender description")
+		}
+		owned, err := ownOutbound(value)
+		if err != nil {
+			return nil, err
+		}
+		hash, err := ConfigHash(owned.Type, owned.Tag, owned.Options)
+		if err != nil {
+			return nil, err
+		}
+		state.outbounds[owned.Tag], state.hashes[owned.Tag] = owned, hash
+	}
+	var err error
+	state.forwarding, err = cloneTyped(desired.Forwarding)
+	if err != nil {
+		return nil, err
+	}
+	state.wireguard, err = cloneTyped(desired.WireGuard)
+	if err != nil {
+		return nil, err
+	}
+	if state.wireguard != nil && state.wireguard.Initializer != nil {
+		initializer := state.wireguard.Initializer
+		if initializer.System || initializer.Name != "" || initializer.ListenPort != 0 || initializer.Execution != nil || initializer.ExecutionAddress.IsValid() || len(initializer.HostSources) != 0 || len(initializer.StackAddress) != 0 || initializer.Detour != "" || len(initializer.Peers) != 0 || len(initializer.SourceRoutes) != 0 {
+			return nil, errors.New("WG initializer must be a pure sender template")
+		}
+		if len(initializer.Address) != 2 || initializer.Address[0] != netip.MustParsePrefix("127.0.0.1/32") || initializer.Address[1] != netip.MustParsePrefix("::1/128") {
+			return nil, errors.New("WG initializer requires stable stack anchors")
+		}
+	}
+	state.authorization, err = cloneTyped(desired.AuthorizationRevisions)
+	if err != nil {
+		return nil, err
+	}
+	p.mu.Lock()
+	if p.closed || ctx.Err() != nil {
+		p.mu.Unlock()
+		if ctx.Err() != nil {
+			return nil, ctx.Err()
+		}
+		return nil, ErrNotRunning
+	}
+	previous := p.descriptions
+	liveValues := []option.Outbound{}
+	wgValues := []option.Outbound{}
+	for tag, value := range p.active {
+		if len(value.leases) == 0 {
+			continue
+		}
+		spec := value.descriptor
+		if current, ok := state.outbounds[tag]; ok {
+			for lease := range value.leases {
+				if lease.selection {
+					spec = current
+					break
+				}
+			}
+		}
+		liveValues = append(liveValues, spec)
+		wgValues = append(wgValues, spec)
+	}
+	for value := range p.retired {
+		if len(value.leases) > 0 {
+			wgValues = append(wgValues, value.descriptor)
+		}
+	}
+	p.mu.Unlock()
+	if state.wireguard != nil && state.wireguard.Initializer != nil && p.endpoints != nil {
+		if endpoint, exists := p.endpoints.Get(state.wireguard.Tag); exists {
+			validator, ok := endpoint.(interface {
+				ValidateRuntimeWireGuardInitializer(option.WireGuardEndpointOptions) error
+			})
+			if !ok {
+				return nil, errors.New("WG endpoint lacks initializer identity validation")
+			}
+			if err := validator.ValidateRuntimeWireGuardInitializer(*state.wireguard.Initializer); err != nil {
+				return nil, err
+			}
+		}
+	}
+	if len(liveValues) > 0 || len(wgValues) > 0 || state.wireguard != nil && p.WireGuard() {
+		sort.Slice(liveValues, func(i, j int) bool { return liveValues[i].Tag < liveValues[j].Tag })
+		live := option.RuntimeResources{Outbounds: liveValues, Forwarding: state.forwarding, WireGuard: liveWireGuard(state.wireguard, wgValues)}
+		if live.WireGuard == nil && state.wireguard != nil && p.WireGuard() {
+			live.WireGuard = &option.RuntimeWireGuard{Tag: state.wireguard.Tag, Initializer: state.wireguard.Initializer, Peers: []option.WireGuardPeer{}, SourceRoutes: []option.WireGuardSourceRoute{}}
+		}
+		if live.WireGuard != nil && p.WireGuard() {
+			live.WireGuard.Initializer = nil
+		}
+		prepared, err := p.prepareLive(ctx, live, true)
+		if err != nil {
+			return nil, err
+		}
+		prepared.install = state
+		prepared.installLive = true
+		prepared.expectedDescriptions = previous
+		prepared.checkDescriptions = true
+		if err := prepared.stageNetwork(ctx); err != nil {
+			_ = prepared.Close()
+			return nil, err
+		}
+		return prepared, nil
+	}
+	p.mu.Lock()
+	if p.closed || p.descriptions != previous {
+		p.mu.Unlock()
+		return nil, ErrConflict
+	}
+	p.preparing.Add(1)
+	p.mu.Unlock()
+	defer p.preparing.Done()
+	lifetime, cancel := context.WithCancel(p.ctx)
+	finished := make(chan struct{})
+	stop := context.AfterFunc(ctx, func() { cancel(); close(finished) })
+	r := &Prepared{pool: p, ctx: lifetime, cancel: cancel, finished: finished, stopCancel: stop, install: state, expectedDescriptions: previous, wanted: map[string]*entry{}, forwarding: map[string]*entry{}, retained: map[*entry]bool{}}
+	defer func() {
+		if resultErr != nil {
+			_ = r.Close()
+		}
+	}()
+	if err = r.prepareForwarding(state.forwarding); err != nil {
+		return nil, err
+	}
+	for _, value := range r.created {
+		for _, stage := range adapter.ListStartStages {
+			if err = ctx.Err(); err != nil {
+				return nil, err
+			}
+			if err = adapter.LegacyStart(value.registration.Outbound, stage); err != nil {
+				return nil, err
+			}
+		}
+	}
+	return r, nil
+}
+func (r *Prepared) commitDescriptions(ctx context.Context) error {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	if r.closed || r.committed {
+		return ErrConflict
+	}
+	r.detachRequestLocked()
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	if err := r.ctx.Err(); err != nil {
+		return err
+	}
+	p := r.pool
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	if p.closed || p.descriptions != r.expectedDescriptions {
+		return ErrConflict
+	}
+	candidates := make([]Registration, 0, len(r.created))
+	for _, value := range r.created {
+		candidates = append(candidates, value.registration)
+	}
+	remove := []Registration{}
+	for tag, value := range p.forwarding {
+		if r.forwarding[tag] == nil {
+			remove = append(remove, value.registration)
+		}
+	}
+	if _, err := p.registry.ReconcileRuntimeOutbounds(ctx, candidates, r.replace, remove); err != nil {
+		return err
+	}
+	for _, apply := range r.applyForwarding {
+		if err := apply(); err != nil {
+			p.dirty = true
+			return err
+		}
+	}
+	for tag, value := range p.forwarding {
+		if r.forwarding[tag] != value {
+			value.retired = true
+			p.retired[value] = struct{}{}
+			p.maybeCloseLocked(value)
+		}
+	}
+	for _, value := range r.created {
+		value.stopPrepare()
+	}
+	p.forwarding = r.forwarding
+	if reflect.DeepEqual(p.descriptions, r.install) {
+		r.install = p.descriptions
+	}
+	p.descriptions = r.install
+	r.committed = true
+	r.cancel()
+	return nil
+}
+func (p *Pool) Described() map[string]string {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	result := map[string]string{}
+	if p.descriptions != nil && !p.closed {
+		for tag, hash := range p.descriptions.hashes {
+			result[tag] = hash
+		}
+	}
+	return result
+}
+func (p *Pool) SetPermissionFence(fence func(map[string]string, func() error) error) {
+	p.mu.Lock()
+	p.permissionFence = fence
+	p.mu.Unlock()
+}
+func (p *Pool) withPermission(state *descriptionState, use func() error) error {
+	p.mu.Lock()
+	fence := p.permissionFence
+	p.mu.Unlock()
+	if fence != nil {
+		if state == nil {
+			return fence(map[string]string{}, use)
+		}
+		return fence(state.authorization, use)
+	}
+	if state != nil && len(state.authorization) != 0 {
+		return ErrConflict
+	}
+	return use()
+}
+func liveWireGuard(full *option.RuntimeWireGuard, values []option.Outbound) *option.RuntimeWireGuard {
+	sources := map[string]bool{}
+	for _, value := range values {
+		if source := senderSource(value); source.IsValid() {
+			sources[source.String()] = true
+		}
+	}
+	if full == nil {
+		if len(sources) == 0 {
+			return nil
+		}
+		return &option.RuntimeWireGuard{Tag: "wg-shared", Peers: []option.WireGuardPeer{}, SourceRoutes: []option.WireGuardSourceRoute{}}
+	}
+	next := &option.RuntimeWireGuard{Tag: full.Tag, Initializer: full.Initializer, Peers: []option.WireGuardPeer{}, SourceRoutes: []option.WireGuardSourceRoute{}}
+	all, needed := map[string]bool{}, map[string]bool{}
+	for _, route := range full.SourceRoutes {
+		all[route.Destination.String()], all[route.Execution.String()+"/128"] = true, true
+		if sources[route.Source.String()] {
+			next.SourceRoutes = append(next.SourceRoutes, route)
+			needed[route.Destination.String()], needed[route.Execution.String()+"/128"] = true, true
+		}
+	}
+	for _, peer := range full.Peers {
+		owned := peer
+		owned.AllowedIPs = nil
+		send := false
+		for _, prefix := range peer.AllowedIPs {
+			if !all[prefix.String()] || needed[prefix.String()] {
+				owned.AllowedIPs = append(owned.AllowedIPs, prefix)
+				send = send || needed[prefix.String()]
+			}
+		}
+		if !send {
+			owned.PersistentKeepaliveInterval = 0
+		}
+		if len(owned.AllowedIPs) > 0 {
+			next.Peers = append(next.Peers, owned)
+		}
+	}
+	if len(next.Peers) == 0 && len(sources) == 0 {
+		return nil
+	}
+	return next
+}
+func outboundDigest(outbound adapter.Outbound) string {
+	if value, ok := outbound.(interface{ OutboundAuthenticationDigest() string }); ok {
+		return value.OutboundAuthenticationDigest()
+	}
+	return ""
+}
+
+// PrepareBorrow owns only a call's unpublished candidates. Publication and
+// selection-reference transfer can therefore share the same short commit.
+func (p *Pool) PrepareBorrow(ctx context.Context, tags []string) (*Prepared, error) {
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	p.mu.Lock()
+	if p.closed {
+		p.mu.Unlock()
+		return nil, ErrNotRunning
+	}
+	state := p.descriptions
+	hot := true
+	for _, tag := range tags {
+		if state != nil {
+			if _, described := state.outbounds[tag]; described {
+				value := p.active[tag]
+				actual, exists := p.registry.RuntimeOutbound(tag)
+				if value != nil && value.registration.Outbound.Type() == "direct" && !p.WireGuardPhysicalReady() {
+					hot = false
+					break
+				}
+				if value == nil || value.description != state || value.registration.ConfigHash != state.hashes[tag] || !exists || !SameObject(actual.Outbound, value.registration.Outbound) {
+					hot = false
+					break
+				}
+				continue
+			}
+		}
+		if p.active[tag] != nil {
+			hot = false
+			break
+		}
+		if _, exists := p.registry.RuntimeOutbound(tag); !exists {
+			hot = false
+			break
+		}
+	}
+	if hot {
+		r := &Prepared{pool: p, ctx: ctx, cancel: func() {}, hot: true, expectedDescriptions: state, checkDescriptions: true, wanted: map[string]*entry{}}
+		seen := map[string]bool{}
+		for _, tag := range tags {
+			if seen[tag] {
+				continue
+			}
+			seen[tag] = true
+			lease, err := p.acquireLocked(ctx, tag)
+			if err != nil {
+				p.mu.Unlock()
+				ReleaseAll(r.borrowedMany)
+				return nil, err
+			}
+			r.borrowedMany = append(r.borrowedMany, lease)
+			r.wanted[tag] = lease.entry
+		}
+		if len(r.borrowedMany) > 0 {
+			r.borrowed = r.borrowedMany[0]
+		}
+		p.mu.Unlock()
+		return r, nil
+	}
+	wanted := map[string]option.Outbound{}
+	for tag, value := range p.active {
+		if len(value.leases) > 0 {
+			wanted[tag] = value.descriptor
+		}
+	}
+	unique := map[string]bool{}
+	for _, tag := range tags {
+		unique[tag] = true
+		if state != nil {
+			if value, ok := state.outbounds[tag]; ok {
+				wanted[tag] = value
+				continue
+			}
+		}
+		if p.active[tag] != nil {
+			p.mu.Unlock()
+			return nil, ErrResourcePending
+		}
+		if _, exists := p.registry.RuntimeOutbound(tag); !exists {
+			p.mu.Unlock()
+			return nil, ErrResourcePending
+		}
+	}
+	values := make([]option.Outbound, 0, len(wanted))
+	for _, value := range wanted {
+		values = append(values, value)
+	}
+	sort.Slice(values, func(i, j int) bool { return values[i].Tag < values[j].Tag })
+	graph := map[string]option.ExecutionHopOptions{}
+	var wg *option.RuntimeWireGuard
+	if state != nil {
+		graph = state.forwarding
+		wg = state.wireguard
+	}
+	p.mu.Unlock()
+	request := option.RuntimeResources{Outbounds: values, Forwarding: graph, WireGuard: liveWireGuard(wg, values)}
+	if request.WireGuard != nil && p.WireGuard() {
+		request.WireGuard.Initializer = nil
+	}
+	needWG := false
+	for tag := range unique {
+		if value, exists := wanted[tag]; exists && value.Type == "direct" {
+			needWG = true
+		}
+	}
+	prepared, err := p.prepareLive(ctx, request, needWG)
+	if err != nil {
+		if ctx.Err() != nil {
+			return nil, ctx.Err()
+		}
+		return nil, errors.Join(ErrResourcePending, err)
+	}
+	prepared.expectedDescriptions = state
+	prepared.checkDescriptions = true
+	for tag := range unique {
+		prepared.borrowTags = append(prepared.borrowTags, tag)
+	}
+	sort.Strings(prepared.borrowTags)
+	p.mu.Lock()
+	if p.closed || p.generation != prepared.generation || p.descriptions != state {
+		p.mu.Unlock()
+		_ = prepared.Close()
+		return nil, ErrConflict
+	}
+	for _, tag := range prepared.borrowTags {
+		value := prepared.wanted[tag]
+		if value == nil {
+			value = prepared.forwarding[tag]
+		}
+		var lease *Lease
+		if value != nil {
+			lease = p.leaseEntryLocked(ctx, value)
+		} else {
+			var err error
+			lease, err = p.acquireLocked(ctx, tag)
+			if err != nil {
+				p.mu.Unlock()
+				_ = prepared.Close()
+				return nil, err
+			}
+		}
+		prepared.borrowedMany = append(prepared.borrowedMany, lease)
+	}
+	if len(prepared.borrowedMany) > 0 {
+		prepared.borrowed = prepared.borrowedMany[0]
+	}
+	p.mu.Unlock()
+	if err := prepared.stageNetwork(ctx); err != nil {
+		_ = prepared.Close()
+		if ctx.Err() != nil {
+			return nil, ctx.Err()
+		}
+		return nil, errors.Join(ErrResourcePending, err)
+	}
+	return prepared, nil
+}
+func (r *Prepared) commitHot(ctx context.Context) error {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	if r.closed || r.committed {
+		return ErrConflict
+	}
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	p := r.pool
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	if p.closed || p.descriptions != r.expectedDescriptions {
+		return ErrConflict
+	}
+	for _, lease := range r.borrowedMany {
+		actual, exists := p.registry.RuntimeOutbound(lease.entry.registration.Outbound.Tag())
+		if !exists || !SameObject(actual.Outbound, lease.entry.registration.Outbound) {
+			return ErrConflict
+		}
+		if _, held := lease.entry.leases[lease]; !held {
+			return ErrConflict
+		}
+	}
+	if r.beforePublish != nil {
+		if err := r.beforePublish(); err != nil {
+			return err
+		}
+	}
+	if r.afterPublish != nil {
+		for _, lease := range r.borrowedMany {
+			lease.selection = true
+		}
+		r.afterPublish(r.borrowedMany)
+	}
+	r.committed = true
+	return nil
+}
+
+func (r *Prepared) PreparedOutbound(tag string) adapter.Outbound {
+	if value := r.wanted[tag]; value != nil {
+		return value.registration.Outbound
+	}
+	value, _ := r.pool.registry.RuntimeOutbound(tag)
+	return value.Outbound
+}
+func (r *Prepared) Authorizes(scope, revision string) bool {
+	return r.expectedDescriptions == nil || r.expectedDescriptions.authorization[scope] == revision
+}
+
+func (r *Prepared) CommitSelection(ctx context.Context, validate func() error, publish func([]*Lease)) error {
+	r.beforePublish = validate
+	r.afterPublish = publish
+	return r.Commit(ctx)
+}
+func (p *Pool) acquireDescription(ctx context.Context, tag string) (*Lease, error) {
+	for attempt := 0; attempt < 4; attempt++ {
+		prepared, err := p.PrepareBorrow(ctx, []string{tag})
+		if err != nil {
+			return nil, err
+		}
+		err = p.withPermission(prepared.expectedDescriptions, func() error { return prepared.Commit(ctx) })
+		lease := prepared.borrowed
+		closeErr := prepared.Close()
+		if err == nil && closeErr != nil {
+			err = closeErr
+		}
+		if errors.Is(err, ErrConflict) {
+			continue
+		}
+		if err != nil {
+			if ctx.Err() != nil {
+				return nil, ctx.Err()
+			}
+			return nil, errors.Join(ErrResourcePending, err)
+		}
+		return lease, nil
+	}
+	return nil, ErrConflict
+}
+func (p *Pool) WithCurrentLeases(values []*Lease, use func() error) error {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	if p.closed {
+		return ErrNotRunning
+	}
+	for _, lease := range values {
+		if lease == nil || lease.pool != p || lease.description != p.descriptions || lease.ctx.Err() != nil {
+			return ErrConflict
+		}
+		if _, held := lease.entry.leases[lease]; !held {
+			return ErrConflict
+		}
+		actual, exists := p.registry.RuntimeOutbound(lease.entry.registration.Outbound.Tag())
+		if !exists || !SameObject(actual.Outbound, lease.entry.registration.Outbound) {
+			return ErrConflict
+		}
+	}
+	if use != nil {
+		return use()
+	}
+	return nil
+}
+func ReleaseAll(values []*Lease) {
+	for _, value := range values {
+		if value != nil {
+			value.Release()
+		}
+	}
+}
