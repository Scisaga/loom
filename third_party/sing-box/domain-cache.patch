+func accessRevision() (string, error) {
+	var nonce [32]byte
+	if _, err := rand.Read(nonce[:]); err != nil {
+		return "", err
+	}
+	return base64.RawURLEncoding.EncodeToString(nonce[:]), nil
+}
+func (s *Selector) AccessAuthorizationState() execution.State {
+	s.accessFence.RLock()
+	defer s.accessFence.RUnlock()
+	return s.accessState
+}
+func (s *Selector) accessConnectionTag(policyID string, choice P.RouteChoice, target M.Socksaddr, metadata *adapter.InboundContext, revision string) (string, error) {
+	current := s.access.Load()
+	if current == nil {
+		recordAccessRejection(metadata, "authorization-unavailable", revision)
+		return "", errors.New("source authorization unavailable")
+	}
+	policy, ok := current.policies[policyID]
+	if !ok {
+		recordAccessRejection(metadata, "policy-ungranted", revision)
+		return "", errors.New("source Policy withdrawn")
+	}
+	if err := policy.compiled.CheckTarget(target); err != nil {
+		recordAccessRejection(metadata, "target-disallowed", revision)
+		return "", err
+	}
+	tag, err := current.choice(policy, choice)
+	if err != nil {
+		recordAccessRejection(metadata, "choice-ineligible", revision)
+	}
+	return tag, err
+}
+func (s *Selector) accessConnectionOutbound(policyID string, choice P.RouteChoice, target M.Socksaddr, metadata *adapter.InboundContext, revision string) (adapter.Outbound, error) {
+	tag, err := s.accessConnectionTag(policyID, choice, target, metadata, revision)
+	if err != nil {
+		return nil, err
+	}
+	return s.accessChoiceOutbound(choice, tag, metadata, revision)
+}
+func (s *Selector) accessChoiceOutbound(choice P.RouteChoice, tag string, metadata *adapter.InboundContext, revision string) (adapter.Outbound, error) {
+	selected := s.accessOutbound(tag)
+	if choice.FirstResourceID != "" {
+		current := s.access.Load()
+		entry := current.options.Entries[choice.FirstResourceID]
+		authenticated, ok := selected.(interface{ OutboundAuthenticationDigest() string })
+		if !ok || authenticated.OutboundAuthenticationDigest() != entry.AuthenticationDigest {
+			reason := "sender-authentication-mismatch"
+			if selected == nil {
+				reason = "sender-not-materialized"
+			}
+			recordAccessRejection(metadata, reason, revision)
+			return nil, errors.New("source resource authentication not materialized")
+		}
+	}
+	if selected == nil {
+		recordAccessRejection(metadata, "sender-unavailable", revision)
+		return nil, errors.New("source transport unavailable")
+	}
+	return selected, nil
+}
+func (s *Selector) checkAccessConnection(policyID string, choice P.RouteChoice, target M.Socksaddr) error {
+	_, err := s.accessConnectionTag(policyID, choice, target, nil, "")
+	return err
+}
+
+// CheckAccessConnection evaluates the pinned connection, independent of the
+// latest performance snapshot. Caller owns the authorization update fence.
+func (s *Selector) CheckAccessConnection(metadata adapter.InboundContext) error {
+	if metadata.Execution == nil || metadata.ExecutionSourceScope != s.Tag() {
+		return errors.New("missing source connection context")
+	}
+	if metadata.ExecutionResource != "" {
+		current := s.access.Load()
+		if current == nil {
+			return errors.New("source permission unavailable")
+		}
+		entry, ok := current.options.Entries[metadata.ExecutionResource]
+		if !ok || entry.AuthenticationDigest != metadata.ExecutionAuthenticationDigest {
+			return errors.New("source resource authentication withdrawn")
+		}
+	}
+	if metadata.ExecutionSenderTag != "" {
+		current := s.access.Load()
+		matched := false
+		if current != nil {
+			for _, entry := range current.options.Entries {
+				if entry.Outbound == metadata.ExecutionSenderTag && entry.AuthenticationDigest == metadata.ExecutionSenderAuthenticationDigest {
+					matched = true
+					break
+				}
+			}
+		}
+		if !matched {
+			return errors.New("actual sending authentication withdrawn")
+		}
+		if metadata.ExecutionNextNodeID != "" {
+			policy, ok := current.policies[metadata.Execution.PolicyID]
+			if !ok {
+				return errors.New("source Policy withdrawn")
+			}
+			var next option.ExecutionEntry
+			for _, entry := range current.options.Entries {
+				if entry.Outbound == metadata.ExecutionSenderTag {
+					next = entry
+					break
+				}
+			}
+			if next.NodeID != metadata.ExecutionNextNodeID {
+				return errors.New("pinned next owner changed")
+			}
+			_, err := policy.compiled.Compiled().Admit(metadata.Execution.Path, P.HopPermission{SenderID: current.options.NodeID, ReceiverID: next.NodeID, Purpose: "forward", Forward: next.Forward, InternetEgress: next.InternetEgress, LANGateway: policy.value.Policy.Kind == "local_network" && next.Forward})
+			if err != nil {
+				return err
+			}
+		}
+	}
+	return s.checkAccessConnection(metadata.Execution.PolicyID, P.RouteChoice{EntryNodeID: metadata.ExecutionEntry, FirstResourceID: metadata.ExecutionResource, FinalExit: metadata.Execution.Path.FinalExitID}, metadata.ExecutionSourceTarget)
+}
+func (s *Selector) ReplaceAccess(options option.ExecutionAccessOptions, expected, hash string, invalidate func()) (execution.State, error) {
+	next, err := newAccessSelector(options)
+	if err != nil {
+		return execution.State{}, err
+	}
+	revision, err := accessRevision()
+	if err != nil {
+		return execution.State{}, err
+	}
+	var release []*sourcepool.Lease
+	defer func() { sourcepool.ReleaseAll(release) }()
+	s.accessFence.Lock()
+	defer s.accessFence.Unlock()
+	current := s.access.Load()
+	if current == nil || expected == "" || s.accessState.Revision != expected {
+		return execution.State{}, ErrSelectionChanged
+	}
+	if current.options.NodeID != next.options.NodeID || current.options.Kind != next.options.Kind || current.options.ServiceID != next.options.ServiceID {
+		return execution.State{}, errors.New("source identity and scope are immutable")
+	}
+	// Authority commits independently of sender materialization. Missing actual
+	// facilities still reject selection and dial; they must not retain revoked
+	// permissions while a new resource is being prepared.
+	if hash != "" && s.accessState.ConfigHash == hash {
+		return s.accessState, nil
+	}
+	s.access.Store(next)
+	s.accessState = execution.State{Revision: revision, ConfigHash: hash}
+	// Revoke a now-invalid snapshot. Still-valid old connections are evaluated
+	// individually below, even if the new default has changed or becomes reject.
+	previousSelection := s.selected.Load()
+	snapshot := s.AccessSnapshot()
+	valid := snapshot.Name == "reject"
+	if !valid {
+		policy, ok := next.policies[snapshot.PolicyID]
+		valid = ok
+		if valid {
+			for _, choice := range snapshot.Choices {
+				tag, err := next.choice(policy, choice)
+				if err != nil {
+					valid = false
+					break
+				}
+				if _, err := s.accessChoiceOutbound(choice, tag, nil, ""); err != nil {
+					valid = false
+					break
+				}
+			}
+		}
+		if valid {
+			for target := range snapshot.Targets {
+				_, host, port, err := P.ParseConnectionTargetKey(target)
+				if err != nil || policy.compiled.CheckTarget(M.ParseSocksaddrHostPort(host, port)) != nil {
+					valid = false
+					break
+				}
+			}
+		}
+	}
+
+	if !valid {
+		snapshot = AccessSnapshot{Name: "reject", Targets: map[string]string{}, Choices: map[string]P.RouteChoice{}}
+	}
+	snapshot.Revision = revision
+	nextSelection := &selectorChoice{revision: revision, fallback: s.outbounds["reject"], targets: map[string]adapter.Outbound{}, access: &snapshot}
+	if previousSelection != nil {
+		if valid {
+			nextSelection.leases = previousSelection.leases
+		} else {
+			release = previousSelection.leases
+		}
+	}
+	s.selected.Store(nextSelection)
+	if invalidate != nil {
+		invalidate()
+	}
+	return s.accessState, nil
+}
+
+// WithAccessAuthorization holds only the current permission revision fence.
+// Resource preparation and all network work must run outside this callback.
+func (s *Selector) WithAccessAuthorization(expected string, use func() error) error {
+	s.accessFence.RLock()
+	defer s.accessFence.RUnlock()
+	if s.access.Load() == nil || expected == "" || s.accessState.Revision != expected {
+		return ErrSelectionChanged
+	}
+	if use != nil {
+		return use()
+	}
+	return nil
+}
+
+// BindAccessConnectionFence captures this already-pinned local connection,
+// including its actual leaf identity, before tracker registration.
+func (s *Selector) BindAccessConnectionFence(metadata *adapter.InboundContext) {
+	metadata.ExecutionSourceCheck = func() (func(), error) {
+		s.accessFence.RLock()
+		if err := s.CheckAccessConnection(*metadata); err != nil {
+			s.accessFence.RUnlock()
+			return nil, err
+		}
+		return s.accessFence.RUnlock, nil
+	}
+}
