+	go func() { _, _ = io.Copy(peer, peer) }()
+	started := make(chan struct{})
+	latePeer := make(chan net.Conn, 1)
+	transport.dial = func(ctx context.Context, _ string, _ M.Socksaddr) (net.Conn, error) {
+		close(started)
+		<-ctx.Done()
+		client, remote := net.Pipe()
+		latePeer <- remote
