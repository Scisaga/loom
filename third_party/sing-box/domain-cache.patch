+package wireguard
+
+import (
+	"errors"
+	"net/netip"
+	"slices"
+	"strconv"
+	"strings"
+)
+
+func validatePeerOwnership(peers []peerConfig) error {
+	type owned struct {
+		prefix netip.Prefix
+		owner  string
+	}
+	values := []owned{}
+	owners := map[string]bool{}
+	for _, peer := range peers {
+		if owners[peer.publicKeyHex] {
+			return errors.New("duplicated WG peer key")
+		}
+		owners[peer.publicKeyHex] = true
+		for _, prefix := range peer.allowedIPs {
+			if !prefix.IsValid() || prefix != prefix.Masked() {
+				return errors.New("noncanonical WG peer source")
+			}
+			values = append(values, owned{prefix, peer.publicKeyHex})
+		}
+	}
+	slices.SortFunc(values, func(a, b owned) int {
+		if n := a.prefix.Addr().Compare(b.prefix.Addr()); n != 0 {
+			return n
+		}
+		return a.prefix.Bits() - b.prefix.Bits()
+	})
+	active := []owned{}
+	for _, value := range values {
+		for len(active) > 0 && !active[len(active)-1].prefix.Contains(value.prefix.Addr()) {
+			active = active[:len(active)-1]
+		}
+		if len(active) > 0 && active[len(active)-1].owner != value.owner {
+			return errors.New("WG packet sources overlap between peers")
+		}
+		active = append(active, value)
+	}
+	return nil
+}
+
+// peerDelta changes only fields whose desired value changed. In particular an
+// AllowedIPs update must not reset an endpoint learnt from authenticated traffic.
+func peerDelta(previous, next []peerConfig) (string, error) {
+	old := make(map[string]peerConfig, len(previous))
+	for _, peer := range previous {
+		old[peer.publicKeyHex] = peer
+	}
+	var ipc strings.Builder
+	for _, peer := range next {
+		prior, exists := old[peer.publicKeyHex]
+		if exists {
+			delete(old, peer.publicKeyHex)
+			if peer.reserved != prior.reserved || peer.reserved != [3]uint8{} && (peer.endpoint != prior.endpoint || peer.destination != prior.destination) {
+				return "", errors.New("managed WG updates cannot change reserved transport bytes")
+			}
+		} else if peer.reserved != [3]uint8{} {
+			return "", errors.New("managed WG updates require ordinary WG transport bytes")
+		}
+		var fields strings.Builder
+		if !exists || !slices.Equal(prior.allowedIPs, peer.allowedIPs) {
+			fields.WriteString("replace_allowed_ips=true\n")
+			for _, prefix := range peer.allowedIPs {
+				fields.WriteString("allowed_ip=" + prefix.String() + "\n")
+			}
+		}
+		if peer.endpoint.IsValid() && (!exists || peer.endpoint != prior.endpoint || peer.destination != prior.destination) {
+			fields.WriteString("endpoint=" + peer.endpoint.String() + "\n")
+		}
+		if peer.preSharedKeyHex != prior.preSharedKeyHex {
+			key := peer.preSharedKeyHex
+			if key == "" {
+				key = strings.Repeat("0", 64)
+			}
+			fields.WriteString("preshared_key=" + key + "\n")
+		}
+		if peer.keepalive != prior.keepalive {
+			fields.WriteString("persistent_keepalive_interval=" + strconv.Itoa(int(peer.keepalive)) + "\n")
+		}
+		if fields.Len() > 0 {
+			ipc.WriteString("public_key=" + peer.publicKeyHex + "\n")
+			ipc.WriteString(fields.String())
+		}
+	}
+	// Stable order makes validation and fault evidence reproducible.
+	removed := make([]string, 0, len(old))
+	for key := range old {
+		removed = append(removed, key)
+	}
+	slices.Sort(removed)
+	for _, key := range removed {
+		ipc.WriteString("public_key=" + key + "\nremove=true\n")
+	}
+	return ipc.String(), nil
+}
+
+// PreparePeers leaves the device, bind and unchanged peer sessions in place.
+// Receiving callers apply it inside their admission fence. The source-only case
+// uses the same native operation without inventing a receiving authorization.
+func (e *Endpoint) PreparePeers(peers []PeerOptions) (func() error, error) {
+	return e.preparePeers(peers, false, false)
+}
+func (e *Endpoint) PrepareRuntimePeers(peers []PeerOptions) (func() error, error) {
+	return e.preparePeers(peers, true, false)
+}
+func (e *Endpoint) PrepareRuntimePeerCleanup(peers []PeerOptions) (func() error, error) {
+	return e.preparePeers(peers, true, true)
+}
+func (e *Endpoint) preparePeers(peers []PeerOptions, runtime, cleanup bool) (func() error, error) {
+	next, err := parsePeers(peers)
+	if runtime {
+		for i := range next {
+			next[i].keepalive = 0
+		}
+	}
+	if err != nil {
+		return nil, err
+	}
+	if runtime && !cleanup {
+		if !e.counterMu.TryRLock() {
+			return nil, errors.New("WG runtime peer preparation busy")
+		}
+	} else {
+		e.counterMu.RLock()
+	}
+	if e.options.System && (e.options.Handler == nil || len(e.options.HostSources) == 0) || e.device == nil {
+		e.counterMu.RUnlock()
+		return nil, errors.New("hot WG admission requires a running managed business stack")
+	}
+	for _, source := range e.options.HostSources {
+		oldOwner, newOwner := "", ""
+		for _, peer := range e.peers {
+			for _, prefix := range peer.allowedIPs {
+				if prefix == source {
+					oldOwner = peer.publicKeyHex
+				}
+			}
+		}
+		for _, peer := range next {
+			for _, prefix := range peer.allowedIPs {
+				if prefix == source {
+					newOwner = peer.publicKeyHex
+				}
+			}
+		}
+		if oldOwner == "" || oldOwner != newOwner {
+			e.counterMu.RUnlock()
+			return nil, errors.New("hot business admission cannot change a host management peer")
+		}
+	}
+	previous := e.peers
+	if runtime {
+		previous = append([]peerConfig(nil), previous...)
+		for i := range previous {
+			previous[i].keepalive = 0
+		}
+	}
+	_, err = peerDelta(previous, next)
+	e.counterMu.RUnlock()
+	if err != nil {
+		return nil, err
+	}
+	return func() error {
+		if runtime && !cleanup {
+			if !e.counterMu.TryLock() {
+				return errors.New("WG runtime peer application busy")
+			}
+		} else {
+			e.counterMu.Lock()
+		}
+		defer e.counterMu.Unlock()
+		e.peerDNSMu.Lock()
+		closed := e.peerDNSClosed
+		e.peerDNSMu.Unlock()
+		if closed || e.device == nil {
+			return errors.New("WG endpoint is closed")
+		}
+		if runtime && !cleanup {
+			present := map[string]bool{}
+			for _, peer := range next {
+				present[peer.publicKeyHex] = true
+			}
+			for _, old := range e.peers {
+				if !present[old.publicKeyHex] {
+					old.allowedIPs = nil
+					old.keepalive = 0
+					next = append(next, old)
+				}
+			}
+		}
+		previous := e.peers
+		if runtime {
+			previous = append([]peerConfig(nil), previous...)
+			for i := range previous {
+				previous[i].keepalive = 0
+			}
+		}
+		ipc, err := peerDelta(previous, next)
+		if dirty := e.runtimeDirty.Load(); runtime && dirty != nil {
+			ipc = runtimeRepairIPC(next, *dirty, cleanup)
+		}
+		if err != nil {
+			return err
+		}
+		if ipc != "" {
+			if runtime {
+				err = e.device.IpcSetRuntime(ipc)
+			} else {
+				err = e.device.IpcSet(ipc)
+			}
+			if err != nil {
+				if runtime {
+					dirty := map[string]bool{}
+					if prior := e.runtimeDirty.Load(); prior != nil {
+						for key := range *prior {
+							dirty[key] = true
+						}
+					}
+					for _, set := range [][]peerConfig{e.peers, next} {
+						for _, peer := range set {
+							dirty[peer.publicKeyHex] = true
+						}
+					}
+					e.runtimeDirty.Store(&dirty)
+				}
+				return errors.New("WG peer admission apply failed")
+			}
+		}
+		// Reuse a learnt address only for the same requested domain and port.
+		// A changed destination must resolve before any new dial can use it.
+		for i := range next {
+			for _, prior := range e.peers {
+				if next[i].publicKeyHex == prior.publicKeyHex && next[i].destination.IsFqdn() && next[i].destination == prior.destination {
+					next[i].endpoint = prior.endpoint
+				}
+			}
+		}
+		e.syncPeerDNS(e.peers, next)
+		e.peers = next
+		if runtime && cleanup {
+			e.runtimeDirty.Store(nil)
+		}
+		return nil
+	}, nil
+}
