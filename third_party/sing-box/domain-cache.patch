+func TestLastBorrowReclaimsAndColdUseRebuilds(t *testing.T) {
+	f := newFixture(t)
+	commit(t, f.pool, sender("demo-a", "echo"))
+	lease, err := f.pool.Acquire(context.Background(), "demo-a")
+	if err != nil {
+		t.Fatal(err)
+	}
+	first := lease.Outbound()
+	left, right := net.Pipe()
+	defer right.Close()
+	connection, err := lease.BindConn(left)
+	if err != nil {
+		t.Fatal(err)
+	}
+	lease.Release()
+	if len(f.pool.Actual()) != 1 {
+		t.Fatal("business connection lost its actual sender")
+	}
+	if err := connection.Close(); err != nil {
+		t.Fatal(err)
+	}
+	deadline := time.Now().Add(time.Second)
+	for len(f.pool.Actual()) != 0 && time.Now().Before(deadline) {
+		time.Sleep(time.Millisecond)
+	}
+	if len(f.pool.Actual()) != 0 {
+		t.Fatal("last business reference left an idle sender materialized")
+	}
+	next, err := f.pool.Acquire(context.Background(), "demo-a")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if next.Outbound() == first {
+		t.Fatal("cold use revived a retired instance")
+	}
+	next.Release()
+}
