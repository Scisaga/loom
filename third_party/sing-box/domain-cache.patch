+package sourcepool
+
+import (
+	"context"
+	"errors"
+	"io"
+	"net"
+	"sync"
+
+	"github.com/sagernet/sing-box/adapter"
+)
+
+// Lease pins one actual transport across pending dial and the resulting flow.
+// No authorization lives here; source/receiver permission checks own revocation.
+type Lease struct {
+	mu          sync.Mutex
+	pool        *Pool
+	entry       *entry
+	description *descriptionState
+	selection   bool
+	ctx         context.Context
+	cancel      context.CancelFunc
+	bound       io.Closer
+	released    bool
+	done        chan struct{}
+}
+
+func (l *Lease) Outbound() adapter.Outbound { return l.entry.registration.Outbound }
+func (l *Lease) Context() context.Context   { return l.ctx }
+func (l *Lease) BindConn(conn net.Conn) (net.Conn, error) {
+	if conn == nil {
+		return nil, errors.New("nil runtime connection")
+	}
+	l.mu.Lock()
+	if l.released || l.bound != nil || l.ctx.Err() != nil {
+		l.mu.Unlock()
+		_ = conn.Close()
+		l.Release()
+		return nil, ErrConflict
+	}
+	wrapped := &leasedConn{Conn: conn, lease: l}
+	l.bound = wrapped
+	l.mu.Unlock()
+	return wrapped, nil
+}
+func (l *Lease) BindPacketConn(conn net.PacketConn) (net.PacketConn, error) {
+	if conn == nil {
+		return nil, errors.New("nil runtime packet connection")
+	}
+	l.mu.Lock()
+	if l.released || l.bound != nil || l.ctx.Err() != nil {
+		l.mu.Unlock()
+		_ = conn.Close()
+		l.Release()
+		return nil, ErrConflict
+	}
+	wrapped := &leasedPacketConn{PacketConn: conn, lease: l}
+	l.bound = wrapped
+	l.mu.Unlock()
+	return wrapped, nil
+}
+
+// Release abandons an unbound dial. A successful bind transfers release to the
+// returned connection, so a conventional defer cannot retire a live flow.
+func (l *Lease) Release() {
+	l.mu.Lock()
+	if l.bound != nil || l.released {
+		l.mu.Unlock()
+		return
+	}
+	l.released = true
+	l.mu.Unlock()
+	l.finish()
+}
+func (l *Lease) finish() {
+	l.cancel()
+	p := l.pool
+	p.mu.Lock()
+	delete(l.entry.leases, l)
+	delete(p.leases, l)
+	if len(l.entry.leases) == 0 && l.entry.projectKeepalive != nil {
+		l.entry.projectKeepalive(p.keepaliveIntervalsLocked())
+		l.entry.projectKeepalive = nil
+	}
+	p.maybeCloseLocked(l.entry)
+	p.mu.Unlock()
+	close(l.done)
+}
+func (l *Lease) close() {
+	l.mu.Lock()
+	if l.released {
+		l.mu.Unlock()
+		<-l.done
+		return
+	}
+	bound := l.bound
+	l.released = true
+	l.bound = nil
+	l.mu.Unlock()
+	l.cancel()
+	if bound != nil {
+		_ = bound.Close()
+	}
+	l.finish()
+}
+func (l *Lease) connectionClosed() {
+	l.mu.Lock()
+	if l.released {
+		l.mu.Unlock()
+		return
+	}
+	l.released = true
+	l.bound = nil
+	l.mu.Unlock()
+	l.finish()
+}
+
+type leasedConn struct {
+	net.Conn
+	lease *Lease
+	once  sync.Once
+	err   error
+}
+
+func (c *leasedConn) Upstream() any           { return c.Conn }
+func (c *leasedConn) ReaderReplaceable() bool { return true }
+func (c *leasedConn) WriterReplaceable() bool { return true }
+
+func (c *leasedConn) Close() error {
+	c.once.Do(func() { c.err = c.Conn.Close(); c.lease.connectionClosed() })
+	return c.err
+}
+
+type leasedPacketConn struct {
+	net.PacketConn
+	lease *Lease
+	once  sync.Once
+	err   error
+}
+
+func (c *leasedPacketConn) Upstream() any           { return c.PacketConn }
+func (c *leasedPacketConn) ReaderReplaceable() bool { return true }
+func (c *leasedPacketConn) WriterReplaceable() bool { return true }
+
+func (c *leasedPacketConn) Close() error {
+	c.once.Do(func() { c.err = c.PacketConn.Close(); c.lease.connectionClosed() })
+	return c.err
+}
