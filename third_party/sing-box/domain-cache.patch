+//go:build with_gvisor
+
+package wireguard
+
+import (
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/sagernet/gvisor/pkg/tcpip"
+	"github.com/sagernet/gvisor/pkg/tcpip/stack"
+	"github.com/sagernet/sing-tun"
+	wgTun "github.com/sagernet/wireguard-go/tun"
+)
+
+type demoClosingTun struct {
+	tun.Tun
+	closes atomic.Int32
+}
+
+func (d *demoClosingTun) Close() error { d.closes.Add(1); return nil }
+
+type demoBlockingDispatcher struct {
+	stack.NetworkDispatcher
+	entered    chan struct{}
+	release    chan struct{}
+	deliveries atomic.Int32
+}
+
+func (d *demoBlockingDispatcher) DeliverNetworkPacket(_ tcpip.NetworkProtocolNumber, _ *stack.PacketBuffer) {
+	d.deliveries.Add(1)
+	d.entered <- struct{}{}
+	<-d.release
+}
+
+func TestStackCloseDrainsReceivedPacketsBeforeDetach(t *testing.T) {
+	for _, system := range []bool{false, true} {
+		name := "userspace"
+		if system {
+			name = "system"
+		}
+		t.Run(name, func(t *testing.T) {
+			dispatcher := &demoBlockingDispatcher{entered: make(chan struct{}, 1), release: make(chan struct{})}
+			var write func([][]byte, int) (int, error)
+			var closeDevice func() error
+			var detached func() bool
+			var receiveMu *sync.RWMutex
+			var host *demoClosingTun
+			if system {
+				ep := &deviceEndpoint{mtu: 1408, done: make(chan struct{})}
+				ipStack, err := tun.NewGVisorStack(ep)
+				if err != nil {
+					t.Fatal(err)
+				}
+				host = &demoClosingTun{}
+				d := &systemStackDevice{systemDevice: &systemDevice{device: host, events: make(chan wgTun.Event)}, endpoint: ep, stack: ipStack}
+				ep.Attach(dispatcher)
+				write = d.Write
+				closeDevice = d.Close
+				detached = func() bool { return !ep.IsAttached() }
+				receiveMu = &d.receiveMu
+			} else {
+				d := &stackDevice{mtu: 1408, done: make(chan struct{}), events: make(chan wgTun.Event), outbound: make(chan *stack.PacketBuffer, 1)}
+				ipStack, err := tun.NewGVisorStack((*wireEndpoint)(d))
+				if err != nil {
+					t.Fatal(err)
+				}
+				d.stack = ipStack
+				(*wireEndpoint)(d).Attach(dispatcher)
+				write = d.Write
+				closeDevice = d.Close
+				detached = func() bool { return !(*wireEndpoint)(d).IsAttached() }
+				receiveMu = &d.receiveMu
+			}
+			packet := make([]byte, 40)
+			packet[0] = 0x60
+			writeDone := make(chan error, 1)
+			go func() { _, err := write([][]byte{packet}, 0); writeDone <- err }()
+			select {
+			case <-dispatcher.entered:
+			case <-time.After(3 * time.Second):
+				t.Fatal("received packet did not reach dispatcher")
+			}
+			closeDone := make(chan error, 1)
+			go func() { closeDone <- closeDevice() }()
+			// A pending close owns the next write lock; observe it without relying on a sleep.
+			deadline := time.Now().Add(3 * time.Second)
+			for receiveMu.TryRLock() {
+				receiveMu.RUnlock()
+				if time.Now().After(deadline) {
+					t.Fatal("close did not wait for the admitted packet")
+				}
+			}
+			if detached() {
+				t.Fatal("stack detached before admitted packet completed")
+			}
+			select {
+			case err := <-closeDone:
+				t.Fatalf("close completed during delivery: %v", err)
+			default:
+			}
+			close(dispatcher.release)
+			select {
+			case err := <-writeDone:
+				if err != nil {
+					t.Fatal(err)
+				}
+			case <-time.After(3 * time.Second):
+				t.Fatal("received packet did not finish")
+			}
+			select {
+			case err := <-closeDone:
+				if err != nil {
+					t.Fatal(err)
+				}
+			case <-time.After(3 * time.Second):
+				t.Fatal("stack teardown deadlocked")
+			}
+			if !detached() {
+				t.Fatal("stack endpoint remained attached")
+			}
+			for i := 0; i < 10; i++ {
+				if _, err := write([][]byte{packet}, 0); err != nil {
+					t.Fatal(err)
+				}
+			}
+			if dispatcher.deliveries.Load() != 1 {
+				t.Fatal("closed stack admitted another packet")
+			}
+			if err := closeDevice(); err != nil {
+				t.Fatal(err)
+			}
+			if host != nil && host.closes.Load() != 1 {
+				t.Fatal("host device was not closed exactly once")
+			}
+		})
+	}
+}
+
+func TestStackDispatcherDetachIsSafeDuringRead(t *testing.T) {
+	for _, system := range []bool{false, true} {
+		dispatcher := &demoBlockingDispatcher{entered: make(chan struct{}, 1), release: make(chan struct{})}
+		close(dispatcher.release)
+		// This dispatcher is never called; all writes use an already detached endpoint.
+		var attach func(stack.NetworkDispatcher)
+		var attached func() bool
+		var write func([][]byte, int) (int, error)
+		if system {
+			ep := &deviceEndpoint{done: make(chan struct{})}
+			d := &systemStackDevice{systemDevice: &systemDevice{}, endpoint: ep}
+			attach = ep.Attach
+			attached = ep.IsAttached
+			write = d.Write
+		} else {
+			d := &stackDevice{done: make(chan struct{})}
+			attach = (*wireEndpoint)(d).Attach
+			attached = (*wireEndpoint)(d).IsAttached
+			write = d.Write
+		}
+		done := make(chan struct{})
+		go func() {
+			defer close(done)
+			for i := 0; i < 1000; i++ {
+				attach(dispatcher)
+				attach(nil)
+			}
+		}()
+		for i := 0; i < 1000; i++ {
+			_ = attached()
+		}
+		<-done
+		packet := make([]byte, 40)
+		packet[0] = 0x60
+		if _, err := write([][]byte{packet}, 0); err != nil {
+			t.Fatal(err)
+		}
+	}
+}
