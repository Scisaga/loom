+func (v *transport) DialContext(ctx context.Context, _ string, _ M.Socksaddr) (net.Conn, error) {
+	if !strings.HasPrefix(v.mode, "echo") {
+		return nil, errors.New("not used")
+	}
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	client, server := net.Pipe()
+	stop := context.AfterFunc(v.ctx, func() { server.Close() })
+	go func() { defer stop(); defer server.Close(); _, _ = io.Copy(server, server) }()
+	return client, nil
+}
+func (v *transport) ListenPacket(context.Context, M.Socksaddr) (net.PacketConn, error) {
+	return nil, errors.New("not used")
+}
+func (v *transport) Start(stage adapter.StartStage) error {
+	if stage != adapter.StartStateStart {
+		return nil
+	}
+	if v.mode == "block" {
+		v.once.Do(func() { close(v.entered) })
+		<-v.ctx.Done()
+		return v.ctx.Err()
+	}
+	if v.mode == "pause" {
+		v.once.Do(func() { close(v.entered) })
+		select {
+		case <-v.proceed:
+		case <-v.ctx.Done():
+			return v.ctx.Err()
+		}
+	}
+	if v.mode == "fail" {
+		return errors.New("demo preparation failure")
+	}
+	return nil
+}
+func (v *transport) Close() error { v.closed.Add(1); return nil }
