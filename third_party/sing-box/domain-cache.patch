+package execution
+
+import (
+	"bytes"
+	"errors"
+	"io"
+	"net"
+	"testing"
+	"time"
+
+	"github.com/sagernet/sing/common/buf"
+	"github.com/sagernet/sing/common/bufio"
+	M "github.com/sagernet/sing/common/metadata"
+)
+
+type packetTargetRecorder struct {
+	writes   int
+	address  net.Addr
+	body     []byte
+	read     []byte
+	from     net.Addr
+	writeErr error
+}
+
+func (c *packetTargetRecorder) WriteTo(body []byte, address net.Addr) (int, error) {
+	c.writes++
+	c.address = address
+	c.body = append([]byte(nil), body...)
+	if c.writeErr != nil {
+		return 0, c.writeErr
+	}
+	return len(body), nil
+}
+func (c *packetTargetRecorder) ReadFrom(body []byte) (int, net.Addr, error) {
+	if c.from == nil {
+		return 0, nil, io.EOF
+	}
+	return copy(body, c.read), c.from, nil
+}
+func (c *packetTargetRecorder) Close() error                     { return nil }
+func (c *packetTargetRecorder) LocalAddr() net.Addr              { return M.ParseSocksaddr("192.0.2.1:8443") }
+func (c *packetTargetRecorder) SetDeadline(time.Time) error      { return nil }
+func (c *packetTargetRecorder) SetReadDeadline(time.Time) error  { return nil }
+func (c *packetTargetRecorder) SetWriteDeadline(time.Time) error { return nil }
+
+func TestNativePacketAdapterPreservesRegisteredTargetAndPayload(t *testing.T) {
+	for _, target := range []string{"demo-target.example:8443", "192.0.2.23:8443", "[2001:db8::23]:8443"} {
+		t.Run(target, func(t *testing.T) {
+			registered := M.ParseSocksaddr(target)
+			transport := &packetTargetRecorder{}
+			connection := &PacketConn{PacketConn: transport, Target: registered}
+			adapted := bufio.NewPacketConn(connection)
+			payload := []byte{0, 1, 0xff, 0x42, 0, 0x7f}
+			packet := buf.NewPacket()
+			_, _ = packet.Write(payload)
+			if err := adapted.WritePacket(packet, registered); err != nil {
+				t.Fatalf("formal packet adapter lost the registered target: %v", err)
+			}
+			if transport.writes != 1 || M.SocksaddrFromNet(transport.address).Unwrap() != registered.Unwrap() || !bytes.Equal(transport.body, payload) {
+				t.Fatal("registered target or UDP payload changed before the transport")
+			}
+			transport.from, transport.read = registered, append([]byte(nil), payload...)
+			reply := buf.NewPacket()
+			defer reply.Release()
+			from, err := adapted.ReadPacket(reply)
+			if err != nil || from.Unwrap() != registered.Unwrap() || !bytes.Equal(reply.Bytes(), payload) {
+				t.Fatal("formal packet adapter changed reply target or payload", err)
+			}
+		})
+	}
+}
+
+func TestNativePacketAdapterRejectsAnotherTargetBeforeTransport(t *testing.T) {
+	registered := M.ParseSocksaddr("demo-target.example:8443")
+	transport := &packetTargetRecorder{}
+	connection := &PacketConn{PacketConn: transport, Target: registered}
+	adapted := bufio.NewPacketConn(connection)
+	for _, target := range []string{"other.example:8443", "demo-target.example:8444", "192.0.2.23:8443", "[2001:db8::23]:8443"} {
+		packet := buf.NewPacket()
+		_, _ = packet.Write([]byte("demo-payload"))
+		if err := adapted.WritePacket(packet, M.ParseSocksaddr(target)); err == nil || transport.writes != 0 {
+			t.Fatal("another target crossed the immutable execution registration")
+		}
+	}
+	if _, err := connection.WriteTo([]byte("demo-payload"), M.ParseSocksaddr("other.example:8443")); err == nil || transport.writes != 0 {
+		t.Fatal("net.PacketConn allowed a different target")
+	}
+}
+
+func TestNativePacketAdapterPreservesTransportErrorAndHidesRawUpstream(t *testing.T) {
+	registered := M.ParseSocksaddr("demo-target.example:8443")
+	failure := errors.New("demo transport closed")
+	transport := &packetTargetRecorder{writeErr: failure}
+	connection := &PacketConn{PacketConn: transport, Target: registered}
+	adapted := bufio.NewPacketConn(connection)
+	packet := buf.NewPacket()
+	if err := adapted.WritePacket(packet, registered); !errors.Is(err, failure) {
+		t.Fatal("formal adapter hid the original transport error", err)
+	}
+	if _, bypass := any(connection).(interface{ Upstream() any }); bypass {
+		t.Fatal("packet registration exposes its unchecked transport")
+	}
+}
