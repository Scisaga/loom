+)
+
+type executionConfirmConn struct {
+	net.Conn
+	readStarted  chan struct{}
+	readOnce     sync.Once
+	closeOnce    sync.Once
+	closeStarted chan struct{}
+	allowClose   <-chan struct{}
+}
+
+func (c *executionConfirmConn) Read(body []byte) (int, error) {
+	c.readOnce.Do(func() { close(c.readStarted) })
+	return c.Conn.Read(body)
+}
+func (c *executionConfirmConn) Close() error {
+	c.closeOnce.Do(func() {
+		if c.closeStarted != nil {
+			close(c.closeStarted)
+		}
+		if c.allowClose != nil {
+			<-c.allowClose
+		}
+		c.Conn.Close()
+	})
+	return nil
+}
+func confirmRequest(t *testing.T) (P.Request, []byte) {
+	t.Helper()
+	request := P.Request{Nonce: [16]byte{1}, Operation: P.ConnectTCP, PolicyID: "demo-policy", Context: &P.PathContext{OriginID: "demo-source", FinalExitID: "demo-exit", Visited: []string{}}, Host: "demo.example", Port: 443}
+	body, err := request.Marshal(2)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return request, body
+}
+func readConfirmRequest(conn net.Conn) error {
+	preface := make([]byte, len(executionPreface))
+	if _, err := io.ReadFull(conn, preface); err != nil {
+		return err
+	}
+	if !bytes.Equal(preface, executionPreface) {
+		return errors.New("unexpected native preface")
+	}
+	_, err := P.ReadFrame(conn, 8<<20)
+	return err
+}
+func TestExecutionTCPConfirmWaitsAndPreservesFirstPayload(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	left, right := net.Pipe()
+	defer right.Close()
+	wrapped := &executionConfirmConn{Conn: left, readStarted: make(chan struct{})}
+	request, body := confirmRequest(t)
+	serverReady := make(chan error, 1)
+	go func() { serverReady <- readConfirmRequest(right) }()
+	type result struct {
+		conn *executionClientConn
+		err  error
+	}
+	done := make(chan result, 1)
+	go func() { conn, err := confirmExecutionTCP(ctx, wrapped, request, body); done <- result{conn, err} }()
+	if err := <-serverReady; err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case <-wrapped.readStarted:
+	case <-time.After(time.Second):
+		t.Fatal("dial did not wait for native response")
+	}
+	select {
+	case <-done:
+		t.Fatal("dial returned before downstream confirmation")
+	default:
+	}
+	response, err := (P.Response{Nonce: request.Nonce, Status: P.Accepted}).Marshal()
+	if err != nil {
+		t.Fatal(err)
+	}
+	payload := []byte("first-application-byte")
+	written := make(chan error, 1)
+	go func() {
+		err := P.WriteFrame(right, response)
+		if err == nil {
+			_, err = right.Write(payload)
+		}
+		written <- err
+	}()
+	accepted := <-done
+	if accepted.err != nil {
+		t.Fatal(accepted.err)
+	}
+	defer accepted.conn.Close()
+	cancel() // A disarmed callback must not close the established connection.
+	_ = accepted.conn.SetReadDeadline(time.Now().Add(time.Second))
+	actual := make([]byte, len(payload))
+	if _, err := io.ReadFull(accepted.conn, actual); err != nil || !bytes.Equal(actual, payload) {
+		t.Fatal("confirmation lost payload or closed returned connection", err)
+	}
+	if err := <-written; err != nil {
+		t.Fatal(err)
+	}
+}
+func TestExecutionTCPConfirmJoinsCancellation(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	left, right := net.Pipe()
+	defer right.Close()
+	allow := make(chan struct{})
+	wrapped := &executionConfirmConn{Conn: left, readStarted: make(chan struct{}), closeStarted: make(chan struct{}), allowClose: allow}
+	request, body := confirmRequest(t)
+	go func() { _ = readConfirmRequest(right) }()
+	done := make(chan error, 1)
+	go func() { _, err := confirmExecutionTCP(ctx, wrapped, request, body); done <- err }()
+	select {
+	case <-wrapped.readStarted:
+	case <-time.After(time.Second):
+		t.Fatal("confirmation did not start")
+	}
+	cancel()
+	select {
+	case <-wrapped.closeStarted:
+	case <-time.After(time.Second):
+		t.Fatal("cancellation did not close this socket")
+	}
+	select {
+	case <-done:
+		t.Fatal("confirmation returned while cancellation still owned the socket")
+	default:
+	}
+	close(allow)
+	select {
+	case err := <-done:
+		if !errors.Is(err, context.Canceled) {
+			t.Fatal(err)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("canceled confirmation did not return")
+	}
+}
+func TestExecutionTCPFailureKeepsTypedResultAndCannotAcceptLater(t *testing.T) {
+	for _, test := range []struct {
+		name   string
+		cause  error
+		status P.Status
+		frame  bool
+	}{
+		{"denied", execution.ErrDenied, P.Denied, true},
+		{"unavailable", execution.ErrUnavailable, P.Unavailable, true},
+		{"unknown", execution.ErrUnknown, 0, false},
+		{"cancel", context.Canceled, 0, false},
+		{"closed", io.EOF, 0, false},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			left, right := net.Pipe()
+			defer left.Close()
+			server := &executionServerConn{Conn: right, nonce: [16]byte{1}, started: time.Now()}
+			done := make(chan struct{})
+			go func() {
+				defer close(done)
+				_ = server.HandshakeFailure(test.cause)
+				_ = server.HandshakeSuccess()
+				right.Close()
+			}()
+			_ = left.SetReadDeadline(time.Now().Add(time.Second))
+			body, err := P.ReadFrame(left, 128)
+			if test.frame {
+				if err != nil {
+					t.Fatal(err)
+				}
+				response, err := P.UnmarshalResponse(body, [16]byte{1})
+				if err != nil || response.Status != test.status {
+					t.Fatal("failure became Accepted", response, err)
+				}
+				if _, err := P.ReadFrame(left, 128); !errors.Is(err, io.EOF) {
+					t.Fatal("late Accepted followed failure", err)
+				}
+			} else if !errors.Is(err, io.EOF) {
+				t.Fatal("unknown/closed connection manufactured a status", err)
+			}
+			<-done
+		})
+	}
+}
