+func (w *Endpoint) ReadWireGuardCounters() (adapter.WireGuardCounters, error) {
+	epoch, peers, err := w.endpoint.PeerCounters()
+	if err != nil {
+		return adapter.WireGuardCounters{}, err
+	}
+	result := adapter.WireGuardCounters{Interface: w.Tag(), Epoch: epoch, Peers: []adapter.WireGuardPeerCounter{}}
+	for _, peer := range peers {
+		result.Peers = append(result.Peers, adapter.WireGuardPeerCounter{PublicKey: base64.RawURLEncoding.EncodeToString(peer.PublicKey[:]), RXBytes: peer.RXBytes, TXBytes: peer.TXBytes})
+	}
+	sort.Slice(result.Peers, func(i, j int) bool { return result.Peers[i].PublicKey < result.Peers[j].PublicKey })
+	return result, nil
+}
