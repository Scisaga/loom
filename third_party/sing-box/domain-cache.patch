+	connection := P.Connection{PolicyID: "demo-policy", Path: P.PathContext{OriginID: "demo-source", FinalExitID: "demo-egress", Visited: []string{"demo-forward"}}}
+	metadata := adapter.InboundContext{Network: "tcp", Destination: M.ParseSocksaddr("demo.example:443"), Execution: &connection}
+	ctx, cleanup, err := adapter.PinOutboundPath(context.Background(), f.manager, actual, &metadata)
+	if err != nil {
+		cleanup()
+		t.Fatal(err)
+	}
+	if metadata.ExecutionNextNodeID != "demo-relay-b" {
+		cleanup()
+		t.Fatal("cold failure did not continue within the qualified order")
+	}
+	if len(f.pool.Actual()) != 1 {
+		cleanup()
+		t.Fatal("failed or unused sender remained actual")
+	}
+	conn, err := actual.DialContext(ctx, "tcp", metadata.Destination)
+	cleanup()
+	if err != nil {
+		t.Fatal(err)
+	}
+	forwardEcho(t, conn)
+	if len(f.pool.Actual()) != 1 {
+		t.Fatal("pending reference release retired live business")
+	}
+	_ = conn.Close()
+	if len(f.pool.Actual()) != 0 {
+		t.Fatal("idle forward retained a sender")
+	}
+}
+
+func TestColdDiagnosticBorrowsWithoutChangingCurrentSelection(t *testing.T) {
+	f, s, a, b := sourceLeaseFixture(t, "echo")
+	before, err := s.CompareAndSelectAccess(context.Background(), a, s.AccessSnapshot())
+	if err != nil {
+		t.Fatal(err)
+	}
+	target := M.ParseSocksaddr("demo.example:443")
+	choice := b.Choices[b.Name]
+	metadata, selected, lease, err := s.BorrowAccessTCPChoice(context.Background(), before.Revision, b.PolicyID, choice, target)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if selected.Tag() != "demo-b" || metadata.ExecutionServiceID != "demo-service" {
+		t.Fatal("diagnostic lost its selected Service or candidate")
+	}
+	if !reflect.DeepEqual(before, s.AccessSnapshot()) || len(f.pool.Actual()) != 2 {
+		t.Fatal("temporary diagnostic changed production selection")
+	}
+	lease.Release()
+	if len(f.pool.Actual()) != 1 {
+		t.Fatal("diagnostic warmed its unused backup")
+	}
+	if metadata.ExecutionServiceID != "demo-service" {
+		t.Fatal("Service metadata did not remain pinned")
+	}
+}
