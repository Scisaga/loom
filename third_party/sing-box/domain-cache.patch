+package wireguard
+
+import (
+	"context"
+	"errors"
+	"net"
+	"net/netip"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/option"
+	W "github.com/sagernet/sing-box/transport/wireguard"
+	"github.com/sagernet/sing/common/buf"
+	M "github.com/sagernet/sing/common/metadata"
+)
+
+type sourceRouteBinding struct {
+	destination netip.Prefix
+	execution   netip.Addr
+}
+
+// One immutable snapshot owns both halves of a resource binding. Addresses
+// initialized on the stack are defaults, never authenticated sender grants.
+type sourceRouteSnapshot struct {
+	routes             []option.WireGuardSourceRoute
+	bindings           map[netip.Addr]sourceRouteBinding
+	peers              []option.WireGuardPeer
+	references         *W.PeerReferences
+	permissionRevision string
+}
+
+func (w *Endpoint) sourceBinding(source netip.Addr) (sourceRouteBinding, bool) {
+	snapshot := w.sourceRoutes.Load()
+	if snapshot == nil {
+		return sourceRouteBinding{}, false
+	}
+	binding, exists := snapshot.bindings[source]
+	return binding, exists
+}
+
+func (w *Endpoint) prepareSourceRoutes(routes []option.WireGuardSourceRoute, peers []option.WireGuardPeer) (*sourceRouteSnapshot, error) {
+	next := &sourceRouteSnapshot{routes: append([]option.WireGuardSourceRoute{}, routes...), bindings: make(map[netip.Addr]sourceRouteBinding, len(routes))}
+	for _, peer := range peers {
+		peer.AllowedIPs = append([]netip.Prefix(nil), peer.AllowedIPs...)
+		peer.Reserved = append([]uint8(nil), peer.Reserved...)
+		next.peers = append(next.peers, peer)
+	}
+	for _, route := range routes {
+		if !route.Source.Is6() || route.Source.Is4In6() || !route.Source.IsPrivate() || route.Source.Zone() != "" ||
+			!route.Execution.Is6() || route.Execution.Is4In6() || !route.Execution.IsPrivate() || route.Execution.Zone() != "" ||
+			!route.Destination.IsValid() || !route.Destination.Addr().Is6() || route.Destination.Addr().Is4In6() || !route.Destination.Addr().IsPrivate() ||
+			route.Destination != route.Destination.Masked() || route.Destination.Bits() != 64 && route.Destination.Bits() != 128 {
+			return nil, errors.New("invalid WireGuard source destination binding")
+		}
+		if _, exists := next.bindings[route.Source]; exists {
+			return nil, errors.New("duplicate WireGuard source destination binding")
+		}
+		owners := 0
+		for _, peer := range peers {
+			for _, allowed := range peer.AllowedIPs {
+				if allowed.Contains(route.Source) {
+					return nil, errors.New("WireGuard peer address overlaps a local source")
+				}
+				if allowed == route.Destination {
+					owners++
+				}
+			}
+		}
+		if owners != 1 {
+			return nil, errors.New("WireGuard source route lacks one peer destination")
+		}
+		executionOwner := false
+		for _, peer := range peers {
+			ownsPool, ownsExecution := false, false
+			for _, allowed := range peer.AllowedIPs {
+				ownsPool = ownsPool || allowed == route.Destination
+				ownsExecution = ownsExecution || allowed == netip.PrefixFrom(route.Execution, 128)
+			}
+			executionOwner = executionOwner || ownsPool && ownsExecution
+		}
+		if !executionOwner || route.Destination.Bits() == 128 && route.Destination.Addr() != route.Execution {
+			return nil, errors.New("WireGuard execution address has no exact same-peer binding")
+		}
+		next.bindings[route.Source] = sourceRouteBinding{destination: route.Destination, execution: route.Execution}
+	}
+	keys := map[string]bool{}
+	for i, peer := range peers {
+		if keys[peer.PublicKey] {
+			return nil, errors.New("duplicate WireGuard peer key")
+		}
+		keys[peer.PublicKey] = true
+		for _, prefix := range peer.AllowedIPs {
+			if !prefix.IsValid() || prefix != prefix.Masked() || prefix.Addr().Is4In6() || !prefix.Addr().IsGlobalUnicast() {
+				return nil, errors.New("noncanonical WireGuard peer address")
+			}
+			if prefix.Bits() != prefix.Addr().BitLen() {
+				bound := false
+				for _, route := range routes {
+					bound = bound || route.Destination == prefix
+				}
+				if !prefix.Addr().Is6() || !prefix.Addr().IsPrivate() || prefix.Bits() != 64 || !bound {
+					return nil, errors.New("WireGuard peer range lacks an exact execution pool binding")
+				}
+			}
+			for _, local := range w.localAddresses {
+				if prefix.Contains(local.Addr()) {
+					return nil, errors.New("WireGuard peer address overlaps a local source")
+				}
+			}
+			if !prefix.IsValid() || prefix != prefix.Masked() {
+				return nil, errors.New("noncanonical WireGuard peer address")
+			}
+			for j := i + 1; j < len(peers); j++ {
+				for _, other := range peers[j].AllowedIPs {
+					if prefix.Overlaps(other) {
+						return nil, errors.New("WireGuard peer address ownership overlaps")
+					}
+				}
+			}
+		}
+	}
+	return next, nil
+}
+
+func (w *Endpoint) configureSourceRoutes(options option.WireGuardEndpointOptions) error {
+	next, err := w.prepareSourceRoutes(options.SourceRoutes, options.Peers)
+	if err != nil {
+		return err
+	}
+	w.sourceRoutes.Store(next)
+	return nil
+}
+
+func (w *Endpoint) resolveTarget(ctx context.Context, destination M.Socksaddr) (M.Socksaddr, error) {
+	source := adapter.WireGuardSource(ctx)
+	binding, exists := w.sourceBinding(source)
+	if !exists {
+		return M.Socksaddr{}, errors.New("WireGuard source has no destination binding")
+	}
+	prefix, execution := binding.destination, binding.execution
+	if !execution.IsValid() {
+		return M.Socksaddr{}, errors.New("WireGuard source has no native execution address")
+	}
+	if prefix.Bits() == 128 {
+		if destination.Addr != execution || destination.Port != 53 || destination.IsFqdn() {
+			return M.Socksaddr{}, errors.New("WireGuard DNS source cannot access business targets")
+		}
+		return destination, nil
+	}
+	if destination.Addr == execution && destination.Port == 53 && !destination.IsFqdn() {
+		return destination, nil
+	}
+	return w.registerTarget(ctx, destination, prefix, execution)
+}
+
+// Preserve the original UDP target and reject packets outside this one flow.
+type targetPacketConn struct {
+	net.PacketConn
+	original M.Socksaddr
+	mapped   M.Socksaddr
+}
+
+func (c *targetPacketConn) WriteTo(body []byte, address net.Addr) (int, error) {
+	if M.SocksaddrFromNet(address).Unwrap() != c.original.Unwrap() {
+		return 0, errors.New("UDP target differs from its WireGuard binding")
+	}
+	return c.PacketConn.WriteTo(body, c.mapped.UDPAddr())
+}
+
+func (c *targetPacketConn) ReadFrom(body []byte) (int, net.Addr, error) {
+	for {
+		n, address, err := c.PacketConn.ReadFrom(body)
+		if err != nil {
+			return n, address, err
+		}
+		if M.SocksaddrFromNet(address).Unwrap() == c.mapped.Unwrap() {
+			return n, c.original, nil
+		}
+	}
+}
+
+func (c *targetPacketConn) ReadPacket(buffer *buf.Buffer) (M.Socksaddr, error) {
+	_, address, err := buffer.ReadPacketFrom(c)
+	if err != nil {
+		return M.Socksaddr{}, err
+	}
+	return M.SocksaddrFromNet(address), nil
+}
+
+func (c *targetPacketConn) WritePacket(buffer *buf.Buffer, destination M.Socksaddr) error {
+	defer buffer.Release()
+	_, err := c.WriteTo(buffer.Bytes(), destination)
+	return err
+}
