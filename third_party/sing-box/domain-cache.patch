+package wireguard
+
+import (
+	"encoding/base64"
+	"encoding/hex"
+	"errors"
+
+	"github.com/sagernet/wireguard-go/device"
+)
+
+// PeerReferences is a disposable snapshot of exact physical objects. It carries
+// no permission, task lifetime or desired-state authority.
+type PeerReferences struct{ values map[string]*device.Peer }
+
+func (e *Endpoint) CapturePeerReferences() (*PeerReferences, error) {
+	e.counterMu.RLock()
+	defer e.counterMu.RUnlock()
+	if e.device == nil {
+		return nil, errors.New("WG endpoint is not running")
+	}
+	result := &PeerReferences{values: map[string]*device.Peer{}}
+	for _, spec := range e.peers {
+		raw, err := hex.DecodeString(spec.publicKeyHex)
+		if err != nil {
+			return nil, err
+		}
+		var key device.NoisePublicKey
+		copy(key[:], raw)
+		peer := e.device.LookupPeer(key)
+		if peer == nil {
+			return nil, errors.New("WG physical peer is missing")
+		}
+		result.values[base64.StdEncoding.EncodeToString(raw)] = peer
+	}
+	return result, nil
+}
+func (r *PeerReferences) Covers(intervals map[string]uint16) bool {
+	if r == nil {
+		return len(intervals) == 0
+	}
+	for key, value := range intervals {
+		if value != 0 && r.values[key] == nil {
+			return false
+		}
+	}
+	return true
+}
+func (r *PeerReferences) Apply(intervals map[string]uint16) {
+	if r == nil {
+		return
+	}
+	for key, peer := range r.values {
+		peer.SetPersistentKeepaliveInterval(intervals[key])
+	}
+}
+
+func (e *Endpoint) ActualPeerCount() (int, error) {
+	if !e.counterMu.TryRLock() {
+		return 0, errors.New("WG physical peers pending")
+	}
+	defer e.counterMu.RUnlock()
+	if e.device == nil {
+		return 0, errors.New("WG endpoint is not running")
+	}
+	return e.device.PeerCount()
+}
+
+func (r *PeerReferences) Projection(keys []string) func(map[string]uint16) {
+	peers := map[string]*device.Peer{}
+	if r != nil {
+		for _, key := range keys {
+			if peer := r.values[key]; peer != nil {
+				peers[key] = peer
+			}
+		}
+	}
+	return func(intervals map[string]uint16) {
+		for key, peer := range peers {
+			peer.SetPersistentKeepaliveInterval(intervals[key])
+		}
+	}
+}
