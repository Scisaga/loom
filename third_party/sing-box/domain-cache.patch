+package wireguard
+
+import (
+	"context"
+	"encoding/hex"
+	"errors"
+	"net"
+	"net/netip"
+	"strings"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/option"
+	"github.com/sagernet/sing-dns"
+	"github.com/sagernet/sing/common/buf"
+	M "github.com/sagernet/sing/common/metadata"
+)
+
+const literalSuffix = ".loom-ip.invalid"
+
+func literalName(address netip.Addr) (string, error) {
+	if !address.IsValid() || address.Is4In6() || address.Zone() != "" {
+		return "", errors.New("invalid literal execution target")
+	}
+	family := ".v6"
+	if address.Is4() {
+		family = ".v4"
+	}
+	return hex.EncodeToString(address.AsSlice()) + family + literalSuffix, nil
+}
+
+func literalAddress(name string) (netip.Addr, bool, error) {
+	if !strings.HasSuffix(strings.ToLower(name), literalSuffix) {
+		return netip.Addr{}, false, nil
+	}
+	body := strings.TrimSuffix(name, literalSuffix)
+	parts := strings.Split(body, ".")
+	if len(parts) != 2 || parts[1] != "v4" && parts[1] != "v6" {
+		return netip.Addr{}, true, errors.New("invalid literal execution target name")
+	}
+	data, err := hex.DecodeString(parts[0])
+	address, valid := netip.AddrFromSlice(data)
+	if err != nil || !valid || parts[1] == "v4" && len(data) != 4 || parts[1] == "v6" && len(data) != 16 {
+		return netip.Addr{}, true, errors.New("invalid literal execution target bytes")
+	}
+	canonical, err := literalName(address)
+	if err != nil || canonical != name {
+		return netip.Addr{}, true, errors.New("noncanonical literal execution target")
+	}
+	return address, true, nil
+}
+
+func (w *Endpoint) configureSourceRoutes(options option.WireGuardEndpointOptions) error {
+	w.sourceRoutes = make(map[netip.Addr]netip.Prefix)
+	for _, route := range options.SourceRoutes {
+		if !route.Source.Is6() || route.Source.Is4In6() || !route.Source.IsPrivate() || route.Source.Zone() != "" ||
+			!route.Destination.IsValid() || !route.Destination.Addr().Is6() || route.Destination.Addr().Is4In6() || !route.Destination.Addr().IsPrivate() ||
+			route.Destination != route.Destination.Masked() || route.Destination.Bits() != 64 && route.Destination.Bits() != 128 {
+			return errors.New("invalid WireGuard source destination binding")
+		}
+		if _, exists := w.sourceRoutes[route.Source]; exists {
+			return errors.New("duplicate WireGuard source destination binding")
+		}
+		local := false
+		for _, address := range w.localAddresses {
+			local = local || address.Bits() == 128 && address.Addr() == route.Source
+		}
+		owners := 0
+		for _, peer := range options.Peers {
+			for _, allowed := range peer.AllowedIPs {
+				if allowed == route.Destination {
+					owners++
+				}
+			}
+		}
+		if !local || owners != 1 {
+			return errors.New("WireGuard source route lacks one local source and one peer destination")
+		}
+		w.sourceRoutes[route.Source] = route.Destination
+	}
+	keys := map[string]bool{}
+	for i, peer := range options.Peers {
+		if keys[peer.PublicKey] {
+			return errors.New("duplicate WireGuard peer key")
+		}
+		keys[peer.PublicKey] = true
+		for _, prefix := range peer.AllowedIPs {
+			if !prefix.IsValid() || prefix != prefix.Masked() || prefix.Addr().Is4In6() || !prefix.Addr().IsGlobalUnicast() {
+				return errors.New("noncanonical WireGuard peer address")
+			}
+			if prefix.Bits() != prefix.Addr().BitLen() {
+				bound := false
+				for _, route := range options.SourceRoutes {
+					bound = bound || route.Destination == prefix
+				}
+				if !prefix.Addr().Is6() || !prefix.Addr().IsPrivate() || prefix.Bits() != 64 || !bound {
+					return errors.New("WireGuard peer range lacks an exact execution pool binding")
+				}
+			}
+			for _, local := range w.localAddresses {
+				if prefix.Contains(local.Addr()) {
+					return errors.New("WireGuard peer address overlaps a local source")
+				}
+			}
+			if !prefix.IsValid() || prefix != prefix.Masked() {
+				return errors.New("noncanonical WireGuard peer address")
+			}
+			for j := i + 1; j < len(options.Peers); j++ {
+				for _, other := range options.Peers[j].AllowedIPs {
+					if prefix.Overlaps(other) {
+						return errors.New("WireGuard peer address ownership overlaps")
+					}
+				}
+			}
+		}
+	}
+	return nil
+}
+
+func (w *Endpoint) resolveTarget(ctx context.Context, destination M.Socksaddr) (M.Socksaddr, error) {
+	prefix, exists := w.sourceRoutes[adapter.WireGuardSource(ctx)]
+	if !exists {
+		return M.Socksaddr{}, errors.New("WireGuard source has no destination binding")
+	}
+	if prefix.Bits() == 128 {
+		if destination.Addr != prefix.Addr() || destination.Port != 53 || destination.IsFqdn() {
+			return M.Socksaddr{}, errors.New("WireGuard DNS source cannot access business targets")
+		}
+		return destination, nil
+	}
+	name := destination.Fqdn
+	if destination.Addr.IsValid() {
+		var err error
+		name, err = literalName(destination.Addr)
+		if err != nil {
+			return M.Socksaddr{}, err
+		}
+	} else if name == "" || strings.HasSuffix(strings.ToLower(name), literalSuffix) {
+		return M.Socksaddr{}, errors.New("reserved or invalid execution target domain")
+	}
+	addresses, err := w.router.Lookup(ctx, name, dns.DomainStrategyUseIPv6)
+	if err != nil {
+		return M.Socksaddr{}, err
+	}
+	if len(addresses) == 0 {
+		return M.Socksaddr{}, errors.New("execution target DNS returned no address")
+	}
+	for _, address := range addresses {
+		if !prefix.Contains(address) {
+			return M.Socksaddr{}, errors.New("execution target belongs to another peer")
+		}
+	}
+	return M.SocksaddrFrom(addresses[0], destination.Port), nil
+}
+
+func (w *Endpoint) restoreTarget(destination M.Socksaddr) (M.Socksaddr, error) {
+	store := w.router.FakeIPStore()
+	if store == nil || !store.Contains(destination.Addr) {
+		return destination, nil
+	}
+	name, found := store.Lookup(destination.Addr)
+	if !found {
+		return M.Socksaddr{}, errors.New("execution target cache entry is missing")
+	}
+	address, literal, err := literalAddress(name)
+	if err != nil {
+		return M.Socksaddr{}, err
+	}
+	if !literal {
+		return destination, nil
+	}
+	if store.Contains(address) {
+		return M.Socksaddr{}, errors.New("execution address cannot be a literal business target")
+	}
+	return M.SocksaddrFrom(address, destination.Port), nil
+}
+
+// Preserve the original UDP target and reject packets outside this one flow.
+type targetPacketConn struct {
+	net.PacketConn
+	original M.Socksaddr
+	mapped   M.Socksaddr
+}
+
+func (c *targetPacketConn) WriteTo(body []byte, address net.Addr) (int, error) {
+	if M.SocksaddrFromNet(address).Unwrap() != c.original.Unwrap() {
+		return 0, errors.New("UDP target differs from its WireGuard binding")
+	}
+	return c.PacketConn.WriteTo(body, c.mapped.UDPAddr())
+}
+
+func (c *targetPacketConn) ReadFrom(body []byte) (int, net.Addr, error) {
+	for {
+		n, address, err := c.PacketConn.ReadFrom(body)
+		if err != nil {
+			return n, address, err
+		}
+		if M.SocksaddrFromNet(address).Unwrap() == c.mapped.Unwrap() {
+			return n, c.original, nil
+		}
+	}
+}
+
+func (c *targetPacketConn) ReadPacket(buffer *buf.Buffer) (M.Socksaddr, error) {
+	_, address, err := buffer.ReadPacketFrom(c)
+	if err != nil {
+		return M.Socksaddr{}, err
+	}
+	return M.SocksaddrFromNet(address), nil
+}
+
+func (c *targetPacketConn) WritePacket(buffer *buf.Buffer, destination M.Socksaddr) error {
+	defer buffer.Release()
+	_, err := c.WriteTo(buffer.Bytes(), destination)
+	return err
+}
