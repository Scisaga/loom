+package wireguard
+
+import (
+	"errors"
+	"strconv"
+)
+
+// PrepareListener changes only the UDP receiving port of this same WG device.
+// The standard shared Bind retains both supported families; a public dial
+// coordinate never supplies this local port.
+func (e *Endpoint) PrepareListener(port uint16) (func() error, error) {
+	e.counterMu.RLock()
+	valid := e.device != nil && e.options.ListenPort != 0 && port != 0
+	e.counterMu.RUnlock()
+	if !valid {
+		return nil, errors.New("WG hot listener update requires its existing receiver and a nonzero port")
+	}
+	return func() error {
+		e.counterMu.Lock()
+		defer e.counterMu.Unlock()
+		if e.device == nil || e.options.ListenPort == 0 {
+			return errors.New("WG listener input changed before apply")
+		}
+		if e.device.BoundPort() == port {
+			e.options.ListenPort = port
+			return nil
+		}
+		// IpcSet rebinds UDP while retaining the Device, keys, peers and inner
+		// connections. Failure is reported; it never restores old permission.
+		e.options.ListenPort = port
+		if err := e.device.IpcSet("listen_port=" + strconv.Itoa(int(port)) + "\n"); err != nil {
+			return errors.New("WG local UDP listener rebind failed")
+		}
+		return nil
+	}, nil
+}
