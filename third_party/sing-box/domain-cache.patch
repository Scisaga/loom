+package execution
+
+import (
+	"context"
+	"crypto/rand"
+	"errors"
+	P "github.com/sagernet/sing-box/common/loomprotocol"
+	"github.com/sagernet/sing-box/option"
+	M "github.com/sagernet/sing/common/metadata"
+	"strings"
+)
+
+func Request(ctx context.Context, route *option.ExecutionRoute, destination M.Socksaddr, operation P.Operation) (P.Request, error) {
+	_, connection, err := PrepareContext(ctx, route)
+	if err != nil {
+		return P.Request{}, err
+	}
+	host := destination.Fqdn
+	if host == "" {
+		host = destination.Addr.String()
+	} else {
+		host = strings.ToLower(strings.TrimSuffix(host, "."))
+	}
+	value := P.Request{Operation: operation, PolicyID: connection.PolicyID, Context: &connection.Path, Host: host, Port: destination.Port}
+	if _, err = rand.Read(value.Nonce[:]); err != nil {
+		return P.Request{}, err
+	}
+	return value, nil
+}
+func CheckResponse(body []byte, request P.Request) (P.Response, error) {
+	response, err := P.UnmarshalResponse(body, request.Nonce)
+	if err != nil {
+		return P.Response{}, errors.Join(ErrUnknown, err)
+	}
+	switch response.Status {
+	case P.Denied:
+		return P.Response{}, ErrDenied
+	case P.Unavailable:
+		return P.Response{}, ErrUnavailable
+	}
+	if request.Operation == P.ResolveTarget {
+		if !response.Address.IsValid() {
+			return P.Response{}, errors.Join(ErrUnknown, errors.New("execution registration returned no target"))
+		}
+	} else if response.Address.IsValid() {
+		return P.Response{}, errors.Join(ErrUnknown, errors.New("unexpected target address in execution response"))
+	}
+	return response, nil
+}
