+)
+
+func TestPublicInternetGuardRejectsLocalAndUnresolvedTargetsBeforeDial(t *testing.T) {
+	guard := &publicInternetDialer{}
+	for _, host := range []string{"127.0.0.1", "10.0.0.1", "192.0.2.1", "198.18.0.1", "::1", netip.MustParsePrefix("fc00::/7").Addr().Next().String(), "2001:db8::1", "demo.example"} {
+		target := M.ParseSocksaddrHostPort(host, 443)
+		if _, err := guard.DialContext(context.Background(), "tcp", target); err == nil {
+			t.Fatal("accepted restricted target", host)
+		}
+		if _, err := guard.DialParallelInterface(context.Background(), "tcp", target, nil, nil, nil, 0); err == nil {
+			t.Fatal("parallel dial bypass", host)
+		}
+		if _, err := guard.ListenPacket(context.Background(), target); err == nil {
+			t.Fatal("UDP bypass", host)
+		}
+		if _, err := guard.ListenSerialInterfacePacket(context.Background(), target, nil, nil, nil, 0); err == nil {
+			t.Fatal("serial UDP bypass", host)
+		}
+	}
+}
