+func TestPublicInternetNeverUsesSNIToAuthorizeLocalIP(t *testing.T) {
+	item := PublicInternetItem{}
+	for _, host := range []string{"127.0.0.1", "10.0.0.1", netip.MustParsePrefix("fc00::/7").Addr().Next().String(), "demo.local", "control.loom"} {
+		if item.Match(&adapter.InboundContext{Destination: M.ParseSocksaddrHostPort(host, 443), Domain: "demo.example"}) {
+			t.Fatal("SNI expanded target permission", host)
+		}
+	}
+	if !item.Match(&adapter.InboundContext{Destination: M.ParseSocksaddrHostPort("demo.example", 443)}) {
+		t.Fatal("rejected ordinary public name")
+	}
+}
