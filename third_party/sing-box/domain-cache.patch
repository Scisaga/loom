+func TestSourceRouteUsesStableStackWithoutGrantingItsAnchors(t *testing.T) {
+	source := netip.MustParseAddr("fdab:77::1")
+	execution := netip.MustParseAddr("fdab:79::1")
+	anchors := []netip.Prefix{netip.MustParsePrefix("127.0.0.1/32"), netip.MustParsePrefix("::1/128")}
+	endpoint := Endpoint{localAddresses: anchors}
+	options := option.WireGuardEndpointOptions{
+		SourceRoutes: []option.WireGuardSourceRoute{{Source: source, Destination: netip.PrefixFrom(execution, 128), Execution: execution}},
+		Peers:        []option.WireGuardPeer{{PublicKey: "demo-peer", AllowedIPs: []netip.Prefix{netip.PrefixFrom(execution, 128)}}},
+	}
+	if err := endpoint.configureSourceRoutes(options); err != nil {
+		t.Fatal("authorized resource source required a stack address change", err)
+	}
+	if _, err := endpoint.BindWireGuardSource(context.Background(), source); err != nil {
+		t.Fatal("current resource source could not bind", err)
+	}
+	for _, anchor := range anchors {
+		if _, err := endpoint.BindWireGuardSource(context.Background(), anchor.Addr()); err == nil {
+			t.Fatal("stack initialization address became an authenticated source")
+		}
+	}
+	if _, err := endpoint.DialContext(context.Background(), "tcp", M.SocksaddrFrom(execution, 53)); err == nil {
+		t.Fatal("a missing binding fell back to the stack default")
+	}
+	if _, err := endpoint.ListenPacket(context.Background(), M.SocksaddrFrom(execution, 53)); err == nil {
+		t.Fatal("a missing UDP binding fell back to the stack default")
+	}
+	ctx, err := endpoint.BindWireGuardSource(context.Background(), source)
+	if err != nil {
+		t.Fatal(err)
+	}
+	target := M.SocksaddrFrom(execution, 53)
+	if actual, err := endpoint.resolveTarget(ctx, target); err != nil || actual != target {
+		t.Fatal("current exact execution binding was lost", err)
+	}
+	options.SourceRoutes[0].Execution = netip.MustParseAddr("fdab:79::2")
+	if err := endpoint.configureSourceRoutes(options); err == nil {
+		t.Fatal("accepted a mismatched execution owner")
+	}
+	if actual, err := endpoint.resolveTarget(ctx, target); err != nil || actual != target {
+		t.Fatal("rejected preparation destroyed the prior immutable source binding", err)
+	}
+}
+
+func TestWGSourceSnapshotPublishesPoolAndExecutionTogether(t *testing.T) {
+	source := netip.MustParseAddr("fdab:77::1")
+	endpoint := Endpoint{localAddresses: []netip.Prefix{netip.MustParsePrefix("::1/128")}}
+	options := [2]option.WireGuardEndpointOptions{}
+	for i, address := range []string{"fdab:79::1", "fdab:79::2"} {
+		execution := netip.MustParseAddr(address)
+		options[i] = option.WireGuardEndpointOptions{SourceRoutes: []option.WireGuardSourceRoute{{Source: source, Destination: netip.PrefixFrom(execution, 128), Execution: execution}}, Peers: []option.WireGuardPeer{{PublicKey: "demo-peer", AllowedIPs: []netip.Prefix{netip.PrefixFrom(execution, 128)}}}}
+	}
+	if err := endpoint.configureSourceRoutes(options[0]); err != nil {
+		t.Fatal(err)
+	}
+	var writer sync.WaitGroup
+	writer.Add(1)
+	go func() {
+		defer writer.Done()
+		for i := 0; i < 2000; i++ {
+			if err := endpoint.configureSourceRoutes(options[i%2]); err != nil {
+				t.Error(err)
+				return
+			}
+		}
+	}()
+	for i := 0; i < 4000; i++ {
+		binding, exists := endpoint.sourceBinding(source)
+		if !exists || binding.destination.Addr() != binding.execution {
+			t.Error("one lookup mixed two source snapshots")
+			break
+		}
+	}
+	writer.Wait()
+}
