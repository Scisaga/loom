+package hysteria2
+
+import (
+	"context"
+	"encoding/binary"
+	"errors"
+	"io"
+	"net"
+	"time"
+
+	"github.com/sagernet/quic-go"
+	"github.com/sagernet/quic-go/quicvarint"
+	"github.com/sagernet/sing-quic/hysteria2/internal/protocol"
+	"github.com/sagernet/sing/common/auth"
+	"github.com/sagernet/sing/common/canceler"
+	E "github.com/sagernet/sing/common/exceptions"
+	M "github.com/sagernet/sing/common/metadata"
+)
+
+const executionFrameType = 0x403
+const maxExecutionFrame = 8 << 20
+
+const (
+	ExecutionDeniedMessage      = "loom:execution:denied"
+	ExecutionUnavailableMessage = "loom:execution:unavailable"
+)
+
+// Keep error strings distinct from wire messages. A generic Hy2 request must
+// not accidentally emit a reserved native outcome through err.Error().
+var (
+	ErrExecutionDenied      = errors.New("native execution denied")
+	ErrExecutionUnavailable = errors.New("native execution path unavailable")
+	ErrExecutionUnknown     = errors.New("native execution confirmation unavailable")
+)
+
+func executionFailureMessage(err error) (string, bool) {
+	if E.IsClosed(err) || E.IsCanceled(err) {
+		return "", false
+	}
+	if errors.Is(err, ErrExecutionDenied) {
+		return ExecutionDeniedMessage, true
+	}
+	if errors.Is(err, ErrExecutionUnknown) {
+		return "execution request failed", true
+	}
+	return ExecutionUnavailableMessage, true
+}
+
+func (c *clientConn) readExecutionResponse() error {
+	if c.responseRead {
+		return nil
+	}
+	accepted, message, err := protocol.ReadTCPResponse(c.Stream)
+	if err != nil {
+		return errors.Join(ErrExecutionUnknown, err)
+	}
+	if !accepted {
+		switch message {
+		case ExecutionDeniedMessage:
+			return ErrExecutionDenied
+		case ExecutionUnavailableMessage:
+			return ErrExecutionUnavailable
+		default:
+			return ErrExecutionUnknown
+		}
+	}
+	c.responseRead = true
+	return nil
+}
+
+// WriteTCPResponse uses the same response encoder as native TCP streams.
+func WriteTCPResponse(writer io.Writer, accepted bool, message string) error {
+	buffer := protocol.WriteTCPResponse(accepted, message, nil)
+	defer buffer.Release()
+	n, err := buffer.WriteTo(writer)
+	if err == nil && n != int64(buffer.Len()) {
+		return io.ErrShortWrite
+	}
+	return err
+}
+
+// ExecutionHandler is a native Hy2 request entry, not a tunnel around Hy2.
+// The application parses its bounded schema and supplies the same authenticated
+// context to TCP or the existing UDP session. It cannot replace authentication.
+type ExecutionHandler func(ctx context.Context, stream net.Conn, source M.Socksaddr,
+	acceptTCP func(context.Context, M.Socksaddr),
+	registerUDP func(context.Context, uint32, M.Socksaddr) error) error
+
+type rawExecutionConn struct {
+	quic.Stream
+	local, remote net.Addr
+}
+
+func (c *rawExecutionConn) LocalAddr() net.Addr  { return c.local }
+func (c *rawExecutionConn) RemoteAddr() net.Addr { return c.remote }
+
+func (s *serverSession[U]) handleExecution(stream quic.Stream) error {
+	user, ok := s.currentUser()
+	if !ok {
+		return errors.New("Hy2 principal is no longer authorized")
+	}
+	ctx := auth.ContextWithUser(s.ctx, user)
+	raw := &rawExecutionConn{Stream: stream, local: s.quicConn.LocalAddr(), remote: s.quicConn.RemoteAddr()}
+	return s.executionHandler(ctx, raw, s.source, func(ctx context.Context, destination M.Socksaddr) {
+		s.handler.NewConnectionEx(ctx, &serverConn{Stream: stream, nativeExecution: true}, s.source, destination, nil)
+	}, func(ctx context.Context, id uint32, destination M.Socksaddr) error {
+		return s.registerExecutionUDP(ctx, id, destination)
+	})
+}
+func (s *serverSession[U]) registerExecutionUDP(ctx context.Context, id uint32, destination M.Socksaddr) error {
+	if s.udpDisabled {
+		return errors.New("UDP disabled")
+	}
+	if _, ok := s.currentUser(); !ok {
+		return errors.New("Hy2 principal is no longer authorized")
+	}
+	s.udpAccess.Lock()
+	if _, exists := s.udpConnMap[id]; exists {
+		s.udpAccess.Unlock()
+		return errors.New("UDP session is already registered")
+	}
+	conn := newUDPPacketConn(ctx, s.quicConn, func() { s.udpAccess.Lock(); delete(s.udpConnMap, id); s.udpAccess.Unlock() })
+	conn.sessionID = id
+	conn.executionTarget = destination.String()
+	s.udpConnMap[id] = conn
+	s.udpAccess.Unlock()
+	active, wrapped := canceler.NewPacketConn(conn.ctx, conn, s.udpTimeout)
+	go s.handler.NewPacketConnectionEx(active, wrapped, s.source, destination, nil)
+	return nil
+}
+
+func writeExecutionRequest(writer io.Writer, body []byte) error {
+	if len(body) == 0 || len(body) > maxExecutionFrame {
+		return errors.New("invalid execution frame size")
+	}
+	header := quicvarint.Append(nil, executionFrameType)
+	header = binary.BigEndian.AppendUint32(header, uint32(len(body)))
+	for _, part := range [][]byte{header, body} {
+		for len(part) > 0 {
+			n, err := writer.Write(part)
+			if err != nil {
+				return err
+			}
+			if n <= 0 || n > len(part) {
+				return io.ErrShortWrite
+			}
+			part = part[n:]
+		}
+	}
+	return nil
+}
+func exchangeExecution(ctx context.Context, conn quic.Connection, body []byte) ([]byte, error) {
+	stream, err := conn.OpenStreamSync(ctx)
+	if err != nil {
+		return nil, err
+	}
+	defer stream.CancelRead(0)
+	defer stream.Close()
+	deadline := time.Now().Add(8 * time.Second)
+	if limit, ok := ctx.Deadline(); ok && limit.Before(deadline) {
+		deadline = limit
+	}
+	_ = stream.SetDeadline(deadline)
+	stop := context.AfterFunc(ctx, func() { stream.CancelRead(0); stream.CancelWrite(0) })
+	defer stop()
+	if err := writeExecutionRequest(stream, body); err != nil {
+		return nil, err
+	}
+	var header [4]byte
+	if _, err := io.ReadFull(stream, header[:]); err != nil {
+		return nil, err
+	}
+	length := binary.BigEndian.Uint32(header[:])
+	if length == 0 || length > 128 {
+		return nil, errors.New("invalid execution response bound")
+	}
+	response := make([]byte, int(length))
+	_, err = io.ReadFull(stream, response)
+	return response, err
+}
+func (c *Client) Execute(ctx context.Context, body []byte) ([]byte, error) {
+	conn, err := c.offer(ctx)
+	if err != nil {
+		return nil, err
+	}
+	return exchangeExecution(ctx, conn.quicConn, body)
+}
+func (c *Client) DialConnWithExecution(ctx context.Context, destination M.Socksaddr, body []byte) (net.Conn, error) {
+	ctx, cancel := context.WithTimeout(ctx, 8*time.Second)
+	defer cancel()
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	if len(body) == 0 || len(body) > maxExecutionFrame {
+		return nil, errors.New("invalid execution request")
+	}
+	conn, err := c.DialConn(ctx, destination)
+	if err != nil {
+		return nil, err
+	}
+	native := conn.(*clientConn)
+	if err := confirmExecutionTCP(ctx, native, body); err != nil {
+		conn.Close()
+		return nil, err
+	}
+	return conn, nil
+}
+
+func confirmExecutionTCP(ctx context.Context, native *clientConn, body []byte) error {
+	deadline := time.Now().Add(8 * time.Second)
+	if limit, ok := ctx.Deadline(); ok && limit.Before(deadline) {
+		deadline = limit
+	}
+	if err := native.Stream.SetDeadline(deadline); err != nil {
+		return err
+	}
+	canceled := make(chan struct{})
+	stop := context.AfterFunc(ctx, func() {
+		native.Stream.CancelRead(0)
+		native.Stream.CancelWrite(0)
+		close(canceled)
+	})
+	err := writeExecutionRequest(native.Stream, body)
+	if err == nil {
+		native.requestWritten = true
+		err = native.readExecutionResponse()
+	}
+	if !stop() {
+		<-canceled
+	}
+	if ctx.Err() != nil {
+		err = ctx.Err()
+	}
+	if err != nil {
+		return err
+	}
+	return native.Stream.SetDeadline(time.Time{})
+}
+
+func (c *Client) ListenPacketWithExecution(ctx context.Context, request func(uint32) ([]byte, error)) (net.PacketConn, []byte, error) {
+	packet, err := c.ListenPacket(ctx)
+	if err != nil {
+		return nil, nil, err
+	}
+	conn := packet.(*udpPacketConn)
+	body, err := request(conn.sessionID)
+	if err != nil {
+		packet.Close()
+		return nil, nil, err
+	}
+	response, err := exchangeExecution(ctx, conn.quicConn, body)
+	if err != nil {
+		packet.Close()
+		return nil, nil, err
+	}
+	return packet, response, nil
+}
