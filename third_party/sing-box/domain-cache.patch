+	s, options, a, b := accessFixture(t)
+	spare := options.Policies[0]
+	spare.Policy.PolicyID = "demo-unselected"
+	options.Policies = append(options.Policies, spare)
+	if _, err := s.ReplaceAccess(options, s.AccessAuthorizationState().Revision, "demo-extra-grant", nil); err != nil {
