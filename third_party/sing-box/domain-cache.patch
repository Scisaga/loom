+func TestAccessOptimizationKeepsActualTCPAndChangesNewConnections(t *testing.T) {
+	listen := func(marker byte) string {
+		listener, err := net.Listen("tcp", "127.0.0.1:0")
+		if err != nil {
+			t.Fatal(err)
+		}
+		t.Cleanup(func() { _ = listener.Close() })
+		go func() {
+			for {
+				conn, err := listener.Accept()
+				if err != nil {
+					return
+				}
+				go func() {
+					defer conn.Close()
+					_ = conn.SetDeadline(time.Now().Add(5 * time.Second))
+					var request [1]byte
+					for {
+						if _, err := io.ReadFull(conn, request[:]); err != nil {
+							return
+						}
+						if _, err := conn.Write([]byte{marker, request[0]}); err != nil {
+							return
+						}
+					}
+				}()
+			}
+		}()
+		return listener.Addr().String()
+	}
+	s, _, a, b := accessFixture(t)
+	s.outbounds["demo-a"] = realTargetOutbound{targetOutbound("demo-a"), listen('a')}
+	s.outbounds["demo-b"] = realTargetOutbound{targetOutbound("demo-b"), listen('b')}
+	idA, choicesA := sourceChoice(t, a)
+	idB, choicesB := sourceChoice(t, b)
+	first, err := s.CompareAndSelectAccess(context.Background(), AccessSnapshot{Name: idA, PolicyID: "demo-policy", Choices: choicesA, Targets: map[string]string{}}, s.AccessSnapshot())
+	if err != nil {
+		t.Fatal(err)
+	}
+	request := M.ParseSocksaddr("demo.example:443")
+	dial := func() net.Conn {
+		metadata := &adapter.InboundContext{Destination: request}
+		conn, err := s.DialContext(adapter.WithContext(context.Background(), metadata), "tcp", request)
+		if err != nil {
+			t.Fatal(err)
+		}
+		t.Cleanup(func() { _ = conn.Close() })
+		return conn
+	}
+	exchange := func(conn net.Conn, marker byte) {
+		_ = conn.SetDeadline(time.Now().Add(time.Second))
+		if _, err := conn.Write([]byte{'x'}); err != nil {
+			t.Fatal(err)
+		}
+		var reply [2]byte
+		if _, err := io.ReadFull(conn, reply[:]); err != nil || reply != [2]byte{marker, 'x'} {
+			t.Fatal("pinned TCP transport changed or closed", reply, err)
+		}
+	}
+	old := dial()
+	exchange(old, 'a')
+	if _, err := s.CompareAndSelectAccess(context.Background(), AccessSnapshot{Name: idB, PolicyID: "demo-policy", Choices: choicesB, Targets: map[string]string{}}, first); err != nil {
+		t.Fatal(err)
+	}
+	exchange(old, 'a')
+	exchange(dial(), 'b')
+}
