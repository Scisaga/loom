+
+func TestWGIdleSenderKeepsReceivingBaseAndLeasedKeepalive(t *testing.T) {
+	incoming := netip.MustParsePrefix("fdab:77::1/128")
+	target := netip.MustParseAddr("fdab:79::1")
+	prefix := netip.PrefixFrom(target, 128)
+	route := option.WireGuardSourceRoute{Source: netip.MustParseAddr("fdab:77::2"), Destination: prefix, Execution: target}
+	peer := option.WireGuardPeer{PublicKey: "demo-key", PreSharedKey: "demo-psk", Address: "192.0.2.10", Port: 51820,
+		AllowedIPs: []netip.Prefix{incoming, prefix}, PersistentKeepaliveInterval: 25}
+	prior := peer
+	prior.AllowedIPs = append([]netip.Prefix(nil), peer.AllowedIPs...)
+	previous := &sourceRouteSnapshot{routes: []option.WireGuardSourceRoute{route}, peers: []option.WireGuardPeer{peer}}
+	base, err := receivingWireGuardPeers(previous, nil, nil)
+	if err != nil || len(base) != 1 || !slices.Equal(base[0].AllowedIPs, []netip.Prefix{incoming}) ||
+		base[0].PublicKey != peer.PublicKey || base[0].PreSharedKey != peer.PreSharedKey || base[0].Address != peer.Address ||
+		base[0].Port != peer.Port || base[0].PersistentKeepaliveInterval != 0 {
+		t.Fatal("idle sender removed receiving identity or kept static keepalive", err)
+	}
+	wanted := base[0]
+	wanted.Address, wanted.Port = "192.0.2.11", 51821
+	retained := []option.WireGuardPeer{{PublicKey: peer.PublicKey, PreSharedKey: peer.PreSharedKey,
+		AllowedIPs: []netip.Prefix{prefix}, PersistentKeepaliveInterval: 25}}
+	active, err := retainedWireGuardPeers(previous, []option.WireGuardPeer{wanted}, retained, []option.WireGuardSourceRoute{route})
+	if err != nil {
+		t.Fatal(err)
+	}
+	active, err = receivingWireGuardPeers(previous, active, []option.WireGuardSourceRoute{route})
+	if err != nil || len(active) != 1 || active[0].PersistentKeepaliveInterval != 25 || active[0].Address != wanted.Address || active[0].Port != wanted.Port ||
+		!slices.Equal(active[0].AllowedIPs, []netip.Prefix{incoming, prefix}) {
+		t.Fatal("receiving base masked a live sender or revived old coordinates", err)
+	}
+	if !reflect.DeepEqual(previous.peers[0], prior) {
+		t.Fatal("workset merge mutated the current immutable snapshot")
+	}
+}
+
+func TestWGSendingWorksetCannotReplaceReceivingAdmission(t *testing.T) {
+	prefix := netip.MustParsePrefix("fdab:77::1/128")
+	peer := option.WireGuardPeer{PublicKey: "demo-key", PreSharedKey: "demo-psk", AllowedIPs: []netip.Prefix{prefix}}
+	previous := &sourceRouteSnapshot{peers: []option.WireGuardPeer{peer}}
+	changed := peer
+	changed.PreSharedKey = "demo-other-psk"
+	if _, err := receivingWireGuardPeers(previous, []option.WireGuardPeer{changed}, nil); err == nil {
+		t.Fatal("sender workset changed receiving authentication")
+	}
+	changed = peer
+	changed.AllowedIPs = []netip.Prefix{netip.MustParsePrefix("fdab:77::2/128")}
+	if _, err := receivingWireGuardPeers(previous, []option.WireGuardPeer{changed}, nil); !errors.Is(err, execution.ErrSuperseded) {
+		t.Fatal("sender workset added an incoming principal", err)
+	}
+	if _, err := receivingWireGuardPeers(&sourceRouteSnapshot{}, []option.WireGuardPeer{peer}, nil); !errors.Is(err, execution.ErrSuperseded) {
+		t.Fatal("old workset restored withdrawn receiving admission", err)
+	}
+}
+
+func TestWGDelayedRetirementCannotRemoveNewPeerAuthentication(t *testing.T) {
+	target := netip.MustParseAddr("fdab:79::1")
+	prefix := netip.PrefixFrom(target, 128)
+	route := option.WireGuardSourceRoute{Source: netip.MustParseAddr("fdab:77::2"), Destination: prefix, Execution: target}
+	current := option.WireGuardPeer{PublicKey: "demo-key", PreSharedKey: "demo-current-psk", AllowedIPs: []netip.Prefix{prefix}}
+	previous := &sourceRouteSnapshot{routes: []option.WireGuardSourceRoute{route}, peers: []option.WireGuardPeer{current}}
+	endpoint := &Endpoint{}
+	endpoint.sourceRoutes.Store(previous)
+	old := current
+	old.PreSharedKey = "demo-old-psk"
+	if err := retireRuntimeWireGuardForTest(endpoint, []option.WireGuardPeer{old}, []option.WireGuardSourceRoute{route}); !errors.Is(err, execution.ErrSuperseded) {
+		t.Fatal("old release removed a newer peer identity", err)
+	}
+	old = current
+	old.PublicKey = "demo-old-key"
+	if err := retireRuntimeWireGuardForTest(endpoint, []option.WireGuardPeer{old}, []option.WireGuardSourceRoute{route}); !errors.Is(err, execution.ErrSuperseded) {
+		t.Fatal("old release borrowed another peer's current binding", err)
+	}
+	if endpoint.sourceRoutes.Load() != previous {
+		t.Fatal("rejected retirement changed the current snapshot")
+	}
+}
