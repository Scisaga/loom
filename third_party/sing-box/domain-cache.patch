+func TestResourceHTTPDescriptionAcknowledgementAndColdObjectRepair(t *testing.T) {
+	server := newEgressTestServer(t, "demo-local-secret", "127.0.0.1:0")
+	factory := service.FromContext[adapter.OutboundRegistry](server.ctx).(*OB.Registry)
+	service.MustRegister[option.OutboundOptionsRegistry](server.ctx, factory)
+	OB.Register[option.Hysteria2OutboundOptions](factory, "hysteria2", func(_ context.Context, _ adapter.Router, _ log.ContextLogger, tag string, value option.Hysteria2OutboundOptions) (adapter.Outbound, error) {
+		return &poolTransport{tag: tag, digest: value.Execution.AuthenticationDigest}, nil
+	})
+	manager := server.outbound.(*OB.Manager)
+	manager.Initialize(&poolTransport{tag: "reject"})
+	for _, stage := range adapter.ListStartStages {
+		if err := manager.Start(stage); err != nil {
+			t.Fatal(err)
+		}
+	}
+	call := func(method string, body []byte) *httptest.ResponseRecorder {
+		request := httptest.NewRequest(method, "/loom/resources", bytes.NewReader(body))
+		request.RemoteAddr = "127.0.0.1:1"
+		request.Header.Set("Authorization", "Bearer demo-local-secret")
+		response := httptest.NewRecorder()
+		server.httpServer.Handler.ServeHTTP(response, request)
+		return response
+	}
+	read := func() resourceReply {
+		t.Helper()
+		response := call(http.MethodGet, nil)
+		var value resourceReply
+		if response.Code != 200 || json.Unmarshal(response.Body.Bytes(), &value) != nil || value.Revision == "" || value.DescribedOutbounds == nil || value.Forwarding == nil {
+			t.Fatal("incomplete resource readback", response.Code)
+		}
+		return value
+	}
+	initial := read()
+	desired := option.RuntimeResources{ExpectedRevision: initial.Revision, AuthorizationRevisions: map[string]string{}, Forwarding: map[string]option.ExecutionHopOptions{}, Outbounds: []option.Outbound{poolSender("demo-a", poolDigest("a"), "demo-coordinate")}}
+	put := func() resourceReply {
+		t.Helper()
+		body, err := SJSON.MarshalContext(server.ctx, desired)
+		if err != nil {
+			t.Fatal(err)
+		}
+		response := call(http.MethodPut, body)
+		var result resourceReply
+		if response.Code != 200 || json.Unmarshal(response.Body.Bytes(), &result) != nil {
+			t.Fatal("current resource request not applied", response.Code, response.Body.String())
+		}
+		return result
+	}
+	applied := put()
+	if applied.ConfigHash == "" || applied.ConfigHash != applied.DesiredConfigHash || len(applied.Outbounds) != 0 || len(applied.DescribedOutbounds) != 1 {
+		t.Fatal("descriptions not acknowledged without warming leaf")
+	}
+	lease, err := server.resourcePool.Acquire(context.Background(), "demo-a")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer lease.Release()
+	warm := read()
+	if warm.Revision != applied.Revision || warm.ConfigHash != applied.ConfigHash || len(warm.Outbounds) != 1 {
+		t.Fatal("traffic changed description publication or was missing from actual readback")
+	}
+	registry := any(manager).(sourcepool.Registry)
+	actual, ok := registry.RuntimeOutbound("demo-a")
+	if !ok {
+		t.Fatal("materialized object missing")
+	}
+	if _, err := registry.DetachRuntimeOutbounds(context.Background(), []sourcepool.Registration{actual}); err != nil {
+		t.Fatal(err)
+	}
+	missing := read()
+	if missing.ConfigHash != applied.ConfigHash || len(missing.Outbounds) != 0 || len(missing.DescribedOutbounds) != 1 {
+		t.Fatal("missing actual object changed description proof or was concealed")
+	}
+	desired.ExpectedRevision = missing.Revision
+	repaired := put()
+	if repaired.ConfigHash == "" || len(repaired.Outbounds) != 1 {
+		t.Fatal("same desired projection did not repair actual object")
+	}
+	body, _ := SJSON.MarshalContext(server.ctx, desired)
+	duplicate := append([]byte(`{"expected_revision":"demo-repeat",`), body[1:]...)
+	if response := call(http.MethodPut, duplicate); response.Code != http.StatusBadRequest {
+		t.Fatal("ambiguous repeated CAS accepted", response.Code)
+	}
+}
+
+func TestForwardingProjectionCanonicalShape(t *testing.T) {
+	var descriptor option.ExecutionHopOptions
+	body := []byte(`{"policy":{"policy_id":"demo-policy","service_id":"demo-service","kind":"internet","origins":[],"exits":["demo-exit"],"nodes":["demo-exit","demo-node"],"entry_scope":{"mode":"any","node_ids":[]},"relay_scope":{"mode":"any","node_ids":[]},"max_hops":0,"edges":[{"from":"demo-node","to":"demo-exit"}]},"node_id":"demo-node","nodes":{"demo-transport":"demo-exit"},"exit_choices":{"demo-exit":["demo-transport"]}}`)
+	if err := json.Unmarshal(body, &descriptor); err != nil {
+		t.Fatal(err)
+	}
+	var raw map[string]any
+	if err := json.Unmarshal(body, &raw); err != nil {
+		t.Fatal(err)
+	}
+	typed := map[string]option.ExecutionHopOptions{"demo-forward": descriptor}
+	if err := validateForwardingJSON(map[string]any{"demo-forward": raw}, typed); err != nil {
+		t.Fatal("current typed traversal changed canonical request bytes", err)
+	}
+	raw["unexpected"] = true
+	if err := validateForwardingJSON(map[string]any{"demo-forward": raw}, typed); err == nil {
+		t.Fatal("an unknown local traversal field was silently ignored")
+	}
+	delete(raw, "unexpected")
+	delete(raw, "exit_choices")
+	if err := validateForwardingJSON(map[string]any{"demo-forward": raw}, typed); err == nil {
+		t.Fatal("an incomplete local traversal value was silently completed")
+	}
+	if err := validateForwardingJSON(nil, map[string]option.ExecutionHopOptions{}); err == nil {
+		t.Fatal("missing forwarding map became current empty projection")
+	}
+}
