+			err = errors.New("unexpected request")
+		}
+		if err == nil {
+			_, err = server.Write([]byte("demo-response"))
+		}
+		done <- err
+	}()
+	client, err := net.DialTimeout("tcp", listener.Addr().String(), time.Second)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer client.Close()
+	lease, err := f.pool.Acquire(context.Background(), "demo-a")
+	if err != nil {
+		t.Fatal(err)
+	}
+	actual := lease.Outbound().(*transport)
+	bound, err := lease.BindConn(client)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer bound.Close()
+	lease.Release()
+	commit(t, f.pool)
+	_ = bound.SetDeadline(time.Now().Add(2 * time.Second))
+	if _, err = bound.Write([]byte("demo-request")); err != nil {
+		t.Fatal(err)
+	}
+	if err = N.CloseWrite(bound); err != nil {
+		t.Fatal(err)
+	}
+	body, err := io.ReadAll(bound)
+	if err != nil || string(body) != "demo-response" {
+		t.Fatal("half-close lost the remaining read direction", err)
+	}
+	if actual.closed.Load() != 0 {
+		t.Fatal("half-close retired the transport while the full connection was owned")
+	}
+	if err = <-done; err != nil {
+		t.Fatal(err)
+	}
+}
