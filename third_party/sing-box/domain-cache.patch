+func (s *Server) tcpObservations(authenticated bool) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		host, _, err := net.SplitHostPort(s.httpServer.Addr)
+		address := net.ParseIP(host)
+		if !authenticated || err != nil || address == nil || !address.IsLoopback() {
+			http.Error(w, "observations require the authenticated local listener", http.StatusForbidden)
+			return
+		}
+		if r.URL.RawQuery != "" {
+			http.Error(w, "unexpected observation query", http.StatusBadRequest)
+			return
+		}
+		render.JSON(w, r, struct {
+			Observations []trafficontrol.TCPObservation `json:"observations"`
+		}{s.trafficManager.TCPObservations(time.Now)})
+	}
+}
