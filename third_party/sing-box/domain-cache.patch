+	if err != nil {
+		t.Fatal(err)
+	}
+	target := M.ParseSocksaddr("demo-target.example:443")
+	called := false
+	err = s.WithAccessTCPChoice(before.Revision, before.PolicyID, b, target, func(metadata adapter.InboundContext, selected adapter.Outbound) error {
+		called = true
+		want, _ := P.CandidateID("demo-service", before.PolicyID, b)
+		if metadata.Execution == nil || metadata.Execution.PolicyID != before.PolicyID || metadata.Execution.Path.OriginID != "demo-source" || metadata.Execution.Path.FinalExitID != b.FinalExit || metadata.ExecutionCandidate != want || metadata.ExecutionSelectionRevision != before.Revision || metadata.ExecutionSourceTarget != target || selected.Tag() != "demo-b" || metadata.ExecutionSourceCheck == nil {
+			t.Fatal("one-shot choice lost its actual authorized execution context")
+		}
+		return nil
+	})
+	if err != nil || !called || !reflect.DeepEqual(before, s.AccessSnapshot()) {
+		t.Fatal("calibration changed the production choice", err)
+	}
+	if err := s.WithAccessTCPChoice("demo-stale", before.PolicyID, b, target, nil); !errors.Is(err, ErrSelectionChanged) {
+		t.Fatal("old selection revision entered a calibration", err)
+	}
+	if err := s.WithAccessTCPChoice(before.Revision, "demo-unselected", b, target, nil); !errors.Is(err, execution.ErrDenied) {
+		t.Fatal("an unselected Policy entered calibration", err)
+	}
+	b.FirstResourceID = "demo-forged-resource"
+	if err := s.WithAccessTCPChoice(before.Revision, before.PolicyID, b, target, nil); !errors.Is(err, execution.ErrDenied) {
+		t.Fatal("an invented choice became a transport grant", err)
+	}
+	if err := s.WithAccessTCPChoice(before.Revision, before.PolicyID, P.RouteChoice{FinalExit: "direct"}, target, nil); !errors.Is(err, execution.ErrDenied) {
+		t.Fatal("calibration bypassed the Policy's final exit constraint", err)
+	}
