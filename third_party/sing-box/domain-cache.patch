+package sourcepool
+
+import (
+	"context"
+	"sync"
+
+	"github.com/sagernet/sing-box/adapter"
+)
+
+type callKey struct{}
+
+// callBorrow only transfers pending-dial references along one synchronous
+// dispatch. Bound connections own their leases; it is neither a catalog nor a
+// new authorization or completion source.
+type callBorrow struct {
+	mu     sync.Mutex
+	leases map[string]*Lease
+	taken  map[string]bool
+}
+
+func WithCall(ctx context.Context) (context.Context, func()) {
+	if _, ok := ctx.Value(callKey{}).(*callBorrow); ok {
+		return ctx, func() {}
+	}
+	call := &callBorrow{leases: map[string]*Lease{}, taken: map[string]bool{}}
+	return context.WithValue(ctx, callKey{}, call), func() {
+		call.mu.Lock()
+		values := make([]*Lease, 0, len(call.leases))
+		for _, lease := range call.leases {
+			values = append(values, lease)
+		}
+		call.mu.Unlock()
+		ReleaseAll(values)
+	}
+}
+func BorrowedOutbound(ctx context.Context, tag string) adapter.Outbound {
+	call, _ := ctx.Value(callKey{}).(*callBorrow)
+	if call == nil {
+		return nil
+	}
+	call.mu.Lock()
+	defer call.mu.Unlock()
+	if lease := call.leases[tag]; lease != nil {
+		return lease.Outbound()
+	}
+	return nil
+}
+func AddCallBorrow(ctx context.Context, lease *Lease) error {
+	call, _ := ctx.Value(callKey{}).(*callBorrow)
+	if call == nil || lease == nil {
+		return ErrConflict
+	}
+	call.mu.Lock()
+	defer call.mu.Unlock()
+	tag := lease.Outbound().Tag()
+	if old := call.leases[tag]; old != nil {
+		return ErrConflict
+	}
+	call.leases[tag] = lease
+	return nil
+}
+func TakeCallBorrow(ctx context.Context, tag string) *Lease {
+	call, _ := ctx.Value(callKey{}).(*callBorrow)
+	if call == nil {
+		return nil
+	}
+	call.mu.Lock()
+	defer call.mu.Unlock()
+	if call.taken[tag] {
+		return nil
+	}
+	lease := call.leases[tag]
+	if lease != nil {
+		call.taken[tag] = true
+	}
+	return lease
+}
