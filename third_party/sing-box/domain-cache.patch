+	<-entered
+	select {
+	case err := <-done:
+		t.Fatal("revocation crossed an outstanding tracker registration", err)
+	case <-time.After(20 * time.Millisecond):
+	}
+	release()
+	if err := <-done; err != nil {
+		t.Fatal(err)
