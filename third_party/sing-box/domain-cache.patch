+	h, err := newHopSelector(option.ExecutionHopOptions{Policy: policy, NodeID: "demo-a", Nodes: map[string]string{"demo-a": "demo-b", "demo-b": "demo-exit"}, ExitChoices: map[string][]string{"demo-exit": {"demo-a", "demo-b"}}})
+	if err != nil {
