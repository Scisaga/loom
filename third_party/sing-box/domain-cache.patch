+func TestPinnedSourceAndForwardCarryExecutionIntoAllResourceDialers(t *testing.T) {
+	for _, forward := range []bool{false, true} {
+		for _, method := range []string{"tcp", "udp", "tcp-addresses", "udp-addresses"} {
+			t.Run(fmt.Sprint("forward=", forward, "/", method), func(t *testing.T) {
+				deadline := time.Now().Add(time.Minute)
+				want := P.Connection{PolicyID: "demo-policy", Path: P.PathContext{OriginID: "demo-source", FinalExitID: "demo-exit-a", Visited: []string{}}}
+				if forward {
+					want.Path.Visited = []string{"demo-entry-a"}
+				}
+				selector, manager := handoffFixture(t, forward, func(ctx context.Context) error {
+					got, ok := P.ConnectionFrom(ctx)
+					if !ok || !reflect.DeepEqual(got, want) {
+						return errors.New("actual sender lost or rewrote pinned execution context")
+					}
+					if got, ok := ctx.Deadline(); !ok || !got.Equal(deadline) {
+						return errors.New("actual sender lost caller deadline")
+					}
+					if ctx.Value(handoffContextKey{}) != "demo-caller-value" {
+						return errors.New("actual sender lost caller context value")
+					}
+					return nil
+				})
+				for _, cancelled := range []bool{false, true} {
+					caller, cancel := context.WithDeadline(context.WithValue(context.Background(), handoffContextKey{}, "demo-caller-value"), deadline)
+					metadata := &adapter.InboundContext{Network: "tcp", Destination: M.ParseSocksaddr("demo.example:443")}
+					if method == "udp" || method == "udp-addresses" {
+						metadata.Network = "udp"
+					}
+					if forward {
+						copy := want
+						copy.Path.Visited = append([]string{}, want.Path.Visited...)
+						metadata.Execution = &copy
+					}
+					ctx, cleanup, err := adapter.PinOutboundPath(caller, manager, selector, metadata)
+					if err != nil {
+						cancel()
+						cleanup()
+						t.Fatal(err)
+					}
+					selected, _ := manager.Outbound(metadata.SelectedOutbounds[selector.Tag()])
+					resource := selector.resourceDialer(selected)
+					if cancelled {
+						cancel()
+					}
+					var conn net.Conn
+					var packet net.PacketConn
+					switch method {
+					case "tcp":
+						conn, err = resource.DialContext(ctx, "tcp", metadata.Destination)
+					case "udp":
+						packet, err = resource.ListenPacket(ctx, metadata.Destination)
+					case "tcp-addresses":
+						conn, err = resource.(dialer.ParallelNetworkDialer).DialParallelNetwork(ctx, "tcp", metadata.Destination, []netip.Addr{netip.MustParseAddr("192.0.2.10")}, nil, nil, nil, 0)
+					case "udp-addresses":
+						packet, _, err = resource.(dialer.ParallelNetworkDialer).ListenSerialNetworkPacket(ctx, metadata.Destination, []netip.Addr{netip.MustParseAddr("192.0.2.10")}, nil, nil, nil, 0)
+					}
+					if conn != nil {
+						_ = conn.Close()
+					}
+					if packet != nil {
+						_ = packet.Close()
+					}
+					cleanup()
+					cancel()
+					if cancelled {
+						if !errors.Is(err, context.Canceled) {
+							t.Fatal("cancelled pinned attempt lost cancellation", err)
+						}
+					} else if err != nil {
+						t.Fatal("pinned actual sender rejected its validated execution context", err)
+					}
+				}
+			})
+		}
+	}
