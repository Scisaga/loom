+	d.destination = destination
+	return d.packets, nil
+}
+func (d *demoMappingUnderlay) ListenSerialInterfacePacket(ctx context.Context, destination M.Socksaddr, _ *C.NetworkStrategy, _, _ []C.InterfaceType, _ time.Duration) (net.PacketConn, error) {
+	return d.ListenPacket(ctx, destination)
+}
+
+type demoMappingPackets struct {
+	net.PacketConn
+	replies []net.Addr
+	written net.Addr
+}
+
+func (d *demoMappingPackets) ReadFrom(body []byte) (int, net.Addr, error) {
+	if len(d.replies) == 0 {
+		return 0, nil, io.EOF
+	}
+	address := d.replies[0]
+	d.replies = d.replies[1:]
+	return copy(body, "demo reply"), address, nil
+}
+func (d *demoMappingPackets) WriteTo(body []byte, address net.Addr) (int, error) {
+	d.written = address
+	return len(body), nil
+}
+
+func TestPrefixMappingChecksAllPhysicalDialPathsAndUDPPeer(t *testing.T) {
+	underlay := &demoMappingUnderlay{packets: &demoMappingPackets{}}
+	d := &prefixMappingDialer{underlay: underlay, virtual: netip.MustParsePrefix("198.51.100.0/24"), local: netip.MustParsePrefix("192.0.2.0/24")}
+	virtual := M.ParseSocksaddr("198.51.100.17:443")
+	physical := M.ParseSocksaddr("192.0.2.17:443")
+	ctx := context.Background()
+	for _, parallel := range []bool{false, true} {
+		underlay.destination = M.Socksaddr{}
+		if parallel {
+			_, _ = d.DialParallelInterface(ctx, "tcp", virtual, nil, nil, nil, 0)
+		} else {
+			_, _ = d.DialContext(ctx, "tcp", virtual)
+		}
+		if underlay.destination != physical {
+			t.Fatal("TCP changed host bits or port")
+		}
+		for _, bad := range []string{"203.0.113.1:443", "[2001:db8::1]:443", "demo.example:443", "[::ffff:198.51.100.17]:443"} {
+			underlay.destination = M.Socksaddr{}
+			if parallel {
+				_, _ = d.DialParallelInterface(ctx, "tcp", M.ParseSocksaddr(bad), nil, nil, nil, 0)
+			} else {
+				_, _ = d.DialContext(ctx, "tcp", M.ParseSocksaddr(bad))
+			}
+			if underlay.destination.IsValid() {
+				t.Fatal("unmapped address reached physical TCP dialer")
+			}
+		}
+		var conn net.PacketConn
+		var err error
+		if parallel {
+			conn, err = d.ListenSerialInterfacePacket(ctx, virtual, nil, nil, nil, 0)
+		} else {
+			conn, err = d.ListenPacket(ctx, virtual)
+		}
+		if err != nil || underlay.destination != physical {
+			t.Fatal("UDP changed host bits or port", err)
+		}
+		underlay.packets.written = nil
+		if _, err = conn.WriteTo([]byte("demo request"), M.ParseSocksaddr("198.51.100.18:443").UDPAddr()); err == nil || underlay.packets.written != nil {
+			t.Fatal("UDP session changed its authorized destination")
+		}
+		if _, err = conn.WriteTo([]byte("demo request"), virtual.UDPAddr()); err != nil || M.SocksaddrFromNet(underlay.packets.written) != physical {
+			t.Fatal("UDP request was not translated", err)
+		}
+		underlay.packets.replies = []net.Addr{M.ParseSocksaddr("192.0.2.18:443").UDPAddr(), M.ParseSocksaddr("192.0.2.17:444").UDPAddr(), physical.UDPAddr()}
+		body := make([]byte, 64)
+		_, address, err := conn.ReadFrom(body)
+		if err != nil || M.SocksaddrFromNet(address) != virtual || len(underlay.packets.replies) != 0 {
+			t.Fatal("UDP reply was injected or exposed the physical address", err)
+		}
+	}
+}
+
+func TestIdentityPrefixMappingKeepsAddressAndUDPPeer(t *testing.T) {
+	underlay := &demoMappingUnderlay{packets: &demoMappingPackets{}}
+	prefix := netip.MustParsePrefix("10.64.8.0/24")
+	d := &prefixMappingDialer{underlay: underlay, virtual: prefix, local: prefix}
+	target := M.ParseSocksaddr("10.64.8.17:443")
+	ctx := context.Background()
+	_, _ = d.DialContext(ctx, "tcp", target)
+	if underlay.destination != target {
+		t.Fatal("identity mapping changed the physical TCP target")
+	}
+	conn, err := d.ListenPacket(ctx, target)
+	if err != nil || underlay.destination != target {
+		t.Fatal("identity mapping changed the physical UDP target", err)
+	}
+	if _, err := conn.WriteTo([]byte("demo request"), target.UDPAddr()); err != nil || M.SocksaddrFromNet(underlay.packets.written) != target {
+		t.Fatal("identity UDP mapping changed its destination", err)
+	}
+	if _, err := conn.WriteTo([]byte("demo request"), M.ParseSocksaddr("10.64.8.18:443").UDPAddr()); err == nil {
+		t.Fatal("identity UDP session accepted a different destination")
+	}
+	underlay.destination = M.Socksaddr{}
+	if _, err := d.DialContext(ctx, "tcp", M.ParseSocksaddr("10.64.9.17:443")); err == nil || underlay.destination.IsValid() {
+		t.Fatal("identity mapping dialed outside its authorized prefix")
+	}
+}
