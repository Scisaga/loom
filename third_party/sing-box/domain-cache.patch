+func TestAccessAuthorizationFencesDelayedRegistrationAndKeepsValidFlows(t *testing.T) {
+	s, options, a, _ := accessFixture(t)
+	id, choices := sourceChoice(t, a)
+	if _, err := s.CompareAndSelectAccess(context.Background(), AccessSnapshot{Name: id, PolicyID: "demo-policy", Choices: choices, Targets: map[string]string{}}, s.AccessSnapshot()); err != nil {
+		t.Fatal(err)
+	}
+	metadata := &adapter.InboundContext{Destination: M.ParseSocksaddr("demo-a.example:443")}
+	s.pinSelection(metadata)
+	initial := s.AccessAuthorizationState()
+	current, err := s.ReplaceAccess(options, initial.Revision, "demo-hash", func() {
+		if s.CheckAccessConnection(*metadata) != nil {
+			t.Error("unchanged permission was lost")
+		}
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	release, _, _, err := execution.TrackFence(adapter.WithContext(context.Background(), metadata))
+	if err != nil {
+		t.Fatal(err)
+	}
+	release()
+	options.Policies = []option.ExecutionPolicy{}
+	closed := false
+	_, err = s.ReplaceAccess(options, current.Revision, "demo-revoked", func() { closed = s.CheckAccessConnection(*metadata) != nil })
+	if err != nil || !closed || s.AccessSnapshot().Name != "reject" {
+		t.Fatal("withdrawn source permission remained active", err)
+	}
+	if release, _, _, err = execution.TrackFence(adapter.WithContext(context.Background(), metadata)); err == nil {
+		release()
+		t.Fatal("delayed registration escaped withdrawal")
+	}
+	if _, err = s.ReplaceAccess(options, current.Revision, "demo-replay", nil); !errors.Is(err, ErrSelectionChanged) {
+		t.Fatal("stale authorization applied", err)
+	}
+}
