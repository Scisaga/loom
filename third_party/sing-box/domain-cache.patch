+package rule
+
+import (
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/common/dialer"
+)
+
+// Name matching never turns an IP request into a domain request using SNI.
+// The final outbound independently checks every resolved physical address.
+type PublicInternetItem struct{}
+
+func (PublicInternetItem) Match(metadata *adapter.InboundContext) bool {
+	if metadata.Destination.Addr.IsValid() {
+		return dialer.PublicInternetAddress(metadata.Destination.Addr)
+	}
+	return dialer.PublicInternetName(metadata.Destination.Fqdn)
+}
+
+func (PublicInternetItem) String() string { return "public_internet=true" }
