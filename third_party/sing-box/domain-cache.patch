+package group
+
+import (
+	"context"
+	"net"
+	"net/netip"
+	"time"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/common/dialer"
+	"github.com/sagernet/sing-box/common/sourcepool"
+	C "github.com/sagernet/sing-box/constant"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+	"github.com/sagernet/sing/service"
+)
+
+// This wrapper exists only at a connection's actual use site. The manager
+// continues to expose the original outbound and all its optional interfaces.
+type resourceDialer struct {
+	pool     *sourcepool.Pool
+	selected adapter.Outbound
+}
+
+func (s *Selector) resourceDialer(selected adapter.Outbound) N.Dialer {
+	if !s.RuntimeResourceConsumer() || selected == nil || selected.Tag() == "reject" {
+		return selected
+	}
+	pool := service.FromContext[*sourcepool.Pool](s.ctx)
+	if pool == nil {
+		return selected
+	}
+	return &resourceDialer{pool: pool, selected: selected}
+}
+func (d *resourceDialer) acquire(ctx context.Context) (*sourcepool.Lease, error) {
+	lease := sourcepool.TakeCallBorrow(ctx, d.selected.Tag())
+	var err error
+	if lease == nil {
+		lease, err = d.pool.Acquire(ctx, d.selected.Tag())
+	}
+	if err != nil {
+		return nil, err
+	}
+	if !sourcepool.SameObject(lease.Outbound(), d.selected) {
+		lease.Release()
+		return nil, sourcepool.ErrConflict
+	}
+	return lease, nil
+}
+func (d *resourceDialer) DialContext(ctx context.Context, network string, target M.Socksaddr) (net.Conn, error) {
+	lease, err := d.acquire(ctx)
+	if err != nil {
+		return nil, err
+	}
+	defer lease.Release()
+	conn, err := lease.Outbound().DialContext(lease.Context(), network, target)
+	if err != nil {
+		if conn != nil {
+			conn.Close()
+		}
+		return nil, err
+	}
+	return lease.BindConn(conn)
+}
+func (d *resourceDialer) ListenPacket(ctx context.Context, target M.Socksaddr) (net.PacketConn, error) {
+	lease, err := d.acquire(ctx)
+	if err != nil {
+		return nil, err
+	}
+	defer lease.Release()
+	conn, err := lease.Outbound().ListenPacket(lease.Context(), target)
+	if err != nil {
+		if conn != nil {
+			conn.Close()
+		}
+		return nil, err
+	}
+	return lease.BindPacketConn(conn)
+}
+
+// Preserve the original outbound's parallel/serial address and interface
+// behavior while pinning the exact object for the whole attempt and flow.
+func (d *resourceDialer) DialParallelNetwork(ctx context.Context, network string, target M.Socksaddr, addresses []netip.Addr, strategy *C.NetworkStrategy, types, fallbackTypes []C.InterfaceType, delay time.Duration) (net.Conn, error) {
+	lease, err := d.acquire(ctx)
+	if err != nil {
+		return nil, err
+	}
+	defer lease.Release()
+	conn, err := dialer.DialSerialNetwork(lease.Context(), lease.Outbound(), network, target, addresses, strategy, types, fallbackTypes, delay)
+	if err != nil {
+		if conn != nil {
+			conn.Close()
+		}
+		return nil, err
+	}
+	return lease.BindConn(conn)
+}
+func (d *resourceDialer) ListenSerialNetworkPacket(ctx context.Context, target M.Socksaddr, addresses []netip.Addr, strategy *C.NetworkStrategy, types, fallbackTypes []C.InterfaceType, delay time.Duration) (net.PacketConn, netip.Addr, error) {
+	lease, err := d.acquire(ctx)
+	if err != nil {
+		return nil, netip.Addr{}, err
+	}
+	defer lease.Release()
+	conn, address, err := dialer.ListenSerialNetworkPacket(lease.Context(), lease.Outbound(), target, addresses, strategy, types, fallbackTypes, delay)
+	if err != nil {
+		if conn != nil {
+			conn.Close()
+		}
+		return nil, netip.Addr{}, err
+	}
+	bound, err := lease.BindPacketConn(conn)
+	return bound, address, err
+}
