+package hysteria2
+
+import (
+	"errors"
+	"github.com/sagernet/sing-box/common/execution"
+	"github.com/sagernet/sing-box/option"
+)
+
+func (h *Inbound) RuntimeExecutionReceiver() *execution.Receiver { return h.execution }
+func (h *Inbound) RuntimeExecutionState() execution.State        { return h.execution.State() }
+func (h *Inbound) UpdateRuntimeExecution(update option.ExecutionUpdate, hash string, invalidate func()) (execution.State, error) {
+	if h.execution == nil || update.Execution == nil || update.ExpectedRevision == "" || update.Hysteria2Users == nil || update.WireGuardPeers != nil || update.WireGuardListener != nil {
+		return execution.State{}, errors.New("incomplete Hy2 receiving update")
+	}
+	users, passwords := []string{}, []string{}
+	names, passwordSet := map[string]bool{}, map[string]bool{}
+	bindings := map[string]bool{}
+	for _, binding := range update.Execution.Bindings {
+		bindings[binding.Key] = true
+	}
+	for _, user := range *update.Hysteria2Users {
+		if user.Name == "" || user.Password == "" || names[user.Name] || passwordSet[user.Password] || !bindings[user.Name] {
+			return execution.State{}, errors.New("invalid Hy2 receiving principals")
+		}
+		names[user.Name], passwordSet[user.Password] = true, true
+		users = append(users, user.Name)
+		passwords = append(passwords, user.Password)
+	}
+	if len(names) != len(bindings) {
+		return execution.State{}, errors.New("Hy2 principal permissions are incomplete")
+	}
+	return h.execution.Replace(*update.Execution, update.ExpectedRevision, hash, func(execution.State) error { h.service.UpdateUsers(users, passwords); return nil }, invalidate)
+}
