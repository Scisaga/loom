+	defer m.access.Unlock()
+	if m.closed {
+		return sourcepool.Registration{}, sourcepool.ErrNotRunning
+	}
+	value, found := m.runtimeByTag[tag]
+	if !found || value.ConfigHash != configHash {
+		return sourcepool.Registration{}, sourcepool.ErrConflict
+	}
+	value.Owned = true
+	m.runtimeByTag[tag] = value
+	return value, nil
+}
+
+// PublishRuntimeOutbounds performs only map/index publication. Constructors and
+// every Start/Close operation belong outside this lock. The caller binds the
+// commit to its already-current permission revision before entering here.
+func (m *Manager) PublishRuntimeOutbounds(ctx context.Context, candidates, replace []sourcepool.Registration) ([]sourcepool.Registration, error) {
+	return m.ReconcileRuntimeOutbounds(ctx, candidates, replace, nil)
+}
+
+func (m *Manager) ReconcileRuntimeOutbounds(ctx context.Context, candidates, replace, remove []sourcepool.Registration) ([]sourcepool.Registration, error) {
+	endpoints := map[string]bool{}
+	if m.endpoint != nil {
+		for _, endpoint := range m.endpoint.Endpoints() {
+			endpoints[endpoint.Tag()] = true
+		}
+	}
+	wanted, err := registrations(candidates)
+	if err != nil {
+		return nil, err
+	}
+	previous, err := registrations(replace)
+	if err != nil {
+		return nil, err
+	}
+	removals, err := registrations(remove)
+	if err != nil {
+		return nil, err
+	}
+	m.access.Lock()
+	defer m.access.Unlock()
+	if ctx.Err() != nil {
+		return nil, ctx.Err()
+	}
+	if m.closed || !m.started || m.stage != adapter.StartStateStarted {
+		return nil, sourcepool.ErrNotRunning
+	}
+	for tag, value := range removals {
+		current, exists := m.runtimeByTag[tag]
+		_, replacing := previous[tag]
+		_, adding := wanted[tag]
+		if !exists || !sameRegistration(current, value) || replacing || adding || sourcepool.SameObject(m.defaultOutbound, value.Outbound) {
+			return nil, sourcepool.ErrConflict
+		}
+		for _, dependent := range m.dependByTag[tag] {
+			if _, removing := removals[dependent]; !removing {
+				if _, replacing := previous[dependent]; !replacing {
+					return nil, sourcepool.ErrDependency
+				}
+			}
+		}
+	}
+	for tag, value := range previous {
+		candidate, replaces := wanted[tag]
+		current, exists := m.runtimeByTag[tag]
+		if !replaces || !exists || !sameRegistration(current, value) || !value.Owned || !candidate.Owned || sourcepool.SameObject(m.defaultOutbound, value.Outbound) {
+			return nil, sourcepool.ErrConflict
+		}
+	}
+	for tag, value := range wanted {
+		current, exists := m.runtimeByTag[tag]
+		if exists {
+			expected, replacing := previous[tag]
+			if !replacing || !sameRegistration(current, expected) {
+				return nil, sourcepool.ErrConflict
+			}
+		} else if _, replacing := previous[tag]; replacing {
+			return nil, sourcepool.ErrConflict
+		}
+		// Every dependency must already exist, or be in this same atomic batch.
+		for _, dependency := range value.Outbound.Dependencies() {
+			if _, removed := removals[dependency]; removed {
+				return nil, sourcepool.ErrDependency
+			}
+			if _, exists := wanted[dependency]; exists {
+				continue
+			}
+			if _, exists := m.outboundByTag[dependency]; exists {
+				continue
+			}
+			// The pool uses only stable endpoints captured before publication. Never
+			// acquire endpoint-manager locks under this manager's map lock.
+			if !endpoints[dependency] {
+				return nil, sourcepool.ErrDependency
+			}
+		}
+	}
+	// Compare and validation completed before touching any existing object.
+	retired := make([]sourcepool.Registration, 0, len(replace))
+	for _, value := range replace {
+		m.detachRuntimeLocked(value)
+		retired = append(retired, value)
+	}
+	for _, value := range remove {
+		m.detachRuntimeLocked(value)
+		retired = append(retired, value)
+	}
+	for _, value := range candidates {
+		tag := value.Outbound.Tag()
+		m.outbounds = append(m.outbounds, value.Outbound)
+		m.outboundByTag[tag] = value.Outbound
+		m.runtimeByTag[tag] = value
+		for _, dependency := range value.Outbound.Dependencies() {
+			m.dependByTag[dependency] = append(m.dependByTag[dependency], tag)
+		}
+	}
+	return retired, nil
+}
+
+func (m *Manager) DetachRuntimeOutbounds(ctx context.Context, expected []sourcepool.Registration) ([]sourcepool.Registration, error) {
+	values, err := registrations(expected)
+	if err != nil {
+		return nil, err
+	}
+	m.access.Lock()
+	defer m.access.Unlock()
+	if ctx.Err() != nil {
+		return nil, ctx.Err()
+	}
+	if m.closed {
+		return nil, sourcepool.ErrNotRunning
+	}
+	for tag, value := range values {
+		current, found := m.runtimeByTag[tag]
+		if !found || !sameRegistration(current, value) || sourcepool.SameObject(m.defaultOutbound, value.Outbound) {
+			return nil, sourcepool.ErrConflict
+		}
+		for _, dependency := range m.dependByTag[tag] {
+			if _, alsoRemoved := values[dependency]; !alsoRemoved {
+				return nil, sourcepool.ErrDependency
+			}
+		}
+	}
+	for _, value := range expected {
+		m.detachRuntimeLocked(value)
+	}
+	return append([]sourcepool.Registration(nil), expected...), nil
+}
+
+func registrations(values []sourcepool.Registration) (map[string]sourcepool.Registration, error) {
+	result := make(map[string]sourcepool.Registration, len(values))
+	for _, value := range values {
+		if !value.Valid() || !value.Owned {
+			return nil, os.ErrInvalid
+		}
+		tag := value.Outbound.Tag()
+		if _, duplicate := result[tag]; duplicate {
+			return nil, errors.New("duplicate runtime outbound tag")
+		}
+		result[tag] = value
+	}
+	return result, nil
+}
+
+func sameRegistration(a, b sourcepool.Registration) bool {
+	return sourcepool.SameObject(a.Outbound, b.Outbound) && a.ConfigHash == b.ConfigHash && a.Owned == b.Owned
+}
+
+func (m *Manager) detachRuntimeLocked(value sourcepool.Registration) {
+	tag := value.Outbound.Tag()
+	delete(m.outboundByTag, tag)
+	delete(m.runtimeByTag, tag)
+	for index, current := range m.outbounds {
+		if sourcepool.SameObject(current, value.Outbound) {
+			m.outbounds = append(m.outbounds[:index], m.outbounds[index+1:]...)
+			break
+		}
+	}
+	for _, dependency := range value.Outbound.Dependencies() {
+		old := m.dependByTag[dependency]
+		filtered := make([]string, 0, len(old))
+		for _, user := range old {
+			if user != tag {
+				filtered = append(filtered, user)
+			}
+		}
+		if len(filtered) == 0 {
+			delete(m.dependByTag, dependency)
+		} else {
+			m.dependByTag[dependency] = filtered
+		}
+	}
+	// Existing dependents of a same-tag replacement still refer to that tag.
+}
