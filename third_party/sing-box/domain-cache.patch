+func (s *Server) accessTCPConnect(authenticated bool) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		host, _, err := net.SplitHostPort(s.httpServer.Addr)
+		address := net.ParseIP(host)
+		if !authenticated || err != nil || address == nil || !address.IsLoopback() {
+			http.Error(w, "authenticated loopback required", http.StatusForbidden)
+			return
+		}
+		if r.URL.RawQuery != "" {
+			http.Error(w, "unexpected calibration query", http.StatusBadRequest)
+			return
+		}
+		body, err := io.ReadAll(http.MaxBytesReader(w, r.Body, 4<<10))
+		if err != nil {
+			http.Error(w, "calibration request exceeds limit", http.StatusBadRequest)
+			return
+		}
+		request, err := decodeAccessTCPRequest(body)
+		if err != nil {
+			http.Error(w, "invalid calibration request", http.StatusBadRequest)
+			return
+		}
+		outbound, ok := s.outbound.Outbound(getEscapeParam(r, "name"))
+		selector, typed := outbound.(*group.Selector)
+		if !ok || !typed || !selector.IsAccessSelector() {
+			http.Error(w, "source scope unavailable", http.StatusNotFound)
+			return
+		}
+		_, targetHost, port, _ := P.ParseConnectionTargetKey(request.Target)
+		target := M.ParseSocksaddrHostPort(targetHost, port)
+		addressText := net.JoinHostPort(targetHost, strconv.Itoa(int(port)))
+		if !s.trafficManager.HasRecentTCPAttempt(request.PolicyID, addressText, time.Now()) {
+			http.Error(w, "calibration target has no recent ordinary attempt", http.StatusForbidden)
+			return
+		}
+		pending, cancel := context.WithTimeout(r.Context(), 8*time.Second)
+		defer cancel()
+		owned := &tcpCalibrationConn{cancel: cancel}
+		metadata, selected, lease, err := selector.BorrowAccessTCPChoice(pending, request.Expected, request.PolicyID, request.Choice, target)
+		if err != nil {
+			accessTCPFailure(w, err)
+			return
+		}
+		if lease != nil {
+			defer lease.Release()
+		}
+		dialCtx, tracker, cleanup, err := s.pinAccessDiagnostic(pending, selector, &metadata, selected, lease, owned)
+		defer cleanup()
+		if err != nil {
+			accessTCPFailure(w, err)
+			return
+		}
+		defer tracker.Close()
+		started := time.Now()
+		conn, cause := selected.DialContext(dialCtx, "tcp", target)
+		observed := time.Now()
+		if cause == nil && conn != nil && lease != nil {
+			conn, cause = lease.BindConn(conn)
+		}
+		owned.attach(conn)
+		if conn != nil {
+			_ = conn.Close()
+		} else if cause == nil {
+			cause = execution.ErrUnknown
+		}
+		if err = selector.WithAccessTCPChoice(request.Expected, request.PolicyID, request.Choice, target, nil); err != nil {
+			accessTCPFailure(w, err)
+			return
+		}
+		if pending.Err() != nil {
+			http.Error(w, "calibration canceled", http.StatusRequestTimeout)
+			return
+		}
+		if errors.Is(cause, execution.ErrDenied) || errors.Is(cause, context.Canceled) {
+			accessTCPFailure(w, cause)
+			return
+		}
+		result := trafficontrol.TCPConnectResult(cause)
+		if result == "" {
+			result = "unknown"
+		}
+		render.JSON(w, r, trafficontrol.TCPObservation{Revision: request.Expected, PolicyID: request.PolicyID,
+			CandidateID: metadata.ExecutionCandidate, Target: addressText, Result: result, StartedAt: started.UnixMilli(), ObservedAt: observed.UnixMilli()})
+	}
+}
+
+func accessTCPFailure(w http.ResponseWriter, err error) {
+	if errors.Is(err, sourcepool.ErrResourcePending) {
+		http.Error(w, "source resource pending", http.StatusServiceUnavailable)
+	} else if errors.Is(err, group.ErrSelectionChanged) || errors.Is(err, sourcepool.ErrConflict) {
+		http.Error(w, "source selection superseded", http.StatusConflict)
+	} else {
+		http.Error(w, "calibration not permitted", http.StatusForbidden)
+	}
+}
