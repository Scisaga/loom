+func TestNativeServerFailureMessagesDoNotChangeGenericHy2(t *testing.T) {
+	for _, value := range []struct {
+		cause   error
+		message string
+		send    bool
+	}{
+		{ErrExecutionDenied, ExecutionDeniedMessage, true},
+		{ErrExecutionUnavailable, ExecutionUnavailableMessage, true},
+		{ErrExecutionUnknown, "execution request failed", true},
+		{context.Canceled, "", false}, {io.EOF, "", false},
+	} {
+		message, send := executionFailureMessage(value.cause)
+		if message != value.message || send != value.send {
+			t.Fatal("native failure classification changed", message, send)
+		}
+	}
+	if ErrExecutionDenied.Error() == ExecutionDeniedMessage || ErrExecutionUnavailable.Error() == ExecutionUnavailableMessage {
+		t.Fatal("generic error string could manufacture a reserved wire code")
+	}
+}
