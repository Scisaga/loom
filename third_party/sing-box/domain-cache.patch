+)
+
+type runtimeMemoryTUN struct {
+	T.Device
+	once   sync.Once
+	done   chan struct{}
+	events chan T.Event
+}
+
+func (t *runtimeMemoryTUN) Read([][]byte, []int, int) (int, error)  { <-t.done; return 0, net.ErrClosed }
+func (t *runtimeMemoryTUN) Write(body [][]byte, _ int) (int, error) { return len(body), nil }
+func (t *runtimeMemoryTUN) MTU() (int, error)                       { return 1280, nil }
+func (t *runtimeMemoryTUN) Name() (string, error)                   { return "demo-memory", nil }
+func (t *runtimeMemoryTUN) Events() <-chan T.Event                  { return t.events }
+func (t *runtimeMemoryTUN) BatchSize() int                          { return 1 }
+func (t *runtimeMemoryTUN) Close() error {
+	t.once.Do(func() { close(t.done); close(t.events) })
+	return nil
+}
+
+type runtimeMemoryBind struct {
+	conn.Bind
+	mu           sync.Mutex
+	done         chan struct{}
+	entered      chan struct{}
+	enteredOnce  sync.Once
+	block        atomic.Bool
+	failEndpoint atomic.Bool
+	sent         atomic.Int32
+	last         atomic.Pointer[netip.AddrPort]
+}
+
+func (b *runtimeMemoryBind) Open(uint16) ([]conn.ReceiveFunc, uint16, error) {
+	b.mu.Lock()
+	select {
+	case <-b.done:
+		b.done = make(chan struct{})
+	default:
+	}
+	done := b.done
+	b.mu.Unlock()
+	return []conn.ReceiveFunc{func([][]byte, []int, []conn.Endpoint) (int, error) { <-done; return 0, net.ErrClosed }}, 0, nil
+}
+func (b *runtimeMemoryBind) Close() error {
+	b.mu.Lock()
+	select {
+	case <-b.done:
+	default:
+		close(b.done)
+	}
+	b.mu.Unlock()
+	return nil
+}
+func (b *runtimeMemoryBind) SetMark(uint32) error { return nil }
+func (b *runtimeMemoryBind) BatchSize() int       { return 1 }
+func (b *runtimeMemoryBind) ParseEndpoint(text string) (conn.Endpoint, error) {
+	if b.failEndpoint.Load() && strings.HasPrefix(text, "192.0.2.11:") {
+		return nil, errors.New("demo parse failure")
+	}
+	address, err := netip.ParseAddrPort(text)
+	if err != nil {
+		return nil, err
+	}
+	return &conn.StdNetEndpoint{AddrPort: address}, nil
+}
+func (b *runtimeMemoryBind) Send(_ [][]byte, endpoint conn.Endpoint) error {
+	b.sent.Add(1)
+	address := endpoint.(*conn.StdNetEndpoint).AddrPort
+	b.last.Store(&address)
+	if b.block.Load() {
+		b.enteredOnce.Do(func() { close(b.entered) })
+		b.mu.Lock()
+		done := b.done
+		b.mu.Unlock()
+		<-done
+		return net.ErrClosed
+	}
+	return nil
+}
+func runtimePhysicalFixture(t *testing.T, domain bool) (*Endpoint, *runtimeMemoryBind, PeerOptions) {
+	t.Helper()
+	ctx, cancel := context.WithCancel(context.Background())
+	ctx = pause.WithDefaultManager(ctx)
+	t.Cleanup(cancel)
+	local, err := ecdh.X25519().GenerateKey(rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	remote, err := ecdh.X25519().GenerateKey(rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var key device.NoisePublicKey
+	copy(key[:], remote.PublicKey().Bytes())
+	destination := M.ParseSocksaddr("192.0.2.10:443")
+	if domain {
+		destination = M.ParseSocksaddr("entry.example:443")
+	}
+	spec := peerConfig{destination: destination, publicKeyHex: hex.EncodeToString(key[:]), allowedIPs: []netip.Prefix{netip.MustParsePrefix("fdab::2/128")}}
+	if !domain {
+		spec.endpoint = netip.MustParseAddrPort("192.0.2.10:443")
+	}
+	bind := &runtimeMemoryBind{done: make(chan struct{}), entered: make(chan struct{})}
+	owned := &lifetimeBind{Bind: bind}
+	memory := &runtimeMemoryTUN{done: make(chan struct{}), events: make(chan T.Event)}
+	e := &Endpoint{options: EndpointOptions{Context: ctx, Logger: logger.NOP(), LazyPeers: domain, ResolvePeerContext: func(context.Context, string) (netip.Addr, error) { return netip.MustParseAddr("192.0.2.12"), nil }}, peers: []peerConfig{spec}, binding: owned, counterEpoch: "demo-epoch"}
+	e.device = device.NewDevice(ctx, memory, owned, &device.Logger{Verbosef: func(string, ...any) {}, Errorf: func(string, ...any) {}}, 1)
+	if err = e.device.IpcSet("private_key=" + hex.EncodeToString(local.Bytes()) + spec.GenerateIpcLines() + "\n"); err != nil {
+		t.Fatal(err)
+	}
+	if err = e.device.Up(); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { cancel(); bind.Close(); e.Close() })
+	return e, bind, PeerOptions{Endpoint: destination, PublicKey: base64.StdEncoding.EncodeToString(remote.PublicKey().Bytes()), AllowedIPs: append([]netip.Prefix(nil), spec.allowedIPs...)}
+}
+func injectRuntimePacket(e *Endpoint, address netip.Addr) {
+	body := make([]byte, 40)
+	body[0] = 0x60
+	body[6] = 6
+	body[7] = 64
+	copy(body[8:24], netip.MustParseAddr("fdab::1").AsSlice())
+	copy(body[24:40], address.AsSlice())
+	e.device.InputPacket(address.AsSlice(), [][]byte{body})
+}
+func TestRuntimePeerRepairUsesLatestTypedValuesAfterPartialIPCFailure(t *testing.T) {
+	e, bind, original := runtimePhysicalFixture(t, false)
+	failed := original
+	failed.Endpoint = M.ParseSocksaddr("192.0.2.11:443")
+	failed.AllowedIPs = []netip.Prefix{netip.MustParsePrefix("fdab::3/128")}
+	bind.failEndpoint.Store(true)
+	apply, err := e.PrepareRuntimePeerCleanup([]PeerOptions{failed})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = apply(); err == nil || !e.RuntimePeersNeedRepair() {
+		t.Fatal("partial IpcSet was not marked unknown")
+	}
+	// The latest legal route returns to the earlier prefix, while its coordinate
+	// is a newer value. An ordinary old→old ACL delta would skip the repair.
+	latest := original
+	latest.Endpoint = M.ParseSocksaddr("192.0.2.12:443")
+	repair, err := e.PrepareRuntimePeerCleanup([]PeerOptions{latest})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = repair(); err != nil {
+		t.Fatal(err)
+	}
+	if e.RuntimePeersNeedRepair() {
+		t.Fatal("confirmed repair stayed pending")
+	}
+	injectRuntimePacket(e, netip.MustParseAddr("fdab::2"))
+	if bind.sent.Load() != 1 || bind.last.Load() == nil || *bind.last.Load() != netip.MustParseAddrPort("192.0.2.12:443") {
+		t.Fatal("actual ACL/coordinate did not use current typed repair")
+	}
+}
+func TestStopIOClosesBindBeforeWaitingForDNSPostConfigSend(t *testing.T) {
+	e, bind, _ := runtimePhysicalFixture(t, true)
+	// A previous real packet has no current keypair/coordinate and remains staged.
+	injectRuntimePacket(e, netip.MustParseAddr("fdab::2"))
+	// Freeze only autonomous timer retries; the tested foreground resolver/UAPI
+	// path remains real and the protocol device remains up.
+	manager := service.FromContext[pause.Manager](e.options.Context)
+	manager.NetworkPause()
+	defer manager.NetworkWake()
+	time.Sleep(device.RekeyTimeout + 20*time.Millisecond)
+	bind.block.Store(true)
+	resolution := make(chan error, 1)
+	go func() { resolution <- e.ensurePeer(context.Background(), netip.MustParseAddr("fdab::2")) }()
+	select {
+	case <-bind.entered:
+	case <-time.After(time.Second):
+		t.Fatal("DNS endpoint postConfig did not enter synchronous Send")
+	}
+	prepared := make(chan error, 1)
+	go func() { _, err := e.PrepareRuntimePeers(nil); prepared <- err }()
+	select {
+	case err := <-prepared:
+		if err == nil {
+			t.Fatal("busy cold plan did not defer")
+		}
+	case <-time.After(200 * time.Millisecond):
+		bind.Close()
+		t.Fatal("cold plan waited behind WG send")
+	}
+	stopped := make(chan error, 1)
+	go func() { stopped <- e.StopIO() }()
+	select {
+	case err := <-stopped:
+		if err != nil {
+			t.Fatal(err)
+		}
+	case <-time.After(time.Second):
+		bind.Close()
+		t.Fatal("StopIO waited on DNS lock before interrupting Send")
+	}
+	select {
+	case <-resolution:
+	case <-time.After(time.Second):
+		t.Fatal("DNS worker did not join after owned bind closed")
+	}
+}
