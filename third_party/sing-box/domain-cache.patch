+func TestNativeOfferWaitingAndInitialUnderlayUseCallerContext(t *testing.T) {
+	client := &Client{ctx: context.Background(), connAccess: make(chan struct{}, 1)}
+	client.connAccess <- struct{}{}
+	ctx, cancel := context.WithCancel(context.Background())
+	done := make(chan error, 1)
+	go func() { _, err := client.offer(ctx); done <- err }()
+	cancel()
+	select {
+	case err := <-done:
+		if !errors.Is(err, context.Canceled) {
+			t.Fatal(err)
+		}
+	case <-time.After(time.Second):
