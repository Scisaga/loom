+package route
+
+import (
+	"context"
+	"errors"
+	"net"
+	"net/netip"
+	"os"
+	"strings"
+
+	D "github.com/miekg/dns"
+	"github.com/sagernet/sing-dns"
+)
+
+// This transport has no sockets, mutable records or fallback. Loom supplies
+// only a projection of the already accepted DeviceView for this process.
+type loomStaticDNS struct {
+	name    string
+	records map[string][]netip.Addr
+}
+
+func newLoomStaticDNS(name string, values map[string][]string) (dns.Transport, error) {
+	t := &loomStaticDNS{name: name, records: make(map[string][]netip.Addr, len(values))}
+	for host, addresses := range values {
+		if host != strings.ToLower(host) || !strings.HasSuffix(host, ".loom") || len(host) > 253 || len(addresses) == 0 {
+			return nil, errors.New("invalid overlay DNS name or empty address set")
+		}
