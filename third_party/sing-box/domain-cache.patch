+
+	"github.com/sagernet/sing-box/option"
+	"github.com/sagernet/sing/common/logger"
+)
+
+func TestWGInitializerValidatesActualIdentityWithoutChangingReceiver(t *testing.T) {
+	key, _ := testWGKey(t)
+	options := option.WireGuardEndpointOptions{PrivateKey: key, Address: []netip.Prefix{netip.MustParsePrefix("127.0.0.1/32"), netip.MustParsePrefix("::1/128")}, Workers: 1}
+	actual, err := NewEndpoint(context.Background(), &executionTestRouter{}, logger.NOP(), "wg-shared", options)
+	if err != nil {
+		t.Fatal(err)
+	}
+	endpoint := actual.(*Endpoint)
+	defer endpoint.Close()
+	before := endpoint.sourceRoutes.Load()
+	if err = endpoint.ValidateRuntimeWireGuardInitializer(options); err != nil {
+		t.Fatal("current construction template rejected", err)
+	}
+	changed := options
+	changed.PrivateKey, _ = testWGKey(t)
+	if endpoint.ValidateRuntimeWireGuardInitializer(changed) == nil {
+		t.Fatal("different private identity accepted")
+	}
+	changed = options
+	changed.Address = []netip.Prefix{netip.MustParsePrefix("127.0.0.2/32"), netip.MustParsePrefix("::1/128")}
+	if endpoint.ValidateRuntimeWireGuardInitializer(changed) == nil {
+		t.Fatal("different stack anchors accepted")
+	}
+	changed = options
+	changed.ListenPort = 443
+	if endpoint.ValidateRuntimeWireGuardInitializer(changed) == nil {
+		t.Fatal("sender template reconfigured listener")
+	}
+	changed = options
+	changed.Workers = 2
+	if endpoint.ValidateRuntimeWireGuardInitializer(changed) == nil {
+		t.Fatal("different actual constructor accepted")
+	}
+	if endpoint.sourceRoutes.Load() != before {
+		t.Fatal("pure validation modified actual source/receive snapshot")
+	}
+}
