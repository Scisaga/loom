+	address, _ := ctx.Value(wireGuardSourceKey{}).(netip.Addr)
+	return address
+}
+
+func WithWireGuardSource(ctx context.Context, address netip.Addr) context.Context {
+	return context.WithValue(ctx, wireGuardSourceKey{}, address)
