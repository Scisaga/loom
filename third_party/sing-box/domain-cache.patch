+func TestAccessLiveLookupKeepsUnusedPolicyChangesAndClosesOnlyRevokedFlows(t *testing.T) {
+	s, options, a, _ := accessFixture(t)
+	s.outbounds["demo-a"] = accessPipeOutbound{targetOutbound("demo-a")}
+	running := map[string]adapter.Outbound{}
+	for tag, value := range s.outbounds {
+		running[tag] = value
+	}
+	running["demo-live"] = accessPipeOutbound{targetOutbound("demo-live")}
+	s.outbound = accessRunningOutbounds{running: running}
+	if s.outbounds["demo-live"] != nil {
+		t.Fatal("fixture placed live component in static members")
+	}
+	id, choices := sourceChoice(t, a)
+	if _, err := s.CompareAndSelectAccess(context.Background(), AccessSnapshot{Name: id, PolicyID: "demo-policy", Choices: choices, Targets: map[string]string{}}, s.AccessSnapshot()); err != nil {
+		t.Fatal(err)
+	}
+	type activeFlow struct {
+		metadata *adapter.InboundContext
+		conn     net.Conn
+	}
+	flows := []activeFlow{}
+	dial := func() activeFlow {
+		t.Helper()
+		target := M.ParseSocksaddr("demo.example:443")
+		metadata := &adapter.InboundContext{Destination: target}
+		conn, err := s.DialContext(adapter.WithContext(context.Background(), metadata), "tcp", target)
+		if err != nil {
+			t.Fatal(err)
+		}
+		t.Cleanup(func() { _ = conn.Close() })
+		value := activeFlow{metadata: metadata, conn: conn}
+		flows = append(flows, value)
+		return value
+	}
+	invalidate := func() {
+		// The formal API uses this same per-connection authorization check.
+		for _, flow := range flows {
+			if s.CheckAccessConnection(*flow.metadata) != nil {
+				_ = flow.conn.Close()
+			}
+		}
+	}
+	exchange := func(flow activeFlow) {
+		t.Helper()
+		_ = flow.conn.SetDeadline(time.Now().Add(time.Second))
+		if _, err := flow.conn.Write([]byte{'x'}); err != nil {
+			t.Fatal("unaffected connection closed", err)
+		}
+		var body [1]byte
+		if _, err := io.ReadFull(flow.conn, body[:]); err != nil || body[0] != 'x' {
+			t.Fatal("unaffected connection stopped carrying business", err)
+		}
+	}
+	first := dial()
+	exchange(first)
+	spare := options.Policies[0]
+	spare.Policy.PolicyID, spare.Policy.ServiceID = "demo-spare-policy", "demo-spare-service"
+	withSpare := options
+	withSpare.Policies = append(append([]option.ExecutionPolicy{}, options.Policies...), spare)
+	withSpare.Entries = map[string]option.ExecutionEntry{}
+	for id, entry := range options.Entries {
+		withSpare.Entries[id] = entry
+	}
+	withSpare.Entries["demo-resource-live"] = option.ExecutionEntry{AuthenticationDigest: "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", NodeID: "demo-entry-a", Outbound: "demo-live", AccessEnabled: true, Forward: true}
+	before := s.AccessAuthorizationState()
+	added, err := s.ReplaceAccess(withSpare, before.Revision, "demo-added", invalidate)
+	if err != nil {
+		t.Fatal("running component outside static members rejected", err)
+	}
+	exchange(first)
+	removed, err := s.ReplaceAccess(options, added.Revision, "demo-spare-removed", invalidate)
+	if err != nil {
+		t.Fatal(err)
+	}
+	exchange(first)
+	addedAgain, err := s.ReplaceAccess(withSpare, removed.Revision, "demo-added-again", invalidate)
+	if err != nil {
+		t.Fatal(err)
+	}
+	live := P.RouteChoice{EntryNodeID: "demo-entry-a", FirstResourceID: "demo-resource-live", FinalExit: "demo-exit-a"}
+	liveID, err := P.CandidateID(spare.Policy.ServiceID, spare.Policy.PolicyID, live)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := s.CompareAndSelectAccess(context.Background(), AccessSnapshot{Name: liveID, PolicyID: spare.Policy.PolicyID, Targets: map[string]string{}, Choices: map[string]P.RouteChoice{liveID: live}}, s.AccessSnapshot()); err != nil {
+		t.Fatal("live-only transport rejected by selection", err)
+	}
+	second := dial()
+	if got := s.pinSelection(second.metadata); got != "demo-live" {
+		t.Fatal("live-only transport was not pinned", got)
+	}
+	if _, err := s.CompareAndSelectAccess(context.Background(), AccessSnapshot{Name: id, PolicyID: "demo-policy", Choices: choices, Targets: map[string]string{}}, s.AccessSnapshot()); err != nil {
+		t.Fatal(err)
+	}
+	if got := s.pinSelection(second.metadata); got != "demo-live" {
+		t.Fatal("pinned live transport followed newer selection", got)
+	}
+	exchange(first)
+	exchange(second)
+	withoutFirst := withSpare
+	withoutFirst.Policies = []option.ExecutionPolicy{spare}
+	if _, err := s.ReplaceAccess(withoutFirst, addedAgain.Revision, "demo-first-revoked", invalidate); err != nil {
+		t.Fatal(err)
+	}
+	_ = first.conn.SetWriteDeadline(time.Now().Add(time.Second))
+	if _, err := first.conn.Write([]byte{'x'}); err == nil {
+		t.Fatal("withdrawn Policy retained existing connection")
+	}
+	exchange(second)
+	if _, err := s.ReplaceAccess(withSpare, addedAgain.Revision, "demo-stale", invalidate); !errors.Is(err, ErrSelectionChanged) {
+		t.Fatal("old source revision restored permission", err)
+	}
+	exchange(second)
+}
