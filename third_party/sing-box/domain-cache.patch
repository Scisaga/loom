+		t.Fatal("old optimization overwrote a later identical user choice", err)
+	}
+	if s.Now() != "demo-a" {
+		t.Fatal("ABA comparison changed the current choice")
+	}
+}
+
+func TestSelectorSnapshotFromAnEarlierInstanceCannotUpdateANewInstance(t *testing.T) {
+	previous, current := targetSelector(), targetSelector()
+	previous.SelectTargets("demo-a", map[string]string{})
+	current.SelectTargets("demo-a", map[string]string{})
+	if _, err := current.CompareAndSelectTargets("demo-b", map[string]string{}, "demo-a", map[string]string{}, selectorRevision(previous)); !errors.Is(err, ErrSelectionChanged) {
