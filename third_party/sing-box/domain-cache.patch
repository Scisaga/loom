+package clashapi
+
+import (
+	"github.com/go-chi/render"
+	"github.com/sagernet/sing-box/adapter"
+	C "github.com/sagernet/sing-box/constant"
+	"net"
+	"net/http"
+	"sort"
+)
+
+func (s *Server) wireGuardCounters(authenticated bool) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		host, _, err := net.SplitHostPort(s.httpServer.Addr)
+		address := net.ParseIP(host)
+		if !authenticated || err != nil || address == nil || !address.IsLoopback() {
+			http.Error(w, "counter source requires the authenticated local listener", http.StatusForbidden)
+			return
+		}
+		if r.URL.RawQuery != "" {
+			http.Error(w, "unexpected counter query", http.StatusBadRequest)
+			return
+		}
+		if s.endpoint == nil {
+			http.Error(w, "counter source unavailable", http.StatusServiceUnavailable)
+			return
+		}
+		values := []adapter.WireGuardCounters{}
+		for _, endpoint := range s.endpoint.Endpoints() {
+			if endpoint.Type() != C.TypeWireGuard {
+				continue
+			}
+			source, ok := endpoint.(adapter.WireGuardCounterReader)
+			if !ok {
+				http.Error(w, "counter source unavailable", http.StatusServiceUnavailable)
+				return
+			}
+			value, err := source.ReadWireGuardCounters()
+			if err != nil {
+				http.Error(w, "counter source unavailable", http.StatusServiceUnavailable)
+				return
+			}
+			values = append(values, value)
+		}
+		sort.Slice(values, func(i, j int) bool { return values[i].Interface < values[j].Interface })
+		render.JSON(w, r, struct {
+			Endpoints []adapter.WireGuardCounters `json:"endpoints"`
+		}{values})
+	}
+}
