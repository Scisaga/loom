+package sourcepool
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"io"
+	"net/netip"
+	"sync"
+
+	"github.com/sagernet/sing-box/adapter"
+	C "github.com/sagernet/sing-box/constant"
+	"github.com/sagernet/sing-box/log"
+	"github.com/sagernet/sing-box/option"
+	M "github.com/sagernet/sing/common/metadata"
+	"github.com/sagernet/sing/service"
+)
+
+type wireGuardUpdater interface {
+	RuntimeWireGuardReferenceProjection([]string) func(map[string]uint16)
+	PrepareRuntimeWireGuardStage(context.Context, []option.WireGuardPeer, []option.WireGuardSourceRoute, []option.WireGuardPeer, []option.WireGuardSourceRoute) (func(string, bool) error, func(map[string]uint16, func() error) error, error)
+}
+type wireGuardRetirer interface {
+	RuntimeWireGuardSnapshot() any
+	PruneRuntimeWireGuard(any, []option.WireGuardSourceRoute, map[string]uint16) error
+}
+type endpointPublisher interface {
+	PublishRuntimeEndpoint(context.Context, adapter.Endpoint) error
+}
+
+type entry struct {
+	registration     Registration
+	descriptor       option.Outbound
+	description      *descriptionState
+	cancel           context.CancelFunc
+	stopPrepare      func() bool
+	source           netip.Addr
+	leases           map[*Lease]struct{}
+	retired          bool
+	closed           bool
+	peers            []option.WireGuardPeer
+	projectKeepalive func(map[string]uint16)
+	routes           []option.WireGuardSourceRoute
+}
+
+// Pool owns disposable transport objects, never permissions. Its mutex protects
+// only the finite live-object set; preparation and object shutdown run outside.
+type Pool struct {
+	mu              sync.Mutex
+	ctx             context.Context
+	cancel          context.CancelFunc
+	router          adapter.Router
+	logger          log.ContextLogger
+	registry        Registry
+	factory         adapter.OutboundRegistry
+	endpoints       adapter.EndpointManager
+	epFactory       adapter.EndpointRegistry
+	active          map[string]*entry
+	forwarding      map[string]*entry
+	retired         map[*entry]struct{}
+	generation      uint64
+	closed          bool
+	preparing       sync.WaitGroup
+	closing         sync.WaitGroup
+	closeError      error
+	dirty           bool
+	closeDone       chan struct{}
+	leases          map[*Lease]struct{}
+	descriptions    *descriptionState
+	permissionFence func(map[string]string, func() error) error
+}
+
+func New(ctx context.Context, router adapter.Router, logger log.ContextLogger) (*Pool, error) {
+	manager := service.FromContext[adapter.OutboundManager](ctx)
+	registry, ok := manager.(Registry)
+	if !ok {
+		return nil, errors.New("outbound manager does not support runtime resources")
+	}
+	factory := service.FromContext[adapter.OutboundRegistry](ctx)
+	if factory == nil {
+		return nil, errors.New("missing runtime outbound factory")
+	}
+	lifetime, cancel := context.WithCancel(ctx)
+	return &Pool{ctx: lifetime, cancel: cancel, router: router, logger: logger,
+		registry: registry, factory: factory, endpoints: service.FromContext[adapter.EndpointManager](ctx),
+		epFactory: service.FromContext[adapter.EndpointRegistry](ctx), active: map[string]*entry{}, forwarding: map[string]*entry{}, retired: map[*entry]struct{}{}, leases: map[*Lease]struct{}{}, closeDone: make(chan struct{})}, nil
+}
+
+type Prepared struct {
+	mu                   sync.Mutex
+	pool                 *Pool
+	generation           uint64
+	ctx                  context.Context
+	stopCancel           func() bool
+	finished             chan struct{}
+	cancel               context.CancelFunc
+	wanted               map[string]*entry
+	forwarding           map[string]*entry
+	applyForwarding      []func() error
+	created              []*entry
+	replace              []Registration
+	endpoint             adapter.Endpoint
+	retained             map[*entry]bool
+	endpointCancel       context.CancelFunc
+	endpointStop         func() bool
+	applyWG              func(string, bool) error
+	guardWG              func(map[string]uint16, func() error) error
+	captureWG            func([]string) func(map[string]uint16)
+	networkTouched       bool
+	committed            bool
+	closed               bool
+	install              *descriptionState
+	installLive          bool
+	hot                  bool
+	expectedDescriptions *descriptionState
+	borrowTags           []string
+	borrowedMany         []*Lease
+	checkDescriptions    bool
+	beforePublish        func() error
+	afterPublish         func([]*Lease)
+	borrowed             *Lease
+}
+
+// Prepare binds constructors to the instance lifetime. Request cancellation
+// cancels that child only until commit; returning an HTTP response cannot cancel
+// a newly published client. Constructors and all Start calls are outside locks.
+func (p *Pool) prepareLive(ctx context.Context, desired option.RuntimeResources, withWG bool) (_ *Prepared, resultErr error) {
+	if desired.Forwarding == nil {
+		return nil, errors.New("forwarding working set must be explicit")
+	}
+	p.mu.Lock()
+	if p.closed || ctx.Err() != nil {
+		p.mu.Unlock()
+		if ctx.Err() != nil {
+			return nil, ctx.Err()
+		}
+		return nil, ErrNotRunning
+	}
+	p.preparing.Add(1)
+	generation := p.generation
+	current := make(map[string]*entry, len(p.active))
+	for tag, value := range p.active {
+		current[tag] = value
+	}
+	retained := []*entry{}
+	seenRetained := map[*entry]bool{}
+	for lease := range p.leases {
+		if !seenRetained[lease.entry] {
+			seenRetained[lease.entry] = true
+			retained = append(retained, lease.entry)
+		}
+	}
+	p.mu.Unlock()
+	defer p.preparing.Done()
+	lifetime, cancel := context.WithCancel(p.ctx)
+	finished := make(chan struct{})
+	stop := context.AfterFunc(ctx, func() { cancel(); close(finished) })
+	prepared := &Prepared{pool: p, generation: generation, ctx: lifetime, cancel: cancel,
+		stopCancel: stop, finished: finished, wanted: map[string]*entry{}, forwarding: map[string]*entry{}, retained: map[*entry]bool{}}
+	for _, value := range retained {
+		prepared.retained[value] = true
+	}
+	defer func() {
+		if resultErr != nil {
+			_ = prepared.Close()
+		}
+	}()
+	for _, value := range desired.Outbounds {
+		if err := ctx.Err(); err != nil {
+			return nil, err
+		}
+		if err := validateSender(value); err != nil {
+			return nil, err
+		}
+		if _, exists := prepared.wanted[value.Tag]; exists {
+			return nil, errors.New("duplicate runtime sender")
+		}
+		hash, err := ConfigHash(value.Type, value.Tag, value.Options)
+		if err != nil {
+			return nil, err
+		}
+		actual, exists := p.registry.RuntimeOutbound(value.Tag)
+		if previous := current[value.Tag]; previous != nil && previous.registration.ConfigHash == hash && exists && SameObject(actual.Outbound, previous.registration.Outbound) && actual.ConfigHash == hash {
+			prepared.wanted[value.Tag] = previous
+			continue
+		}
+		if exists {
+			if previous := current[value.Tag]; previous != nil {
+				if !SameObject(actual.Outbound, previous.registration.Outbound) {
+					return nil, ErrConflict
+				}
+				prepared.replace = append(prepared.replace, previous.registration)
+			} else if actual.ConfigHash == hash {
+				adopted, err := p.registry.AdoptRuntimeOutbound(value.Tag, hash)
+				if err != nil {
+					return nil, err
+				}
+				prepared.wanted[value.Tag] = &entry{registration: adopted, descriptor: value, source: senderSource(value), leases: map[*Lease]struct{}{}}
+				continue
+			} else {
+				return nil, ErrConflict
+			}
+		}
+		objectCtx, objectCancel := context.WithCancel(p.ctx)
+		stopObject := context.AfterFunc(lifetime, objectCancel)
+		candidate, err := p.factory.CreateOutbound(objectCtx, p.router, p.logger, value.Tag, value.Type, value.Options)
+		if err != nil {
+			stopObject()
+			objectCancel()
+			return nil, err
+		}
+		owned := &entry{registration: Registration{Outbound: candidate, ConfigHash: hash, Owned: true}, descriptor: value, cancel: objectCancel, stopPrepare: stopObject, source: senderSource(value), leases: map[*Lease]struct{}{}}
+		prepared.created = append(prepared.created, owned)
+		prepared.wanted[value.Tag] = owned
+	}
+	if err := prepared.prepareForwarding(desired.Forwarding); err != nil {
+		return nil, err
+	}
+	if withWG {
+		if err := prepared.prepareWireGuard(desired.WireGuard, retained); err != nil {
+			return nil, err
+		}
+	}
+	for _, value := range prepared.created {
+		for _, stage := range adapter.ListStartStages {
+			if err := ctx.Err(); err != nil {
+				return nil, err
+			}
+			if err := adapter.LegacyStart(value.registration.Outbound, stage); err != nil {
+				return nil, err
+			}
+		}
+	}
+	return prepared, nil
+}
+
+func senderSource(value option.Outbound) netip.Addr {
+	if options, ok := value.Options.(*option.DirectOutboundOptions); ok && options.Inet6BindAddress != nil {
+		return options.Inet6BindAddress.Build(netip.Addr{})
+	}
+	return netip.Addr{}
+}
+
+func validateSender(value option.Outbound) error {
+	if value.Tag == "" {
+		return errors.New("runtime sender requires an exact tag")
+	}
+	switch options := value.Options.(type) {
+	case *option.Hysteria2OutboundOptions:
+		if value.Type == C.TypeHysteria2 && senderRoute(options.Execution) && options.Detour == "" {
+			return nil
+		}
+	case *option.DirectOutboundOptions:
+		if value.Type == C.TypeDirect && senderRoute(options.Execution) && options.Detour == "wg-shared" && options.Inet6BindAddress != nil && options.Inet4BindAddress == nil && options.PrefixMapping == nil && !options.PublicInternet {
+			return nil
+		}
+	}
+	return errors.New("resource pool accepts only independent authenticated senders")
+}
+
+func senderRoute(route *option.ExecutionRoute) bool {
+	return route != nil && ValidHash(route.AuthenticationDigest) && route.PolicyID == "" && route.OriginID == "" && route.FinalExitID == "" && route.LocalNodeID == ""
+}
+
+func (r *Prepared) prepareWireGuard(wanted *option.RuntimeWireGuard, retained []*entry) error {
+	p := r.pool
+	if wanted == nil {
+		for _, value := range r.wanted {
+			if value.registration.Outbound.Type() == C.TypeDirect {
+				return errors.New("WG sender requires its physical resource projection")
+			}
+		}
+		return nil
+	}
+	if wanted.Tag != "wg-shared" || p.endpoints == nil {
+		return errors.New("invalid shared WG endpoint")
+	}
+	endpoint, exists := p.endpoints.Get(wanted.Tag)
+	peers := append([]option.WireGuardPeer(nil), wanted.Peers...)
+	routes := append([]option.WireGuardSourceRoute(nil), wanted.SourceRoutes...)
+	// Only a newly created/adopted entry receives its own immutable resource
+	// bindings; a concurrent Prepare never mutates an already-live object.
+	for _, value := range r.wanted {
+		if value.registration.Outbound.Type() != C.TypeDirect {
+			continue
+		}
+		source := value.source
+		if !source.IsValid() {
+			return errors.New("WG sender source is missing")
+		}
+		if value.routes == nil {
+			for _, route := range wanted.SourceRoutes {
+				if route.Source == source {
+					value.routes = append(value.routes, route)
+				}
+			}
+			if len(value.routes) == 0 {
+				return errors.New("WG sender has no exact source binding")
+			}
+			for _, peer := range wanted.Peers {
+				filtered := peer
+				filtered.AllowedIPs = nil
+				for _, prefix := range peer.AllowedIPs {
+					for _, route := range value.routes {
+						if prefix == route.Destination || prefix == netip.PrefixFrom(route.Execution, 128) {
+							filtered.AllowedIPs = append(filtered.AllowedIPs, prefix)
+							break
+						}
+					}
+				}
+				if len(filtered.AllowedIPs) != 0 {
+					value.peers = append(value.peers, filtered)
+				}
+			}
+		}
+	}
+	// A lease owns exact source/AllowedIPs bindings, never a historical dial
+	// coordinate. The endpoint merges these with one current physical snapshot.
+	var retainedPeers []option.WireGuardPeer
+	var retainedRoutes []option.WireGuardSourceRoute
+	for _, previous := range retained {
+		for _, peer := range previous.peers {
+			retainedPeers = append(retainedPeers, option.WireGuardPeer{PublicKey: peer.PublicKey, PreSharedKey: peer.PreSharedKey, PersistentKeepaliveInterval: peer.PersistentKeepaliveInterval, AllowedIPs: append([]netip.Prefix(nil), peer.AllowedIPs...)})
+		}
+		for _, route := range previous.routes {
+			retainedRoutes = append(retainedRoutes, route)
+			found := false
+			for _, next := range routes {
+				if next.Source == route.Source {
+					if next != route {
+						return ErrConflict
+					}
+					found = true
+				}
+			}
+			if !found {
+				routes = append(routes, route)
+			}
+		}
+	}
+	if exists {
+		if wanted.Initializer != nil {
+			return errors.New("existing WG endpoint cannot be reinitialized")
+		}
+	} else {
+		if wanted.Initializer == nil || p.epFactory == nil {
+			return errors.New("missing WG sender initializer")
+		}
+		initializer := *wanted.Initializer
+		if initializer.System || initializer.Name != "" || initializer.ListenPort != 0 || initializer.Execution != nil || initializer.ExecutionAddress.IsValid() || len(initializer.HostSources) != 0 || len(initializer.StackAddress) != 0 || initializer.Detour != "" {
+			return errors.New("runtime WG initializer must be a pure sender")
+		}
+		if len(initializer.Address) != 2 || initializer.Address[0] != netip.MustParsePrefix("127.0.0.1/32") || initializer.Address[1] != netip.MustParsePrefix("::1/128") {
+			return errors.New("WG sender requires stable stack anchors")
+		}
+		initializer.Peers, initializer.SourceRoutes = []option.WireGuardPeer{}, []option.WireGuardSourceRoute{}
+		var err error
+		objectCtx, objectCancel := context.WithCancel(p.ctx)
+		r.endpointCancel = objectCancel
+		r.endpointStop = context.AfterFunc(r.ctx, objectCancel)
+		endpoint, err = p.epFactory.Create(objectCtx, p.router, p.logger, wanted.Tag, C.TypeWireGuard, &initializer)
+		if err != nil {
+			return err
+		}
+		r.endpoint = endpoint
+		for _, stage := range adapter.ListStartStages {
+			if err := r.ctx.Err(); err != nil {
+				return err
+			}
+			if err := endpoint.Start(stage); err != nil {
+				return err
+			}
+		}
+	}
+	updater, ok := endpoint.(wireGuardUpdater)
+	if !ok {
+		return errors.New("WG endpoint lacks incremental sender support")
+	}
+	var err error
+	r.captureWG = updater.RuntimeWireGuardReferenceProjection
+	r.applyWG, r.guardWG, err = updater.PrepareRuntimeWireGuardStage(r.ctx, peers, routes, retainedPeers, retainedRoutes)
+	return err
+}
+
+func (r *Prepared) Commit(ctx context.Context) error {
+	if r.install != nil && !r.installLive {
+		return r.commitDescriptions(ctx)
+	}
+	if r.hot {
+		return r.commitHot(ctx)
+	}
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	if r.closed || r.committed {
+		return ErrConflict
+	}
+	// Detach the request callback before publication. A callback already in
+	// progress is joined, so a late cancellation can never create live objects.
+	r.detachRequestLocked()
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	if err := r.ctx.Err(); err != nil {
+		return err
+	}
+	p := r.pool
+	defer func() {
+		if r.committed && r.guardWG != nil {
+			p.scheduleWGCleanup()
+		}
+	}()
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	if p.closed || p.generation != r.generation || r.checkDescriptions && p.descriptions != r.expectedDescriptions {
+		return ErrConflict
+	}
+	publish := func() error {
+		// A flow may have started while constructors were running. Never retire
+		// its WG binding using an earlier zero-lease snapshot; retry preparation.
+		for tag, previous := range p.active {
+			if r.wanted[tag] != previous && len(previous.leases) != 0 && !r.retained[previous] {
+				return ErrConflict
+			}
+		}
+		if r.beforePublish != nil {
+			if err := r.beforePublish(); err != nil {
+				return err
+			}
+		}
+		for tag, old := range p.active {
+			next := r.wanted[tag]
+			if next == nil || next == old {
+				continue
+			}
+			for lease := range old.leases {
+				if lease.selection && outboundDigest(old.registration.Outbound) != outboundDigest(next.registration.Outbound) {
+					return ErrConflict
+				}
+			}
+		}
+		if r.endpoint != nil {
+			publisher, ok := p.endpoints.(endpointPublisher)
+			if !ok {
+				return errors.New("endpoint manager lacks runtime publication")
+			}
+			if err := publisher.PublishRuntimeEndpoint(ctx, r.endpoint); err != nil {
+				return err
+			}
+			// Endpoint ownership transfers immediately. A later sender failure is
+			// reported as incomplete, but may not close this registered endpoint.
+			r.endpointStop()
+			r.endpoint = nil
+			r.endpointCancel = nil
+		}
+		candidates := make([]Registration, 0, len(r.created))
+		for _, value := range r.created {
+			candidates = append(candidates, value.registration)
+		}
+		remove := []Registration{}
+		for tag, value := range p.active {
+			if _, keep := r.wanted[tag]; !keep {
+				remove = append(remove, value.registration)
+			}
+		}
+		for tag, value := range p.forwarding {
+			if _, keep := r.forwarding[tag]; !keep {
+				remove = append(remove, value.registration)
+			}
+		}
+		if _, err := p.registry.ReconcileRuntimeOutbounds(ctx, candidates, r.replace, remove); err != nil {
+			return err
+		}
+		for tag, previous := range p.active {
+			if next := r.wanted[tag]; next != nil && next != previous {
+				for lease := range previous.leases {
+					if lease.selection {
+						delete(previous.leases, lease)
+						next.leases[lease] = struct{}{}
+						lease.entry = next
+						lease.description = r.expectedDescriptions
+					}
+				}
+			}
+			if r.wanted[tag] != previous {
+				previous.retired = true
+				p.retired[previous] = struct{}{}
+			}
+		}
+		for tag, previous := range p.forwarding {
+			if r.forwarding[tag] != previous {
+				previous.retired = true
+				p.retired[previous] = struct{}{}
+			}
+		}
+		for _, value := range r.created {
+			value.stopPrepare()
+		}
+		r.cancel()
+		if r.installLive {
+			p.descriptions = r.install
+			r.expectedDescriptions = r.install
+		}
+		p.active = r.wanted
+		for _, value := range p.active {
+			value.description = r.expectedDescriptions
+		}
+		p.forwarding = r.forwarding
+		if r.captureWG != nil {
+			seen := map[*entry]bool{}
+			for lease := range p.leases {
+				value := lease.entry
+				if seen[value] {
+					continue
+				}
+				seen[value] = true
+				keys := []string{}
+				for _, peer := range value.peers {
+					keys = append(keys, peer.PublicKey)
+				}
+				if len(keys) > 0 {
+					value.projectKeepalive = r.captureWG(keys)
+				}
+			}
+		}
+		p.generation++
+		p.dirty = false
+		r.committed = true
+		if len(r.borrowedMany) > 0 {
+			r.borrowed = r.borrowedMany[0]
+		}
+		if r.afterPublish != nil {
+			for _, lease := range r.borrowedMany {
+				lease.selection = true
+			}
+			r.afterPublish(r.borrowedMany)
+		}
+		for value := range p.retired {
+			p.maybeCloseLocked(value)
+		}
+		for _, apply := range r.applyForwarding {
+			if err := apply(); err != nil {
+				p.dirty = true
+				return err
+			}
+		}
+		return nil
+	}
+	if r.guardWG != nil {
+		return r.guardWG(p.keepaliveIntervalsLocked(), publish)
+	}
+	return publish()
+}
+
+func (r *Prepared) Close() error {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	if r.closed || r.committed {
+		return nil
+	}
+	r.closed = true
+	r.detachRequestLocked()
+	r.cancel()
+	ReleaseAll(r.borrowedMany)
+	var result error
+	for _, value := range r.created {
+		value.stopPrepare()
+		if r.networkTouched && r.endpoint == nil {
+			r.pool.mu.Lock()
+			schedule := !r.pool.closed
+			if schedule {
+				r.pool.closing.Add(1)
+			}
+			r.pool.mu.Unlock()
+			if schedule {
+				go func(value *entry) { defer r.pool.closing.Done(); r.pool.retireWireGuard(value) }(value)
+			}
+		}
+		result = errors.Join(result, closeEntry(value))
+	}
+	if r.endpointStop != nil {
+		r.endpointStop()
+	}
+	if r.endpointCancel != nil {
+		r.endpointCancel()
+	}
+	if r.endpoint != nil {
+		result = errors.Join(result, r.endpoint.Close())
+	}
+	return result
+}
+
+func (r *Prepared) detachRequestLocked() {
+	if r.stopCancel == nil {
+		return
+	}
+	if !r.stopCancel() {
+		<-r.finished
+	}
+	r.stopCancel = nil
+}
+
+func (p *Pool) Actual() map[string]string {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	result := map[string]string{}
+	if p.closed {
+		return result
+	}
+	for tag, value := range p.active {
+		if actual, found := p.registry.RuntimeOutbound(tag); found && SameObject(actual.Outbound, value.registration.Outbound) && actual.ConfigHash == value.registration.ConfigHash {
+			result[tag] = actual.ConfigHash
+		}
+	}
+	return result
+}
+func (p *Pool) WireGuard() bool {
+	if p.endpoints == nil {
+		return false
+	}
+	_, exists := p.endpoints.Get("wg-shared")
+	return exists
+}
+
+func (p *Pool) Ready() bool {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	if p.closed || p.dirty {
+		return false
+	}
+	for tag, value := range p.active {
+		actual, exists := p.registry.RuntimeOutbound(tag)
+		if !exists || !SameObject(actual.Outbound, value.registration.Outbound) || actual.ConfigHash != value.registration.ConfigHash {
+			return false
+		}
+	}
+	for tag, value := range p.forwarding {
+		actual, exists := p.registry.RuntimeOutbound(tag)
+		runtime, ok := value.registration.Outbound.(forwardingRuntime)
+		if !exists || !SameObject(actual.Outbound, value.registration.Outbound) || !ok || !ValidHash(runtime.RuntimeForwardingHash()) {
+			return false
+		}
+	}
+	return true
+}
+
+func (p *Pool) Close() error {
+	p.mu.Lock()
+	if p.closed {
+		p.mu.Unlock()
+		<-p.closeDone
+		p.mu.Lock()
+		err := p.closeError
+		p.mu.Unlock()
+		return err
+	}
+	p.closed = true
+	defer close(p.closeDone)
+	p.cancel()
+	var leases []*Lease
+	for lease := range p.leases {
+		leases = append(leases, lease)
+	}
+	p.mu.Unlock()
+	// Only whole-executor shutdown interrupts the shared socket. This precedes
+	// joining retired peers, whose Send may otherwise wait for that socket close.
+	var interruptErr error
+	if p.endpoints != nil {
+		if endpoint, ok := p.endpoints.Get("wg-shared"); ok {
+			if interrupter, ok := endpoint.(interface{ StopRuntimeWireGuardIO() error }); ok {
+				interruptErr = interrupter.StopRuntimeWireGuardIO()
+			}
+		}
+	}
+	for _, lease := range leases {
+		lease.close()
+	}
+	p.preparing.Wait()
+	p.mu.Lock()
+	var retired []*entry
+	for value := range p.retired {
+		retired = append(retired, value)
+	}
+	p.retired = map[*entry]struct{}{}
+	p.active = map[string]*entry{}
+	p.forwarding = map[string]*entry{}
+	p.mu.Unlock()
+	result := interruptErr
+	for _, value := range retired {
+		result = errors.Join(result, closeEntry(value))
+	}
+	// Active registrations are closed by the existing outbound manager during
+	// Box shutdown; closing them here would double-close third-party clients.
+	p.closing.Wait()
+	p.mu.Lock()
+	result = errors.Join(result, p.closeError)
+	p.closeError = result
+	p.mu.Unlock()
+	return result
+}
+
+// Called with p.mu held. Closing is asynchronous only for retired objects: no
+// active permission fence or lookup mutex is held across third-party Close.
+func (p *Pool) maybeCloseLocked(value *entry) {
+	if value.closed || len(value.leases) != 0 {
+		return
+	}
+	if !value.retired {
+		if p.closed || p.active[value.registration.Outbound.Tag()] != value {
+			return
+		}
+		if _, err := p.registry.DetachRuntimeOutbounds(context.WithoutCancel(p.ctx), []Registration{value.registration}); err != nil {
+			p.dirty = true
+			p.closeError = errors.Join(p.closeError, err)
+			return
+		}
+		delete(p.active, value.registration.Outbound.Tag())
+		value.retired = true
+		p.retired[value] = struct{}{}
+		p.generation++
+	}
+	value.closed = true
+	delete(p.retired, value)
+	p.closing.Add(1)
+	go func() {
+		defer p.closing.Done()
+		p.retireWireGuard(value)
+		err := closeEntry(value)
+		p.mu.Lock()
+		p.closeError = errors.Join(p.closeError, err)
+		p.mu.Unlock()
+	}()
+}
+
+func (p *Pool) scheduleWGCleanup() {
+	p.mu.Lock()
+	if p.closed {
+		p.mu.Unlock()
+		return
+	}
+	p.closing.Add(1)
+	p.mu.Unlock()
+	go func() { defer p.closing.Done(); p.retireWireGuard(nil) }()
+}
+func (p *Pool) retireWireGuard(value *entry) {
+	if p.endpoints == nil || value != nil && len(value.routes) == 0 {
+		return
+	}
+	for {
+		p.mu.Lock()
+		if p.closed {
+			p.mu.Unlock()
+			return
+		}
+		keep := []option.WireGuardSourceRoute{}
+		seen := map[option.WireGuardSourceRoute]bool{}
+		for lease := range p.leases {
+			for _, route := range lease.entry.routes {
+				if !seen[route] {
+					seen[route] = true
+					keep = append(keep, route)
+				}
+			}
+		}
+		endpoint, exists := p.endpoints.Get("wg-shared")
+		retirer, ok := endpoint.(wireGuardRetirer)
+		if !exists || !ok {
+			p.mu.Unlock()
+			return
+		}
+		expected := retirer.RuntimeWireGuardSnapshot()
+		intervals := p.keepaliveIntervalsLocked()
+		p.mu.Unlock()
+		err := retirer.PruneRuntimeWireGuard(expected, keep, intervals)
+		if errors.Is(err, ErrConflict) {
+			continue
+		}
+		if err != nil {
+			p.mu.Lock()
+			if !p.closed {
+				p.dirty = true
+				p.closeError = errors.Join(p.closeError, err)
+			}
+			p.mu.Unlock()
+		}
+		return
+	}
+}
+func (p *Pool) WireGuardPhysicalReady() bool {
+	if p.endpoints == nil {
+		return true
+	}
+	endpoint, exists := p.endpoints.Get("wg-shared")
+	if !exists {
+		return true
+	}
+	if checker, ok := endpoint.(interface{ RuntimeWireGuardNeedsRepair() bool }); ok {
+		return !checker.RuntimeWireGuardNeedsRepair()
+	}
+	return true
+}
+func closeEntry(value *entry) error {
+	if value.cancel != nil {
+		value.cancel()
+	}
+	if closer, ok := value.registration.Outbound.(io.Closer); ok {
+		return closer.Close()
+	}
+	return nil
+}
+
+func (p *Pool) Acquire(ctx context.Context, tag string) (*Lease, error) {
+	return p.acquireDescription(ctx, tag)
+}
+
+func (p *Pool) acquireLocked(ctx context.Context, tag string) (*Lease, error) {
+	if p.closed {
+		return nil, ErrNotRunning
+	}
+	value := p.active[tag]
+	if value == nil {
+		value = p.forwarding[tag]
+	}
+	if value == nil {
+		actual, found := p.registry.RuntimeOutbound(tag)
+		if !found {
+			return nil, fmt.Errorf("runtime sender %q is not running", tag)
+		}
+		// Stable non-pool outbounds need no retirement, but pending dials still
+		// receive the caller's cancellation and the instance lifetime.
+		value = &entry{registration: actual, leases: map[*Lease]struct{}{}}
+	}
+	actual, found := p.registry.RuntimeOutbound(tag)
+	if !found || !SameObject(actual.Outbound, value.registration.Outbound) {
+		return nil, ErrConflict
+	}
+	return p.leaseEntryLocked(ctx, value), nil
+}
+func (p *Pool) leaseEntryLocked(ctx context.Context, value *entry) *Lease {
+	lifetime, cancel := context.WithCancel(ctx)
+	lease := &Lease{pool: p, entry: value, description: p.descriptions, ctx: lifetime, cancel: cancel, done: make(chan struct{})}
+	value.leases[lease] = struct{}{}
+	p.leases[lease] = struct{}{}
+	return lease
+}
+
+// AcquireWireGuardExecution borrows the exact described resource, cold if needed.
+// An endpoint-wide lease would not pin its source binding during retirement.
+func (p *Pool) AcquireWireGuardExecution(ctx context.Context, target M.Socksaddr) (*Lease, error) {
+	if target.IsFqdn() || !target.Addr.Is6() || target.Addr.Is4In6() || target.Port != 53 {
+		return nil, errors.New("invalid WG execution target")
+	}
+	p.mu.Lock()
+	state := p.descriptions
+	tag := ""
+	if state != nil && state.wireguard != nil {
+		for _, route := range state.wireguard.SourceRoutes {
+			if route.Execution != target.Addr {
+				continue
+			}
+			for key, description := range state.outbounds {
+				if senderSource(description) == route.Source {
+					if tag != "" && tag != key {
+						p.mu.Unlock()
+						return nil, errors.New("ambiguous WG execution target")
+					}
+					tag = key
+				}
+			}
+		}
+	}
+	p.mu.Unlock()
+	if tag == "" {
+		return nil, ErrResourcePending
+	}
+	return p.Acquire(ctx, tag)
+}
+
+func (p *Pool) keepaliveIntervalsLocked() map[string]uint16 {
+	values := map[string]uint16{}
+	for lease := range p.leases {
+		for _, peer := range lease.entry.peers {
+			interval := peer.PersistentKeepaliveInterval
+			if interval != 0 && (values[peer.PublicKey] == 0 || interval < values[peer.PublicKey]) {
+				values[peer.PublicKey] = interval
+			}
+		}
+	}
+	return values
+}
+func (r *Prepared) stageNetwork(ctx context.Context) error {
+	if r.applyWG == nil {
+		return nil
+	}
+	p := r.pool
+	p.mu.Lock()
+	if p.closed || p.generation != r.generation || (r.checkDescriptions && p.descriptions != r.expectedDescriptions) {
+		p.mu.Unlock()
+		return ErrConflict
+	}
+	for tag, old := range p.active {
+		if next := r.wanted[tag]; next != nil && next != old {
+			for lease := range old.leases {
+				if lease.selection && outboundDigest(old.registration.Outbound) != outboundDigest(next.registration.Outbound) {
+					p.mu.Unlock()
+					return ErrConflict
+				}
+			}
+		}
+	}
+	p.mu.Unlock()
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	state := r.expectedDescriptions
+	if r.install != nil {
+		state = r.install
+	}
+	if err := p.withPermission(state, func() error { return ctx.Err() }); err != nil {
+		return err
+	}
+	expected := ""
+	if state != nil {
+		expected = state.authorization["wg-shared"]
+	}
+	r.networkTouched = true
+	if err := r.applyWG(expected, r.install != nil); err != nil {
+		return err
+	}
+	if !p.WireGuardPhysicalReady() {
+		return ErrResourcePending
+	}
+	return nil
+}
