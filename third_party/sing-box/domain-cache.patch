+	var endpoint *WG.Endpoint
+	delayed := &deferredWGCleanup{entered: make(chan struct{}), proceed: make(chan struct{}), done: make(chan struct{})}
+	if deferCleanup {
+		t.Cleanup(func() {
+			select {
+			case <-delayed.proceed:
+			default:
+				close(delayed.proceed)
