+			}
+			if s.pinSelection(m) != "reject" || m.ExecutionAccessRejectReason != test {
+				t.Fatal("pinned rejection lost its actual guard", m.ExecutionAccessRejectReason)
+			}
+			if test != "pinned-context-missing" && m.ExecutionAccessRejectRevision != rejectionRevisionHash(original.Revision) {
+				t.Fatal("pinned failure used a later snapshot revision")
+			}
+		})
+	}
