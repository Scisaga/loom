+
+func BindMetadata(metadata *adapter.InboundContext, route *option.ExecutionRoute) error {
+	if route == nil {
+		return nil
+	}
+	ctx := context.Background()
+	if metadata.Execution != nil {
+		ctx = P.WithConnection(ctx, *metadata.Execution)
+	}
+	_, connection, err := PrepareContext(ctx, route)
+	if err != nil {
+		return err
+	}
+	metadata.Execution = &connection
+	return nil
+}
