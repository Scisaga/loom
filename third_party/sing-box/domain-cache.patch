+package clashapi
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"io"
+	"maps"
+	"net"
+	"net/http"
+	"reflect"
+	"slices"
+	"sync"
+	"time"
+
+	"github.com/go-chi/render"
+	"github.com/sagernet/sing-box/common/execution"
+	"github.com/sagernet/sing-box/common/sourcepool"
+	"github.com/sagernet/sing-box/option"
+	"github.com/sagernet/sing-box/protocol/group"
+	SJSON "github.com/sagernet/sing/common/json"
+)
+
+type resourceExecutionState struct {
+	mu               sync.Mutex
+	revision         string
+	authorization    map[string]string
+	desiredHash      string
+	completeHash     string
+	describedHashes  map[string]string
+	forwardingHashes map[string]string
+	cancel           context.CancelFunc
+	stopped          bool
+	active           sync.WaitGroup
+}
+
+type resourceReply struct {
+	Revision               string            `json:"revision"`
+	AuthorizationRevisions map[string]string `json:"authorization_revisions"`
+	DesiredConfigHash      string            `json:"desired_config_hash"`
+	ConfigHash             string            `json:"config_hash"`
+	Outbounds              map[string]string `json:"outbounds"`
+	DescribedOutbounds     map[string]string `json:"described_outbounds"`
+	Forwarding             map[string]string `json:"forwarding"`
+	WireGuard              bool              `json:"wireguard"`
+}
+
+type resourceAuthorization struct {
+	revision string
+	with     func(string, func() error) error
+}
+
+func (s *Server) resourceAuthorizations() (map[string]resourceAuthorization, error) {
+	result := map[string]resourceAuthorization{}
+	add := func(tag, revision string, with func(string, func() error) error) error {
+		if tag == "" || revision == "" {
+			return execution.ErrSuperseded
+		}
+		if _, exists := result[tag]; exists {
+			return errors.New("ambiguous native permission scope")
+		}
+		result[tag] = resourceAuthorization{revision, with}
+		return nil
+	}
+	if s.outbound != nil {
+		for _, outbound := range s.outbound.Outbounds() {
+			if selector, ok := outbound.(*group.Selector); ok && selector.IsAccessSelector() {
+				if err := add(selector.Tag(), selector.AccessAuthorizationState().Revision, selector.WithAccessAuthorization); err != nil {
+					return nil, err
+				}
+			}
+		}
+	}
+	if s.endpoint != nil {
+		for _, endpoint := range s.endpoint.Endpoints() {
+			if receiver, ok := endpoint.(receivingExecution); ok && receiver.RuntimeExecutionReceiver() != nil {
+				r := receiver.RuntimeExecutionReceiver()
+				if err := add(endpoint.Tag(), r.State().Revision, r.WithState); err != nil {
+					return nil, err
+				}
+			}
+		}
+	}
+	if s.inbound != nil {
+		for _, inbound := range s.inbound.Inbounds() {
+			if receiver, ok := inbound.(receivingExecution); ok && receiver.RuntimeExecutionReceiver() != nil {
+				r := receiver.RuntimeExecutionReceiver()
+				if err := add(inbound.Tag(), r.State().Revision, r.WithState); err != nil {
+					return nil, err
+				}
+			}
+		}
+	}
+	return result, nil
+}
+
+func authorizationRevisions(values map[string]resourceAuthorization) map[string]string {
+	result := make(map[string]string, len(values))
+	for tag, value := range values {
+		result[tag] = value.revision
+	}
+	return result
+}
+func withResourceAuthorizations(values map[string]resourceAuthorization, expected map[string]string, use func() error) error {
+	if !reflect.DeepEqual(authorizationRevisions(values), expected) {
+		return execution.ErrSuperseded
+	}
+	tags := slices.Sorted(maps.Keys(values))
+	var next func(int) error
+	next = func(index int) error {
+		if index == len(tags) {
+			return use()
+		}
+		tag := tags[index]
+		return values[tag].with(expected[tag], func() error { return next(index + 1) })
+	}
+	return next(0)
+}
+func (s *Server) resourceReadback() resourceReply {
+	s.resources.mu.Lock()
+	reply := resourceReply{Revision: s.resources.revision, AuthorizationRevisions: maps.Clone(s.resources.authorization), DesiredConfigHash: s.resources.desiredHash, ConfigHash: s.resources.completeHash}
+	s.resources.mu.Unlock()
+	current, err := s.resourceAuthorizations()
+	if err != nil || !reflect.DeepEqual(authorizationRevisions(current), reply.AuthorizationRevisions) {
+		reply.ConfigHash = ""
+	}
+	reply.DescribedOutbounds = s.resourcePool.Described()
+	reply.Outbounds = s.resourcePool.Actual()
+	reply.Forwarding = s.resourcePool.Forwarding()
+	s.resources.mu.Lock()
+	if s.resources.revision != reply.Revision || !reflect.DeepEqual(s.resources.describedHashes, reply.DescribedOutbounds) || !reflect.DeepEqual(s.resources.forwardingHashes, reply.Forwarding) {
+		reply.ConfigHash = ""
+	}
+	s.resources.mu.Unlock()
+	reply.WireGuard = s.resourcePool.WireGuard()
+	return reply
+}
+
+func (s *Server) runtimeResources(authenticated bool) http.HandlerFunc {
+	if s.resourcePool != nil {
+		s.resourcePool.SetPermissionFence(func(expected map[string]string, use func() error) error {
+			current, err := s.resourceAuthorizations()
+			if err != nil {
+				return err
+			}
+			return withResourceAuthorizations(current, expected, use)
+		})
+	}
+	return func(w http.ResponseWriter, r *http.Request) {
+		listenHost, _, le := net.SplitHostPort(s.httpServer.Addr)
+		peerHost, _, pe := net.SplitHostPort(r.RemoteAddr)
+		listenIP, peerIP := net.ParseIP(listenHost), net.ParseIP(peerHost)
+		if !authenticated || le != nil || pe != nil || listenIP == nil || peerIP == nil || !listenIP.IsLoopback() || !peerIP.IsLoopback() {
+			http.Error(w, "resources require authenticated loopback", http.StatusForbidden)
+			return
+		}
+		if r.URL.RawQuery != "" || r.URL.ForceQuery || s.resourcePool == nil {
+			http.Error(w, "resource execution unavailable", http.StatusServiceUnavailable)
+			return
+		}
+		if r.Method == http.MethodGet {
+			render.JSON(w, r, s.resourceReadback())
+			return
+		}
+		body, err := io.ReadAll(http.MaxBytesReader(w, r.Body, 8<<20))
+		if err != nil {
+			http.Error(w, "resource request exceeds limit", http.StatusBadRequest)
+			return
+		}
+		if err := validateResourceJSON(body); err != nil {
+			http.Error(w, "ambiguous resource input", http.StatusBadRequest)
+			return
+		}
+		var request option.RuntimeResources
+		if SJSON.UnmarshalContext(s.ctx, body, &request) != nil || request.ExpectedRevision == "" || request.AuthorizationRevisions == nil || request.Outbounds == nil || request.Forwarding == nil {
+			http.Error(w, "incomplete resource request", http.StatusBadRequest)
+			return
+		}
+		// Requiring exact top-level names also rejects a second JSON value. The
+		// typed outbound decoder enforces each native constructor's own fields.
+		decoder := json.NewDecoder(bytes.NewReader(body))
+		decoder.UseNumber()
+		var raw map[string]any
+		if decoder.Decode(&raw) != nil || decoder.Decode(new(any)) != io.EOF {
+			http.Error(w, "invalid resource request", http.StatusBadRequest)
+			return
+		}
+		for field := range raw {
+			if field != "expected_revision" && field != "authorization_revisions" && field != "outbounds" && field != "wireguard" && field != "forwarding" {
+				http.Error(w, "unexpected resource field", http.StatusBadRequest)
+				return
+			}
+		}
+		if err := validateForwardingJSON(raw["forwarding"], request.Forwarding); err != nil {
+			http.Error(w, "invalid forwarding projection", http.StatusBadRequest)
+			return
+		}
+		delete(raw, "expected_revision")
+		canonical, err := json.Marshal(raw)
+		if err != nil {
+			http.Error(w, "invalid resource projection", http.StatusBadRequest)
+			return
+		}
+		sum := sha256.Sum256(canonical)
+		hash := "sha256:" + hex.EncodeToString(sum[:])
+		auth, err := s.resourceAuthorizations()
+		if err != nil || !reflect.DeepEqual(authorizationRevisions(auth), request.AuthorizationRevisions) {
+			http.Error(w, "resource permissions superseded", http.StatusConflict)
+			return
+		}
+		state, err := execution.NewState("")
+		if err != nil {
+			http.Error(w, "resource revision unavailable", http.StatusServiceUnavailable)
+			return
+		}
+		pending, cancel := context.WithTimeout(r.Context(), 8*time.Second)
+		defer cancel()
+		err = withResourceAuthorizations(auth, request.AuthorizationRevisions, func() error {
+			s.resources.mu.Lock()
+			defer s.resources.mu.Unlock()
+			if s.resources.stopped || s.resources.revision != request.ExpectedRevision {
+				return execution.ErrSuperseded
+			}
+			if s.resources.cancel != nil {
+				s.resources.cancel()
+			}
+			s.resources.revision = state.Revision
+			s.resources.desiredHash = hash
+			s.resources.completeHash = ""
+			s.resources.authorization = maps.Clone(request.AuthorizationRevisions)
+			s.resources.cancel = cancel
+			s.resources.active.Add(1)
+			return nil
+		})
+		if err != nil {
+			http.Error(w, "resource request superseded", http.StatusConflict)
+			return
+		}
+		defer s.resources.active.Done()
+		prepared, err := s.resourcePool.Prepare(pending, request)
+		if err != nil {
+			http.Error(w, "resource preparation incomplete", http.StatusServiceUnavailable)
+			return
+		}
+		defer prepared.Close()
+		current, err := s.resourceAuthorizations()
+		if err == nil {
+			err = withResourceAuthorizations(current, request.AuthorizationRevisions, func() error {
+				s.resources.mu.Lock()
+				defer s.resources.mu.Unlock()
+				if s.resources.stopped || pending.Err() != nil || s.resources.revision != state.Revision || s.resources.desiredHash != hash {
+					return execution.ErrSuperseded
+				}
+				if err := prepared.Commit(pending); err != nil {
+					return err
+				}
+				s.resources.completeHash = hash
+				s.resources.describedHashes = s.resourcePool.Described()
+				s.resources.forwardingHashes = s.resourcePool.Forwarding()
+				s.resources.cancel = nil
+				return nil
+			})
+		}
+		if err != nil {
+			if errors.Is(err, execution.ErrSuperseded) || errors.Is(err, sourcepool.ErrConflict) {
+				http.Error(w, "resource request superseded", http.StatusConflict)
+			} else {
+				http.Error(w, "resource application incomplete", http.StatusServiceUnavailable)
+			}
+			return
+		}
+		render.JSON(w, r, s.resourceReadback())
+	}
+}
+
+func validateForwardingJSON(raw any, typed map[string]option.ExecutionHopOptions) error {
+	values, ok := raw.(map[string]any)
+	if !ok || len(values) != len(typed) {
+		return errors.New("forwarding must be an explicit object")
+	}
+	for tag, descriptor := range typed {
+		body, err := json.Marshal(values[tag])
+		if err != nil {
+			return err
+		}
+		sum := sha256.Sum256(body)
+		hash, err := option.RuntimeForwardingHash(descriptor)
+		if err != nil || hash != "sha256:"+hex.EncodeToString(sum[:]) {
+			return errors.New("noncanonical forwarding projection")
+		}
+	}
+	return nil
+}
+
+func (s *Server) closeRuntimeResources() error {
+	s.resources.mu.Lock()
+	s.resources.stopped = true
+	if s.resources.cancel != nil {
+		s.resources.cancel()
+	}
+	s.resources.mu.Unlock()
+	s.resources.active.Wait()
+	if s.resourcePool != nil {
+		return s.resourcePool.Close()
+	}
+	return nil
+}
+
+func validateResourceJSON(body []byte) error {
+	decoder := json.NewDecoder(bytes.NewReader(body))
+	decoder.UseNumber()
+	var parse func(int) error
+	parse = func(depth int) error {
+		if depth > 128 {
+			return errors.New("resource input nesting exceeds limit")
+		}
+		token, err := decoder.Token()
+		if err != nil {
+			return err
+		}
+		delimiter, isDelimiter := token.(json.Delim)
+		if !isDelimiter {
+			return nil
+		}
+		if delimiter == '{' {
+			seen := map[string]bool{}
+			for decoder.More() {
+				key, err := decoder.Token()
+				if err != nil {
+					return err
+				}
+				name, ok := key.(string)
+				if !ok || seen[name] {
+					return errors.New("repeated resource field")
+				}
+				seen[name] = true
+				if err := parse(depth + 1); err != nil {
+					return err
+				}
+			}
+			end, err := decoder.Token()
+			if err != nil || end != json.Delim('}') {
+				return errors.New("invalid resource object")
+			}
+			return nil
+		}
+		if delimiter == '[' {
+			for decoder.More() {
+				if err := parse(depth + 1); err != nil {
+					return err
+				}
+			}
+			end, err := decoder.Token()
+			if err != nil || end != json.Delim(']') {
+				return errors.New("invalid resource array")
+			}
+			return nil
+		}
+		return errors.New("invalid resource value")
+	}
+	if err := parse(0); err != nil {
+		return err
+	}
+	if _, err := decoder.Token(); err != io.EOF {
+		return errors.New("trailing resource input")
+	}
+	return nil
+}
