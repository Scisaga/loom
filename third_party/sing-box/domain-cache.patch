+package wireguard
+
+import (
+	"context"
+	"errors"
+	"net/netip"
+	"time"
+)
+
+type peerDNSResult struct {
+	until time.Time
+	epoch uint64
+}
+type peerDNSFlight struct {
+	done   chan struct{}
+	cancel context.CancelFunc
+	epoch  uint64
+	err    error
+}
+
+// Managed peers resolve only when that peer is actually used. An optional
+// candidate's slow or failed DNS cannot block creation of the shared endpoint.
+// Cache and in-flight work are disposable, bounded by the current peer set.
+func (e *Endpoint) ensurePeer(ctx context.Context, address netip.Addr) error {
+	if !e.options.LazyPeers {
+		return nil
+	}
+	e.counterMu.RLock()
+	var target peerConfig
+	bits := -1
+	for _, peer := range e.peers {
+		for _, prefix := range peer.allowedIPs {
+			if prefix.Bits() > bits && prefix.Contains(address) {
+				target = peer
+				bits = prefix.Bits()
+			}
+		}
+	}
+	e.counterMu.RUnlock()
+	if bits < 0 {
+		return errors.New("WG destination has no authenticated peer")
+	}
+	if !target.destination.IsFqdn() {
+		return nil
+	}
+	e.peerDNSMu.Lock()
+	if e.peerDNSClosed {
+		e.peerDNSMu.Unlock()
+		return errors.New("WG endpoint closed")
+	}
+	if value, ok := e.peerDNSCache[target.publicKeyHex]; ok && value.epoch == e.peerDNSEpoch && time.Now().Before(value.until) {
+		e.peerDNSMu.Unlock()
+		return nil
+	}
+	if e.peerDNSFlights == nil {
+		e.peerDNSFlights = map[string]*peerDNSFlight{}
+		e.peerDNSCache = map[string]peerDNSResult{}
+		e.peerDNSConcurrent = make(chan struct{}, 4)
+	}
+	flight := e.peerDNSFlights[target.publicKeyHex]
+	if flight == nil || flight.epoch != e.peerDNSEpoch {
+		pending, cancel := context.WithTimeout(e.options.Context, 8*time.Second)
+		flight = &peerDNSFlight{done: make(chan struct{}), cancel: cancel, epoch: e.peerDNSEpoch}
+		e.peerDNSFlights[target.publicKeyHex] = flight
+		go e.resolvePeer(pending, target, flight)
+	}
+	e.peerDNSMu.Unlock()
+	select {
+	case <-ctx.Done():
+		return ctx.Err()
+	case <-flight.done:
+		return flight.err
+	}
+}
+func (e *Endpoint) resolvePeer(ctx context.Context, target peerConfig, flight *peerDNSFlight) {
+	defer flight.cancel()
+	var address netip.Addr
+	var err error
+	select {
+	case <-ctx.Done():
+		err = ctx.Err()
+	case e.peerDNSConcurrent <- struct{}{}:
+		if e.options.ResolvePeerContext == nil {
+			err = errors.New("managed WG peer has no explicit resolver")
+		} else {
+			address, err = e.options.ResolvePeerContext(ctx, target.destination.Fqdn)
+		}
+		<-e.peerDNSConcurrent
+	}
+	if err == nil && (!address.IsValid() || address.Zone() != "" || address.Is4In6() || !address.IsGlobalUnicast()) {
+		err = errors.New("WG endpoint resolver returned an invalid unicast address")
+	}
+	e.counterMu.Lock()
+	e.peerDNSMu.Lock()
+	current := flight.epoch == e.peerDNSEpoch && !e.peerDNSClosed && e.peerDNSFlights[target.publicKeyHex] == flight
+	if !current {
+		err = context.Canceled
+	}
+	index := -1
+	for i, peer := range e.peers {
+		if peer.publicKeyHex == target.publicKeyHex && peer.destination == target.destination {
+			index = i
+			break
+		}
+	}
+	if index < 0 || e.device == nil {
+		err = context.Canceled
+	}
+	if err == nil {
+		endpoint := netip.AddrPortFrom(address, target.destination.Port)
+		if endpoint != e.peers[index].endpoint {
+			if e.device.IpcSet("public_key="+target.publicKeyHex+"\nendpoint="+endpoint.String()+"\n") != nil {
+				err = errors.New("WG resolved endpoint apply failed")
+			} else {
+				e.peers[index].endpoint = endpoint
+			}
+		}
+		if err == nil {
+			e.peerDNSCache[target.publicKeyHex] = peerDNSResult{time.Now().Add(time.Minute), flight.epoch}
+		}
+	}
+	// A failed refresh is not proof that the already authenticated coordinate
+	// failed. Keep attempting it; a real transport outcome supplies that evidence.
+	if err != nil && current && index >= 0 && e.peers[index].endpoint.IsValid() {
+		err = nil
+	}
+	flight.err = err
+	if e.peerDNSFlights[target.publicKeyHex] == flight {
+		delete(e.peerDNSFlights, target.publicKeyHex)
+	}
+	close(flight.done)
+	e.peerDNSMu.Unlock()
+	e.counterMu.Unlock()
+}
+
+// Caller holds counterMu. Keep unrelated caches and in-flight resolutions;
+// invalidating the flight identity also prevents an A -> B -> A late result.
+func (e *Endpoint) syncPeerDNS(previous, next []peerConfig) {
+	byKey := make(map[string]peerConfig, len(next))
+	for _, peer := range next {
+		byKey[peer.publicKeyHex] = peer
+	}
+	e.peerDNSMu.Lock()
+	defer e.peerDNSMu.Unlock()
+	for _, prior := range previous {
+		peer, exists := byKey[prior.publicKeyHex]
+		if exists && peer.destination == prior.destination {
+			continue
+		}
+		delete(e.peerDNSCache, prior.publicKeyHex)
+		if flight := e.peerDNSFlights[prior.publicKeyHex]; flight != nil {
+			flight.cancel()
+			delete(e.peerDNSFlights, prior.publicKeyHex)
+		}
+	}
+}
+func (e *Endpoint) invalidatePeerDNS(closing bool) {
+	e.peerDNSMu.Lock()
+	defer e.peerDNSMu.Unlock()
+	e.peerDNSEpoch++
+	e.peerDNSClosed = e.peerDNSClosed || closing
+	for key := range e.peerDNSCache {
+		delete(e.peerDNSCache, key)
+	}
+	for _, flight := range e.peerDNSFlights {
+		flight.cancel()
+	}
+}
