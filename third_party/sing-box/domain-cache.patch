+//go:build with_wireguard
+
+package wireguard
+
+import (
+	"errors"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/sagernet/sing-box/common/execution"
+	"github.com/sagernet/sing-box/option"
+)
+
+func TestWGPhysicalBusyDoesNotQueueReadbackOrReceivingUpdate(t *testing.T) {
+	for _, operation := range []string{"source-readback", "source-update", "receiving-update"} {
+		t.Run(operation, func(t *testing.T) {
+			endpoint := &Endpoint{}
+			permissions := option.ExecutionOptions{NodeID: "demo-forward", Responsibilities: []string{"forward"}, Policies: []option.ExecutionPolicy{}, Bindings: []option.ExecutionBinding{}, SenderAuthenticationDigests: map[string]string{}}
+			if operation == "receiving-update" {
+				var err error
+				endpoint.execution, err = execution.New(permissions)
+				if err != nil {
+					t.Fatal(err)
+				}
+			} else {
+				state, err := execution.NewState("")
+				if err != nil {
+					t.Fatal(err)
+				}
+				endpoint.transportState.Store(&state)
+			}
+			prior := endpoint.RuntimeExecutionState()
+			endpoint.updateMu.Lock()
+			var once sync.Once
+			unlock := func() { once.Do(endpoint.updateMu.Unlock) }
+			defer unlock()
+			type outcome struct {
+				state       execution.State
+				err         error
+				invalidated bool
+			}
+			done := make(chan outcome, 1)
+			go func() {
+				if operation == "source-readback" {
+					done <- outcome{state: endpoint.RuntimeExecutionState()}
+					return
+				}
+				peers := []option.WireGuardPeer{}
+				update := option.ExecutionUpdate{ExpectedRevision: prior.Revision, WireGuardPeers: &peers}
+				if operation == "receiving-update" {
+					update.Execution = &permissions
+				}
+				invalidated := false
+				state, err := endpoint.UpdateRuntimeExecution(update, "demo-physical", func() { invalidated = true })
+				done <- outcome{state: state, err: err, invalidated: invalidated}
+			}()
+			select {
+			case got := <-done:
+				if operation == "source-readback" {
+					if got.state != prior || got.err != nil {
+						t.Fatal("busy readback changed execution state", got.err)
+					}
+				} else if !errors.Is(got.err, execution.ErrSuperseded) {
+					t.Fatal("busy physical operation was not deferred", got.err)
+				} else if operation == "receiving-update" && (!got.invalidated || got.state.Revision == prior.Revision || got.state.ConfigHash != "" || endpoint.RuntimeExecutionState() != got.state) {
+					t.Fatal("busy physical operation delayed permission or falsely confirmed resources")
+				}
+			case <-time.After(200 * time.Millisecond):
+				unlock()
+				select {
+				case <-done:
+				case <-time.After(time.Second):
+					t.Fatal("blocked operation did not exit after physical mutex release")
+				}
+				t.Fatal("readback or receiving update queued behind physical cleanup")
+			}
+		})
+	}
+}
