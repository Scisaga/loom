+type nativeExecutionRouter struct {
+	adapter.Router
+	targets     chan M.Socksaddr
+	slowTarget  M.Socksaddr
+	slowEntered chan struct{}
+	slowRelease <-chan struct{}
+}
+
+func (r *nativeExecutionRouter) RouteConnectionEx(ctx context.Context, conn net.Conn, metadata adapter.InboundContext, onClose N.CloseHandlerFunc) {
+	value, ok := P.ConnectionFrom(ctx)
+	if !ok || value.PolicyID != "demo-policy" || metadata.ExecutionOutbound != "demo-egress" {
+		conn.Close()
+		return
+	}
+	r.targets <- metadata.Destination
+	if metadata.Destination == r.slowTarget {
+		close(r.slowEntered)
+		<-r.slowRelease
+	}
+	// The formal ConnectionManager confirms its downstream dial before
+	// reporting success, rather than waiting for an application payload.
+	if err := N.ReportConnHandshakeSuccess(conn, nil); err != nil {
+		conn.Close()
+		return
+	}
+	go func() {
+		defer conn.Close()
+		var body [32]byte
+		for {
+			n, err := conn.Read(body[:])
+			if err != nil {
+				return
+			}
+			if _, err = conn.Write(body[:n]); err != nil {
+				return
+			}
+		}
+	}()
+}
+func (r *nativeExecutionRouter) RoutePacketConnectionEx(ctx context.Context, conn N.PacketConn, metadata adapter.InboundContext, onClose N.CloseHandlerFunc) {
+	if _, ok := P.ConnectionFrom(ctx); !ok || metadata.ExecutionOutbound != "demo-egress" {
+		conn.Close()
+		return
+	}
+	r.targets <- metadata.Destination
+	go func() {
+		defer conn.Close()
+		for {
+			body := buf.NewPacket()
+			destination, err := conn.ReadPacket(body)
+			if err != nil {
+				body.Release()
+				return
+			}
+			if err = conn.WritePacket(body, destination); err != nil {
+				return
+			}
+		}
+	}()
+}
+func demoTLS(t *testing.T) (string, string) {
+	t.Helper()
+	key, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	now := time.Now()
+	template := &x509.Certificate{SerialNumber: big.NewInt(1), Subject: pkix.Name{CommonName: "demo.example"}, DNSNames: []string{"demo.example"}, NotBefore: now.Add(-time.Minute), NotAfter: now.Add(time.Hour), KeyUsage: x509.KeyUsageDigitalSignature | x509.KeyUsageCertSign, ExtKeyUsage: []x509.ExtKeyUsage{x509.ExtKeyUsageServerAuth}, IsCA: true, BasicConstraintsValid: true}
+	certificate, err := x509.CreateCertificate(rand.Reader, template, template, &key.PublicKey, key)
+	if err != nil {
+		t.Fatal(err)
+	}
+	private, err := x509.MarshalPKCS8PrivateKey(key)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return string(pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: certificate})), string(pem.EncodeToMemory(&pem.Block{Type: "PRIVATE " + "KEY", Bytes: private}))
+}
+func demoPassword(t *testing.T) string {
+	t.Helper()
+	var data [32]byte
+	if _, err := rand.Read(data[:]); err != nil {
+		t.Fatal(err)
+	}
+	return base64.RawURLEncoding.EncodeToString(data[:])
+}
+func receivingPolicy() option.ExecutionOptions {
+	policy := P.HopPolicy{PolicyID: "demo-policy", ServiceID: "demo-service", Kind: "internet", Origins: []string{"demo-access"}, Exits: []string{"demo-exit"}, Nodes: []string{"demo-exit"}, EntryScope: P.PolicyScope{Mode: "any", NodeIDs: []string{}}, RelayScope: P.PolicyScope{Mode: "none", NodeIDs: []string{}}, Edges: []P.DirectedHop{}}
+	return option.ExecutionOptions{SenderAuthenticationDigests: map[string]string{},NodeID: "demo-exit", AccessEnabled: true, Responsibilities: []string{"internet_egress"}, Policies: []option.ExecutionPolicy{{Policy: policy, EgressOutbound: "demo-egress", ForwardOutbound: "demo-forward", PublicInternet: true}}, Bindings: []option.ExecutionBinding{{Key: "demo-user-a", SenderID: "demo-access"}}}
+}
+func TestIndependentHy2NativeTCPUDPAndStableIdentityOnUserChanges(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), 15*time.Second)
+	defer cancel()
+	certificate, key := demoTLS(t)
+	passwordA, passwordB := demoPassword(t), demoPassword(t)
+	permissions := receivingPolicy()
+	router := &nativeExecutionRouter{targets: make(chan M.Socksaddr, 32)}
+	address := badoption.Addr(netip.MustParseAddr("127.0.0.1"))
+	probe, err := net.ListenPacket("udp4", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	listenPort := uint16(probe.LocalAddr().(*net.UDPAddr).Port)
+	probe.Close()
+	serverAdapter, err := NewInbound(ctx, router, logger.NOP(), "demo-server", option.Hysteria2InboundOptions{Execution: &permissions, ListenOptions: option.ListenOptions{Listen: &address, ListenPort: listenPort}, Users: []option.Hysteria2User{{Name: "demo-user-a", Password: passwordA}}, InboundTLSOptionsContainer: option.InboundTLSOptionsContainer{TLS: &option.InboundTLSOptions{Enabled: true, ServerName: "demo.example", Certificate: []string{certificate}, Key: []string{key}}}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	server := serverAdapter.(*Inbound)
+	defer server.Close()
+	if err = server.Start(adapter.StartStateStart); err != nil {
+		t.Fatal(err)
+	}
+	port := listenPort
+	makeClient := func(origin, password string, extension bool) *Outbound {
+		t.Helper()
+		var route *option.ExecutionRoute
+		if extension {
+			route = &option.ExecutionRoute{PolicyID: "demo-policy", OriginID: origin, FinalExitID: "demo-exit"}
+		}
+		clientAdapter, err := NewOutbound(ctx, router, logger.NOP(), "demo-client", option.Hysteria2OutboundOptions{Execution: route, ServerOptions: option.ServerOptions{Server: "127.0.0.1", ServerPort: port}, Password: password, OutboundTLSOptionsContainer: option.OutboundTLSOptionsContainer{TLS: &option.OutboundTLSOptions{Enabled: true, ServerName: "demo.example", Certificate: []string{certificate}}}})
+		if err != nil {
+			t.Fatal(err)
+		}
+		client := clientAdapter.(*Outbound)
+		t.Cleanup(func() { client.Close() })
+		return client
+	}
+	client := makeClient("demo-access", passwordA, true)
+	target := M.ParseSocksaddr("api.example:443")
+	connect := func(client *Outbound) net.Conn {
+		t.Helper()
+		conn, err := client.DialContext(ctx, "tcp", target)
+		if err != nil {
+			t.Fatal(err)
+		}
+		t.Cleanup(func() { conn.Close() })
+		return conn
+	}
+	exchange := func(conn net.Conn) {
+		t.Helper()
+		_ = conn.SetDeadline(time.Now().Add(3 * time.Second))
+		if _, err = conn.Write([]byte("demo")); err != nil {
+			t.Fatal(err)
+		}
+		var reply [4]byte
+		if _, err = io.ReadFull(conn, reply[:]); err != nil || string(reply[:]) != "demo" {
+			t.Fatal("native Hy2 stream failed", err)
+		}
+	}
+	connection := connect(client)
+	exchange(connection)
+	if actual := <-router.targets; actual != target {
+		t.Fatal("entry lost original target", actual)
+	}
+	packet, err := client.ListenPacket(ctx, target)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer packet.Close()
+	_ = packet.SetDeadline(time.Now().Add(3 * time.Second))
+	if _, err = packet.WriteTo([]byte("udp"), target); err != nil {
+		t.Fatal(err)
+	}
+	var reply [16]byte
+	n, _, err := packet.ReadFrom(reply[:])
+	if err != nil || string(reply[:n]) != "udp" {
+		t.Fatal("Hy2 UDP native context failed", err)
+	}
+	if actual := <-router.targets; actual != target {
+		t.Fatal("UDP target changed")
+	}
+	if _, err = packet.WriteTo([]byte("x"), M.ParseSocksaddr("other.example:443")); err == nil {
+		t.Fatal("registered UDP session changed its target")
+	}
+	// Adding/reordering users must not reinterpret an existing QUIC session's ID.
+	permissions.Policies[0].Policy.Origins = []string{"demo-access", "demo-access-b"}
+	permissions.Bindings = append(permissions.Bindings, option.ExecutionBinding{Key: "demo-user-b", SenderID: "demo-access-b"})
+	users := []option.Hysteria2User{{Name: "demo-user-b", Password: passwordB}, {Name: "demo-user-a", Password: passwordA}}
+	if _, err = server.UpdateRuntimeExecution(option.ExecutionUpdate{ExpectedRevision: server.execution.State().Revision, Execution: &permissions, Hysteria2Users: &users}, "demo-added", nil); err != nil {
+		t.Fatal(err)
+	}
+	exchange(connection)
+	other := makeClient("demo-access-b", passwordB, true)
+	otherConnection := connect(other)
+	exchange(otherConnection)
+	<-router.targets
+	// A valid password without native context cannot fall back to the retired
+	// target-only business request at this Loom receiver.
+	legacy := makeClient("demo-access", passwordA, false)
+	missing := connect(legacy)
+	_ = missing.SetDeadline(time.Now().Add(time.Second))
+	_, _ = missing.Write([]byte("x"))
+	var one [1]byte
+	if _, err = missing.Read(one[:]); err == nil {
+		t.Fatal("context-free business fallback was accepted")
+	}
+	// Rotating one credential closes its old QUIC sessions and preserves others.
+	users[1].Password = demoPassword(t)
+	if _, err = server.UpdateRuntimeExecution(option.ExecutionUpdate{ExpectedRevision: server.execution.State().Revision, Execution: &permissions, Hysteria2Users: &users}, "demo-rotated", nil); err != nil {
+		t.Fatal(err)
+	}
+	_ = connection.SetReadDeadline(time.Now().Add(time.Second))
+	if _, err = connection.Read(one[:]); err == nil {
+		t.Fatal("changed credential preserved its authenticated session")
+	}
+	if errors.Is(err, context.DeadlineExceeded) {
+		t.Fatal("credential withdrawal did not close the session")
+	}
+	exchange(otherConnection)
+}
