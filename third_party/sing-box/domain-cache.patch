 	}
+	if !errors.Is(readErr, io.EOF) {
+		abort(readErr)
+	}
+	// EOF is a read half-close. Already received queries still own responses;
+	// wait for those bounded writes before releasing the other direction.
+	pending.Wait()
+	errorMu.Lock()
+	defer errorMu.Unlock()
+	if failure != nil {
+		return failure
+	}
+	if err := parentCtx.Err(); err != nil {
+		return err
+	}
+	if errors.Is(readErr, io.EOF) {
+		return nil
+	}
+	return readErr
 }
 
