+package execution
+
+import (
+	"context"
+	"crypto/rand"
+	"encoding/base64"
+	"errors"
+
+	"github.com/sagernet/sing-box/adapter"
+	P "github.com/sagernet/sing-box/common/loomprotocol"
+	"github.com/sagernet/sing-box/option"
+	M "github.com/sagernet/sing/common/metadata"
+)
+
+var ErrSuperseded = errors.New("receiving projection changed before apply")
+
+func revision() (string, error) {
+	var nonce [32]byte
+	if _, err := rand.Read(nonce[:]); err != nil {
+		return "", err
+	}
+	return base64.RawURLEncoding.EncodeToString(nonce[:]), nil
+}
+
+// NewState identifies one applied local-runtime projection, never authority.
+func NewState(hash string) (State, error) {
+	revision, err := revision()
+	return State{Revision: revision, ConfigHash: hash}, err
+}
+func (r *Receiver) State() State {
+	if r == nil {
+		return State{}
+	}
+	s := r.current.Load()
+	if s == nil {
+		return State{}
+	}
+	return s.state
+}
+func (r *Receiver) Update(options option.ExecutionOptions) error {
+	_, err := r.Replace(options, "", "", nil, nil)
+	return err
+}
+
+// Replace publishes accepted permission before changing transport admission.
+// A transport error never restores a superseded grant. Invalidation runs under
+// the tracker-registration fence immediately after accepting permission. Actual
+// transport operations serialize outside that fence, including slow teardown.
+func (r *Receiver) Replace(options option.ExecutionOptions, expected, hash string, apply func(State) error, invalidate func()) (State, error) {
+	next, err := compile(options)
+	if err != nil {
+		return State{}, err
+	}
+	next.state.Revision, err = revision()
+	if err != nil {
+		return State{}, err
+	}
+	next.state.ConfigHash = hash
+	if apply != nil {
+		// New permission takes effect before transport admission. Until that
+		// apply completes, a GET must not claim the whole projection succeeded.
+		next.state.ConfigHash = ""
+	}
+	err = func() error {
+		r.fence.Lock()
+		defer r.fence.Unlock()
+		if current := r.current.Load(); expected != "" && (current == nil || current.state.Revision != expected) {
+			return ErrSuperseded
+		}
+		if current := r.current.Load(); current != nil && current.nodeID != next.nodeID {
+			return errors.New("receiving update cannot replace the node identity")
+		}
+		// A permission-only hash proves this accepted permission projection,
+		// independently of older physical work. Resource completeness is checked
+		// separately; an in-flight old callback cannot invalidate this proof.
+		r.current.Store(next)
+		if invalidate != nil {
+			invalidate()
+		}
+		return nil
+	}()
+	if err != nil {
+		return State{}, err
+	}
+	if apply == nil {
+		return next.state, nil
+	}
+
+	// Busy transport work belongs to its original request. Do not queue another
+	// native task after accepting permission: the ordinary current-state retry
+	// can apply its own projection once that physical operation has exited.
+	if !r.transportMu.TryLock() {
+		return r.State(), ErrSuperseded
+	}
+	defer r.transportMu.Unlock()
+	r.fence.RLock()
+	current := r.current.Load()
+	if current != next {
+		r.fence.RUnlock()
+		return current.state, ErrSuperseded
+	}
+	r.fence.RUnlock()
+	err = apply(next.state)
+	r.fence.Lock()
+	defer r.fence.Unlock()
+	if current = r.current.Load(); current != next {
+		// Neither a successful old operation nor a failed one can confirm or
+		// clear the state of a later permission-only/physical replacement.
+		return current.state, errors.Join(ErrSuperseded, err)
+	}
+	if err != nil {
+		return next.state, err
+	}
+	confirmed := *next
+	confirmed.state.ConfigHash = hash
+	r.current.Store(&confirmed)
+	return confirmed.state, nil
+}
+
+type admissionKey struct{}
+type admission struct {
+	receiver  *Receiver
+	principal string
+	target    M.Socksaddr
+}
+
+func withAdmission(ctx context.Context, receiver *Receiver, principal string, target M.Socksaddr) context.Context {
+	return context.WithValue(ctx, admissionKey{}, admission{receiver, principal, target})
+}
+
+// TrackFence is held only for current-grant recheck and tracker registration,
+// never DNS, dialing, stream handshakes or other network work.
+func TrackFence(ctx context.Context) (func(), string, M.Socksaddr, error) {
+	releaseSource := func() {}
+	if metadata := adapter.ContextFrom(ctx); metadata != nil && metadata.ExecutionSourceCheck != nil {
+		var err error
+		releaseSource, err = metadata.ExecutionSourceCheck()
+		if err != nil {
+			return nil, "", M.Socksaddr{}, err
+		}
+	}
+	admitted, ok := ctx.Value(admissionKey{}).(admission)
+	if !ok {
+		return releaseSource, "", M.Socksaddr{}, nil
+	}
+	admitted.receiver.fence.RLock()
+	connection, ok := P.ConnectionFrom(ctx)
+	if !ok {
+		admitted.receiver.fence.RUnlock()
+		releaseSource()
+		return nil, "", M.Socksaddr{}, errors.New("missing admitted connection")
+	}
+	if _, _, err := admitted.receiver.Restore(ctx, admitted.principal, connection, admitted.target); err != nil {
+		admitted.receiver.fence.RUnlock()
+		releaseSource()
+		return nil, "", M.Socksaddr{}, err
+	}
+	metadata := adapter.ContextFrom(ctx)
+	if metadata == nil || admitted.receiver.CheckSenderAuthentication(*metadata) != nil {
+		admitted.receiver.fence.RUnlock()
+		releaseSource()
+		return nil, "", M.Socksaddr{}, ErrDenied
+	}
+	return func() { admitted.receiver.fence.RUnlock(); releaseSource() }, admitted.principal, admitted.target, nil
+}
+
+// WithState holds only a short current-permission fence. The callback must not
+// perform network I/O, construct or start transport resources.
+func (r *Receiver) WithState(expected string, use func() error) error {
+	if r == nil || expected == "" {
+		return ErrSuperseded
+	}
+	r.fence.RLock()
+	defer r.fence.RUnlock()
+	if current := r.current.Load(); current == nil || current.state.Revision != expected {
+		return ErrSuperseded
+	}
+	if use != nil {
+		return use()
+	}
+	return nil
+}
