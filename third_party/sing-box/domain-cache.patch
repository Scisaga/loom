+func TestSystemBusinessStackAcceptsStableDualStackAnchors(t *testing.T) {
+	anchors := []netip.Prefix{netip.MustParsePrefix("127.0.0.1/32"), netip.MustParsePrefix("::1/128")}
+	hostAddress := netip.MustParsePrefix("192.0.2.10/32")
+	hostSource := netip.MustParsePrefix("192.0.2.11/32")
+	device, err := newSystemStackDevice(DeviceOptions{Context: context.Background(), Name: "demo-wg", MTU: 1408, UDPTimeout: time.Minute,
+		StackAddress: anchors, Address: []netip.Prefix{hostAddress}, HostSources: []netip.Prefix{hostSource},
+		CreateDialer: func(string) N.Dialer { return nil },
+	})
+	if err != nil {
+		t.Fatal("business stack initialization required resource-specific IPv6 sources", err)
+	}
+	// Never Start: this test must not create a host TUN. Give cleanup a memory
+	// stand-in so it can exercise the normal combined-stack close sequence.
+	device.systemDevice.device = &demoClosingTun{Tun: tun.Tun(nil)}
+	defer device.Close()
+	if device.userspace.addr4.Len() != 4 || device.userspace.addr6.Len() != 16 {
+		t.Fatal("stable business defaults did not cover both address families")
+	}
+	if device.options.Address[0] != hostAddress || device.options.HostSources[0] != hostSource {
+		t.Fatal("business stack anchors changed host management ownership")
+	}
+}
+
+func TestStableStackBindsOriginalResourceSourceForTCPAndUDP(t *testing.T) {
+	anchors := []netip.Prefix{netip.MustParsePrefix("127.0.0.1/32"), netip.MustParsePrefix("::1/128")}
+	left, err := newStackDevice(DeviceOptions{MTU: 1408, Address: anchors})
+	if err != nil {
+		t.Fatal(err)
+	}
+	right, err := newStackDevice(DeviceOptions{MTU: 1408, Address: anchors})
+	if err != nil {
+		left.Close()
+		t.Fatal(err)
+	}
+	var pumps sync.WaitGroup
+	for _, pair := range [][2]*stackDevice{{left, right}, {right, left}} {
+		pumps.Add(1)
+		go func(source, destination *stackDevice) {
+			defer pumps.Done()
+			packet := make([]byte, 65535)
+			for {
+				sizes := []int{0}
+				if n, err := source.Read([][]byte{packet}, sizes, 0); err != nil || n == 0 {
+					return
+				}
+				if _, err := destination.Write([][]byte{packet[:sizes[0]]}, 0); err != nil {
+					return
+				}
+			}
+		}(pair[0], pair[1])
+	}
+	defer func() { left.Close(); right.Close(); pumps.Wait() }()
+	// Neither source is registered with AddProtocolAddress. The only bytes
+	// leaving either memory stack are synchronously passed to its test peer.
+	source := netip.MustParseAddr("fdab:77::1")
+	target := netip.MustParseAddr("fdab:79::1")
+	remote := tcpip.FullAddress{NIC: tun.DefaultNIC, Addr: tun.AddressFromAddr(target), Port: 443}
+	listener, err := gonet.ListenTCP(right.stack, remote, header.IPv6ProtocolNumber)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer listener.Close()
+	serverTCP := make(chan error, 1)
+	go func() {
+		conn, err := listener.Accept()
+		if err == nil {
+			defer conn.Close()
+			err = conn.SetDeadline(time.Now().Add(3 * time.Second))
+			if err == nil && M.SocksaddrFromNet(conn.RemoteAddr()).Addr != source {
+				err = net.InvalidAddrError("TCP lost the exact resource source")
+			}
+			if err == nil {
+				var body [4]byte
+				_, err = io.ReadFull(conn, body[:])
+				if err == nil {
+					_, err = conn.Write(body[:])
+				}
+			}
+		}
+		serverTCP <- err
+	}()
+	ctx, cancel := context.WithTimeout(adapter.WithWireGuardSource(context.Background(), source), 3*time.Second)
+	defer cancel()
+	conn, err := left.DialContext(ctx, "tcp", M.SocksaddrFrom(target, 443))
+	if err != nil {
+		t.Fatal(err)
+	}
+	_ = conn.SetDeadline(time.Now().Add(3 * time.Second))
+	if _, err := conn.Write([]byte("demo")); err != nil {
+		conn.Close()
+		t.Fatal(err)
+	}
+	var body [4]byte
+	_, err = io.ReadFull(conn, body[:])
+	conn.Close()
+	if err != nil || string(body[:]) != "demo" {
+		t.Fatal("memory TCP return path failed", err)
+	}
+	if err := <-serverTCP; err != nil {
+		t.Fatal(err)
+	}
+	udpServer, err := gonet.DialUDP(right.stack, &remote, nil, header.IPv6ProtocolNumber)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer udpServer.Close()
+	_ = udpServer.SetDeadline(time.Now().Add(3 * time.Second))
+	serverUDP := make(chan error, 1)
+	go func() {
+		var body [4]byte
+		n, from, err := udpServer.ReadFrom(body[:])
+		if err == nil && M.SocksaddrFromNet(from).Addr != source {
+			err = net.InvalidAddrError("UDP lost the exact resource source")
+		}
+		if err == nil {
+			_, err = udpServer.WriteTo(body[:n], from)
+		}
+		serverUDP <- err
+	}()
+	udp, err := left.DialContext(ctx, "udp", M.SocksaddrFrom(target, 443))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer udp.Close()
+	_ = udp.SetDeadline(time.Now().Add(3 * time.Second))
+	if _, err := udp.Write([]byte("demo")); err != nil {
+		t.Fatal(err)
+	}
+	n, err := udp.Read(body[:])
+	if err != nil || n != 4 || string(body[:]) != "demo" {
+		t.Fatal("memory UDP return path failed", err)
+	}
+	if err := <-serverUDP; err != nil {
+		t.Fatal(err)
+	}
+	for _, device := range []*stackDevice{left, right} {
+		for _, addresses := range device.stack.AllAddresses() {
+			for _, address := range addresses {
+				if address.AddressWithPrefix.Address == tun.AddressFromAddr(source) || address.AddressWithPrefix.Address == tun.AddressFromAddr(target) {
+					t.Fatal("business flow added a resource-specific stack address")
+				}
+			}
+		}
+	}
+}
