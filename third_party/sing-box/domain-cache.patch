+package clashapi
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"io"
+	"net"
+	"net/http"
+
+	"github.com/go-chi/render"
+	"github.com/sagernet/sing-box/option"
+	"github.com/sagernet/sing-box/protocol/group"
+)
+
+// A local accepted-config consumer may replace the source authorization
+// projection. This API neither persists authority nor accepts a performance
+// update as a grant. Decisions retain a separate complete CAS snapshot.
+func (s *Server) executionAccess(authenticated bool) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		host, _, err := net.SplitHostPort(s.httpServer.Addr)
+		address := net.ParseIP(host)
+		if !authenticated || err != nil || address == nil || !address.IsLoopback() {
+			http.Error(w, "authenticated loopback required", http.StatusForbidden)
+			return
+		}
+		if r.URL.RawQuery != "" {
+			http.Error(w, "unexpected query", http.StatusBadRequest)
+			return
+		}
+		tag := getEscapeParam(r, "name")
+		outbound, ok := s.outbound.Outbound(tag)
+		selector, typed := outbound.(*group.Selector)
+		if !ok || !typed || !selector.IsAccessSelector() {
+			http.Error(w, "source scope unavailable", http.StatusNotFound)
+			return
+		}
+		if r.Method == http.MethodGet {
+			render.JSON(w, r, selector.AccessAuthorizationState())
+			return
+		}
+		body, err := io.ReadAll(http.MaxBytesReader(w, r.Body, 8<<20))
+		if err != nil {
+			http.Error(w, "projection exceeds limit", http.StatusBadRequest)
+			return
+		}
+		var update struct {
+			Expected string                         `json:"expected_revision"`
+			Access   *option.ExecutionAccessOptions `json:"access"`
+		}
+		decoder := json.NewDecoder(bytes.NewReader(body))
+		decoder.DisallowUnknownFields()
+		if decoder.Decode(&update) != nil || decoder.Decode(new(any)) != io.EOF || update.Expected == "" || update.Access == nil {
+			http.Error(w, "invalid source projection", http.StatusBadRequest)
+			return
+		}
+		var projection map[string]any
+		decoder = json.NewDecoder(bytes.NewReader(body))
+		decoder.UseNumber()
+		if decoder.Decode(&projection) != nil {
+			http.Error(w, "invalid source projection", http.StatusBadRequest)
+			return
+		}
+		delete(projection, "expected_revision")
+		canonical, _ := json.Marshal(projection)
+		sum := sha256.Sum256(canonical)
+		hash := "sha256:" + hex.EncodeToString(sum[:])
+		invalidate := func() {
+			for _, tracker := range s.trafficManager.Snapshot().Connections {
+				metadata := tracker.Metadata().Metadata
+				if metadata.ExecutionSourceScope == tag && selector.CheckAccessConnection(metadata) != nil {
+					_ = tracker.Close()
+				}
+			}
+		}
+		state, err := selector.ReplaceAccess(*update.Access, update.Expected, hash, invalidate)
+		if errors.Is(err, group.ErrSelectionChanged) {
+			http.Error(w, "source authorization superseded", http.StatusConflict)
+			return
+		}
+		if err != nil {
+			http.Error(w, "source projection rejected", http.StatusBadRequest)
+			return
+		}
+		render.JSON(w, r, state)
+	}
+}
