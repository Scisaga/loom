{
  "log": {
    "level": "warn"
  },
  "inbounds": [
    {
      "type": "hysteria2",
      "tag": "in",
      "listen": "::",
      "listen_port": 443,
      "users": [
        {
          "name": "cred-ci",
          "password": "${secret:vault:cred/ci}"
        },
        {
          "name": "cred-phone",
          "password": "${secret:vault:cred/phone}"
        },
        {
          "name": "cred-ws-eg",
          "password": "${secret:vault:cred/ws-eg}"
        },
        {
          "name": "cred-ws-sg",
          "password": "${secret:vault:cred/ws-sg}"
        }
      ],
      "tls": {
        "enabled": true,
        "certificate_path": "/etc/loom/tls/node.crt",
        "key_path": "/etc/loom/tls/node.key",
        "alpn": [
          "h3"
        ]
      }
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "egress"
    },
    {
      "type": "block",
      "tag": "block"
    }
  ],
  "route": {
    "rules": [
      {
        "auth_user": [
          "cred-ci"
        ],
        "outbound": "egress"
      },
      {
        "auth_user": [
          "cred-phone"
        ],
        "outbound": "egress"
      },
      {
        "auth_user": [
          "cred-ws-eg"
        ],
        "outbound": "egress"
      },
      {
        "auth_user": [
          "cred-ws-sg"
        ],
        "outbound": "egress"
      }
    ],
    "final": "block"
  }
}
