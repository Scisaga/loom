{
  "log": {
    "level": "warn"
  },
  "dns": {
    "servers": [
      {
        "tag": "dns0",
        "address": "223.5.5.5",
        "detour": "dns-out"
      },
      {
        "tag": "dns1",
        "address": "119.29.29.29",
        "detour": "dns-out"
      }
    ],
    "strategy": "prefer_ipv4"
  },
  "inbounds": [
    {
      "type": "hysteria2",
      "tag": "in",
      "listen": "::",
      "listen_port": 443,
      "users": [
        {
          "name": "cred-phone",
          "password": "${secret:vault:cred/phone}"
        },
        {
          "name": "cred-ws-llm",
          "password": "${secret:vault:cred/ws-llm}"
        },
        {
          "name": "cred-ws-sg",
          "password": "${secret:vault:cred/ws-sg}"
        },
        {
          "name": "telemetry-cn-bj",
          "password": "${secret:telemetry/cn-bj}"
        },
        {
          "name": "telemetry-cn-cd",
          "password": "${secret:telemetry/cn-cd}"
        },
        {
          "name": "telemetry-cn-gz",
          "password": "${secret:telemetry/cn-gz}"
        }
      ],
      "tls": {
        "enabled": true,
        "certificate_path": "/etc/loom/tls/node.crt",
        "key_path": "/etc/loom/tls/node.key",
        "alpn": [
          "h3"
        ]
      }
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "dns-out"
    },
    {
      "type": "direct",
      "tag": "via-sg-vps",
      "bind_interface": "wg-sg-vps"
    },
    {
      "type": "direct",
      "tag": "egress"
    },
    {
      "type": "direct",
      "tag": "hy2-link-reflector"
    },
    {
      "type": "block",
      "tag": "block"
    }
  ],
  "route": {
    "rules": [
      {
        "auth_user": [
          "cred-phone"
        ],
        "ip_cidr": [
          "10.99.0.4/32"
        ],
        "outbound": "via-sg-vps"
      },
      {
        "auth_user": [
          "cred-ws-sg"
        ],
        "ip_cidr": [
          "10.99.0.4/32"
        ],
        "outbound": "via-sg-vps"
      },
      {
        "auth_user": [
          "cred-ws-llm"
        ],
        "domain": [
          "192.0.2.10",
          "192.0.2.11"
        ],
        "outbound": "egress"
      },
      {
        "auth_user": [
          "telemetry-cn-bj"
        ],
        "ip_cidr": [
          "127.0.0.1/32"
        ],
        "port": [
          61804
        ],
        "outbound": "hy2-link-reflector"
      },
      {
        "auth_user": [
          "telemetry-cn-cd"
        ],
        "ip_cidr": [
          "127.0.0.1/32"
        ],
        "port": [
          61804
        ],
        "outbound": "hy2-link-reflector"
      },
      {
        "auth_user": [
          "telemetry-cn-gz"
        ],
        "ip_cidr": [
          "127.0.0.1/32"
        ],
        "port": [
          61804
        ],
        "outbound": "hy2-link-reflector"
      }
    ],
    "final": "block"
  }
}
