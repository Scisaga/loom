{
  "log": {
    "level": "warn"
  },
  "dns": {
    "servers": [
      {
        "tag": "dns0",
        "address": "223.5.5.5",
        "detour": "dns-out"
      },
      {
        "tag": "dns1",
        "address": "119.29.29.29",
        "detour": "dns-out"
      }
    ],
    "strategy": "prefer_ipv4"
  },
  "inbounds": [
    {
      "type": "hysteria2",
      "tag": "in",
      "listen": "::",
      "listen_port": 443,
      "users": [
        {
          "name": "cred-ci",
          "password": "${secret:vault:cred/ci}"
        },
        {
          "name": "cred-phone",
          "password": "${secret:vault:cred/phone}"
        },
        {
          "name": "cred-ws-eg",
          "password": "${secret:vault:cred/ws-eg}"
        },
        {
          "name": "cred-ws-sg",
          "password": "${secret:vault:cred/ws-sg}"
        },
        {
          "name": "telemetry-cn-bj",
          "password": "${secret:telemetry/cn-bj}"
        },
        {
          "name": "telemetry-cn-cd",
          "password": "${secret:telemetry/cn-cd}"
        }
      ],
      "tls": {
        "enabled": true,
        "certificate_path": "/etc/loom/tls/node.crt",
        "key_path": "/etc/loom/tls/node.key",
        "alpn": [
          "h3"
        ]
      }
    },
    {
      "type": "mixed",
      "tag": "hy2-link-in-cn-sh",
      "listen": "127.0.0.1",
      "listen_port": 61825
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "dns-out"
    },
    {
      "type": "direct",
      "tag": "via-cn-bj"
    },
    {
      "type": "direct",
      "tag": "via-jp-vps",
      "bind_interface": "wg-jp-vps"
    },
    {
      "type": "direct",
      "tag": "via-sg-vps",
      "bind_interface": "wg-sg-vps"
    },
    {
      "type": "direct",
      "tag": "egress"
    },
    {
      "type": "direct",
      "tag": "hy2-link-reflector"
    },
    {
      "type": "hysteria2",
      "tag": "hy2-link-cn-sh",
      "server": "203.0.113.11",
      "server_port": 443,
      "password": "${secret:telemetry/cn-gz}",
      "tls": {
        "enabled": true,
        "server_name": "cn-sh.node.internal",
        "certificate_path": "/etc/loom/tls/ca.crt",
        "alpn": [
          "h3"
        ]
      }
    },
    {
      "type": "block",
      "tag": "block"
    }
  ],
  "route": {
    "rules": [
      {
        "auth_user": [
          "cred-ci"
        ],
        "ip_cidr": [
          "203.0.113.10/32"
        ],
        "outbound": "via-cn-bj"
      },
      {
        "auth_user": [
          "cred-ci"
        ],
        "ip_cidr": [
          "10.99.1.6/32"
        ],
        "outbound": "via-jp-vps"
      },
      {
        "auth_user": [
          "cred-ci"
        ],
        "ip_cidr": [
          "10.99.0.6/32"
        ],
        "outbound": "via-sg-vps"
      },
      {
        "auth_user": [
          "cred-phone"
        ],
        "ip_cidr": [
          "10.99.0.6/32"
        ],
        "outbound": "via-sg-vps"
      },
      {
        "auth_user": [
          "cred-ws-eg"
        ],
        "ip_cidr": [
          "203.0.113.10/32"
        ],
        "outbound": "via-cn-bj"
      },
      {
        "auth_user": [
          "cred-ws-eg"
        ],
        "ip_cidr": [
          "10.99.1.6/32"
        ],
        "outbound": "via-jp-vps"
      },
      {
        "auth_user": [
          "cred-ws-eg"
        ],
        "ip_cidr": [
          "10.99.0.6/32"
        ],
        "outbound": "via-sg-vps"
      },
      {
        "auth_user": [
          "cred-ws-sg"
        ],
        "ip_cidr": [
          "10.99.0.6/32"
        ],
        "outbound": "via-sg-vps"
      },
      {
        "auth_user": [
          "cred-ci"
        ],
        "outbound": "egress"
      },
      {
        "auth_user": [
          "cred-ws-eg"
        ],
        "outbound": "egress"
      },
      {
        "auth_user": [
          "telemetry-cn-bj"
        ],
        "ip_cidr": [
          "127.0.0.1/32"
        ],
        "port": [
          61804
        ],
        "outbound": "hy2-link-reflector"
      },
      {
        "auth_user": [
          "telemetry-cn-cd"
        ],
        "ip_cidr": [
          "127.0.0.1/32"
        ],
        "port": [
          61804
        ],
        "outbound": "hy2-link-reflector"
      },
      {
        "inbound": [
          "hy2-link-in-cn-sh"
        ],
        "outbound": "hy2-link-cn-sh"
      }
    ],
    "final": "block"
  }
}
