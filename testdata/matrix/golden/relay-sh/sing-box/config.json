{
  "log": {
    "level": "warn"
  },
  "inbounds": [
    {
      "type": "hysteria2",
      "tag": "in",
      "listen": "::",
      "listen_port": 4433,
      "users": [
        {
          "name": "cred-android",
          "password": "${secret:vault:cred/android}"
        },
        {
          "name": "cred-ci",
          "password": "${secret:vault:cred/ci}"
        },
        {
          "name": "cred-ws-eg",
          "password": "${secret:vault:cred/ws-eg}"
        },
        {
          "name": "cred-ws-sg",
          "password": "${secret:vault:cred/ws-sg}"
        }
      ],
      "tls": {
        "enabled": true,
        "certificate_path": "/etc/loom/tls/node.crt",
        "key_path": "/etc/loom/secrets/node.key",
        "alpn": [
          "h3"
        ]
      }
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "via-wg-target-jp",
      "bind_interface": "wg-target-jp"
    },
    {
      "type": "direct",
      "tag": "via-wg-target-sg",
      "bind_interface": "wg-target-sg"
    },
    {
      "type": "block",
      "tag": "block"
    }
  ],
  "route": {
    "rules": [
      {
        "auth_user": [
          "cred-android"
        ],
        "ip_cidr": [
          "10.99.0.4/32"
        ],
        "outbound": "via-wg-target-sg"
      },
      {
        "auth_user": [
          "cred-ci"
        ],
        "ip_cidr": [
          "10.99.1.4/32"
        ],
        "outbound": "via-wg-target-jp"
      },
      {
        "auth_user": [
          "cred-ci"
        ],
        "ip_cidr": [
          "10.99.0.4/32"
        ],
        "outbound": "via-wg-target-sg"
      },
      {
        "auth_user": [
          "cred-ws-eg"
        ],
        "ip_cidr": [
          "10.99.1.4/32"
        ],
        "outbound": "via-wg-target-jp"
      },
      {
        "auth_user": [
          "cred-ws-eg"
        ],
        "ip_cidr": [
          "10.99.0.4/32"
        ],
        "outbound": "via-wg-target-sg"
      },
      {
        "auth_user": [
          "cred-ws-sg"
        ],
        "ip_cidr": [
          "10.99.0.4/32"
        ],
        "outbound": "via-wg-target-sg"
      }
    ],
    "final": "block"
  }
}
