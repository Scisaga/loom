[Unit]
Description=Loom private transport relay (non-authority)
After=network-online.target
Wants=network-online.target
Conflicts=loom-control.service

[Service]
Type=simple
ExecStart=/usr/local/libexec/loom-control-minimal control relay --state-dir /var/lib/loom-control-relay --network-config /etc/loom/report/v2/config.json
Restart=on-failure
RestartSec=3s
User=root
Group=root
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadOnlyPaths=/etc/loom/report/v2 /var/lib/loom-control-relay
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
