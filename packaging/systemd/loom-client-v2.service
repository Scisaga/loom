[Unit]
Description=Loom v2 private device configuration and reporting
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/loom client serve-v2
Restart=on-failure
RestartSec=5s
UMask=0077
StateDirectory=loom/client-v2

[Install]
WantedBy=multi-user.target
