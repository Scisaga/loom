# 复制为 .env 并限制读取权限；该文件只放操作输入，不记录部署状态。
# scripts/deploy-code 只解析赋值，不执行 shell、不展开变量或命令。
# SSH 地址、账号、跳板和身份文件仍只维护在 .ssh_config。
LOOM_DEPLOY_HOSTS="demo-control demo-server"
LOOM_LOCAL_NODE=demo-control
LOOM_SSH_CONFIG=.ssh_config
LOOM_DEPLOY_SOURCE=deploy/ssot.yaml
LOOM_RELEASE_DIR=deploy/released
LOOM_SIGNING_KEY=deploy/keys/platform-signing.key
LOOM_PUBLISH_OUTPUTS='["deploy/distribution"]'
LOOM_PUBLISH_HISTORY=deploy/ssot-history
LOOM_PIN_DIR=deploy/pinned
LOOM_DEPLOY_COMMAND=/usr/local/bin/loom

# 已签名跨平台制品目录；发布时复用并增量复制到上述 distribution 节点。
LOOM_CLIENT_RELEASE_SOURCE=dist/client-releases
LOOM_CLIENT_RELEASE_STORE=/var/lib/loom/client-dist/releases

# 以下仅定位本机资料，由操作者向相应 CLI 显式传入；发布工具不自动加载。
LOOM_ADMIN_DIR=deploy/admin
LOOM_CONTROL_STATE_DIR=/var/lib/loom-control
LOOM_ACCEPTANCE_DIR=deploy/evidence
LOOM_CONTROL_WORKTREE=.

# DNS 进程单独通过受保护的 dotenv/环境边界注入；发布工具不转发它。
GANDI_PAT_TOKEN=
